<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(DesktopAssembly)' == ''">
    <ProjectReference Include="../../VibeCode.Desktop/VibeCode.Desktop.csproj" />
  </ItemGroup>
  <!-- Allows the same regression to be run against a previously built desktop assembly. -->
  <ItemGroup Condition="'$(DesktopAssembly)' != ''">
    <Reference Include="VibeCode"><HintPath>$(DesktopAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>
