<Window x:Class="VibeCode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VibeCode.UI"
        xmlns:svc="clr-namespace:VibeCode.Services"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="VibeCode" Icon="pack://application:,,,/VibeCode;component/Assets/logo.png"
        Width="1400" Height="880" MinWidth="960" MinHeight="600"
        Background="{StaticResource Bg0}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Ui}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        KeyDown="OnWindowKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:StatusBrushConverter x:Key="StatusBrush" />
        <ui:DiffBgConverter x:Key="DiffBg" />
        <ui:DiffFgConverter x:Key="DiffFg" />
        <ui:DiffSignConverter x:Key="DiffSign" />
        <ui:TodoFgConverter x:Key="TodoFg" />
        <ui:BannerBrushConverter x:Key="BannerBrush" />
        <ui:BannerFgConverter x:Key="BannerFg" />
        <ui:UsageBrushConverter x:Key="UsageBrush" />
        <ui:CompactUsageConverter x:Key="CompactUsage" />
        <ui:NonEmptyToVisibilityConverter x:Key="ShowIf" />
        <ui:HintVisibilityConverter x:Key="HintVis" />
        <ui:TimeAgoConverter x:Key="TimeAgo" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Bridge pane header actions use compact, fast hover labels. The between-delay window makes each next
             title appear immediately as the pointer moves across the adjacent icon buttons. -->
        <Style x:Key="BridgeActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="500" />
            <Setter Property="ToolTipService.ShowDuration" Value="4000" />
            <Setter Property="ToolTipService.Placement" Value="Bottom" />
            <Setter Property="ToolTipService.VerticalOffset" Value="4" />
        </Style>
        <Style x:Key="BridgeActionToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="500" />
            <Setter Property="ToolTipService.ShowDuration" Value="4000" />
            <Setter Property="ToolTipService.Placement" Value="Bottom" />
            <Setter Property="ToolTipService.VerticalOffset" Value="4" />
        </Style>

        <!-- Large account manager provider picker. WPF's stock ComboBox popup is light-themed, so keep this
             one self-contained and visually consistent with the rest of the dark account surface. -->
        <Style x:Key="AccountProviderOption" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="option" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Rad8}"
                                Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="option" Property="Background" Value="{StaticResource Bg3}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="option" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountProviderPicker" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AccountProviderOption}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="picker" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="pickerBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Rad10}">
                                            <Grid>
                                                <ContentPresenter Margin="14,0,44,0" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                <Border HorizontalAlignment="Right" Width="38" Background="Transparent">
                                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                               Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pickerBorder" Property="Background" Value="{StaticResource Bg3}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="pickerBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="14,0,44,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Margin="0,5,0,0"
                                        Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="{StaticResource Rad10}">
                                    <ScrollViewer Margin="2" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="picker" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Account rows live in virtualized ListBoxes. Strip the stock item chrome because each row supplies
             its own full-width button, hover state, context menu, and accessibility name. -->
        <Style x:Key="AccountManagerListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- staged composer attachment chip: thumbnail for images, icon+name for files; shared by the main composer and each bridge pane -->
        <!-- ImageMenu is declared further down (with the other context menus), so it MUST be DynamicResource here:
             a StaticResource forward reference inside a deferred template throws "Cannot find resource named
             'ImageMenu'" the moment the first chip is laid out, which took the whole app down. -->
        <DataTemplate x:Key="AttachmentChip" DataType="{x:Type ui:Attachment}">
            <Border Margin="0,3,6,3" CornerRadius="{StaticResource Rad9}" Background="{StaticResource Bg1}"
                    BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Preview}" MaxHeight="52" MaxWidth="120" Stretch="Uniform"
                           ContextMenu="{DynamicResource ImageMenu}"
                           Visibility="{Binding HasPreview, Converter={StaticResource ShowIf}}" />
                    <StackPanel Orientation="Horizontal" Margin="9,6,32,6" VerticalAlignment="Center"
                                Visibility="{Binding HasPreview, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="15"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="{StaticResource Text}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Remove badge. Deliberately NOT GhostButton: that style is transparent until hover and
                         paints the glyph in near-white Text (#ECEDF1), which disappears against a pasted
                         screenshot — the reason staged images felt impossible to remove. This carries its own
                         dark disc so the X stays legible over any image content, in either theme. -->
                    <Button Click="OnRemoveAttachment" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="18" Height="18" Padding="0" Margin="3" Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Remove" AutomationProperties.Name="Remove attachment">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="9" Background="#B3000000"
                                        BorderBrush="#59FFFFFF" BorderThickness="1">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9"
                                               Foreground="#FFFFFF" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E5D93025" />
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FFA51D16" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Shared selectable card. Keep this ahead of every deferred DataTemplate that references it:
             StaticResource forward references fail only when those templates are first instantiated. -->
        <Style x:Key="OptionCard" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{StaticResource Bg2}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" CornerRadius="{StaticResource Rad10}" Padding="12,9" Margin="0,3">
                            <DockPanel>
                                <Border x:Name="radio" DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="{StaticResource Rad7}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1.5" Margin="0,2,10,0"
                                        VerticalAlignment="Top">
                                    <Ellipse x:Name="dot" Width="6" Height="6" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="radio" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One dense subagent row, shared by normal chats and Bridge panes. Rows live in a single roster surface
             instead of separate cards so a large swarm stays quick to scan. -->
        <DataTemplate x:Key="SubagentCompactRow" DataType="{x:Type ui:SubagentItem}">
            <Button Click="OnOpenSubagentInspector" Cursor="Hand" Background="Transparent" BorderThickness="0"
                    Padding="0" HorizontalContentAlignment="Stretch" FocusVisualStyle="{x:Null}"
                    ToolTip="Open this subagent's live transcript"
                    AutomationProperties.Name="{Binding Label}"
                    AutomationProperties.HelpText="Open this subagent's live activity and transcript">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
                                Background="Transparent" Padding="7,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource Bg2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.RowSpan="2" Width="6" Height="6" Margin="0,5,8,0"
                             VerticalAlignment="Top"
                             Fill="{Binding VisualStatus, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource Text}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="9.5"
                               Foreground="{StaticResource Faint}" Margin="9,1,1,0" />
                    <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="8.5"
                               Foreground="{StaticResource Faint}" Margin="8,2,1,0" />
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Activity}" FontSize="10" Foreground="{StaticResource Accent}"
                                   MaxWidth="135" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding Activity}" />
                        <TextBlock Grid.Column="1" Text="{Binding Task}" FontSize="10" Foreground="{StaticResource Muted}"
                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding Task}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Bounded roster: the outer surface groups every worker together and the list begins scrolling once it
             grows beyond a compact popup. Selecting a row swaps this shared surface to the child's live transcript. -->
        <DataTemplate x:Key="SubagentRoster" DataType="{x:Type ui:ChatViewModel}">
            <Grid>
                <StackPanel Width="320" Margin="10,8,10,10"
                            Visibility="{Binding SelectedSubagent, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                    <!-- One surface for the whole feature: arm the swarm up top, manage the subagents it spawned
                         right below. Opened by the single header button (chat + Bridge pane), not a ⋮ row. -->
                    <ToggleButton Style="{StaticResource OptionCard}" Margin="0,0,0,9"
                                  IsChecked="{Binding SwarmNextTurn, Mode=TwoWay}"
                                  Visibility="{Binding SwarmsAvailable, Converter={StaticResource BoolVis}}"
                                  AutomationProperties.Name="Use an agent swarm on the next message">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="14"
                                       Foreground="{StaticResource Accent}" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Swarm next message" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding SwarmNextTurnText}" FontSize="10.5"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <TextBlock Text="{Binding SubagentPanelTitle}" Style="{StaticResource Caption}"
                               FontSize="9.5" Margin="2,0,0,6" />
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="{StaticResource Rad8}" ClipToBounds="True"
                            Visibility="{Binding HasSubagents, Converter={StaticResource BoolVis}}">
                        <ScrollViewer MaxHeight="240" Padding="5,1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <ItemsControl ItemsSource="{Binding Subagents}"
                                          ItemTemplate="{StaticResource SubagentCompactRow}" />
                        </ScrollViewer>
                    </Border>
                    <!-- Without this an empty roster opened as a blank card with no explanation. -->
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="{StaticResource Rad8}" Padding="12,11"
                            Visibility="{Binding HasSubagents, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding SwarmAvailabilityText}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>

                <Grid Width="560" Margin="10,8,10,10"
                      Visibility="{Binding DataContext.SelectedSubagent, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Converter={StaticResource ShowIf}}"
                      DataContext="{Binding DataContext.SelectedSubagent, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,9">
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="8,4"
                                Margin="0,0,10,0" Click="OnCloseSubagentInspector"
                                ToolTip="Back to all subagents"
                                AutomationProperties.Name="Back to all subagents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="10"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="All subagents" FontSize="11" Foreground="{StaticResource Accent}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{StaticResource Faint}" Margin="10,1,1,0" />
                        <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="0,3,0,0"
                                 VerticalAlignment="Top"
                                 Fill="{Binding VisualStatus, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="{StaticResource Rad8}" Padding="11,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Activity}" FontSize="11" Foreground="{StaticResource Accent}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Task}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Task, Converter={StaticResource ShowIf}}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource Bg0}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="{StaticResource Rad8}" ClipToBounds="True">
                        <ScrollViewer MinHeight="170" MaxHeight="500" Padding="12,8"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly" ui:AutoScroll.Enabled="True">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Transcript}"
                                              Visibility="{Binding HasTranscript, Converter={StaticResource BoolVis}}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,42"
                                            Visibility="{Binding HasTranscript, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="22"
                                               Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TranscriptEmptyText}" FontSize="11"
                                               Foreground="{StaticResource Muted}" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="310" Margin="0,9,0,0" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="MdViewer" TargetType="md:MarkdownScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="MarkdownStyleName" Value="Sasabune" />
            <!-- MdXaml derives from FlowDocumentScrollViewer but defaults Focusable=False. Mouse focus is required
                 for the viewer to receive Ctrl+C after a drag selection; keep it out of the Tab sequence. -->
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsSelectionEnabled" Value="True" />
            <!-- don't let the (non-scrolling) viewer swallow the wheel - keep the chat scrolling -->
            <Setter Property="ui:WheelForward.ToParent" Value="True" />
        </Style>

        <!-- dark right-click menu for message/tool "Copy" actions (WPF ships a white one) -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Rad7}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkMenuItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Overlay}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource Rad10}" Padding="4">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- "Copy whole conversation" is the way to grab text that spans a tool card: WPF can't
             drag-select across the separate message/card controls, so we copy the transcript wholesale. -->
        <ContextMenu x:Key="BlockMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem Header="Copy" Click="OnCopyBlock" />
            <MenuItem Header="Copy whole conversation" Click="OnCopyConversation" />
        </ContextMenu>

        <!-- right-click on a chat/composer/lightbox image: put the bitmap on the clipboard -->
        <ContextMenu x:Key="ImageMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem Header="Copy image" Click="OnCopyImage" />
        </ContextMenu>

        <!-- thin dark separator for the dark context menus (WPF's default is a white line) -->
        <Style x:Key="DarkSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="6,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- right-click menu for a sidebar chat row: pin / fork / rename / copy / delete -->
        <ContextMenu x:Key="ChatMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem Click="OnPinChat">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PinGlyph}" FontFamily="{StaticResource Icons}" FontSize="12" Width="20"
