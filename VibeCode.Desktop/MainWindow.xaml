        <!-- Composer action button. Vector artwork keeps the send icon stable across Windows font versions; the old
             Segoe glyph rendered as the wrong symbol on some machines and sat visibly off-center. -->
        <Style x:Key="SendButton" TargetType="Button">
            <!-- 30px + the composer's 8px margins = exactly the 46px single-line input height, so the button sits
                 DEAD-CENTER on one line and bottom-anchored as the box grows. 38px filled the pill flush-to-top. -->
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            <Setter Property="ToolTip" Value="Send (Enter)" />
            <Setter Property="AutomationProperties.Name" Value="Send message" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Rad999}"
                                SnapsToDevicePixels="True">
                            <Grid Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="sendIcon" Fill="{TemplateBinding Foreground}" Stretch="Uniform"
                                      Data="M 1,1 L 17,9 L 1,17 L 4.4,10.3 L 11.2,9 L 4.4,7.7 Z" />
                                <Rectangle x:Name="stopIcon" Width="9" Height="9" RadiusX="2" RadiusY="2"
                                           Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <DataTrigger Binding="{Binding CanInterrupt}" Value="True">
                                <Setter TargetName="sendIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="stopIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}" />
                </Trigger>
                <!-- a turn is running → become the stop / interrupt button (declared after the send-hover triggers so it wins).
                     Uses CanInterrupt (running only), NOT IsWorking, so it stays a Send button during "starting session…". -->
                <DataTrigger Binding="{Binding CanInterrupt}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="#55E0808B" />
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                    <Setter Property="ToolTip" Value="Interrupt (Esc)" />
                    <Setter Property="AutomationProperties.Name" Value="Interrupt" />
                </DataTrigger>
                <!-- hover while interruptible: red wash (declared last so it beats the transparent stop background) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CanInterrupt}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource RedSoft}" />
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ message item templates ============ -->

        <DataTemplate DataType="{x:Type ui:UserItem}">
            <Grid Style="{StaticResource Appear}" Margin="0,16,0,0" ContextMenu="{StaticResource BlockMenu}">
                <Grid HorizontalAlignment="Right" MaxWidth="600" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" HorizontalAlignment="Stretch" MaxWidth="600" Background="{StaticResource Bg2}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="{StaticResource RadBubble}"
                        Padding="14,10">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,6"
                                          Visibility="{Binding HasAttachments, Converter={StaticResource ShowIf}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:Attachment}">
                                        <Border Margin="4,3,0,3" CornerRadius="{StaticResource Rad9}" Background="{StaticResource Bg3}"
                                                BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Preview}" MaxHeight="128" MaxWidth="220" Stretch="Uniform"
                                                       Cursor="Hand" MouseLeftButtonDown="OnImageDblClick"
                                                       ContextMenu="{StaticResource ImageMenu}"
                                                       ToolTip="Double-click to expand · right-click to copy"
                                                       Visibility="{Binding HasPreview, Converter={StaticResource ShowIf}}" />
                                                <StackPanel Orientation="Horizontal" Margin="9,7"
                                                            Visibility="{Binding HasPreview, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource Text}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="170" TextWrapping="NoWrap" />
                                                        <TextBlock Text="{Binding SizeText}" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource Text}" Padding="0" TextWrapping="Wrap" IsTabStop="False"
                                     SelectionBrush="{StaticResource AccentDim}" Visibility="{Binding HasText, Converter={StaticResource ShowIf}}"
                                     Style="{x:Null}" FontFamily="{StaticResource Ui}" FontSize="13.5" ui:WheelForward.ToParent="True"
                                     PreviewMouseLeftButtonDown="OnPromptDoubleClick" />
                            <TextBlock Text="{Binding UndoStatusText}" FontSize="10.5" Foreground="{StaticResource Accent}"
                                       Margin="0,6,0,0" Visibility="{Binding HasUndoStatus, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Border>
                    <!-- Accent pulse the navigator flashes over the bubble when you "fly" to this prompt. Starts hidden,
                         never blocks input; code-behind (FlashItem) animates its Opacity. Named so a recycled container
                         reuses one overlay per row. -->
                    <Border x:Name="NavFlash" Grid.Row="0" HorizontalAlignment="Stretch" MaxWidth="600"
                            CornerRadius="{StaticResource RadBubble}" Background="{StaticResource Accent}"
                            Opacity="0" IsHitTestVisible="False" />
                    <Button Grid.Row="1" Width="22" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="4,2,0,0" Padding="0" Click="OnUndoPrompt" ToolTip="{Binding UndoToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Undo this prompt and restore it to the message input"
                            AutomationProperties.HelpText="{Binding UndoToolTip}">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Data="M 11.5,2 L 11.5,8.5 L 3.5,8.5 M 6.5,5.5 L 3.5,8.5 L 6.5,11.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowUndo}" Value="True" />
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding CanRequestUndo}" Value="True">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Setter Property="Opacity" Value="0.82" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding HasUndoStatus}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ============ "Jump to your messages" navigator ============
             Shared popup body (normal-chat header icon next to swarm + Bridge pane ⋮ → Your messages).
             Lists only the user's own prompts (ChatViewModel.UserMessages). Click flies the transcript
             to that prompt and flashes it (OnNavigateToMessage). UI-virtualized for long chats. -->
        <DataTemplate x:Key="UserMessagesPopup">
            <!-- WheelForward.Contain: scroll this list only; never let the wheel reach the chat under the Popup. -->
            <Border Style="{StaticResource PopupCard}" Width="360" MaxHeight="440" ui:WheelForward.Contain="True">
                <DockPanel Margin="2">
                    <DockPanel DockPanel.Dock="Top" Margin="14,11,14,7">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding UserMessages.Count}"
                                   Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Your messages" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderSoft}" Margin="14,0,14,2" />
                    <ListBox ItemsSource="{Binding UserMessages}" Background="Transparent" BorderThickness="0"
                             MaxHeight="360" Padding="6,4"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:UserItem}">
                                <Button Style="{StaticResource GhostButton}" Click="OnNavigateToMessage"
                                        HorizontalContentAlignment="Left" Padding="9,7" Margin="0,1"
                                        Cursor="Hand" AutomationProperties.Name="Jump to this message">
                                    <!-- Cap tooltip: full Preview can be huge (bridge system text) and paints a giant blob. -->
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="320" Padding="10,6">
                                            <TextBlock Text="{Binding ToolTipPreview}" TextWrapping="Wrap" MaxWidth="300"
                                                       FontSize="12" LineHeight="16" />
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE8BD;" FontFamily="{StaticResource Icons}"
                                                   FontSize="10.5" Foreground="{StaticResource Faint}"
                                                   Margin="0,0,9,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Preview}" FontSize="12.5" Foreground="{StaticResource Text}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A pending prompt shared by normal chats and every Bridge pane. The queue-head action is outside the
             faded card so it stays legible and clickable in both the standard and CLI themes. -->
        <DataTemplate DataType="{x:Type ui:QueuedItem}">
            <Grid Style="{StaticResource Appear}" Margin="0,10,0,6">
                <StackPanel HorizontalAlignment="Right" MaxWidth="600">
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="{StaticResource RadBubble}" Padding="14,9" Opacity="0.55">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9"
                                        Padding="4,2" Margin="8,0,0,0" Click="OnCancelQueued"
                                        ToolTip="Cancel this queued message" AutomationProperties.Name="Cancel queued message" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="10.5"
                                           Foreground="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"
                                           ToolTip="This queued message will request a swarm"
                                           Visibility="{Binding UseSwarm, Converter={StaticResource BoolVis}}" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="10.5"
                                           Foreground="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"
                                           ToolTip="Extended queue request"
                                           Visibility="{Binding Extended, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding QueueStatusText}" FontSize="10.5" FontStyle="Italic"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13.5"
                                       Visibility="{Binding HasText, Converter={StaticResource ShowIf}}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Content="{Binding QueueActionText}" HorizontalAlignment="Right"
                            Margin="0,4,3,0" Padding="9,4" Click="OnSendQueuedNow"
                            Visibility="{Binding IsQueueHead, Converter={StaticResource BoolVis}}"
                            IsEnabled="{Binding Owner.CanSendQueuedNow}"
                            ToolTip="{Binding QueueActionToolTip}"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Send prompt now"
                            AutomationProperties.HelpText="{Binding QueueActionToolTip}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:TextItem}">
            <Grid Style="{StaticResource Appear}" Margin="0,6" ContextMenu="{StaticResource BlockMenu}">
                <!-- Bind RenderText, not Text: it is the finished markdown once the block stops and a throttled
                     snapshot (trailing block cursor, unterminated code fence closed) while the message streams, so
                     a long turn reads as markdown live instead of showing its source until the turn ends. -->
                <md:MarkdownScrollViewer Style="{StaticResource MdViewer}" Markdown="{Binding RenderText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ThinkingItem}">
            <StackPanel Style="{StaticResource Appear}" Margin="0,3" ContextMenu="{StaticResource BlockMenu}">
                <!-- Only a thinking block WITH text is an expander; without text (signature-only / omitted display)
                     IsHitTestVisible=False makes it a static, non-clickable "Thought process" marker. -->
                <ToggleButton x:Name="thToggle" Style="{StaticResource GhostToggle}" HorizontalAlignment="Left" Padding="6,3"
                              IsHitTestVisible="{Binding HasText}">
                    <StackPanel Orientation="Horizontal">
                        <!-- brain: Fluent "Brain Circuit" vector (Segoe MDL2/Fluent fonts have no brain glyph) -->
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource Faint}"
                              VerticalAlignment="Center" Margin="0,0,7,0"
                              Data="F1 M14.5 2C16.1405 2 17.4964 3.21548 17.7178 4.79492C19.5765 5.08024 21 6.68645 21 8.625C21 9.72785 20.5383 10.7221 19.7988 11.4277C21.1042 12.0863 22 13.4381 22 15V15.25C22 17.2437 20.5412 18.8958 18.6328 19.1992C18.2015 20.8129 16.7319 21.9998 15.0059 22C13.7782 22 12.686 21.4091 12 20.4961C11.314 21.4091 10.2218 22 8.99414 22C7.26809 21.9998 5.79853 20.8129 5.36719 19.1992C3.45883 18.8958 2 17.2437 2 15.25V15C2 13.4384 2.89526 12.0865 4.2002 11.4277C3.46102 10.7221 3 9.7276 3 8.625C3 6.68645 4.42349 5.08024 6.28223 4.79492C6.50358 3.21548 7.85955 2 9.5 2C10.5054 2 11.4038 2.45677 12 3.17383C12.5962 2.45677 13.4946 2 14.5 2ZM9.5 3.5C8.5335 3.5 7.75 4.2835 7.75 5.25V5.5C7.75 5.91421 7.41421 6.25 7 6.25H6.875C5.56332 6.25 4.5 7.31332 4.5 8.625C4.5 9.93668 5.56332 11 6.875 11H7C8.16483 11 9.12286 11.8852 9.23828 13.0195L9.25 13.25V13.6465C9.98275 13.9433 10.5 14.6608 10.5 15.5C10.5 16.6046 9.60457 17.5 8.5 17.5C7.39543 17.5 6.5 16.6046 6.5 15.5C6.5 14.6608 7.01725 13.9433 7.75 13.6465V13.25L7.74609 13.1729C7.70747 12.7949 7.38817 12.5 7 12.5H6C4.61929 12.5 3.5 13.6193 3.5 15V15.25C3.5 16.6307 4.61929 17.75 6 17.75C6.33862 17.7509 6.62814 17.9771 6.71875 18.292L6.74512 18.4316H6.74707C6.85289 19.5956 7.83586 20.4998 8.99414 20.5C10.2385 20.5 11.25 19.4909 11.25 18.25V9.25H10.3535C10.0567 9.98275 9.3392 10.5 8.5 10.5C7.39543 10.5 6.5 9.60457 6.5 8.5C6.5 7.39543 7.39543 6.5 8.5 6.5C9.3392 6.5 10.0567 7.01725 10.3535 7.75H11.25V5.25C11.25 4.2835 10.4665 3.5 9.5 3.5ZM17.7305 12.5C17.5087 12.883 17.1642 13.1847 16.75 13.3525V14.25C16.75 15.4926 15.7426 16.5 14.5 16.5H12.75V18.25C12.75 19.4909 13.7615 20.5 15.0059 20.5C16.1641 20.4998 17.1471 19.5956 17.2529 18.4316H17.2549L17.2812 18.292C17.3719 17.9771 17.6614 17.7509 18 17.75C19.3807 17.75 20.5 16.6307 20.5 15.25V15C20.5 13.6193 19.3807 12.5 18 12.5H17.7305ZM8.5 15C8.22386 15 8 15.2239 8 15.5C8 15.7761 8.22386 16 8.5 16C8.77614 16 9 15.7761 9 15.5C9 15.2239 8.77614 15 8.5 15ZM14.5 3.5C13.5364 3.5 12.7547 4.27876 12.75 5.24121V15H14.5C14.9142 15 15.25 14.6642 15.25 14.25V13.3525C14.5174 13.0557 14 12.3391 14 11.5C14 10.3954 14.8954 9.5 16 9.5C16.8839 9.5 17.6321 10.074 17.8965 10.8691C18.829 10.5486 19.5 9.6663 19.5 8.625C19.5 7.31332 18.4367 6.25 17.125 6.25H17C16.5858 6.25 16.25 5.91421 16.25 5.5V5.25C16.25 4.2835 15.4665 3.5 14.5 3.5ZM16 11C15.7239 11 15.5 11.2239 15.5 11.5C15.5 11.7761 15.7239 12 16 12C16.2761 12 16.5 11.7761 16.5 11.5C16.5 11.2239 16.2761 11 16 11ZM8.5 8C8.22386 8 8 8.22386 8 8.5C8 8.77614 8.22386 9 8.5 9C8.77614 9 9 8.77614 9 8.5C9 8.22386 8.77614 8 8.5 8Z" />
                        <TextBlock Text="{Binding Header}" Foreground="{StaticResource Faint}" FontStyle="Italic" FontSize="12" />
                        <TextBlock x:Name="chev" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="8"
                                   Foreground="{StaticResource Faint}" Margin="7,2,0,0" RenderTransformOrigin=".5,.5"
                                   Visibility="{Binding HasText, Converter={StaticResource BoolVis}}">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="2,0,0,0" Margin="8,6,0,2" Padding="14,2">
                    <!-- Expanded body shows only when the toggle is checked AND there is real reasoning text, so a
                         recycled (virtualized ListBox) container carrying a stale IsChecked can never flash an empty box. -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, ElementName=thToggle}" Value="True" />
                                        <Condition Binding="{Binding HasText}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" Style="{x:Null}" BorderThickness="0"
                             Background="Transparent" Padding="0" IsTabStop="False" Foreground="{StaticResource Muted}"
                             FontStyle="Italic" FontSize="12.5" TextWrapping="Wrap"
                             SelectionBrush="{StaticResource AccentDim}" ui:WheelForward.ToParent="True" />
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=thToggle}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="chev"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="90" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="chev"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One command/edit inside a compact activity group. The first click on the group exposes these one-line
             rows; this row's own chevron is the second click that reveals the exact command output or file diff. -->
        <DataTemplate x:Key="CompactToolRow" DataType="{x:Type ui:ToolItem}">
            <Border x:Name="row" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1"
                    ContextMenu="{StaticResource BlockMenu}">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding Expanded}" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                  Padding="0" FocusVisualStyle="{x:Null}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="rowHeader" Background="Transparent" Padding="11,7">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="rowHeader" Property="Background" Value="{StaticResource Bg2}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="1,0,9,0" VerticalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="11"
                                       Foreground="{StaticResource Faint}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="compactRowChev" DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}"
                                       FontSize="8" Foreground="{StaticResource Faint}" Margin="10,1,1,0"
                                       RenderTransformOrigin=".5,.5">
                                <TextBlock.RenderTransform><RotateTransform Angle="0" /></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10"
                                       VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap"
                                       Visibility="{Binding HasDiffStat, Converter={StaticResource BoolVis}}">
                                <Run Text="+" Foreground="{StaticResource Green}" /><Run Text="{Binding Added, Mode=OneWay}" Foreground="{StaticResource Green}" /><Run Text="  &#x2212;" Foreground="{StaticResource Red}" /><Run Text="{Binding Removed, Mode=OneWay}" Foreground="{StaticResource Red}" />
                            </TextBlock>
                            <TextBlock Text="{Binding HeaderSummary}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}"
                                       FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                    </ToggleButton>

                    <Border BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,1,0,0" Padding="13,9,13,11"
                            Background="{StaticResource CodeBg}"
                            Visibility="{Binding Expanded, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <StackPanel Visibility="{Binding WebSearchDetails, Converter={StaticResource ShowIf}}">
                                <TextBlock Text="{Binding WebSearchDetailLabel}" Style="{StaticResource Caption}"
                                           FontSize="9" Margin="1,0,0,4" />
                                <TextBox Style="{StaticResource CodeBox}"
                                         Text="{Binding WebSearchDetails, Mode=OneWay}" MaxHeight="260" />
                            </StackPanel>
                            <TextBlock Text="COMMAND" Style="{StaticResource Caption}" FontSize="9" Margin="1,0,0,4"
                                       Visibility="{Binding BashCommand, Converter={StaticResource ShowIf}}" />
                            <TextBox Style="{StaticResource CodeBox}" Text="{Binding BashCommand, Mode=OneWay}"
                                     Visibility="{Binding BashCommand, Converter={StaticResource ShowIf}}" />
                            <TextBlock Text="INPUT" Style="{StaticResource Caption}" FontSize="9" Margin="1,0,0,4"
                                       Visibility="{Binding CompactFallbackInput, Converter={StaticResource ShowIf}}" />
                            <TextBox Style="{StaticResource CodeBox}" Text="{Binding CompactFallbackInput, Mode=OneWay}"
                                     FontSize="11.5" MaxHeight="320"
                                     Visibility="{Binding CompactFallbackInput, Converter={StaticResource ShowIf}}" />
                            <TextBlock Text="CONTENT" Style="{StaticResource Caption}" FontSize="9" Margin="1,0,0,4"
                                       Visibility="{Binding WriteContent, Converter={StaticResource ShowIf}}" />
                            <TextBox Style="{StaticResource CodeBox}" Text="{Binding WriteContent, Mode=OneWay}"
                                     FontSize="11.5" MaxHeight="320"
                                     Visibility="{Binding WriteContent, Converter={StaticResource ShowIf}}" />
                            <Button HorizontalAlignment="Left" Margin="0,3,0,5" Padding="8,3" Cursor="Hand"
                                    Style="{StaticResource GhostButton}" Click="OnViewFullCode"
                                    Visibility="{Binding CanViewCode, Converter={StaticResource BoolVis}}"
                                    ToolTip="Open the full file with these changes highlighted">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11"
                                               Foreground="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="View full code" FontSize="11.5" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Left" Margin="0,0,0,5" Padding="8,3" Cursor="Hand"
                                    Style="{StaticResource GhostButton}" Click="OnOpenInEditor"
                                    Visibility="{Binding CanViewCode, Converter={StaticResource BoolVis}}"
                                    ToolTip="Open this file in VS Code, Cursor, Rider, Sublime…">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11"
                                               Foreground="{StaticResource Faint}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open in editor" FontSize="11.5" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border CornerRadius="{StaticResource Rad8}" Background="{StaticResource CodeBg}" Padding="0,6" Margin="0,2"
                                    Visibility="{Binding DiffLines.Count, Converter={StaticResource ShowIf}}">
                                <ItemsControl ItemsSource="{Binding DiffLines}" ItemTemplate="{StaticResource DiffRow}" />
                            </Border>
                            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}"
                                       FontSize="10.5" Margin="1,5,0,0"
                                       Visibility="{Binding ProgressText, Converter={StaticResource ShowIf}}" />
                            <StackPanel Visibility="{Binding ResultCapped, Converter={StaticResource ShowIf}}">
                                <TextBlock Text="OUTPUT" Style="{StaticResource Caption}" FontSize="9" Margin="1,8,0,4" />
                                <TextBox Style="{StaticResource CodeBox}" Text="{Binding ResultCapped, Mode=OneWay}"
                                         FontSize="11.5" Foreground="{StaticResource Muted}" MaxHeight="300" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="#18E0808B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Expanded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="compactRowChev"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="90" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="compactRowChev"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:CompactToolGroupItem}">
            <Grid x:Name="compactGroupRoot">
                <!-- Normal mode still uses the original ToolItem cards; grouping is only a lossless model wrapper. -->
                <ItemsControl x:Name="fullToolList" ItemsSource="{Binding Tools}" />

                <Border x:Name="compactGroupCard" Visibility="Collapsed" Background="{StaticResource Bg1}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="{StaticResource Rad12}"
                        Margin="0,4" ContextMenu="{StaticResource BlockMenu}">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding Expanded}" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                      Padding="0" FocusVisualStyle="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="groupHeader" Background="Transparent" CornerRadius="{StaticResource Rad11}" Padding="12,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="groupHeader" Property="Background" Value="{StaticResource Bg2}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="1,0,10,0" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="12.5"
                                           Margin="0,0,9,0" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontFamily="{StaticResource Mono}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Rad99}"
                                        Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Accent}" FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="compactGroupChev" DockPanel.Dock="Right" Text="&#xE76C;"
                                           Style="{StaticResource Icon}" FontSize="9" Foreground="{StaticResource Faint}"
                                           Margin="10,1,2,0" RenderTransformOrigin=".5,.5">
                                    <TextBlock.RenderTransform><RotateTransform Angle="0" /></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap"
                                           Visibility="{Binding HasDiffStat, Converter={StaticResource BoolVis}}">
                                    <Run Text="+" Foreground="{StaticResource Green}" /><Run Text="{Binding Added, Mode=OneWay}" Foreground="{StaticResource Green}" /><Run Text="  &#x2212;" Foreground="{StaticResource Red}" /><Run Text="{Binding Removed, Mode=OneWay}" Foreground="{StaticResource Red}" />
                                </TextBlock>
                            </DockPanel>
                        </ToggleButton>

                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="0,0,0,0"
                                Visibility="{Binding Expanded, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource CompactToolRow}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding UseCompactDisplay}" Value="True">
                    <Setter TargetName="fullToolList" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="compactGroupCard" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="compactGroupCard" Property="BorderBrush" Value="#44E0808B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Expanded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="compactGroupChev"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="90" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="compactGroupChev"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ToolItem}">
            <Grid Style="{StaticResource Appear}" Margin="0,4" ContextMenu="{StaticResource BlockMenu}">
                <Border x:Name="card" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1" CornerRadius="{StaticResource Rad12}">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding Expanded}" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                      Padding="0" FocusVisualStyle="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="hd" Background="Transparent" CornerRadius="{StaticResource Rad11}" Padding="12,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hd" Property="Background" Value="{StaticResource Bg2}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="1,0,10,0" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="12.5"
                                           Margin="0,0,9,0" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" FontFamily="{StaticResource Mono}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <Border DockPanel.Dock="Left" Background="{StaticResource BlueSoft}" CornerRadius="{StaticResource Rad99}" Padding="7,1.5"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsAgent, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="subagent" Foreground="{StaticResource Blue}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="toolChev" DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}"
                                           FontSize="9" Foreground="{StaticResource Faint}" Margin="10,1,2,0"
                                           RenderTransformOrigin=".5,.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Foreground="{StaticResource Faint}"
                                           FontSize="10.5" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"
                                           Margin="8,0,0,0" TextWrapping="NoWrap" />
                                <!-- coalesced-edit count ("3 edits") -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding EditCountText}" Foreground="{StaticResource Faint}"
                                           FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap"
                                           Visibility="{Binding IsMultiEdit, Converter={StaticResource BoolVis}}" />
                                <!-- lines added / removed for Edit / MultiEdit -->
                                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap"
                                           Visibility="{Binding HasDiffStat, Converter={StaticResource BoolVis}}">
                                    <Run Text="+" Foreground="{StaticResource Green}" /><Run Text="{Binding Added, Mode=OneWay}" Foreground="{StaticResource Green}" /><Run Text="  &#x2212;" Foreground="{StaticResource Red}" /><Run Text="{Binding Removed, Mode=OneWay}" Foreground="{StaticResource Red}" />
                                </TextBlock>
                                <TextBlock Text="{Binding HeaderSummary}" Foreground="{StaticResource Muted}"
                                           FontFamily="{StaticResource Mono}" FontSize="11.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </DockPanel>
                        </ToggleButton>

                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Faint}"
                                   FontFamily="{StaticResource Mono}" FontSize="10.5" Margin="30,0,12,8"
                                   Visibility="{Binding ProgressText, Converter={StaticResource ShowIf}}" />

                        <!-- subagent transcript -->
                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="14,6,12,10"
                                Visibility="{Binding Children.Count, Converter={StaticResource ShowIf}}">
                            <Border BorderBrush="#558FAEE6" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <ItemsControl ItemsSource="{Binding Children}"
                                              Visibility="{Binding Expanded, Converter={StaticResource BoolVis}}" />
                            </Border>
                        </Border>

                        <!-- expanded body -->
                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="14,10,14,12"
                                Visibility="{Binding Expanded, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding WebSearchDetails, Converter={StaticResource ShowIf}}">
                                    <TextBlock Text="{Binding WebSearchDetailLabel}" Style="{StaticResource Caption}"
                                               FontSize="9.5" Margin="1,0,0,4" />
                                    <TextBox Style="{StaticResource CodeBox}"
                                             Text="{Binding WebSearchDetails, Mode=OneWay}" MaxHeight="260" />
                                </StackPanel>
                                <TextBox Style="{StaticResource CodeBox}" Text="{Binding BashCommand, Mode=OneWay}"
                                         Visibility="{Binding BashCommand, Converter={StaticResource ShowIf}}" />
                                <Button HorizontalAlignment="Left" Margin="0,4,0,6" Padding="8,3" Cursor="Hand"
                                        Style="{StaticResource GhostButton}" Click="OnViewFullCode"
                                        Visibility="{Binding CanViewCode, Converter={StaticResource BoolVis}}"
                                        ToolTip="Open the full file with these changes highlighted">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11.5"
                                                   Foreground="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="View full code" FontSize="12" Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border CornerRadius="{StaticResource Rad8}" Background="{StaticResource CodeBg}" Padding="0,6" Margin="0,4"
                                        Visibility="{Binding DiffLines.Count, Converter={StaticResource ShowIf}}">
                                    <ItemsControl ItemsSource="{Binding DiffLines}" ItemTemplate="{StaticResource DiffRow}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Todos}"
                                              Visibility="{Binding Todos.Count, Converter={StaticResource ShowIf}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2.5">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" Style="{StaticResource Icon}"
                                                           FontSize="12" Foreground="{Binding Status, Converter={StaticResource TodoFg}}"
                                                           Margin="0,1,9,0" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Text}" FontSize="12.5"
                                                           Foreground="{Binding Status, Converter={StaticResource TodoFg}}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Style="{StaticResource CodeBox}" Text="{Binding WriteContent, Mode=OneWay}" FontSize="11.5"
                                         MaxHeight="320"
                                         Visibility="{Binding WriteContent, Converter={StaticResource ShowIf}}" />
                                <md:MarkdownScrollViewer Style="{StaticResource MdViewer}" Markdown="{Binding PlanMarkdown}"
                                                         Visibility="{Binding PlanMarkdown, Converter={StaticResource ShowIf}}" />
                                <StackPanel Visibility="{Binding ResultCapped, Converter={StaticResource ShowIf}}">
                                    <TextBlock Text="OUTPUT" Style="{StaticResource Caption}" FontSize="9.5" Margin="1,8,0,4" />
                                    <TextBox Style="{StaticResource CodeBox}" Text="{Binding ResultCapped, Mode=OneWay}" FontSize="11.5"
                                             Foreground="{StaticResource Muted}" MaxHeight="300" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="#44E0808B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Expanded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="toolChev"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="90" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="toolChev"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:PermItem}">
            <Grid Style="{StaticResource Appear}" Margin="0,10">
                <Border CornerRadius="{StaticResource Rad12}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#664C8DF5" />
                            <Setter Property="Background" Value="{StaticResource Bg1}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPending}" Value="False">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                                    <Setter Property="Opacity" Value="0.65" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Margin="16,12,16,14">
                        <DockPanel>
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Rad99}" Padding="9,2.5" DockPanel.Dock="Left"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="PERMISSION" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="question"><Setter Property="Text" Value="QUESTION" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="plan"><Setter Property="Text" Value="PLAN READY" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0"
                                       VerticalAlignment="Center" DockPanel.Dock="Left" TextWrapping="NoWrap" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding DecisionText, Converter={StaticResource ShowIf}}">
                                <TextBlock FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,1,5,0" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="{StaticResource Green}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="deny">
                                                    <Setter Property="Text" Value="&#xE711;" />
                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="cancelled">
                                                    <Setter Property="Text" Value="&#xE711;" />
                                                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DecisionText}" Foreground="{StaticResource Faint}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12"
                                       FontFamily="{StaticResource Mono}" Margin="10,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>

                        <!-- generic permission body -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="perm"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border CornerRadius="{StaticResource Rad8}" Background="{StaticResource CodeBg}" Padding="0,6" Margin="0,10,0,0"
                                    Visibility="{Binding DiffLines.Count, Converter={StaticResource ShowIf}}">
                                <ItemsControl ItemsSource="{Binding DiffLines}" ItemTemplate="{StaticResource DiffRow}" />
                            </Border>
                            <TextBox Style="{StaticResource CodeBox}" Text="{Binding BodyText, Mode=OneWay}" Margin="0,10,0,0"
                                     MaxHeight="240" Visibility="{Binding BodyText, Converter={StaticResource ShowIf}}" />
                            <DockPanel Margin="0,12,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolVis}}">
                                <Button Content="Allow" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Left" Padding="18,7"
                                        Click="OnPermAllow" />
                                <Button Content="Always allow" Margin="8,0,0,0" DockPanel.Dock="Left" Click="OnPermAllowAlways" />
                                <Button Content="Deny" Style="{StaticResource DangerButton}" Margin="8,0,0,0" DockPanel.Dock="Right"
                                        Click="OnPermDeny" />
                                <TextBox Margin="16,0,0,0" FontSize="12"
                                         Text="{Binding DenyNote, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Tell the agent what to do instead (optional)" />
                            </DockPanel>
                        </StackPanel>

                        <!-- question body -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="question"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ItemsControl ItemsSource="{Binding Questions}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,8">
                                            <TextBlock Text="{Binding Question}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton IsChecked="{Binding Selected}" Style="{StaticResource OptionCard}"
                                                                      HorizontalAlignment="Stretch" Click="OnQuestionOptionClicked">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" />
                                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}"
                                                                           FontSize="11.5" Margin="0,2,0,0"
                                                                           Visibility="{Binding Description, Converter={StaticResource ShowIf}}" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox FontSize="12" Margin="0,6,0,0"
                                                     Text="{Binding Custom, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Or type your own answer" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Answer" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="18,7"
                                    Click="OnQuestionAnswer" Visibility="{Binding IsPending, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <!-- plan body -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="plan"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                    CornerRadius="{StaticResource Rad10}" Padding="14,6" Margin="0,10" MaxHeight="380">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <md:MarkdownScrollViewer Style="{StaticResource MdViewer}" Markdown="{Binding PlanMarkdown}" />
                                </ScrollViewer>
                            </Border>
                            <WrapPanel Visibility="{Binding IsPending, Converter={StaticResource BoolVis}}">
                                <Button Content="Approve · auto-accept edits" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                        Click="OnPlanApproveAuto" />
                                <Button Content="Approve · review edits" Margin="8,0,0,0" Click="OnPlanApproveManual" />
                                <Button Content="Keep planning" Margin="8,0,0,0" Click="OnPlanKeepPlanning" />
                                <TextBox Width="220" Margin="8,0,0,0" FontSize="12"
                                         Text="{Binding DenyNote, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Feedback for the next plan iteration (optional)" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:DividerItem}">
            <Grid Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="{StaticResource BorderSoft}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{StaticResource Bg2}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1" CornerRadius="{StaticResource Rad99}" Padding="10,2.5" Margin="10,0">
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Faint}" FontSize="10" FontWeight="SemiBold" />
                </Border>
                <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource BorderSoft}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:BannerItem}">
            <Grid Style="{StaticResource Appear}" Margin="0,8">
                <Border Background="{Binding Level, Converter={StaticResource BannerBrush}}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="{StaticResource Rad10}" Padding="12,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="13"
                                   Foreground="{Binding Level, Converter={StaticResource BannerFg}}" Margin="1,1,10,0"
                                   VerticalAlignment="Top" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Text}" FontSize="12.5" />
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- root shell (margin compensates for maximized overhang) -->
    <Border x:Name="Shell" Background="{StaticResource Bg0}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ titlebar ============ -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <!-- Companion windows use a plain session label; app-wide extensions stay in the primary shell. -->
                    <TextBlock x:Name="BridgeMonitorTitle" DockPanel.Dock="Left" Visibility="Collapsed"
                               Text="Bridge — second display" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                               FontSize="13.5" Foreground="{StaticResource Muted}" Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="TitleBarBrand" DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0">
                        <Image Width="24" Height="24" VerticalAlignment="Center"
                               Source="pack://application:,,,/VibeCode;component/Assets/logo.png"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="VibeCode logo" />
                        <TextBlock Text="VibeCode" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="13.5"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="for devs" Foreground="{StaticResource Faint}" FontSize="11.5"
                                   Margin="7,1,0,0" VerticalAlignment="Center" />

                        <!-- Spotify inline player (no popup): album art + song + transport + progress. Only when enabled. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    DataContext="{x:Static svc:SpotifyService.Instance}"
                                    Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                            <Border Width="1" Height="18" Background="{StaticResource BorderSoft}" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- connected player -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}">
                                <!-- album art (the png) - hidden when nothing is playing, so only the text remains -->
                                <Border Width="30" Height="30" CornerRadius="{StaticResource Rad6}" Background="{StaticResource Bg3}" ClipToBounds="True" VerticalAlignment="Center"
                                        Margin="0,0,9,0"
                                        Visibility="{Binding HasTrack, Converter={StaticResource BoolVis}}">
                                    <Grid>
                                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="14"
                                                   Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <!-- song + artist: size to content (short names like "Escape"/"V21" used to sit in a
                                     fixed 150px hole with a big empty gap before the transport). Cap at 150 so long
                                     titles ellipsize; ToolTip keeps the full string reachable. -->
                                <StackPanel VerticalAlignment="Center" MaxWidth="150"
                                            ToolTip="{Binding NowPlayingTooltip}">
                                    <TextBlock Text="{Binding Track}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                               MaxWidth="150" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTip="{Binding Track}"
                                               Visibility="{Binding HasTrack, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="{Binding Artist}" FontSize="10" Foreground="{StaticResource Muted}"
                                               MaxWidth="150" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTip="{Binding Artist}"
                                               Visibility="{Binding HasTrack, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="Nothing playing" FontSize="11" Foreground="{StaticResource Faint}"
                                               Visibility="{Binding HasTrack, Converter={StaticResource ShowIf}, ConverterParameter=invert}" />
                                </StackPanel>
                                <!-- transport cluster: a thin duration line ABOVE the (smaller) buttons.
                                     The whole thing hides when nothing is playing - only "Nothing playing" remains. -->
                                <StackPanel VerticalAlignment="Center" Margin="14,0,2,0"
                                            Visibility="{Binding HasTrack, Converter={StaticResource BoolVis}}">
                                    <!-- duration line: elapsed | progress bar | total -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource Mono}" FontSize="8.5"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center" Width="26" TextAlignment="Right" />
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Width="106" Height="3"
                                                     Margin="6,0" VerticalAlignment="Center" Style="{StaticResource SlimProgress}"
                                                     Foreground="{StaticResource SpotifyGreen}" />
                                        <TextBlock Text="{Binding TotalText}" FontFamily="{StaticResource Mono}" FontSize="8.5"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center" Width="26" />
                                    </StackPanel>
                                    <!-- transport row (compact): shuffle / prev / play-pause / next / repeat -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <Button Click="OnSpotifyShuffle" FontFamily="{StaticResource Icons}" FontSize="10"
                                                Width="20" Height="20" Cursor="Hand" VerticalContentAlignment="Stretch"
                                                AutomationProperties.Name="Shuffle" ToolTip="Shuffle">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                    <Style.Triggers>
                                                        <!-- when shuffle is on: low-key green glyph -->
                                                        <DataTrigger Binding="{Binding ShuffleOn}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SpotifyGreenDim}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <!-- centered glyph with an active-underline pinned to the bottom that lights up
                                                 green when shuffle is on (Spotify-style). The line's default is a Style Setter,
                                                 NOT a local Background, so the DataTrigger can actually override it. -->
                                            <Grid>
                                                <TextBlock Text="&#xE8B1;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border Height="2" Width="8" CornerRadius="{StaticResource Rad1}" Margin="0,0,0,2"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShuffleOn}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SpotifyGreen}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="12" Width="20" Height="20"
                                                Margin="1,0,0,0" Foreground="{StaticResource Muted}" Click="OnSpotifyPrevTrack"
                                                AutomationProperties.Name="Previous track" ToolTip="Previous" />
                                        <Button Click="OnSpotifyPlayPause" Width="24" Height="24" Margin="3,0" Cursor="Hand"
                                                Background="{StaticResource Bg2}" Foreground="{StaticResource SpotifyGreen}"
                                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                                FocusVisualStyle="{x:Null}" AutomationProperties.Name="Play or pause">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="pc" Width="24" Height="24" CornerRadius="{StaticResource Rad99}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <TextBlock x:Name="ppGlyph" Text="{Binding PlayPauseGlyph}"
                                                                   FontFamily="{StaticResource Icons}" FontSize="9.5"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter TargetName="pc" Property="Background" Value="{StaticResource SpotifyGreenSoft}" />
                                                            <Setter TargetName="pc" Property="BorderBrush" Value="#4A1DB954" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                                            <Setter TargetName="ppGlyph" Property="Margin" Value="1,0,0,0" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="pc" Property="Background" Value="#3024D062" />
                                                            <Setter TargetName="pc" Property="BorderBrush" Value="{StaticResource SpotifyGreenDim}" />
                                                            <Setter Property="Foreground" Value="{StaticResource SpotifyGreenHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="pc" Property="Background" Value="#34159C46" />
                                                            <Setter TargetName="pc" Property="BorderBrush" Value="{StaticResource SpotifyGreenPress}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="12" Width="20" Height="20"
                                                Margin="1,0,0,0" Foreground="{StaticResource Muted}" Click="OnSpotifyNextTrack"
                                                AutomationProperties.Name="Next track" ToolTip="Next" />
                                        <Button Click="OnSpotifyRepeat" FontFamily="{StaticResource Icons}" FontSize="10"
                                                Width="20" Height="20" Margin="1,0,0,0" Cursor="Hand" VerticalContentAlignment="Stretch"
                                                AutomationProperties.Name="Repeat" ToolTip="Repeat">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RepeatActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SpotifyGreenDim}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <TextBlock Text="{Binding RepeatGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border Height="2" Width="8" CornerRadius="{StaticResource Rad1}" Margin="0,0,0,2"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RepeatActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SpotifyGreen}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <ui:SpotifyVolumeControl Margin="1,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- enabled but not connected -->
                            <Button Style="{StaticResource GhostButton}" Padding="9,4" Cursor="Hand" Click="OnSpotifyOpenSettings"
                                    VerticalAlignment="Center" AutomationProperties.Name="Connect Spotify"
                                    Visibility="{Binding IsConnected, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="12"
                                               Foreground="{StaticResource SpotifyGreen}" VerticalAlignment="Center" />
                                    <TextBlock Text="Connect Spotify" FontSize="11.5" Foreground="{StaticResource Muted}"
                                               Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Games is a toggleable extension (Settings > Extensions) but ships ON by default, so the
                             controller normally sits beside Settings. Its whole slot hides when the extension is
                             switched off, exactly like the Weather chip. -->
                        <Grid VerticalAlignment="Stretch">
                            <ToggleButton x:Name="GamesButton" Style="{StaticResource GhostToggle}"
                                          Width="38" Height="46" Padding="0" Cursor="Hand"
                                          ToolTip="Games" AutomationProperties.Name="Games"
                                          Visibility="{Binding Source={x:Static svc:GamesService.Instance}, Path=Enabled, Converter={StaticResource BoolVis}}"
                                          IsChecked="{Binding IsOpen, ElementName=GamesPopup, Mode=TwoWay}">
                                <TextBlock Text="&#x1F3AE;" FontFamily="Segoe UI Emoji" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="GamesPopup" PlacementTarget="{Binding ElementName=GamesButton}"
                                   Placement="Bottom" VerticalOffset="4" StaysOpen="False"
                                   AllowsTransparency="True">
                                <!-- Replaced at runtime by GamesPopupCard; keep this fallback minimal. -->
                                <Border Style="{StaticResource PopupCard}" Width="280">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="Games" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}" Margin="8,6,8,8" />
                                        <Rectangle Height="1" Fill="{StaticResource BorderHairline}" Margin="4,0,4,4" />
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                HorizontalAlignment="Stretch" Padding="8,7" Click="OnOpenSurviveTheShapes"
                                                AutomationProperties.Name="Open Survive the Shapes">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10"
                                                        Background="#1C45E6D2" Margin="0,0,10,0">
                                                    <TextBlock Text="&#x1F3AF;" FontFamily="Segoe UI Emoji" FontSize="17"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Text="Play" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                           VerticalAlignment="Center" Margin="10,0,2,0" />
                                                <TextBlock Text="Survive the Shapes" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <!-- Weather chip: temperature at a glance, click for radar and SPC maps. Sits just left of the gear
                             because picking a place lives in Settings > Extensions. Only when the extension is on. -->
                        <Button x:Name="WeatherChip" Style="{StaticResource GhostButton}" Padding="9,4" Cursor="Hand" Click="OnWeatherChipClick"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                DataContext="{x:Static svc:WeatherService.Instance}"
                                ToolTip="{Binding ChipTooltip}" AutomationProperties.Name="Weather"
                                Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding ChipText}" FontSize="11.5"
                                       Foreground="{StaticResource WeatherBlue}" VerticalAlignment="Center" />
                        </Button>
                        <!-- No telemetry button here. The HUD is opened from Settings > Usage, next to the same
                             numbers it plots; a second door onto one window is a titlebar slot spent twice. -->
                        <Button x:Name="SettingsButton" Style="{StaticResource TitlebarButton}" Content="&#xE713;" FontSize="12" Click="OnOpenSettings"
                                ToolTip="Settings" AutomationProperties.Name="Settings" />
                        <Button Style="{StaticResource TitlebarButton}" Content="&#xE921;" Click="OnMinimizeClick"
                                AutomationProperties.Name="Minimize" />
                        <Button x:Name="MaxRestoreBtn" Click="OnMaxRestoreClick" AutomationProperties.Name="Maximize">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TitlebarButton}">
                                    <Setter Property="Content" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Content" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource TitlebarClose}" Content="&#xE8BB;" Click="OnCloseClick"
                                AutomationProperties.Name="Close" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ content ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Auto (not fixed 276) so the sidebar Border can collapse to 0 for full-screen chat -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ============ sidebar (collapsible — full-screen chat hides chats + projects) ============ -->
                <Border x:Name="SidebarSurface" Grid.Column="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,0,1,0">
                    <!-- Width lives in the Style (not a local value) so the collapse trigger can override it -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="276" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- footer: account switcher (above) + settings / hidden count -->
                        <Border x:Name="AccountFooter" DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
                                Padding="8,8">
                            <StackPanel>
                                <!-- account switcher: a full-width sidebar-footer row (not a floating pill) -->
                                <ToggleButton x:Name="AccountToggle" Cursor="Hand" HorizontalAlignment="Stretch"
                                              Checked="OnAccountChecked" Unchecked="OnAccountUnchecked"
                                              AutomationProperties.Name="Account manager"
                                              ToolTip="Manage Claude, Codex, Kimi, and Grok accounts">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" CornerRadius="{StaticResource Rad10}" Padding="7,6" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Left" Width="30" Height="30">
                                                        <Border Width="30" Height="30" CornerRadius="{StaticResource Rad99}"
                                                                Background="{StaticResource BrandGradient}">
                                                            <TextBlock Text="{Binding AccountInitial}" Foreground="White" FontSize="13"
                                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- signed-in presence dot (green), ringed to read as a badge -->
                                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                 Margin="0,0,-1,-1" Fill="{StaticResource Green}" Stroke="{StaticResource Bg1}"
                                                                 StrokeThickness="2" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}}" />
                                                    </Grid>
                                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70E;" FontFamily="{StaticResource Icons}"
                                                               FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                                               Margin="8,0,2,0" />
                                                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding AccountLabel}" Foreground="{StaticResource Text}"
                                                                   FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" />
                                                        <TextBlock Text="{Binding AccountSub}" Foreground="{StaticResource Faint}"
                                                                   FontSize="10.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <DockPanel LastChildFill="False" Margin="2,6,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="8,5"
                                            Click="OnOpenSettings" AutomationProperties.Name="Open settings">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                            <TextBlock Text="Settings" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,5"
                                            Click="OnOpenSettings" ToolTip="Find and restore hidden projects in Settings"
                                            AutomationProperties.Name="Hidden projects"
                                            Visibility="{Binding HiddenCount, Converter={StaticResource ShowIf}}">
                                        <TextBlock FontSize="11" Foreground="{StaticResource Faint}">
                                            <Run Text="{Binding HiddenCount, Mode=OneWay}" /><Run Text=" hidden" />
                                        </TextBlock>
                                    </Button>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <!-- collapse the sidebar into full-screen chat (reopen via the round arrow on the edge).
                             Lives here by New chat - not up in the titlebar by the VibeCode logo. -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="12,9,8,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,4" Cursor="Hand"
                                    Click="OnCollapseSidebar" ToolTip="Hide sidebar (full-screen chat)"
                                    AutomationProperties.Name="Hide sidebar">
                                <TextBlock Text="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           Foreground="{StaticResource Faint}" />
                            </Button>
                        </DockPanel>
                        <Button DockPanel.Dock="Top" Margin="12,6,12,4" HorizontalAlignment="Stretch" Click="OnNewChatHome"
                                Padding="12,8" AutomationProperties.Name="New chat">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{StaticResource AccentSoft}" BorderBrush="#404C8DF5"
                                            BorderThickness="1" CornerRadius="{StaticResource Rad10}" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11.5"
                                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            <TextBlock Text="New chat" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                       FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#384C8DF5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4,4,8">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ChatGroups}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"
                                                               Margin="10,10,0,4" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch" Padding="10,7" Click="OnOpenChat"
                                                    ContextMenu="{StaticResource ChatMenu}">
                                                <DockPanel>
                                                    <Ellipse Width="7" Height="7" DockPanel.Dock="Left" Margin="0,0,9,0"
                                                             VerticalAlignment="Center"
                                                             Style="{StaticResource ChatListStatusDot}" />
                                                    <!-- pin marker: shown for rows in the dedicated pinned section -->
                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE718;" FontFamily="{StaticResource Icons}"
                                                               FontSize="10" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                               Margin="0,0,7,0"
                                                               Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}" />
                                                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource Icons}"
                                                            FontSize="9" Padding="5,3" Click="OnCloseChat" ToolTip="Close chat">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                <Setter Property="Opacity" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                 Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <!-- bridge-running cue: this chat is the host of a live bridge; click to return -->
                                                    <TextBlock DockPanel.Dock="Right" Text="&#xE8CE;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,4,0"
                                                               ToolTip="Bridge — click to open (resumes it if it was closed)"
                                                               Visibility="{Binding IsBridgeHost, Converter={StaticResource BoolVis}}" />
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Hiding one project is a row-hover ✕; hiding the lot is a header action, so it
                                     sits on the header rather than being a 35th click. Only shown when there is
                                     something to hide, and it asks first - the undo lives over in Settings. -->
                                <DockPanel Margin="10,16,4,4" LastChildFill="False">
                                    <TextBlock Text="PROJECTS" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2"
                                            Cursor="Hand" Click="OnHideAllProjects"
                                            ToolTip="Hide every project in this list (restore them in Settings ▸ Projects)"
                                            AutomationProperties.Name="Hide all projects"
                                            Visibility="{Binding Projects.Count, Converter={StaticResource ShowIf}}">
                                        <TextBlock Text="Hide all" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                    </Button>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <ToggleButton IsChecked="{Binding Open}" Style="{StaticResource GhostToggle}"
                                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                              Padding="10,7">
                                                    <DockPanel>
                                                        <TextBlock x:Name="projChev" Text="&#xE76C;" FontFamily="{StaticResource Icons}"
                                                                   FontSize="8.5" Foreground="{StaticResource Faint}" Margin="0,1,8,0"
                                                                   VerticalAlignment="Center" DockPanel.Dock="Left"
                                                                   RenderTransformOrigin=".5,.5" TextWrapping="NoWrap">
                                                            <TextBlock.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </TextBlock.RenderTransform>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Open}" Value="True">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Faint}"
                                                                       FontSize="10.5" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                                         Value="True">
                                                                                <Setter Property="Opacity" Value="0" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Button Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                                    Padding="5,3" Click="OnHideProject" ToolTip="Hide this project"
                                                                    AutomationProperties.Name="Hide project">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                        <Setter Property="IsHitTestVisible" Value="False" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                                         Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                                <Setter Property="IsHitTestVisible" Value="True" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" />
                                                    </DockPanel>
                                                </ToggleButton>
                                                <StackPanel Margin="16,0,0,4" Visibility="{Binding Open, Converter={StaticResource BoolVis}}">
                                                    <ItemsControl ItemsSource="{Binding Sessions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch" Padding="8,5"
                                                                        Click="OnResumeSession" ToolTip="{Binding Title}">
                                                                    <DockPanel>
                                                                        <TextBlock Text="{Binding LastModified, Converter={StaticResource TimeAgo}}"
                                                                                   Foreground="{StaticResource Faint}" FontSize="10"
                                                                                   DockPanel.Dock="Right" VerticalAlignment="Center"
                                                                                   Margin="6,0,0,0" />
                                                                        <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}"
                                                                                CornerRadius="{StaticResource Rad5}" Padding="5,1" Margin="5,0,0,0"
                                                                                Visibility="{Binding ProviderBadge, Converter={StaticResource ShowIf}}">
                                                                            <TextBlock Text="{Binding ProviderBadge}" FontSize="9"
                                                                                       Foreground="{StaticResource Accent}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                                                   Foreground="{StaticResource Muted}"
                                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left" Padding="8,5" Click="OnNewChatInProject">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                                            <TextBlock Text="New chat here" Foreground="{StaticResource Muted}" FontSize="11.5"
                                                                       Margin="7,0,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- reopen control: a round arrow button on the left edge (mid-height) to restore the collapsed sidebar -->
                <Button Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="55"
                        Margin="6,0,0,0" Click="OnExpandSidebar" Cursor="Hand"
                        ToolTip="Show sidebar (chats &amp; projects)" AutomationProperties.Name="Show sidebar"
                        Visibility="{Binding SidebarCollapsed, Converter={StaticResource BoolVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cb" Width="30" Height="30" CornerRadius="{StaticResource Rad99}" Background="{StaticResource GlassBar}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="1" Opacity="0.4" />
                                </Border.Effect>
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="13"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cb" Property="Background" Value="{StaticResource Bg3}" />
                                    <Setter TargetName="cb" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ============ animated backdrop (chat + home canvas) ============ -->
                <Grid Grid.Column="1">
                    <Image x:Name="BgImage" gif:ImageBehavior.AutoStart="True" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <!-- unify overlay: pulls the scene's stray hues toward the neutral UI base -->
                    <Rectangle Fill="#141A1A1D" />
                    <!-- gradient vignette scrim: dark at header/composer edges, lighter mid-scroll -->
                    <Rectangle>
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{DynamicResource ScrimChat}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SurfaceShowHome, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource ScrimHome}" />
                                    </DataTrigger>
                                    <!-- bridge: lighter scrim so the custom background reads through the glass panes -->
                                    <DataTrigger Binding="{Binding SurfaceShowBridge, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource ScrimBridge}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Grid>

                <!-- ============ home ============ -->
                <ScrollViewer x:Name="HomeSurface" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SurfaceShowHome, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                    <StackPanel MaxWidth="660" Margin="32,52,32,60">
                        <Image Width="76" Height="76" HorizontalAlignment="Center"
                               Source="pack://application:,,,/VibeCode;component/Assets/logo.png"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Effect="{StaticResource BrandGlow}" />

                        <TextBlock Text="What are we vibing on?" FontFamily="{StaticResource Display}" FontSize="28"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6" />
                        <TextBlock Text="Choose Claude Code, OpenAI Codex, Kimi Code, or Grok, then work with its connected account and your project tools."
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,0,0,28" />

                        <Border Style="{StaticResource Card}" Padding="14" CornerRadius="{StaticResource Rad16}">
                            <StackPanel>
                                <Border Background="{StaticResource Bg2}" CornerRadius="{StaticResource Rad10}" Padding="3"
                                        HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="ClaudeProviderToggle" Style="{StaticResource PillTab}"
                                                      Tag="claude" Click="OnProviderPick" AutomationProperties.Name="Use Claude Code">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✦" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="Claude Code" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="CodexProviderToggle" Style="{StaticResource PillTab}"
                                                      Tag="codex" Click="OnProviderPick" AutomationProperties.Name="Use OpenAI Codex">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="◎" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="OpenAI Codex" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="KimiProviderToggle" Style="{StaticResource PillTab}"
                                                      Tag="kimi" Click="OnProviderPick" AutomationProperties.Name="Use Kimi Code">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="K" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="Kimi Code" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="GrokProviderToggle" Style="{StaticResource PillTab}"
                                                      Tag="grok" Click="OnProviderPick" AutomationProperties.Name="Use Grok">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="G" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="Grok" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                                <DockPanel>
                                    <Button Content="New Chat" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                                            Margin="10,0,0,0" Padding="22,9" Click="OnStartChat" />
                                    <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource Rad10}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13"
                                                       Foreground="{StaticResource Faint}" Margin="12,0,0,0" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,3,4,3"
                                                    Padding="8,4" Click="OnBrowseFolder" ToolTip="Browse for a folder"
                                                    AutomationProperties.Name="Browse folder">
                                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                           Foreground="{StaticResource Muted}" />
                                            </Button>
                                            <Grid>
                                                <TextBox x:Name="CwdBox" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                                         Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
                                                         SelectionBrush="{StaticResource AccentDim}" FontFamily="{StaticResource Mono}"
                                                         FontSize="12.5" Padding="10,9" VerticalContentAlignment="Center"
                                                         KeyDown="OnCwdKeyDown" AutomationProperties.Name="Project folder path" />
                                                <TextBlock Text="Path to a project folder…" Foreground="{StaticResource Faint}"
                                                           FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Visibility>
                                                        <MultiBinding Converter="{StaticResource HintVis}">
                                                            <Binding Path="Text" ElementName="CwdBox" />
                                                            <Binding Path="IsKeyboardFocusWithin" ElementName="CwdBox" />
                                                        </MultiBinding>
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                                <TextBlock x:Name="CwdHint" Text="CLAUDE.md, skills and MCP servers load exactly like the CLI."
                                           Foreground="{StaticResource Faint}" FontSize="11.5" Margin="3,10,0,0" />
                                <ItemsControl ItemsSource="{Binding RecentProjects}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6" Click="OnChipClick" ToolTip="{Binding Cwd}" Cursor="Hand"
                                                    FocusVisualStyle="{x:Null}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{StaticResource Bg2}"
                                                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                                                CornerRadius="{StaticResource Rad99}" Padding="11,4.5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                                           Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                                           Foreground="{StaticResource Muted}" Margin="7,0,0,0"
                                                                           VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Dormant bridges: closing a chat or force-quitting must never lose a multi-agent bridge,
                             so every saved one stays one click from coming back with all of its agents. -->
                        <StackPanel Visibility="{Binding HasResumableBridges, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="SAVED BRIDGES" Style="{StaticResource Caption}" FontSize="11" Margin="4,30,0,8" />
                            <ItemsControl ItemsSource="{Binding ResumableBridges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Padding="12,9" Click="OnResumeSavedBridge"
                                                ToolTip="Reopen this bridge and resume every agent">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE8CE;" Style="{StaticResource Icon}" FontSize="12.5"
                                                           Foreground="{StaticResource Accent}" Margin="0,0,11,0" />
                                                <TextBlock Text="{Binding SavedAt, Converter={StaticResource TimeAgo}}"
                                                           Foreground="{StaticResource Faint}" FontSize="11" DockPanel.Dock="Right"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}"
                                                        CornerRadius="{StaticResource Rad5}" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{StaticResource Accent}" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="RECENT SESSIONS" Style="{StaticResource Caption}" FontSize="11" Margin="4,30,0,8" />
                        <ItemsControl ItemsSource="{Binding RecentSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="12,9" Click="OnResumeSession">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8BD;" Style="{StaticResource Icon}" FontSize="12.5"
                                                       Foreground="{StaticResource Faint}" Margin="0,0,11,0" />
                                            <TextBlock Text="{Binding LastModified, Converter={StaticResource TimeAgo}}"
                                                       Foreground="{StaticResource Faint}" FontSize="11" DockPanel.Dock="Right"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}"
                                                    CornerRadius="{StaticResource Rad5}" Padding="5,1" VerticalAlignment="Center"
                                                    Visibility="{Binding ProviderBadge, Converter={StaticResource ShowIf}}">
                                                <TextBlock Text="{Binding ProviderBadge}" FontSize="9"
                                                           Foreground="{StaticResource Accent}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ chat ============ -->
                <Grid x:Name="ChatSurface" Grid.Column="1"
                      DataContext="{Binding SurfaceActiveChat, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <!-- home screen owns column 1 instead -->
                                <DataTrigger Binding="{Binding SurfaceShowHome, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- bridge overlay owns column 1 instead (and must not bleed through behind the panes) -->
                                <DataTrigger Binding="{Binding SurfaceShowBridge, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- header -->
                    <Border Grid.Row="0" Background="{StaticResource Bg0}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="0,0,0,1" Padding="20,9">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <!-- Your messages: header icon (was a floating bottom-right pill).
                                     Bridge panes open the same list from the ⋮ menu — leave those alone. -->
                                <Grid Width="30" Height="30" Margin="0,0,4,0"
                                      Visibility="{Binding UserMessages.Count, Converter={StaticResource ShowIf}}">
                                    <ToggleButton x:Name="ChatMessagesToggle" Style="{StaticResource IconToggle}"
                                                  ToolTip="Your messages"
                                                  AutomationProperties.Name="Jump to your messages"
                                                  AutomationProperties.HelpText="Jump to a prompt you sent in this chat">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=ChatMessagesToggle}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="5"
                                           Opened="OnUserMessagesPopupOpened"
                                           IsOpen="{Binding IsChecked, ElementName=ChatMessagesToggle, Mode=TwoWay}">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UserMessagesPopup}" />
                                    </Popup>
                                </Grid>
                                <!-- Bridge is the headline action, so it gets its own header button instead of hiding
                                     one level down in ⋮. The ⋮ keeps the secondary stuff (fork / swarm / subagents). -->
                                <Button x:Name="BridgeButton" Style="{StaticResource IconButton}"
                                        Margin="0,0,4,0" Click="OnMenuBridge"
                                        Visibility="{Binding CanBridge, Converter={StaticResource BoolVis}}"
                                        ToolTip="{Binding BridgeMenuDescription, StringFormat='Bridge — {0}'}"
                                        AutomationProperties.Name="Bridge"
                                        AutomationProperties.HelpText="{Binding BridgeMenuDescription}">
                                    <!-- Accent lives on the glyph itself: a Foreground set on the Button does not
                                         reach the templated ContentPresenter here (same reason the messages
                                         toggle below re-binds its own Foreground). -->
                                    <TextBlock Text="&#xE8CE;" FontFamily="{StaticResource Icons}" FontSize="13"
                                               Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Agent swarm + subagents: ONE header button. It arms the swarm and manages the
                                     subagents from the same popup, and carries its own state on the glyph (dot when
                                     armed, count badge while workers are live) instead of a generic ⋮ dot. -->
                                <Grid Width="30" Height="30" Margin="0,0,4,0"
                                      Visibility="{Binding ShowSwarmControl, Converter={StaticResource BoolVis}}">
                                    <ToggleButton x:Name="ChatSubagentsToggle" Style="{StaticResource IconToggle}"
                                                  ToolTip="{Binding SubagentButtonToolTip}"
                                                  AutomationProperties.Name="Agent swarm and subagents"
                                                  AutomationProperties.HelpText="{Binding SubagentButtonToolTip}">
                                        <Grid Width="20" Height="18">
                                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                            <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}"
                                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"
                                                     Visibility="{Binding SwarmNextTurn, Converter={StaticResource BoolVis}}" />
                                            <Border MinWidth="12" Height="12" Padding="2,0" CornerRadius="{StaticResource Rad6}"
                                                    Background="{StaticResource Accent}" BorderBrush="{StaticResource Bg1}"
                                                    BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-3,-4,0"
                                                    Visibility="{Binding ActiveSubagentCount, Converter={StaticResource ShowIf}}">
                                                <TextBlock Text="{Binding ActiveSubagentCount}" FontFamily="{StaticResource Ui}"
                                                           FontSize="7.5" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </ToggleButton>
                                    <Popup x:Name="ChatSubagentsPopup" PlacementTarget="{Binding ElementName=ChatSubagentsToggle}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="5"
                                           IsOpen="{Binding IsChecked, ElementName=ChatSubagentsToggle, Mode=TwoWay}">
                                        <Border Style="{StaticResource PopupCard}" MinWidth="340" MaxWidth="600">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SubagentRoster}" />
                                        </Border>
                                    </Popup>
                                </Grid>
                                <!-- ⋮ More: Fork only now. Hidden outright when Fork is unavailable, otherwise the
                                     menu would open empty (swarm/subagents moved back to their own button). -->
                                <Grid Width="30" Height="30" Margin="0,0,0,0"
                                      Visibility="{Binding CanFork, Converter={StaticResource BoolVis}}">
                                    <ToggleButton x:Name="MoreToggle" Style="{StaticResource IconToggle}" Content="&#xE712;"
                                                  ToolTip="Fork session" Checked="OnMoreChecked" Unchecked="OnMoreUnchecked"
                                                  AutomationProperties.Name="Chat menu"
                                                  AutomationProperties.HelpText="Fork session" />
                                </Grid>
                                <ToggleButton x:Name="PanelToggle" Style="{StaticResource IconToggle}" Content="&#xE8A0;"
                                              ToolTip="Artifacts &amp; todos" AutomationProperties.Name="Artifacts and todos"
                                              IsChecked="False" Margin="4,0,0,0" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" ToolTip="Close chat"
                                        Click="OnCloseActiveChat" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Style="{StaticResource StatusDot}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           MaxWidth="440" />
                                <TextBlock Text="{Binding Cwd}" Foreground="{StaticResource Faint}"
                                           FontFamily="{StaticResource Mono}" FontSize="10.5" Margin="12,1,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           MaxWidth="360" />
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Rad99}" Padding="8,2"
                                        Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProviderDisplay}" Foreground="{StaticResource Accent}" FontSize="10.5" />
                                </Border>
                                <!-- Which account THIS chat runs under. Open chats keep the account they started on by
                                     design; without this the user switches accounts and sees no change anywhere. -->
                                <TextBlock Text="{Binding AccountLabel, StringFormat=running as {0}}"
                                           Visibility="{Binding ShowAccountLabel, Converter={StaticResource BoolVis}}"
                                           Foreground="{StaticResource Faint}" FontSize="10.5" Margin="12,1,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           MaxWidth="200" ToolTip="New chats use the account selected in the account menu." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- messages -->
                    <!-- Virtualized message log: a ListBox (not a plain ItemsControl in a ScrollViewer) so only
                         the on-screen rows are realized. Long chats used to render every heterogeneous item, which
                         lagged badly. The ScrollViewer that used to be x:Name="MsgScroll" now lives inside the
                         ListBox control template (see ListBox.Template) - code-behind reaches it via FindScrollViewer. -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="MsgList"
                                 ItemsSource="{Binding Items}"
                                 ui:NavHost.IsEnabled="True"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.ScrollChanged="OnMsgScrollChanged"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1"
                                 VirtualizingPanel.CacheLengthUnit="Page">
                            <!-- pixel-based virtualizing panel: required for smooth scrolling with variable-height items -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <!-- strip the default ListBox chrome down to a bare ScrollViewer + ItemsPresenter. The
                                 focused layout gets a wider reading/tool-output column when the sidebar is collapsed,
                                 while the regular layout keeps the compact 800px measure. -->
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Margin="28,8,28,24" HorizontalAlignment="Center">
                                            <ItemsPresenter.Style>
                                                <Style TargetType="ItemsPresenter">
                                                    <Setter Property="MaxWidth" Value="800" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Value="True">
                                                            <Setter Property="MaxWidth" Value="1400" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsPresenter.Style>
                                        </ItemsPresenter>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <!-- bare ContentPresenter container: no selection highlight, no focus chrome, no padding -
                                 keeps each item looking identical to before AND lets text selection inside items keep
                                 working (the inner MdXaml viewer / read-only TextBoxes handle the mouse themselves). -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <!-- empty-state overlay: sibling of the list (not an item) so virtualization never touches it.
                             IsHitTestVisible=False lets clicks/scroll fall through to the list underneath.
                             Normal mode: logo + prompt. CLI mode only: provider ASCII art (not a transcript item). -->
                        <StackPanel Margin="0,80,0,0" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Visibility="{Binding Items.Count, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                            <!-- standard empty state (dark / non-CLI) -->
                            <StackPanel Visibility="{Binding ShowNormalEmpty, Converter={StaticResource BoolVis}}">
                                <Image Width="56" Height="56" HorizontalAlignment="Center"
                                       Source="pack://application:,,,/VibeCode;component/Assets/logo.png"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="VibeCode logo" />
                                <TextBlock Text="What are we building today?" Foreground="{StaticResource Muted}" FontSize="15"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
                                <TextBlock Text="Shift+Enter for a new line - type / for commands" Foreground="{StaticResource Faint}"
                                           FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                            <!-- CLI mode: cool provider banner, then the same hints in mono -->
                            <StackPanel Visibility="{Binding ShowCliWelcome, Converter={StaticResource BoolVis}}"
                                        HorizontalAlignment="Center">
                                <!-- DownOnly: the banner is fixed-width mono art, so a narrow window shrinks it
                                     rather than cropping the last letters off the word. -->
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CliWelcomeArt}" FontFamily="{StaticResource Mono}"
                                               FontSize="11.5" Foreground="{StaticResource Accent}"
                                               TextAlignment="Left" HorizontalAlignment="Center"
                                               TextWrapping="NoWrap" LineHeight="14"
                                               SnapsToDevicePixels="True"
                                               AutomationProperties.Name="{Binding CliWelcomeTagline}" />
                                </Viewbox>
                                <TextBlock Text="{Binding CliWelcomeTagline}" FontFamily="{StaticResource Mono}"
                                           FontSize="12" Foreground="{StaticResource Muted}"
                                           HorizontalAlignment="Center" Margin="0,14,0,6" />
                                <TextBlock Text="Shift+Enter · new line    / · commands"
                                           FontFamily="{StaticResource Mono}" FontSize="11"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- composer -->
                    <Border Grid.Row="2" Background="Transparent" Padding="24,4,24,10">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="MaxWidth" Value="800" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="True">
                                            <Setter Property="MaxWidth" Value="1400" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="{StaticResource RedSoft}" BorderBrush="#44E0808B" BorderThickness="1"
                                    CornerRadius="{StaticResource Rad12}" Padding="12,9" Margin="0,0,0,10"
                                    Visibility="{Binding AuthNeeded, Converter={StaticResource BoolVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                            FontSize="10" Width="26" Height="26" Margin="6,0,0,0" Click="OnDismissAuth"
                                            ToolTip="Dismiss" AutomationProperties.Name="Dismiss sign-in banner" />
                                    <Button Content="{Binding SignInButtonText}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                                            Click="OnSignIn" />
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="{StaticResource Icons}" FontSize="13"
                                               Foreground="{StaticResource Red}" VerticalAlignment="Center" Margin="1,0,10,0"
                                               TextWrapping="NoWrap" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Text}" FontSize="12.5"
                                               Text="{Binding AuthMessage}" />
                                </DockPanel>
                            </Border>

                            <!-- transient composer status/errors (dictation, attachments); collapsed when empty -->
                            <Border x:Name="ComposerHint" HorizontalAlignment="Left" Margin="4,0,0,8" Padding="9,3" CornerRadius="{StaticResource Rad99}"
                                    Background="{StaticResource AccentSoft}"
                                    Visibility="{Binding Text, ElementName=ComposerHintText, Converter={StaticResource ShowIf}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="NoWrap" />
                                    <TextBlock x:Name="ComposerHintText" FontSize="11.5" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Bg2}" BorderThickness="1" CornerRadius="{StaticResource Rad16}"
                                    AllowDrop="True" PreviewDragOver="OnComposerDragOver" PreviewDrop="OnComposerDrop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- The send button lives INSIDE this bubble, pinned to the right of the text box - do not move it
                                         down into the composer-controls DockPanel below. Out there it inflates that row (every ghost
                                         pill stretches to its height) and reads as a loose orb floating outside the composer. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InputBox" Grid.Column="0" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
                                                 SelectionBrush="{StaticResource AccentDim}" FontSize="14" Padding="16,13,6,14"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220"
                                                 VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnInputKeyDown"
                                                 DataObject.Pasting="OnComposerPasting"
                                                 TextChanged="OnInputChanged" LostKeyboardFocus="OnInputLostFocus"
                                                 AutomationProperties.Name="Message input" />
                                        <TextBlock Grid.Column="0" Text="{Binding ComposerPlaceholder}" Foreground="{StaticResource Faint}" FontSize="14"
                                                   Margin="17,13,0,0" IsHitTestVisible="False" VerticalAlignment="Top">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource HintVis}">
                                                    <Binding Path="Text" ElementName="InputBox" />
                                                    <Binding Path="IsKeyboardFocusWithin" ElementName="InputBox" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <!-- Bottom-aligned so it stays put as the box grows to its 220px max height. -->
                                        <Button Grid.Column="1" Style="{StaticResource SendButton}" Click="OnSendClick"
                                                VerticalAlignment="Bottom" Margin="0,0,8,8" />
                                    </Grid>
                                    <!-- staged attachments (images / files) sent with the next message -->
                                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="14,2,14,2"
                                                  ItemTemplate="{StaticResource AttachmentChip}"
                                                  Visibility="{Binding HasAttachments, Converter={StaticResource ShowIf}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- composer controls: moved out of the input bubble, sit just below it. VerticalAlignment=Center +
                                 a pinned Height keep every pill at its natural size - without this, dropping any taller control
                                 in here silently stretches all the others to match (which is what the send button used to do). -->
                            <DockPanel Margin="6,8,6,0" LastChildFill="False" Height="30"
                                       VerticalAlignment="Center" TextBlock.LineHeight="14">
                                        <Button x:Name="AttachButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Left"
                                                Padding="7,5" Margin="0,0,2,0" Click="OnAttachClick"
                                                ToolTip="Attach image or file (or paste / drag-drop)" AutomationProperties.Name="Attach file">
                                            <TextBlock Text="&#xE723;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </Button>
                                        <!-- dictate: push-to-talk mic (offline speech-to-text). Click to record, click again to insert. -->
                                        <Button x:Name="MicButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Left"
                                                Padding="7,5" Margin="0,0,2,0" Click="OnMicClick"
                                                ToolTip="Dictate (speech to text)" AutomationProperties.Name="Dictate">
                                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </Button>
                                        <ToggleButton x:Name="ModeToggle" Style="{StaticResource GhostToggle}" DockPanel.Dock="Left"
                                                      Padding="9,5" Checked="OnModeChecked" Unchecked="OnModeUnchecked"
                                                      AutomationProperties.Name="Permission mode">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ModeIcon}" FontFamily="{StaticResource Icons}" FontSize="10"
                                                           Margin="0,1,6,0" VerticalAlignment="Center" TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <!-- accept-edits lightning reads yellow (energetic); other modes keep the neutral text colour -->
                                                                <DataTrigger Binding="{Binding Mode}" Value="acceptEdits">
                                                                    <Setter Property="Foreground" Value="{StaticResource Yellow}" />
                                                                </DataTrigger>
                                                                <!-- bypass permissions is dangerous - flag it red -->
                                                                <DataTrigger Binding="{Binding Mode}" Value="bypassPermissions">
                                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ModeDisplay}" FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Mode}" Value="bypassPermissions">
                                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                           Foreground="{StaticResource Faint}" Margin="6,2,0,0" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="ModelToggle" Style="{StaticResource GhostToggle}" DockPanel.Dock="Left"
                                                      Padding="9,5" Margin="2,0,0,0" Checked="OnModelChecked" Unchecked="OnModelUnchecked"
                                                      AutomationProperties.Name="Model picker">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                           Margin="0,1,6,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding ModelDisplay}" FontSize="11.5" />
                                                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                           Foreground="{StaticResource Faint}" Margin="6,2,0,0" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="ThinkToggle" Style="{StaticResource GhostToggle}" DockPanel.Dock="Left"
                                                      Padding="9,5" Margin="2,0,0,0" Checked="OnThinkChecked" Unchecked="OnThinkUnchecked"
                                                      AutomationProperties.Name="Effort level" ToolTip="Reasoning effort for this model"
                                                      Visibility="{Binding HasEffort, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                           Margin="0,1,6,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                <TextBlock FontFamily="{StaticResource Mono}" FontSize="9" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" ToolTip="{Binding EffortDisplay}"><Run Text="{Binding EffortFilled, Mode=OneWay}" Foreground="{StaticResource Accent}" /><Run Text="{Binding EffortEmpty, Mode=OneWay}" Foreground="{StaticResource Faint}" /></TextBlock>
                                                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                           Foreground="{StaticResource Faint}" Margin="6,2,0,0" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="ExtendedQueueToggle" Style="{StaticResource GhostToggle}" DockPanel.Dock="Left"
                                                      Padding="9,5" Margin="2,0,0,0"
                                                      Checked="OnExtendedQueueChecked" Unchecked="OnExtendedQueueUnchecked"
                                                      AutomationProperties.Name="Extended queue settings"
                                                      ToolTip="{Binding ExtendedQueueDescription}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                           Margin="0,1,6,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding ExtendedQueueDisplay}" FontSize="11.5" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExtendedQueueEnabled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ExtendedQueuePaused}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Yellow}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                           Foreground="{StaticResource Faint}" Margin="6,2,0,0" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ToggleButton>
                            </DockPanel>

                            <!-- status strip -->
                            <DockPanel Margin="6,7,6,0" LastChildFill="False" Height="16">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                            Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource Accent}" Margin="0,0,3,0">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1"
                                                                             Duration="0:0:0.45" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource Accent}" Margin="0,0,3,0">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:0.15">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1"
                                                                             Duration="0:0:0.45" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource Accent}">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:0.3">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1"
                                                                             Duration="0:0:0.45" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </StackPanel>
                                    <TextBlock Text="{Binding WorkingText}" Foreground="{StaticResource Muted}" FontSize="11"
                                               FontFamily="{StaticResource Mono}" Margin="0,0,14,0" TextWrapping="NoWrap" />
                                </StackPanel>
                                <!-- Same token theme for every provider (including Grok): total (in/out). -->
                                <TextBlock Text="{Binding TokensText}" Foreground="{StaticResource Muted}" FontSize="11"
                                           FontFamily="{StaticResource Mono}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Margin="0,0,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasTokens, Converter={StaticResource BoolVis}}" />
                                <ToggleButton x:Name="GrokAccountUsageToggle" DockPanel.Dock="Left"
                                              Padding="7,1" Margin="0,0,10,0"
                                              Checked="OnGrokUsageChecked" Unchecked="OnGrokUsageUnchecked"
                                              AutomationProperties.Name="Grok account usage"
                                              ToolTip="Grok plan usage, reset time, and prepaid balance">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource GhostToggle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGrok}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Grok" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding GrokUsageSummary}" FontSize="10.5"
                                                   FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="7"
                                                   Margin="6,1,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Text="{Binding CtxText}" Foreground="{StaticResource Muted}" FontSize="10.5"
                                           FontFamily="{StaticResource Mono}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="·" Foreground="{StaticResource Faint}" FontSize="10.5" DockPanel.Dock="Left"
                                           Margin="8,0" VerticalAlignment="Center"
                                           Visibility="{Binding CostText, Converter={StaticResource ShowIf}}" />
                                <TextBlock Text="{Binding CostText}" Foreground="{StaticResource Faint}" FontSize="10.5"
                                           FontFamily="{StaticResource Mono}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SessionShort}" Foreground="{StaticResource Faint}" FontSize="10.5"
                                           FontFamily="{StaticResource Mono}" DockPanel.Dock="Right" ToolTip="{Binding SessionId}"
                                           VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <ToggleButton x:Name="UsageToggle" DockPanel.Dock="Right"
                                              Padding="7,1" Margin="0,0,10,0" Checked="OnUsageChecked" Unchecked="OnUsageUnchecked"
                                              AutomationProperties.Name="Claude account usage" ToolTip="Claude plan, limits and reset times">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource GhostToggle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsClaude}" Value="True" />
                                                        <Condition Binding="{Binding Summary, Source={x:Static svc:UsageService.Instance}, Converter={StaticResource ShowIf}}" Value="Visible" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Summary, Source={x:Static svc:UsageService.Instance}}"
                                                   FontSize="10.5" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="7"
                                                   Margin="6,1,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="CodexUsageToggle" DockPanel.Dock="Right"
                                              Padding="7,1" Margin="0,0,10,0"
                                              Checked="OnCodexUsageChecked" Unchecked="OnCodexUsageUnchecked"
                                              AutomationProperties.Name="OpenAI Codex account usage"
                                              ToolTip="OpenAI Codex limits and reset times">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource GhostToggle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCodex}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.IsCodexSignedIn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.HasCodexAccountUsage, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding DataContext.CodexAccountUsage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10.5" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="7"
                                                   Margin="6,1,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </ToggleButton>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ bridge: multiple coding-agent providers on one project ============ -->
                <!-- transparent so the animated backdrop + scrim (driven by the background setting) show through,
                     exactly like the normal chat view. The chat grid above is collapsed while ShowBridge so it can't bleed through.
                     Bound to ShowBridge (not IsBridge) so the bridge can keep running hidden in the background. -->
                <Grid x:Name="BridgeSurface" Grid.Column="1"
                      Visibility="{Binding SurfaceShowBridge, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ShowIf}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- bridge header -->
                    <Border Grid.Row="0" Background="{StaticResource GlassBar}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="0,0,0,1" Padding="20,9">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <!-- Minimized bridge agents: click a chip to bring that pane back onto the grid.
                                     Sits next to the usage pills so a hidden agent is one click away without hunting. -->
                                <ItemsControl ItemsSource="{Binding BridgePanes}" VerticalAlignment="Center" Margin="0,0,6,0"
                                              Visibility="{Binding HasMinimizedBridgePanes, Converter={StaticResource BoolVis}}"
                                              AutomationProperties.Name="Minimized bridge agents">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Visibility" Value="{Binding BridgeMinimized, Converter={StaticResource BoolVis}}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:ChatViewModel}">
                                            <Button Style="{StaticResource GhostButton}" Padding="9,3.5" Margin="0,0,6,0"
                                                    Click="OnRestoreBridgePane" Cursor="Hand"
                                                    ToolTip="Restore this agent to the bridge grid"
                                                    AutomationProperties.Name="{Binding BridgeLabel, StringFormat=Restore {0}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="chip" Background="{StaticResource Bg2}"
                                                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                                                CornerRadius="{StaticResource Rad99}" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE922;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                                           Margin="0,0,6,0" />
                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                         Style="{StaticResource StatusDot}" />
                                                                <TextBlock Text="{Binding BridgeLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                                                           TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="{StaticResource Bg3}" />
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentSoft}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Artifacts were removed from bridges; each pane opens its own todos from the ⋮ menu. -->
                                <!-- account usage (session · week): the bridge has no per-chat status strip, so surface
                                     the shared rate-limit numbers up here. CLICK to open the full breakdown + refresh.
                                     Hidden until /usage has produced a summary.
                                     Four providers can be on one bridge, so every pill here is deliberately dense:
                                     tight padding, small type, and no dropdown chevron. The full wording lives in the
                                     tooltip and the popup. -->
                                <ToggleButton x:Name="BridgeUsageToggle" Cursor="Hand" Margin="0,0,5,0" VerticalAlignment="Center"
                                              Checked="OnBridgeUsageChecked" Unchecked="OnBridgeUsageUnchecked"
                                              AutomationProperties.Name="Claude account usage"
                                              ToolTip="{Binding Summary, Source={x:Static svc:UsageService.Instance}, StringFormat=Claude — {0}. Click for details.}"
                                              Visibility="{Binding BridgeUsesClaude, Converter={StaticResource BoolVis}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="pill" Background="{StaticResource Bg2}" BorderBrush="{StaticResource BorderSoft}"
                                                    BorderThickness="1" CornerRadius="{StaticResource Rad99}" Padding="7,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Claude" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Summary, Source={x:Static svc:UsageService.Instance}, Converter={StaticResource CompactUsage}}"
                                                               FontSize="9.5"
                                                               FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="pill" Property="Background" Value="{StaticResource Bg3}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="pill" Property="Background" Value="{StaticResource Bg3}" />
                                                    <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- Codex account usage: opens its own app-server-backed breakdown rather than Claude's
                                     /usage panel. The cached summary remains instant while opening forces fresh data. -->
                                <ToggleButton x:Name="BridgeCodexUsageToggle" Cursor="Hand" Margin="0,0,5,0"
                                              VerticalAlignment="Center" Checked="OnBridgeCodexUsageChecked"
                                              Unchecked="OnBridgeCodexUsageUnchecked"
                                              ToolTip="{Binding CodexAccountUsage, StringFormat=Codex — {0}. Click for limits and reset times.}"
                                              AutomationProperties.Name="OpenAI Codex account usage">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsBridge}" Value="True" />
                                                        <Condition Binding="{Binding BridgeUsesCodex}" Value="True" />
                                                        <Condition Binding="{Binding IsCodexSignedIn}" Value="True" />
                                                        <Condition Binding="{Binding HasCodexAccountUsage}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="codexPill" Background="{StaticResource Bg2}"
                                                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                                    CornerRadius="{StaticResource Rad99}" Padding="7,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Codex" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding CodexAccountUsage, Converter={StaticResource CompactUsage}}"
                                                               FontSize="9.5"
                                                               FontFamily="{StaticResource Mono}" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CodexAtLimit}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="codexPill" Property="Background" Value="{StaticResource Bg3}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="codexPill" Property="Background" Value="{StaticResource Bg3}" />
                                                    <Setter TargetName="codexPill" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- Kimi for Coding quota. Kimi's own /usage only counts session tokens, so this comes
                                     from the plan quota endpoint the Kimi CLI itself uses. -->
                                <ToggleButton x:Name="BridgeKimiUsageToggle" Cursor="Hand" Margin="0,0,5,0"
                                              VerticalAlignment="Center" Checked="OnBridgeKimiUsageChecked"
                                              Unchecked="OnBridgeKimiUsageUnchecked"
                                              ToolTip="{Binding Summary, Source={x:Static svc:KimiUsageService.Instance}, StringFormat='Kimi — {0}. Click for quota and reset times.'}"
                                              AutomationProperties.Name="Kimi account usage">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding BridgeUsesKimi}" Value="True" />
                                                        <Condition Binding="{Binding HasData, Source={x:Static svc:KimiUsageService.Instance}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="kimiPill" Background="{StaticResource Bg2}"
                                                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                                    CornerRadius="{StaticResource Rad99}" Padding="7,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Kimi" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Summary, Source={x:Static svc:KimiUsageService.Instance}, Converter={StaticResource CompactUsage}}"
                                                               FontSize="9.5"
                                                               FontFamily="{StaticResource Mono}" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AtLimit, Source={x:Static svc:KimiUsageService.Instance}}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="kimiPill" Property="Background" Value="{StaticResource Bg3}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="kimiPill" Property="Background" Value="{StaticResource Bg3}" />
                                                    <Setter TargetName="kimiPill" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- Real xAI billing for the unique Grok accounts backing this Bridge. -->
                                <ToggleButton x:Name="BridgeHeaderGrokUsageToggle" Cursor="Hand" Margin="0,0,5,0"
                                              VerticalAlignment="Center" Checked="OnBridgeGrokUsageChecked"
                                              Unchecked="OnBridgeGrokUsageUnchecked"
                                              Visibility="{Binding BridgeUsesGrok, Converter={StaticResource BoolVis}}"
                                              ToolTip="{Binding BridgeGrokUsageSummary, StringFormat='Grok — {0}. Click for account limits, resets and prepaid balances.'}"
                                              AutomationProperties.Name="Grok Bridge usage">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="grokPill" Background="{StaticResource Bg2}"
                                                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                                    CornerRadius="{StaticResource Rad99}" Padding="7,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Grok" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding BridgeGrokUsageSummary, Converter={StaticResource CompactUsage}}"
                                                               FontSize="9.5"
                                                               FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"
                                                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="grokPill" Property="Background" Value="{StaticResource Bg3}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="grokPill" Property="Background" Value="{StaticResource Bg3}" />
                                                    <Setter TargetName="grokPill" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- Announce: icon-only megaphone; hover tooltip says "Announce". Pause every agent
                                     on this bridge and hand them one broadcast, then they carry on. Left of Add agent. -->
                                <ToggleButton x:Name="BridgeAnnounceToggle" Style="{StaticResource GhostToggle}"
                                              Padding="7,5" Margin="0,0,7,0" VerticalAlignment="Center" MinWidth="30"
                                              Checked="OnBridgeAnnounceChecked" Unchecked="OnBridgeAnnounceUnchecked"
                                              IsEnabled="{Binding CanAnnounceToBridge}"
                                              ToolTip="Announce"
                                              AutomationProperties.Name="Announce">
                                    <TextBlock Text="&#xE789;" FontFamily="{StaticResource Icons}" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </ToggleButton>
                                <!-- Stays enabled at the agent cap so a click can explain the limit (was silently
                                     disabled with no feedback). OnAddBridgeAgent opens the provider menu when room
                                     remains, otherwise a dialog that points at Settings → Bridge. -->
                                <Button Style="{StaticResource GhostButton}" Padding="10,5" Click="OnAddBridgeAgent"
                                        ToolTip="{Binding AddBridgeAgentToolTip}"
                                        AutomationProperties.Name="Add bridge agent">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource DarkContextMenu}" Placement="Bottom">
                                            <MenuItem Tag="claude" Click="OnAddBridgeProvider"
                                                      AutomationProperties.Name="Add Claude Code agent">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✦" FontSize="12" Width="22"
                                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <TextBlock Text="Claude Code" />
                                                            <TextBlock Text="Add a Claude agent to this bridge" FontSize="10.5"
                                                                       Foreground="{StaticResource Faint}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Tag="codex" Click="OnAddBridgeProvider"
                                                      AutomationProperties.Name="Add OpenAI Codex agent">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="◎" FontSize="13" Width="22"
                                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <TextBlock Text="OpenAI Codex" />
                                                            <TextBlock Text="Add a Codex agent to this bridge" FontSize="10.5"
                                                                       Foreground="{StaticResource Faint}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Tag="kimi" Click="OnAddBridgeProvider"
                                                      AutomationProperties.Name="Add Kimi Code agent">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="K" FontSize="11" FontWeight="SemiBold" Width="22"
                                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <TextBlock Text="Kimi Code" />
                                                            <TextBlock Text="Add a Kimi agent to this bridge" FontSize="10.5"
                                                                       Foreground="{StaticResource Faint}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Tag="grok" Click="OnAddBridgeProvider"
                                                      AutomationProperties.Name="Add Grok agent">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="G" FontSize="11" FontWeight="SemiBold" Width="22"
                                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <TextBlock Text="Grok" />
                                                            <TextBlock Text="Add a Grok agent to this bridge" FontSize="10.5"
                                                                       Foreground="{StaticResource Faint}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AddBridgeAgentText}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="7"
                                                   Foreground="{StaticResource Faint}" Margin="7,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8CE;" FontFamily="{StaticResource Icons}" FontSize="13"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Bridge" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BridgeSummary}" Foreground="{StaticResource Faint}" FontSize="11.5"
                                                   Margin="10,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10.5"
                                               FontFamily="{StaticResource Mono}" Margin="0,2,0,0" MaxWidth="620"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTip="{Binding BridgeProjectPath}"
                                               AutomationProperties.Name="{Binding BridgeProjectPath}">
                                        <Run Text="Project: " /><Run Text="{Binding BridgeProjectPath, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- transient dictation status/errors (the bridge has no composer hint of its own); collapsed when empty -->
                                <Border Margin="14,0,0,0" VerticalAlignment="Center" Padding="9,3" CornerRadius="{StaticResource Rad99}"
                                        Background="{StaticResource AccentSoft}"
                                        Visibility="{Binding BridgeHint, Converter={StaticResource ShowIf}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding BridgeHint}" FontSize="11.5" Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- panes -->
                    <ItemsControl x:Name="BridgePaneList" Grid.Row="1" ItemsSource="{Binding BridgePanes}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <!-- Explicit rows prevent UniformGrid's square auto-layout from reserving a 2x2 area for
                                 only two agents. Columns remain automatic, so every visible pane spans the full height.
                                 Rows are set from code (ScheduleBridgeGridRows), NOT bound: each window shows only the
                                 agents on its own display, so the density is per-window and a shared VM binding would
                                 be wrong for the split - and the code assignment would silently clobber it anyway. -->
                            <ItemsPanelTemplate><UniformGrid /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- Collapse a pane's container when a PEER is expanded: UniformGrid ignores Collapsed children when
                             counting cells, so the one visible (focused) pane fills the whole area. Visibility must live on
                             the CONTAINER (ContentPresenter), not the inner Border, or the empty cell would still be reserved. -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <!-- Expand-focus (BridgeVisible) and user-minimize (BridgeMinimized) both hide the cell. -->
                                <Setter Property="Visibility" Value="{Binding BridgePaneShown, Converter={StaticResource ShowIf}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:ChatViewModel}">
                                <Border Margin="5" Background="{StaticResource GlassPane}" CornerRadius="{StaticResource Rad12}"
                                        BorderThickness="1"
                                        PreviewMouseLeftButtonDown="OnBridgePanePointerDown"
                                        PreviewMouseWheel="OnBridgePaneMouseWheel">
                                    <!-- the pane you're typing in gets an accent frame (tiling-terminal style;
                                         brush lives in <Border.Style>, not an attribute, so the trigger can win) -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource PaneFocusBorder}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- pane header -->
                                        <Border x:Name="PaneHeader" Grid.Row="0" Background="{StaticResource GlassBar}" CornerRadius="{StaticResource RadTop12}"
                                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="12,7">
                                            <DockPanel LastChildFill="False">
                                                <!-- Window controls (Close / Expand / Minimize) are all standalone header
                                                     buttons: Minimize used to hide in ⋮, which is not where anyone
                                                     looks for it when Expand and Close are right there. -->
                                                <Button DockPanel.Dock="Right" Style="{StaticResource BridgeActionButton}" Content="&#xE711;"
                                                        FontSize="10" ToolTip="Close" Click="OnRemoveBridgePane"
                                                        AutomationProperties.Name="Close bridge agent"
                                                        AutomationProperties.HelpText="{Binding RemoveBridgeAgentToolTip}" />
                                                <!-- expand this agent to fill the bridge (focus), toggles back to the grid; glyph/tooltip swap on BridgeExpanded.
                                                     Content is set only via the style (base + DataTrigger) — a local Content would beat the trigger. -->
                                                <Button DockPanel.Dock="Right" FontSize="10" Margin="0,0,2,0" Click="OnToggleBridgePaneExpand">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BridgeActionButton}">
                                                            <Setter Property="Content" Value="&#xE740;" />
                                                            <Setter Property="ToolTip" Value="Expand" />
                                                            <Setter Property="AutomationProperties.Name" Value="{Binding ExpandBridgeAgentAutomationName}" />
                                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding ExpandBridgeAgentToolTip}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BridgeExpanded}" Value="True">
                                                                    <Setter Property="Content" Value="&#xE73F;" />
                                                                    <Setter Property="ToolTip" Value="Restore" />
                                                                    <Setter Property="AutomationProperties.Name" Value="Restore bridge grid" />
                                                                    <Setter Property="AutomationProperties.HelpText" Value="Restore all Bridge panes" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- Hide this pane without closing it; a chip in the bridge header brings it back. -->
                                                <Button DockPanel.Dock="Right" Style="{StaticResource BridgeActionButton}" Content="&#xE921;"
                                                        FontSize="10" Margin="0,0,2,0" ToolTip="Minimize"
                                                        Click="OnPaneMenuMinimize"
                                                        AutomationProperties.Name="Minimize this bridge agent"
                                                        AutomationProperties.HelpText="Hide this agent from the grid without closing it" />
                                                <!-- Agent swarm + subagents: ONE pane button, same as normal chats. Arms the
                                                     swarm and manages its subagents from a single popup. -->
                                                <Grid DockPanel.Dock="Right" Width="30" Height="30" Margin="0,0,2,0"
                                                      Visibility="{Binding ShowSwarmControl, Converter={StaticResource BoolVis}}">
                                                    <ToggleButton x:Name="PaneSubagentsToggle" Style="{StaticResource BridgeActionToggle}"
                                                                  ToolTip="{Binding SubagentButtonToolTip}"
                                                                  Click="OnPaneToggleClick" Unchecked="OnPaneToggleUnchecked"
                                                                  AutomationProperties.Name="Agent swarm and subagents"
                                                                  AutomationProperties.HelpText="{Binding SubagentButtonToolTip}">
                                                        <Grid Width="20" Height="18">
                                                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"
                                                                     Visibility="{Binding SwarmNextTurn, Converter={StaticResource BoolVis}}" />
                                                            <Border MinWidth="12" Height="12" Padding="2,0" CornerRadius="{StaticResource Rad6}"
                                                                    Background="{StaticResource Accent}" BorderBrush="{StaticResource Bg1}"
                                                                    BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="0,-3,-4,0"
                                                                    Visibility="{Binding ActiveSubagentCount, Converter={StaticResource ShowIf}}">
                                                                <TextBlock Text="{Binding ActiveSubagentCount}" FontFamily="{StaticResource Ui}"
                                                                           FontSize="7.5" FontWeight="Bold" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <Popup PlacementTarget="{Binding ElementName=PaneSubagentsToggle}" Placement="Bottom"
                                                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="5"
                                                           IsOpen="{Binding IsChecked, ElementName=PaneSubagentsToggle, Mode=TwoWay}">
                                                        <Border Style="{StaticResource PopupCard}" MinWidth="340" MaxWidth="600">
                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SubagentRoster}" />
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                                <!-- ⋮ overflow: Manager, Fork, Todos, Your messages. -->
                                                <Grid DockPanel.Dock="Right" Margin="0,0,2,0">
                                                    <ToggleButton x:Name="PaneMoreToggle" Style="{StaticResource BridgeActionToggle}"
                                                                  Content="&#xE712;" ToolTip="More"
                                                                  Click="OnPaneToggleClick" Unchecked="OnPaneToggleUnchecked"
                                                                  AutomationProperties.Name="Bridge agent menu"
                                                                  AutomationProperties.HelpText="Manager, fork, todos, and your messages" />
                                                    <!-- attention dot when todos remain -->
                                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                          IsHitTestVisible="False" Width="6" Height="6">
                                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}"
                                                                 Visibility="{Binding TodoRemaining, Converter={StaticResource ShowIf}}" />
                                                    </Grid>
                                                    <Popup PlacementTarget="{Binding ElementName=PaneMoreToggle}" Placement="Bottom"
                                                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="5"
                                                           IsOpen="{Binding IsChecked, ElementName=PaneMoreToggle, Mode=TwoWay}">
                                                        <Border Style="{StaticResource PopupCard}" MinWidth="268" MaxWidth="340">
                                                            <StackPanel Margin="5">
                                                                <!-- Crown / step-down manager -->
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" Padding="9,8" Click="OnPaneMenuManager"
                                                                        AutomationProperties.Name="Toggle bridge manager"
                                                                        AutomationProperties.HelpText="{Binding ManagerToolTip}"
                                                                        ToolTip="{Binding ManagerToolTip}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="14" Height="10" VerticalAlignment="Center" Margin="1,0,0,0">
                                                                            <Canvas Width="24" Height="16.4">
                                                                                <Path>
                                                                                    <Path.Style>
                                                                                        <Style TargetType="Path">
                                                                                            <Setter Property="Fill" Value="{StaticResource Muted}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsBridgeManager}" Value="True">
                                                                                                    <Setter Property="Fill" Value="#F5C242" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Path.Style>
                                                                                    <Path.Data>
                                                                                        <GeometryGroup FillRule="Nonzero">
                                                                                            <PathGeometry Figures="M2,12.4 L2.7,4.6 L8.3,8.9 L12,1.8 L15.7,8.9 L21.3,4.6 L22,12.4 Z" />
                                                                                            <RectangleGeometry Rect="1.4,13.2,21.2,3.1" RadiusX="1.5" RadiusY="1.5" />
                                                                                            <EllipseGeometry Center="2.7,3.9" RadiusX="1.7" RadiusY="1.7" />
                                                                                            <EllipseGeometry Center="12,1.7" RadiusX="1.8" RadiusY="1.8" />
                                                                                            <EllipseGeometry Center="21.3,3.9" RadiusX="1.7" RadiusY="1.7" />
                                                                                        </GeometryGroup>
                                                                                    </Path.Data>
                                                                                </Path>
                                                                            </Canvas>
                                                                        </Viewbox>
                                                                        <StackPanel Margin="12,0,0,0">
                                                                            <TextBlock FontSize="12.5" Foreground="{StaticResource Text}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="Make manager" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsBridgeManager}" Value="True">
                                                                                                <Setter Property="Text" Value="Step down as manager" />
                                                                                                <Setter Property="Foreground" Value="#F5C242" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock FontSize="10.5" Foreground="{StaticResource Faint}"
                                                                                       TextWrapping="Wrap" MaxWidth="250">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="You talk to it; it dispatches the other agents" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsBridgeManager}" Value="True">
                                                                                                <Setter Property="Text" Value="Currently directing this bridge" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                                <!-- Fork into a standalone chat -->
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" Padding="9,8" Click="OnPaneMenuFork"
                                                                        Visibility="{Binding CanFork, Converter={StaticResource BoolVis}}"
                                                                        AutomationProperties.Name="Fork this bridge conversation"
                                                                        AutomationProperties.HelpText="Fork this conversation into a separate chat">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                                                   Width="16" TextAlignment="Center" />
                                                                        <StackPanel Margin="11,0,0,0">
                                                                            <TextBlock Text="Fork" FontSize="12.5" Foreground="{StaticResource Text}" />
                                                                            <TextBlock Text="Copy this conversation into a separate chat" FontSize="10.5"
                                                                                       Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                                                                       MaxWidth="250" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="6,4" />
                                                                <!-- Todos list for this pane -->
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" Padding="9,8" Click="OnPaneMenuTodos"
                                                                        AutomationProperties.Name="Todos for this bridge agent"
                                                                        AutomationProperties.HelpText="Open this agent's task list">
                                                                    <DockPanel>
                                                                        <Border DockPanel.Dock="Right" MinWidth="18" Height="18" Padding="5,0"
                                                                                CornerRadius="{StaticResource Rad6}" Background="{StaticResource AccentSoft}"
                                                                                VerticalAlignment="Center" Margin="10,0,0,0"
                                                                                Visibility="{Binding TodoRemaining, Converter={StaticResource ShowIf}}">
                                                                            <TextBlock Text="{Binding TodoRemaining}" FontFamily="{StaticResource Ui}"
                                                                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="&#xE73A;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                                                       Width="16" TextAlignment="Center" />
                                                                            <StackPanel Margin="11,0,0,0">
                                                                                <TextBlock Text="Todos" FontSize="12.5" Foreground="{StaticResource Text}" />
                                                                                <TextBlock Text="This agent's task list" FontSize="10.5"
                                                                                           Foreground="{StaticResource Faint}" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Button>
                                                                <!-- Jump list of prompts the user sent in this pane -->
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" Padding="9,8" Click="OnPaneMenuMessages"
                                                                        Visibility="{Binding UserMessages.Count, Converter={StaticResource ShowIf}}"
                                                                        AutomationProperties.Name="Jump to your messages"
                                                                        AutomationProperties.HelpText="Jump to a prompt you sent in this pane">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                                                   Width="16" TextAlignment="Center" />
                                                                        <StackPanel Margin="11,0,0,0">
                                                                            <TextBlock Text="Your messages" FontSize="12.5" Foreground="{StaticResource Text}" />
                                                                            <TextBlock Text="Jump to a prompt you sent" FontSize="10.5"
                                                                                       Foreground="{StaticResource Faint}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                    <!-- Feature panels opened from the ⋮ menu (after the menu dismisses). -->
                                                    <Popup x:Name="PaneTodosPopup" PlacementTarget="{Binding ElementName=PaneHeader}" Placement="Bottom"
                                                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                                                        <Border Style="{StaticResource PopupCard}"
                                                                Width="{Binding ActualWidth, ElementName=PaneHeader}"
                                                                MinWidth="240" MaxWidth="560" MaxHeight="360">
                                                            <DockPanel Margin="14,12">
                                                                <StackPanel DockPanel.Dock="Top"
                                                                            Visibility="{Binding Todos.Count, Converter={StaticResource ShowIf}}">
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="11"
                                                                                   FontFamily="{StaticResource Mono}">
                                                                            <Run Text="{Binding TodoDone, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding TodoTotal, Mode=OneWay}" /><Run Text=" done" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="Task list" FontSize="12.5" FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource Muted}" />
                                                                    </DockPanel>
                                                                    <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding TodoDone, Mode=OneWay}"
                                                                                 Maximum="{Binding TodoTotal, Mode=OneWay}" Margin="0,0,0,8" />
                                                                </StackPanel>
                                                                <TextBlock DockPanel.Dock="Top" Text="{Binding TodosEmptyText}"
                                                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5" Margin="2,4"
                                                                           Visibility="{Binding Todos.Count, Converter={StaticResource ShowIf}, ConverterParameter=invert}" />
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                              Visibility="{Binding Todos.Count, Converter={StaticResource ShowIf}}">
                                                                    <ItemsControl ItemsSource="{Binding Todos}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <DockPanel Margin="0,4">
                                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" FontFamily="{StaticResource Icons}"
                                                                                               FontSize="13" Foreground="{Binding Status, Converter={StaticResource TodoFg}}"
                                                                                               Margin="0,1,10,0" VerticalAlignment="Top" TextWrapping="NoWrap" />
                                                                                    <TextBlock Text="{Binding Text}" FontSize="12.5"
                                                                                               Foreground="{Binding Status, Converter={StaticResource TodoFg}}">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </DockPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </DockPanel>
                                                        </Border>
                                                    </Popup>
                                                    <Popup x:Name="PaneMessagesPopup" PlacementTarget="{Binding ElementName=PaneHeader}" Placement="Bottom"
                                                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="5"
                                                           Opened="OnUserMessagesPopupOpened">
                                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UserMessagesPopup}" />
                                                    </Popup>
                                                </Grid>
                                                <Grid VerticalAlignment="Center" Width="8" Height="8">
                                                     <Ellipse Width="8" Height="8" Style="{StaticResource StatusDot}" />
                                                     <!-- the manager's little gold crown, floating just above the status dot -->
                                                     <Viewbox Width="14" Height="9.6" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                              Margin="-3,-11,-3,0" ToolTip="Bridge manager"
                                                              Visibility="{Binding IsBridgeManager, Converter={StaticResource BoolVis}}">
                                                         <Canvas Width="24" Height="16">
                                                             <!-- body + three spikes -->
                                                             <Path StrokeLineJoin="Round" Stroke="#8A6414" StrokeThickness="1"
                                                                   Data="M 2,13 L 2.7,4.6 L 8.3,8.9 L 12,1.8 L 15.7,8.9 L 21.3,4.6 L 22,13 Z">
                                                                 <Path.Fill>
                                                                     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                         <GradientStop Color="#FFE690" Offset="0" />
                                                                         <GradientStop Color="#F5C242" Offset="0.55" />
                                                                         <GradientStop Color="#DD9E23" Offset="1" />
                                                                     </LinearGradientBrush>
                                                                 </Path.Fill>
                                                             </Path>
                                                             <!-- pearls on the spike tips -->
                                                             <Ellipse Canvas.Left="1.0" Canvas.Top="2.2" Width="3.4" Height="3.4"
                                                                      Fill="#FFF0B4" Stroke="#8A6414" StrokeThickness="0.8" />
                                                             <Ellipse Canvas.Left="10.2" Canvas.Top="-0.2" Width="3.6" Height="3.6"
                                                                      Fill="#FFF0B4" Stroke="#8A6414" StrokeThickness="0.8" />
                                                             <Ellipse Canvas.Left="19.6" Canvas.Top="2.2" Width="3.4" Height="3.4"
                                                                      Fill="#FFF0B4" Stroke="#8A6414" StrokeThickness="0.8" />
                                                             <!-- base band -->
                                                             <Rectangle Canvas.Left="1.4" Canvas.Top="12.1" Width="21.2" Height="3.6"
                                                                        RadiusX="1.7" RadiusY="1.7" Stroke="#8A6414" StrokeThickness="0.8">
                                                                 <Rectangle.Fill>
                                                                     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                         <GradientStop Color="#F7CC55" Offset="0" />
                                                                         <GradientStop Color="#C98F1B" Offset="1" />
                                                                     </LinearGradientBrush>
                                                                 </Rectangle.Fill>
                                                             </Rectangle>
                                                             <!-- center ruby -->
                                                             <Ellipse Canvas.Left="10.8" Canvas.Top="12.7" Width="2.4" Height="2.4"
                                                                      Fill="#E14B37" Stroke="#7C2416" StrokeThickness="0.5" />
                                                         </Canvas>
                                                     </Viewbox>
                                                 </Grid>
                                                <TextBlock Text="{Binding BridgeLabel}" FontWeight="SemiBold" FontSize="12.5"
                                                           Margin="9,0,0,0" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding WorkingText}" Foreground="{StaticResource Faint}" FontSize="9.5"
                                                           Margin="10,1,0,0" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}" />
                                                <!-- Bridge panes: show Grok session tokens next to $ the same way as Claude/Codex/Kimi. -->
                                                <TextBlock Text="{Binding TokensText}" Foreground="{StaticResource Faint}" FontSize="9.5"
                                                           FontFamily="{StaticResource Mono}" Margin="10,1,0,0" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasTokens, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Text="{Binding CostText}" Foreground="{StaticResource Faint}" FontSize="11"
                                                           FontFamily="{StaticResource Mono}" Margin="10,1,0,0" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding CostText, Converter={StaticResource ShowIf}}" />
                                            </DockPanel>
                                        </Border>
                                        <!-- messages (UI-virtualized so long transcripts stay smooth) -->
                                        <Grid Grid.Row="1">
                                            <ListBox Background="Transparent" BorderThickness="0" Padding="0"
                                                     HorizontalContentAlignment="Stretch"
                                                     ItemsSource="{Binding Items}"
                                                     ui:NavHost.IsEnabled="True"
                                                     ScrollViewer.CanContentScroll="True"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Pixel"
                                                     VirtualizingPanel.CacheLength="1"
                                                     VirtualizingPanel.CacheLengthUnit="Page"
                                                     ui:AutoScroll.Enabled="True">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.Template>
                                                    <ControlTemplate TargetType="ListBox">
                                                        <ScrollViewer Focusable="False" CanContentScroll="True"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsPresenter Margin="12,8" />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ListBox.Template>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                            <!-- CLI-only empty banner for this bridge agent (same art as normal chats). -->
                                            <StackPanel Margin="0,36,0,0" IsHitTestVisible="False"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                                        Visibility="{Binding Items.Count, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                                                <StackPanel Visibility="{Binding ShowCliWelcome, Converter={StaticResource BoolVis}}"
                                                            HorizontalAlignment="Center">
                                                    <!-- Bridge panes get narrow fast, so the banner scales down
                                                         to fit instead of losing letters off both ends. -->
                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                                             HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding CliWelcomeArt}" FontFamily="{StaticResource Mono}"
                                                                   FontSize="9.5" Foreground="{StaticResource Accent}"
                                                                   TextAlignment="Left" HorizontalAlignment="Center"
                                                                   TextWrapping="NoWrap" LineHeight="12"
                                                                   SnapsToDevicePixels="True"
                                                                   AutomationProperties.Name="{Binding CliWelcomeTagline}" />
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding CliWelcomeTagline}" FontFamily="{StaticResource Mono}"
                                                               FontSize="10.5" Foreground="{StaticResource Muted}"
                                                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <!-- "Your messages" lives in the pane ⋮ menu (not floating over the transcript). -->
                                        <!-- composer -->
                                        <Border Grid.Row="2" Background="{StaticResource GlassBar}" CornerRadius="{StaticResource RadBottom12}"
                                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="8"
                                                AllowDrop="True" PreviewDragOver="OnBridgeComposerDragOver" PreviewDrop="OnBridgeComposerDrop">
                                            <DockPanel>
                                                <!-- per-pane controls: same permission mode / model / effort a normal chat has -->
                                                <WrapPanel DockPanel.Dock="Bottom" Margin="2,7,0,0">
                                                    <!-- permission mode -->
                                                    <ToggleButton x:Name="PaneModeToggle" Style="{StaticResource GhostToggle}" Padding="7,3"
                                                                  AutomationProperties.Name="Pane permission mode">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ModeIcon}" FontFamily="{StaticResource Icons}" FontSize="9.5"
                                                                       Margin="0,1,5,0" VerticalAlignment="Center" TextWrapping="NoWrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Mode}" Value="acceptEdits">
                                                                                <Setter Property="Foreground" Value="{StaticResource Yellow}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Mode}" Value="bypassPermissions">
                                                                                <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ModeDisplay}" FontSize="11" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Mode}" Value="bypassPermissions">
                                                                                <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="8"
                                                                       Foreground="{StaticResource Faint}" Margin="5,2,0,0" VerticalAlignment="Center"
                                                                       TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Popup PlacementTarget="{Binding ElementName=PaneModeToggle}" Placement="Top" StaysOpen="False"
                                                           AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=PaneModeToggle, Mode=TwoWay}">
                                                        <Border Style="{StaticResource PopupCard}" MinWidth="230">
                                                            <StackPanel Margin="5">
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" Padding="9,6" Tag="default" Click="OnPaneModePick">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                                        <TextBlock Text="Ask before acting" FontSize="12" Foreground="{StaticResource Text}" Margin="10,0,0,0" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" Padding="9,6" Tag="auto" Click="OnPaneModePick">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                                                   Foreground="{StaticResource Green}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                                        <TextBlock Text="Auto" FontSize="12" Foreground="{StaticResource Text}" Margin="10,0,0,0" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" Padding="9,6" Tag="plan" Click="OnPaneModePick">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                                                   Foreground="{StaticResource Blue}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                                        <TextBlock Text="Plan mode" FontSize="12" Foreground="{StaticResource Text}" Margin="10,0,0,0" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" Padding="9,6" Tag="bypassPermissions" Click="OnPaneModePick">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                                                   Foreground="{StaticResource Red}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                                        <TextBlock Text="Bypass permissions" FontSize="12" Foreground="{StaticResource Text}" Margin="10,0,0,0" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                    <!-- model -->
                                                    <ToggleButton x:Name="PaneModelToggle" Style="{StaticResource GhostToggle}" Padding="7,3" Margin="2,0,0,0"
                                                                  AutomationProperties.Name="Pane model picker">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="9.5"
                                                                       Margin="0,1,5,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                            <TextBlock Text="{Binding ModelDisplay}" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="8"
                                                                       Foreground="{StaticResource Faint}" Margin="5,2,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Popup PlacementTarget="{Binding ElementName=PaneModelToggle}" Placement="Top" StaysOpen="False"
                                                           AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=PaneModelToggle, Mode=TwoWay}">
                                                        <Border Style="{StaticResource PopupCard}" MinWidth="260">
                                                            <StackPanel Margin="5">
                                                                <TextBlock Text="{Binding ModelPickerHint}" FontSize="10.5" Foreground="{StaticResource Faint}"
                                                                           Margin="9,5,9,4" TextWrapping="Wrap"
                                                                           Visibility="{Binding ModelPickerHint, Converter={StaticResource ShowIf}}" />
                                                                <ItemsControl ItemsSource="{Binding PickerModels}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                                                    HorizontalContentAlignment="Stretch" Padding="9,6" Click="OnPaneModelPick"
                                                                                    IsEnabled="{Binding CanApply}"
                                                                                    AutomationProperties.Name="{Binding Display}"
                                                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                                <DockPanel>
                                                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE9D2;" FontFamily="{StaticResource Icons}"
                                                                                               FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                                                               Margin="0,0,10,0" TextWrapping="NoWrap" />
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Display}" FontSize="12" Foreground="{StaticResource Text}" />
                                                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource Faint}"
                                                                                                   Visibility="{Binding Description, Converter={StaticResource ShowIf}}" />
                                                                                        <!-- Live tokens/sec + latency from OpenRouter; absent until the lookup lands. -->
                                                                                        <TextBlock Text="{Binding Speed}" FontSize="9.5" FontFamily="{StaticResource Mono}"
                                                                                                   Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                                                                                   Visibility="{Binding Speed, Converter={StaticResource ShowIf}}" />
                                                                                        <TextBlock Text="{Binding Scope}" FontSize="10" Foreground="{StaticResource Accent}"
                                                                                                   Visibility="{Binding Scope, Converter={StaticResource ShowIf}}" />
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                    <!-- effort (hidden for models without effort control) -->
                                                    <ToggleButton x:Name="PaneEffortToggle" Style="{StaticResource GhostToggle}" Padding="7,3" Margin="2,0,0,0"
                                                                  AutomationProperties.Name="Pane effort level"
                                                                  Visibility="{Binding HasEffort, Converter={StaticResource BoolVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="9.5"
                                                                       Margin="0,1,5,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                            <TextBlock FontFamily="{StaticResource Mono}" FontSize="8" VerticalAlignment="Center" TextWrapping="NoWrap"><Run Text="{Binding EffortFilled, Mode=OneWay}" Foreground="{StaticResource Accent}" /><Run Text="{Binding EffortEmpty, Mode=OneWay}" Foreground="{StaticResource Faint}" /></TextBlock>
                                                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="8"
                                                                       Foreground="{StaticResource Faint}" Margin="5,2,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Popup PlacementTarget="{Binding ElementName=PaneEffortToggle}" Placement="Top" StaysOpen="False"
                                                           AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=PaneEffortToggle, Mode=TwoWay}">
                                                        <Border Style="{StaticResource PopupCard}" MinWidth="270">
                                                            <StackPanel Margin="5">
                                                                <TextBlock Text="REASONING EFFORT" Style="{StaticResource Caption}" FontSize="9.5" Margin="9,6,0,4" />
                                                                <ItemsControl ItemsSource="{Binding EffortOptions}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                                                    HorizontalAlignment="Stretch" Padding="9,6" Click="OnPaneEffortPick"
                                                                                    AutomationProperties.Name="{Binding Label}"
                                                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                                <DockPanel>
                                                                                    <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                                                               FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                                                               Margin="10,0,0,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}" />
                                                                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Mono}" FontSize="8.5"
                                                                                               VerticalAlignment="Center" Margin="0,0,11,0" TextWrapping="NoWrap" MinWidth="22"><Run Text="{Binding Filled, Mode=OneWay}" Foreground="{StaticResource Accent}" /><Run Text="{Binding Empty, Mode=OneWay}" Foreground="{StaticResource Faint}" /></TextBlock>
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Text}" />
                                                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource Faint}"
                                                                                                   Visibility="{Binding Description, Converter={StaticResource ShowIf}}" />
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                    <ToggleButton x:Name="PaneExtendedQueueToggle" Style="{StaticResource GhostToggle}"
                                                                  Padding="7,3" Margin="2,0,0,0"
                                                                  AutomationProperties.Name="Pane extended queue settings"
                                                                  ToolTip="{Binding ExtendedQueueDescription}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="9.5"
                                                                       Margin="0,1,5,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                            <TextBlock Text="{Binding ExtendedQueueDisplay}" FontSize="11" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ExtendedQueueEnabled}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ExtendedQueuePaused}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource Yellow}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="8"
                                                                       Foreground="{StaticResource Faint}" Margin="5,2,0,0" VerticalAlignment="Center"
                                                                       TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Popup PlacementTarget="{Binding ElementName=PaneExtendedQueueToggle}" Placement="Top"
                                                           StaysOpen="False" AllowsTransparency="True"
                                                           IsOpen="{Binding IsChecked, ElementName=PaneExtendedQueueToggle, Mode=TwoWay}">
                                                        <Border Style="{StaticResource PopupCard}" MinWidth="310" MaxWidth="360">
                                                            <StackPanel Margin="5">
                                                                <TextBlock Text="EXTENDED QUEUE" Style="{StaticResource Caption}" FontSize="9.5"
                                                                           Margin="9,6,0,4" />
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                                        HorizontalAlignment="Stretch" Padding="9,7"
                                                                        Click="OnExtendedQueueEnabledPick">
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                                                   FontSize="11" Foreground="{StaticResource Accent}"
                                                                                   Visibility="{Binding ExtendedQueueEnabled, Converter={StaticResource BoolVis}}" />
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding ExtendedQueueToggleText}" FontSize="12"
                                                                                       Foreground="{StaticResource Text}" />
                                                                            <TextBlock Text="{Binding ExtendedQueueDescription}" FontSize="10.5"
                                                                                       Foreground="{StaticResource Faint}" MaxWidth="280" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Button>
                                                                <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="6,4,6,3" />
                                                                <TextBlock Text="REQUESTS PER TURN" Style="{StaticResource Caption}" FontSize="9.5"
                                                                           Margin="9,5,0,3" />
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                                        HorizontalAlignment="Stretch" Padding="9,6" Tag="1"
                                                                        Click="OnExtendedQueueChunkPick">
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                                                   FontSize="11" Foreground="{StaticResource Accent}"
                                                                                   Visibility="{Binding ExtendedQueueChunkIs1, Converter={StaticResource BoolVis}}" />
                                                                        <TextBlock Text="1 request · safest" FontSize="12" />
                                                                    </DockPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                                        HorizontalAlignment="Stretch" Padding="9,6" Tag="2"
                                                                        Click="OnExtendedQueueChunkPick">
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                                                   FontSize="11" Foreground="{StaticResource Accent}"
                                                                                   Visibility="{Binding ExtendedQueueChunkIs2, Converter={StaticResource BoolVis}}" />
                                                                        <TextBlock Text="2 requests · balanced" FontSize="12" />
                                                                    </DockPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                                        HorizontalAlignment="Stretch" Padding="9,6" Tag="3"
                                                                        Click="OnExtendedQueueChunkPick">
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                                                   FontSize="11" Foreground="{StaticResource Accent}"
                                                                                   Visibility="{Binding ExtendedQueueChunkIs3, Converter={StaticResource BoolVis}}" />
                                                                        <TextBlock Text="3 requests · fastest" FontSize="12" />
                                                                    </DockPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Center" Padding="10,7" Margin="6,7,6,2"
                                                                        Content="Resume queue now" Click="OnExtendedQueueResume"
                                                                        Visibility="{Binding ExtendedQueuePaused, Converter={StaticResource BoolVis}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </WrapPanel>
                                                <!-- staged attachments for this pane (images / files sent with the next message) -->
                                                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Attachments}" Margin="2,6,2,0"
                                                              ItemTemplate="{StaticResource AttachmentChip}"
                                                              Visibility="{Binding HasAttachments, Converter={StaticResource ShowIf}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <!-- input row -->
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SendButton}" Click="OnBridgePaneSend"
                                                            VerticalAlignment="Bottom" Margin="6,0,0,0" />
                                                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="OnBridgeAttachClick"
                                                            VerticalAlignment="Bottom" Padding="6,5" Margin="0,0,4,0"
                                                            ToolTip="Attach image or file (or paste / drag-drop)" AutomationProperties.Name="Attach file">
                                                        <TextBlock Text="&#xE723;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                    </Button>
                                                    <!-- dictate into this pane (offline speech-to-text) -->
                                                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="OnBridgeMicClick"
                                                            VerticalAlignment="Bottom" Padding="6,5" Margin="0,0,4,0"
                                                            ToolTip="Dictate (speech to text)" AutomationProperties.Name="Dictate">
                                                        <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                    </Button>
                                                    <Grid>
                                                        <TextBox x:Name="PaneInput" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Style="{x:Null}"
                                                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                                                 CaretBrush="{StaticResource Accent}" FontSize="13" Padding="8,7" AcceptsReturn="True"
                                                                 TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                                                 PreviewKeyDown="OnBridgeInputKeyDown" DataObject.Pasting="OnComposerPasting"
                                                                 AutomationProperties.Name="Bridge message input" />
                                                        <!-- ElementName resolves per-pane inside this DataTemplate's namescope -->
                                                        <TextBlock Text="{Binding ComposerPlaceholder}" Foreground="{StaticResource Faint}" FontSize="13"
                                                                   Margin="9,7,0,0" IsHitTestVisible="False" VerticalAlignment="Top">
                                                            <TextBlock.Visibility>
                                                                <MultiBinding Converter="{StaticResource HintVis}">
                                                                    <Binding Path="Text" ElementName="PaneInput" />
                                                                    <Binding Path="IsKeyboardFocusWithin" ElementName="PaneInput" />
                                                                </MultiBinding>
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                    </Grid>
                                                </DockPanel>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ============ right panel ============ -->
                <Border x:Name="RightPanelSurface" Grid.Column="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1,0,0,0"
                        DataContext="{Binding SurfacePanelChat, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="356" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SurfaceShowHome, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <Setter Property="Width" Value="0" /><Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- The Bridge surface has no shared Artifacts/Todos side panel: artifacts are gone and
                                     todos live in each pane's own popup. Keep it collapsed while the bridge is shown. -->
                                <DataTrigger Binding="{Binding SurfaceShowBridge, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <Setter Property="Width" Value="0" /><Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=PanelToggle}" Value="False">
                                    <Setter Property="Width" Value="0" /><Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="12">
                        <Border DockPanel.Dock="Top" Background="{StaticResource CodeBg}" CornerRadius="{StaticResource Rad10}" Padding="3"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="ArtTab" Style="{StaticResource PillTab}" IsChecked="True" Click="OnPanelTab"
                                              HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Artifacts" FontSize="12" FontWeight="SemiBold" />
                                        <Border Background="{StaticResource Bg3}" CornerRadius="{StaticResource Rad99}" Padding="6,0.5" Margin="7,0,0,0"
                                                Visibility="{Binding Files.Count, Converter={StaticResource ShowIf}}">
                                            <TextBlock Text="{Binding Files.Count}" FontSize="10" Foreground="{StaticResource Muted}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TodoTab" Grid.Column="1" Style="{StaticResource PillTab}" Click="OnPanelTab"
                                              HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Todos" FontSize="12" FontWeight="SemiBold" />
                                        <Border Background="{StaticResource Bg3}" CornerRadius="{StaticResource Rad99}" Padding="6,0.5" Margin="7,0,0,0"
                                                Visibility="{Binding TodoSummary, Converter={StaticResource ShowIf}}">
                                            <TextBlock Text="{Binding TodoSummary}" FontSize="10" Foreground="{StaticResource Muted}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- content area: artifacts + todos overlay and FILL the panel.
                             Must be the DockPanel's last child so LastChildFill stretches it to full
                             width+height; otherwise each view docks Left and shrinks to content width. -->
                        <Grid>
                        <!-- artifacts -->
                        <Grid Visibility="{Binding IsChecked, ElementName=ArtTab, Converter={StaticResource BoolVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" MaxHeight="180" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- empty state: centered vertically + horizontally in the panel -->
                            <StackPanel Grid.RowSpan="3" VerticalAlignment="Center"
                                        Visibility="{Binding Files.Count, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                                <Border Width="46" Height="46" CornerRadius="{StaticResource Rad14}" Background="{StaticResource Bg2}"
                                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="20"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ArtifactsEmptyText}" Foreground="{StaticResource Muted}"
                                           TextAlignment="Center" FontSize="12.5" Margin="24,14,24,0" />
                                <TextBlock Text="HTML opens in your browser for live preview." Foreground="{StaticResource Faint}"
                                           TextAlignment="Center" FontSize="11.5" Margin="24,3,24,0" />
                            </StackPanel>
                            <!-- files header: label + close-all (only when there are files) -->
                            <DockPanel Grid.Row="0" Margin="2,0,2,7"
                                       Visibility="{Binding Files.Count, Converter={StaticResource ShowIf}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,3"
                                        Click="OnCloseAllArtifacts" AutomationProperties.Name="Close all artifacts"
                                        ToolTip="Clear the artifacts list (does not delete the files on disk)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE894;" FontFamily="{StaticResource Icons}" FontSize="10.5"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" TextWrapping="NoWrap" />
                                        <TextBlock Text="Close all" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Files" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                     Visibility="{Binding Files.Count, Converter={StaticResource ShowIf}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding Path}">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" FontFamily="{StaticResource Icons}"
                                                       FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,0,8,0"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="10"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap">
                                                <Run Text="×" /><Run Text="{Binding Writes, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="2" Background="{StaticResource Bg0}" BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1" CornerRadius="{StaticResource Rad10}" Margin="0,8,0,0"
                                    Visibility="{Binding SelectedFile, Converter={StaticResource ShowIf}}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
                                            Padding="10,5">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE711;" FontSize="10" Click="OnClosePreview" ToolTip="Close preview"
                                                    AutomationProperties.Name="Close preview" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE8A7;" FontSize="11" Click="OnOpenArtifact"
                                                    ToolTip="Open with default app (HTML = live browser preview)" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE72C;" FontSize="11" Click="OnRefreshArtifact" ToolTip="Refresh preview" />
                                            <TextBlock Text="{Binding SelectedFile.FileName}" FontFamily="{StaticResource Mono}"
                                                       FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                    </Border>
                                    <TextBox Style="{x:Null}" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="NoWrap" FontFamily="{StaticResource Mono}" FontSize="11"
                                             Foreground="{StaticResource Text}" Background="Transparent" BorderThickness="0"
                                             Padding="10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                             SelectionBrush="{StaticResource AccentDim}" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- todos -->
                        <DockPanel Visibility="{Binding IsChecked, ElementName=TodoTab, Converter={StaticResource BoolVis}}">
                            <StackPanel DockPanel.Dock="Top"
                                        Visibility="{Binding Todos.Count, Converter={StaticResource ShowIf}}">
                                <DockPanel Margin="4,2,4,6">
                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="11"
                                               FontFamily="{StaticResource Mono}">
                                        <Run Text="{Binding TodoDone, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding TodoTotal, Mode=OneWay}" /><Run Text=" done" />
                                    </TextBlock>
                                    <TextBlock Text="Task list" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding TodoDone, Mode=OneWay}"
                                             Maximum="{Binding TodoTotal, Mode=OneWay}" Margin="4,0,4,10" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,80,0,0"
                                        Visibility="{Binding Todos.Count, Converter={StaticResource ShowIf}, ConverterParameter=invert}">
                                <Border Width="46" Height="46" CornerRadius="{StaticResource Rad14}" Background="{StaticResource Bg2}"
                                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE73A;" FontFamily="{StaticResource Icons}" FontSize="20"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding TodosEmptyText}"
                                           Foreground="{StaticResource Muted}" TextAlignment="Center" FontSize="12.5"
                                           Margin="24,14,24,0" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Todos}" Margin="4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" FontFamily="{StaticResource Icons}"
                                                           FontSize="13" Foreground="{Binding Status, Converter={StaticResource TodoFg}}"
                                                           Margin="0,1,10,0" VerticalAlignment="Top" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Text}" FontSize="12.5"
                                                           Foreground="{Binding Status, Converter={StaticResource TodoFg}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>

            </Grid>

            <!-- slash command popup -->
            <Popup x:Name="SlashPopup" PlacementTarget="{Binding ElementName=InputBox}" Placement="Top" StaysOpen="True"
                   AllowsTransparency="True" Width="600">
                <Border Style="{StaticResource PopupCard}">
                    <ListBox x:Name="SlashList" MaxHeight="280" MouseUp="OnSlashPick" Margin="3">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Mono}"
                                               Foreground="{StaticResource Blue}" FontWeight="SemiBold" FontSize="12.5"
                                               TextWrapping="NoWrap">
                                        <Run Text="/" /><Run Text="{Binding Name, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ArgumentHint}" FontFamily="{StaticResource Mono}"
                                               Foreground="{StaticResource Faint}" FontSize="11.5" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="NoWrap"
                                               Visibility="{Binding ArgumentHint, Converter={StaticResource ShowIf}}" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12"
                                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <!-- mode popup -->
            <!-- chat menu (fork), opened from the header's ⋯ button. Bridge is deliberately NOT here — it's a
                 first-class header button. Neither are swarm/subagents — they have their own header button. -->
            <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreToggle}" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" Closed="OnMorePopupClosed">
                <Border Style="{StaticResource PopupCard}" MinWidth="268" MaxWidth="340">
                    <StackPanel Margin="5">
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                Padding="9,7" Click="OnMenuFork" AutomationProperties.Name="Fork session"
                                Visibility="{Binding CanFork, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="13"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                           Margin="0,1,0,0" />
                                <StackPanel Margin="11,0,0,0">
                                    <TextBlock Text="Fork session" FontSize="12.5" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Copy this conversation into a separate new chat" FontSize="10.5"
                                               Foreground="{StaticResource Faint}" TextWrapping="NoWrap" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Fresh Bridge start: pick agent 2's provider (same roster as Add agent). Resume paths skip this. -->
            <Popup x:Name="BridgePeerPopup" PlacementTarget="{Binding ElementName=BridgeButton}" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True">
                <Border Style="{StaticResource PopupCard}" MinWidth="280">
                    <StackPanel Margin="5">
                        <TextBlock Text="Start Bridge" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{StaticResource Text}" Margin="9,6,9,2" />
                        <TextBlock Text="Choose any provider for agent 2 — same choices as Add agent."
                                   FontSize="10.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                   Margin="9,0,9,8" />
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch" Padding="9,7" Tag="claude" Click="OnStartBridgeWithProvider"
                                AutomationProperties.Name="Start bridge with Claude Code">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" FontSize="12" Width="22"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Claude Code" FontSize="12.5" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Agent 2 runs as Claude" FontSize="10.5"
                                               Foreground="{StaticResource Faint}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch" Padding="9,7" Tag="codex" Click="OnStartBridgeWithProvider"
                                AutomationProperties.Name="Start bridge with OpenAI Codex">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◎" FontSize="13" Width="22"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="OpenAI Codex" FontSize="12.5" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Agent 2 runs as Codex" FontSize="10.5"
                                               Foreground="{StaticResource Faint}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch" Padding="9,7" Tag="kimi" Click="OnStartBridgeWithProvider"
                                AutomationProperties.Name="Start bridge with Kimi Code">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="K" FontSize="11" FontWeight="SemiBold" Width="22"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Kimi Code" FontSize="12.5" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Agent 2 runs as Kimi" FontSize="10.5"
                                               Foreground="{StaticResource Faint}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch" Padding="9,7" Tag="grok" Click="OnStartBridgeWithProvider"
                                AutomationProperties.Name="Start bridge with Grok">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="G" FontSize="11" FontWeight="SemiBold" Width="22"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Grok" FontSize="12.5" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Agent 2 runs as Grok" FontSize="10.5"
                                               Foreground="{StaticResource Faint}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="ModePopup" PlacementTarget="{Binding ElementName=ModeToggle}" Placement="Top" StaysOpen="False"
                   AllowsTransparency="True" Closed="OnModePopupClosed">
                <Border Style="{StaticResource PopupCard}" MinWidth="250">
                    <StackPanel Margin="5">
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                Padding="9,7" Tag="default" Click="OnModePick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <TextBlock Text="Ask before acting" FontSize="12.5" Foreground="{StaticResource Text}"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                Padding="9,7" Tag="auto" Click="OnModePick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           Foreground="{StaticResource Green}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <TextBlock Text="Auto" FontSize="12.5" Foreground="{StaticResource Text}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                Padding="9,7" Tag="plan" Click="OnModePick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           Foreground="{StaticResource Blue}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <TextBlock Text="Plan mode" FontSize="12.5" Foreground="{StaticResource Text}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                Padding="9,7" Tag="bypassPermissions" Click="OnModePick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           Foreground="{StaticResource Red}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <TextBlock Text="Bypass permissions" FontSize="12.5" Foreground="{StaticResource Text}"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- effort popup (per-model, built from the CLI's supportedEffortLevels) -->
            <Popup x:Name="ThinkPopup" PlacementTarget="{Binding ElementName=ThinkToggle}" Placement="Top" StaysOpen="False"
                   AllowsTransparency="True" Closed="OnThinkPopupClosed">
                <Border Style="{StaticResource PopupCard}" MinWidth="290">
                    <StackPanel Margin="5">
                        <TextBlock Text="REASONING EFFORT" Style="{StaticResource Caption}" FontSize="9.5" Margin="9,6,0,4" />
                        <ItemsControl ItemsSource="{Binding EffortOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch" Padding="9,7" Click="OnEffortPick"
                                            AutomationProperties.Name="{Binding Label}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                       FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}" />
                                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Mono}" FontSize="8.5"
                                                       VerticalAlignment="Center" Margin="0,0,11,0" TextWrapping="NoWrap" MinWidth="22">
                                                <Run Text="{Binding Filled, Mode=OneWay}" Foreground="{StaticResource Accent}" /><Run Text="{Binding Empty, Mode=OneWay}" Foreground="{StaticResource Faint}" />
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Faint}"
                                                           Visibility="{Binding Description, Converter={StaticResource ShowIf}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Fast mode: faster output on models that support it (Claude Code's fastMode setting) -->
                        <StackPanel Visibility="{Binding CanFastMode, Converter={StaticResource BoolVis}}">
                            <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="6,4,6,3" />
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                    Padding="9,7" Click="OnFastModePick" AutomationProperties.Name="Fast mode">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                                               Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding FastMode, Converter={StaticResource BoolVis}}" />
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="13" Width="18"
                                               Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="0,0,11,0" TextWrapping="NoWrap" />
                                    <StackPanel>
                                        <TextBlock Text="Fast mode" FontSize="12.5" Foreground="{StaticResource Text}" />
                                        <TextBlock Text="Faster output · applies to new chats" FontSize="11" Foreground="{StaticResource Faint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Extended queue: an opt-in FIFO for unattended runs. Chunk size is requests per provider turn, not
                 parallelism; the next chunk is not dispatched until the previous result has ended. -->
            <Popup x:Name="ExtendedQueuePopup" PlacementTarget="{Binding ElementName=ExtendedQueueToggle}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                   Closed="OnExtendedQueuePopupClosed">
                <Border Style="{StaticResource PopupCard}" MinWidth="326" MaxWidth="380">
                    <StackPanel Margin="5">
                        <TextBlock Text="EXTENDED QUEUE" Style="{StaticResource Caption}" FontSize="9.5" Margin="9,6,0,4" />
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" Padding="9,7" Click="OnExtendedQueueEnabledPick">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                           FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" Visibility="{Binding ExtendedQueueEnabled, Converter={StaticResource BoolVis}}" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="13"
                                           Width="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           Margin="0,0,11,0" TextWrapping="NoWrap" />
                                <StackPanel>
                                    <TextBlock Text="{Binding ExtendedQueueToggleText}" FontSize="12.5" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="{Binding ExtendedQueueDescription}" FontSize="11" Foreground="{StaticResource Faint}"
                                               MaxWidth="285" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="6,4,6,3" />
                        <TextBlock Text="REQUESTS PER TURN" Style="{StaticResource Caption}" FontSize="9.5" Margin="9,5,0,3" />
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" Padding="9,6" Tag="1" Click="OnExtendedQueueChunkPick">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           Foreground="{StaticResource Accent}" Visibility="{Binding ExtendedQueueChunkIs1, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="1 request · safest" FontSize="12" Foreground="{StaticResource Text}" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" Padding="9,6" Tag="2" Click="OnExtendedQueueChunkPick">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           Foreground="{StaticResource Accent}" Visibility="{Binding ExtendedQueueChunkIs2, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="2 requests · balanced" FontSize="12" Foreground="{StaticResource Text}" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" Padding="9,6" Tag="3" Click="OnExtendedQueueChunkPick">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           Foreground="{StaticResource Accent}" Visibility="{Binding ExtendedQueueChunkIs3, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="3 requests · fastest" FontSize="12" Foreground="{StaticResource Text}" />
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="10,7" Margin="6,7,6,2"
                                Content="Resume queue now" Click="OnExtendedQueueResume"
                                Visibility="{Binding ExtendedQueuePaused, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- model popup -->
            <Popup x:Name="ModelPopup" PlacementTarget="{Binding ElementName=ModelToggle}" Placement="Top" StaysOpen="False"
                   AllowsTransparency="True" Closed="OnModelPopupClosed">
                <Border Style="{StaticResource PopupCard}" MinWidth="280">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding ModelPickerHint}" FontSize="10.5" Foreground="{StaticResource Faint}"
                                   Margin="9,5,9,4" TextWrapping="Wrap"
                                   Visibility="{Binding ModelPickerHint, Converter={StaticResource ShowIf}}" />
                        <ItemsControl ItemsSource="{Binding PickerModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="9,7" Click="OnModelPick"
                                            IsEnabled="{Binding CanApply}"
                                            AutomationProperties.Name="{Binding Display}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,11,0"
                                                       TextWrapping="NoWrap" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" FontSize="12.5" Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Faint}"
                                                           Margin="0,1,0,0"
                                                           Visibility="{Binding Description, Converter={StaticResource ShowIf}}" />
                                                <!-- Live tokens/sec + latency from OpenRouter; absent until the lookup lands. -->
                                                <TextBlock Text="{Binding Speed}" FontSize="10" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                                                           Visibility="{Binding Speed, Converter={StaticResource ShowIf}}" />
                                                <TextBlock Text="{Binding Scope}" FontSize="10" Foreground="{StaticResource Accent}"
                                                           Visibility="{Binding Scope, Converter={StaticResource ShowIf}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- usage popup (plan, limits + reset times, context window) -->
            <Popup x:Name="UsagePopup" PlacementTarget="{Binding ElementName=UsageToggle}" Placement="Top" StaysOpen="False"
                   AllowsTransparency="True" Closed="OnUsagePopupClosed">
                <Border Style="{StaticResource PopupCard}" Width="304">
                    <StackPanel Margin="14,11,14,11">
                        <StackPanel DataContext="{x:Static svc:UsageService.Instance}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Rad99}" Padding="8,1.5"
                                        VerticalAlignment="Center" Visibility="{Binding Plan, Converter={StaticResource ShowIf}}">
                                    <TextBlock Text="{Binding Plan}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                </Border>
                                <TextBlock Text="Usage" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Limits}" Margin="0,9,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,9">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0}%}"
                                                           FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Text}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource SlimProgress}" Height="4" Value="{Binding Percent, Mode=OneWay}"
                                                         Maximum="100" Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}" />
                                            <TextBlock Text="{Binding ResetDisplay, StringFormat=resets {0}}" FontSize="9.5"
                                                       Foreground="{StaticResource Faint}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Visibility="{Binding HasReset, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,9,0,2"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <!-- context window (per active chat) -->
                        <StackPanel Visibility="{Binding CtxHasData, Converter={StaticResource BoolVis}}">
                            <DockPanel Margin="0,1,0,3">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CtxDetailText}"
                                           FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="Context" FontSize="11.5" Foreground="{StaticResource Text}" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource SlimProgress}" Height="4"
                                         Value="{Binding CtxPercentValue, Mode=OneWay}" Maximum="100" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,10,0,7" />
                        <TextBlock Text="{Binding UpdatedText, Source={x:Static svc:UsageService.Instance}}" FontSize="9.5"
                                   Foreground="{StaticResource Faint}" />
                        <TextBlock Text="Approximate - this machine's local sessions only." FontSize="9" Foreground="{StaticResource Faint}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Authoritative xAI billing for the isolated account used by the active Grok chat. -->
            <Popup x:Name="GrokUsagePopup" PlacementTarget="{Binding ElementName=GrokAccountUsageToggle}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6"
                   Closed="OnGrokUsagePopupClosed">
                <Border Style="{StaticResource PopupCard}" Width="342">
                    <StackPanel Margin="14,11" DataContext="{Binding GrokAccount}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}"
                                    CornerRadius="{StaticResource Rad99}" Padding="8,1.5" VerticalAlignment="Center"
                                    Visibility="{Binding PlanDisplay, Converter={StaticResource ShowIf}}">
                                <TextBlock Text="{Binding PlanDisplay}" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock Text="Grok account usage" FontWeight="SemiBold" FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Faint}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                        <Border Background="{StaticResource Bg2}" CornerRadius="{StaticResource Rad6}"
                                Padding="10,8" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsageSummary}"
                                               FontFamily="{StaticResource Mono}" FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AtLimit}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UsageLabel}" FontSize="10.5"
                                               Foreground="{StaticResource Muted}" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource SlimProgress}" Height="4" Maximum="100"
                                             Value="{Binding UsagePercent}"
                                             Visibility="{Binding HasUsage, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding ResetDisplay}" FontSize="9.5"
                                           Foreground="{StaticResource Faint}" Margin="0,6,0,0"
                                           Visibility="{Binding ResetDisplay, Converter={StaticResource ShowIf}}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CreditDisplay}" FontSize="10.5" FontFamily="{StaticResource Mono}"
                                   Foreground="{StaticResource Muted}" Margin="0,9,0,0"
                                   Visibility="{Binding CreditDisplay, Converter={StaticResource ShowIf}}" />
                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,10,0,7" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,3"
                                    Click="OnGrokUsageRefresh" ToolTip="Refresh xAI account usage now">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="10"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" FontSize="10.5" Foreground="{StaticResource Muted}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding UpdatedDisplay}" FontSize="9.5"
                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>
            <!-- bridge account-usage details: opened by clicking BridgeUsageToggle in the bridge header -->
            <Popup x:Name="BridgeUsagePopup" PlacementTarget="{Binding ElementName=BridgeUsageToggle}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" Closed="OnBridgeUsagePopupClosed">
                <Border Style="{StaticResource PopupCard}" Width="304">
                    <StackPanel Margin="14,11" DataContext="{x:Static svc:UsageService.Instance}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Rad99}" Padding="8,1.5"
                                    VerticalAlignment="Center" Visibility="{Binding Plan, Converter={StaticResource ShowIf}}">
                                <TextBlock Text="{Binding Plan}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock Text="Claude account usage" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Limits}" Margin="0,9,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,9">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0}%}"
                                                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Text}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource SlimProgress}" Height="4" Value="{Binding Percent, Mode=OneWay}"
                                                     Maximum="100" Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}" />
                                        <TextBlock Text="{Binding ResetDisplay, StringFormat=resets {0}}" FontSize="9.5"
                                                   Foreground="{StaticResource Faint}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Visibility="{Binding HasReset, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Why the list is empty. Without this the card renders as a blank box with a Refresh button
                             for every failure (signed-out account, dead CLI, timeout) and looks like a rate limit. -->
                        <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,9,0,2"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}" />
                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,4,0,7" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,3" Click="OnBridgeUsageRefresh"
                                    ToolTip="Refresh usage now">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding UpdatedText}" FontSize="9.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Kimi for Coding quota: the plan pool plus every rolling rate window Kimi reports (typically 5h). -->
            <Popup x:Name="BridgeKimiUsagePopup" PlacementTarget="{Binding ElementName=BridgeKimiUsageToggle}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" Closed="OnBridgeKimiUsagePopupClosed">
                <Border Style="{StaticResource PopupCard}" Width="304">
                    <StackPanel Margin="14,11" DataContext="{x:Static svc:KimiUsageService.Instance}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Rad99}" Padding="8,1.5"
                                    VerticalAlignment="Center" Visibility="{Binding Plan, Converter={StaticResource ShowIf}}">
                                <TextBlock Text="{Binding Plan}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock Text="Kimi account usage" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Limits}" Margin="0,9,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,9">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0}%}"
                                                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Text}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource SlimProgress}" Height="4" Value="{Binding Percent, Mode=OneWay}"
                                                     Maximum="100" Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}" />
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="9.5"
                                                       FontFamily="{StaticResource Mono}" Foreground="{StaticResource Faint}"
                                                       Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding ResetDisplay, StringFormat=resets {0}}" FontSize="9.5"
                                                       Foreground="{StaticResource Faint}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Visibility="{Binding HasReset, Converter={StaticResource BoolVis}}" />
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Kimi's access token only lives ~15 minutes and VibeCode never spends the refresh token,
                             so this line also carries "these numbers are from HH:MM" when the read went stale. -->
                        <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,9,0,2"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}" />
                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,4,0,7" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,3" Click="OnBridgeKimiUsageRefresh"
                                    ToolTip="Refresh Kimi quota now">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding UpdatedText}" FontSize="9.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Announce: type one message and it's delivered to every agent on the bridge at once. Sending first
                 interrupts each running agent so the notice lands immediately; they resume on their own afterwards. -->
            <Popup x:Name="BridgeAnnouncePopup" PlacementTarget="{Binding ElementName=BridgeAnnounceToggle}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6"
                   Closed="OnBridgeAnnouncePopupClosed">
                <Border Style="{StaticResource PopupCard}" Width="342">
                    <StackPanel Margin="15,13">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24"
                                    VerticalAlignment="Top" Click="OnCloseBridgeAnnounce" ToolTip="Close"
                                    AutomationProperties.Name="Close announce">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE789;" FontFamily="{StaticResource Icons}" FontSize="13"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="Announce to all agents" FontWeight="SemiBold" FontSize="12.5"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Pauses every agent on this bridge, delivers one message, then they carry on."
                                   FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBox x:Name="AnnounceInput" Margin="0,10,0,0" MinHeight="68" MaxHeight="190"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" KeyDown="OnAnnounceInputKeyDown" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Enter to send · Shift+Enter for a new line" DockPanel.Dock="Left"
                                       FontSize="9.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnSendBridgeAnnouncement"
                                    Style="{StaticResource GhostButton}" Padding="13,5" Background="{StaticResource AccentSoft}"
                                    ToolTip="Interrupt every agent and send this announcement"
                                    AutomationProperties.Name="Send announcement">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="11"
                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Send" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Authoritative xAI billing for each unique Grok account backing the active Bridge. -->
            <Popup x:Name="BridgeGrokUsagePopup" PlacementTarget="{Binding ElementName=BridgeHeaderGrokUsageToggle}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6"
                   Closed="OnBridgeGrokUsagePopupClosed">
                <Border Style="{StaticResource PopupCard}" Width="378" MaxHeight="560">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,11">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}"
                                        CornerRadius="{StaticResource Rad99}" Padding="8,1.5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BridgeGrokAccountCountText}" FontSize="9.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                </Border>
                                <TextBlock Text="Grok Bridge usage" FontWeight="SemiBold" FontSize="12.5"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Background="{StaticResource Bg2}" CornerRadius="{StaticResource Rad6}"
                                    Padding="9,7" Margin="0,10,0,2">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BridgeGrokUsageSummary}"
                                               FontFamily="{StaticResource Mono}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="xAI account quota" FontSize="10.5"
                                               Foreground="{StaticResource Muted}" />
                                </DockPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding BridgeGrokAccounts}" Margin="0,7,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
                                                Padding="0,8,0,9">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}"
                                                            CornerRadius="{StaticResource Rad99}" Padding="7,1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PlanDisplay}" FontSize="9"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                               FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <DockPanel Margin="0,7,0,4">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsageSummary}"
                                                               FontFamily="{StaticResource Mono}" FontSize="10.5"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AtLimit}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding UsageLabel}" FontSize="10.5"
                                                               Foreground="{StaticResource Faint}" />
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource SlimProgress}" Height="4" Maximum="100"
                                                             Value="{Binding UsagePercent}"
                                                             Visibility="{Binding HasUsage, Converter={StaticResource BoolVis}}" />
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedDisplay}"
                                                               FontSize="9" Foreground="{StaticResource Faint}" />
                                                    <TextBlock Text="{Binding ResetDisplay}" FontSize="9.5"
                                                               Foreground="{StaticResource Faint}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding CreditDisplay}" FontSize="9.5"
                                                           FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"
                                                           Margin="0,5,0,0"
                                                           Visibility="{Binding CreditDisplay, Converter={StaticResource ShowIf}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,8,0,7" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,3"
                                        Click="OnBridgeGrokUsageRefresh" ToolTip="Refresh xAI account usage now">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Refresh" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Live xAI billing for the accounts used by this Bridge."
                                           FontSize="9.5" Foreground="{StaticResource Faint}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="245" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
            <!-- Codex usage details: shared by normal Codex chats and the Bridge header, independent from
                 Claude's /usage popup and backed by account/rateLimits/read. -->
            <Popup x:Name="BridgeCodexUsagePopup" PlacementTarget="{Binding ElementName=BridgeCodexUsageToggle}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6"
                   Closed="OnBridgeCodexUsagePopupClosed">
                <Border Style="{StaticResource PopupCard}" Width="352" MaxHeight="560">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,11" DataContext="{Binding CurrentCodexAccount}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Rad99}"
                                        Padding="8,1.5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlanDisplay}" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" />
                                </Border>
                                <TextBlock Text="OpenAI Codex usage" FontWeight="SemiBold" FontSize="12.5"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />

                            <Border Background="{StaticResource AmberSoft}" BorderBrush="{StaticResource Amber}"
                                    BorderThickness="1" CornerRadius="{StaticResource Rad6}" Padding="8,5" Margin="0,9,0,0"
                                    Visibility="{Binding HasRateLimitStatus, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding RateLimitStatusDisplay}" FontSize="10.5"
                                           Foreground="{StaticResource Amber}" FontWeight="SemiBold" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding UsageLimits}" Margin="0,11,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type svc:CodexUsageLimit}">
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0}%}"
                                                           FontFamily="{StaticResource Mono}" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                           Foreground="{StaticResource Text}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource SlimProgress}" Height="4"
                                                         Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                                                         Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}" />
                                            <TextBlock Text="{Binding DetailDisplay}" FontSize="9.5"
                                                       Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding ResetDisplay, StringFormat=resets {0}}" FontSize="9.5"
                                                       Foreground="{StaticResource Faint}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasReset, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="9.5"
                                                       Foreground="{StaticResource Amber}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel>
                                <Border Background="{StaticResource Bg2}" CornerRadius="{StaticResource Rad6}" Padding="8,5" Margin="0,0,0,6"
                                        Visibility="{Binding HasCreditDetails, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding CreditDetailsDisplay}" FontSize="10"
                                               Foreground="{StaticResource Muted}" />
                                </Border>
                                <Border Background="{StaticResource Bg2}" CornerRadius="{StaticResource Rad6}" Padding="8,5" Margin="0,0,0,6"
                                        Visibility="{Binding HasResetCredits, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding ResetCreditsDisplay}" FontSize="10"
                                               Foreground="{StaticResource Muted}" />
                                </Border>
                                <Border Background="{StaticResource Bg2}" CornerRadius="{StaticResource Rad6}" Padding="8,6" Margin="0,0,0,6"
                                        Visibility="{Binding HasSpendLimit, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Workspace spend limit" FontSize="10.5"
                                                   Foreground="{StaticResource Text}" />
                                        <TextBlock Text="{Binding SpendLimit.Summary}" FontSize="9.5"
                                                   Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SpendLimit.ResetDisplay, StringFormat=resets {0}}"
                                                   FontSize="9.5" Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,4,0,7" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,3"
                                        Click="OnBridgeCodexUsageRefresh" ToolTip="Refresh Codex usage now">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Refresh" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UsageUpdatedText}" FontSize="9.5"
                                               Foreground="{StaticResource Faint}" />
                                    <TextBlock Text="Live subscription limits from Codex" FontSize="9"
                                               Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- ============ account manager ============ -->
            <!-- An in-window overlay, NOT a Popup. A Popup lives in its own HWND that Windows clamps to the
                 monitor work area, which cropped the bottom of the card off screen - including the footer row
                 that holds the "Add account" button, so the manager looked like it had no way to add one.
                 Laid out inside the shell it is bounded by the window and always shows its footer. -->
            <Grid x:Name="AccountManagerOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="950"
                  Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="#B80B0A08" MouseLeftButtonDown="OnAccountManagerBackdropClick" />
                <Border Style="{StaticResource PopupCard}" MaxWidth="1040" MaxHeight="720"
                        Margin="38" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid Margin="24,21,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    Click="OnCloseAccountManager" ToolTip="Close account manager"
                                    AutomationProperties.Name="Close account manager" />
                            <StackPanel>
                                <TextBlock Text="Account manager" Foreground="{StaticResource Text}"
                                           FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Search, compare usage, and choose the account new chats should use."
                                           Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,18,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Height="42">
                                <TextBox x:Name="AccountSearchBox" Padding="19,0,19,0"
                                         VerticalContentAlignment="Center" TextChanged="OnAccountSearchChanged"
                                         AutomationProperties.Name="Search saved accounts"
                                         AutomationProperties.HelpText="Searches account names, providers, plans, and visible usage details" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Left"
                                           VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                <TextBlock x:Name="AccountSearchPlaceholder" Text="Search saved accounts…"
                                           Foreground="{StaticResource Faint}" FontSize="12.5"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="38,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource HintVis}">
                                            <Binding Path="Text" ElementName="AccountSearchBox" />
                                            <Binding Path="IsKeyboardFocusWithin" ElementName="AccountSearchBox" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <Button x:Name="AccountSearchClearButton" Style="{StaticResource IconButton}"
                                        Content="&#xE711;" Width="28" Height="28" Margin="0,0,7,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnClearAccountSearch" ToolTip="Clear search"
                                        AutomationProperties.Name="Clear account search" Visibility="Collapsed" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SHOW" Style="{StaticResource Caption}" FontSize="9"
                                               Margin="2,0,0,6" />
                                    <ComboBox x:Name="AccountProviderCombo" Style="{StaticResource AccountProviderPicker}"
                                              Height="38" SelectionChanged="OnAccountProviderChanged"
                                              AutomationProperties.Name="Filter accounts by AI">
                                        <ComboBoxItem Tag="all" Content="All accounts" />
                                        <ComboBoxItem Tag="claude" Content="Claude Code" />
                                        <ComboBoxItem Tag="codex" Content="OpenAI Codex" />
                                        <ComboBoxItem Tag="kimi" Content="Kimi Code" />
                                        <ComboBoxItem Tag="grok" Content="Grok" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="STATUS" Style="{StaticResource Caption}" FontSize="9"
                                               Margin="2,0,0,6" />
                                    <ComboBox x:Name="AccountStatusCombo" Style="{StaticResource AccountProviderPicker}"
                                              Height="38" SelectedIndex="0"
                                              SelectionChanged="OnAccountStatusChanged"
                                              AutomationProperties.Name="Account status filter">
                                        <ComboBoxItem Tag="all" Content="All statuses" />
                                        <ComboBoxItem Tag="ready" Content="Ready" />
                                        <ComboBoxItem Tag="at-limit" Content="At limit" />
                                        <ComboBoxItem Tag="sign-in" Content="Needs sign-in" />
                                        <ComboBoxItem Tag="selected" Content="Selected" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="SORT" Style="{StaticResource Caption}" FontSize="9"
                                               Margin="2,0,0,6" />
                                    <ComboBox x:Name="AccountSortCombo" Style="{StaticResource AccountProviderPicker}"
                                              Height="38" SelectedIndex="0"
                                              SelectionChanged="OnAccountSortChanged"
                                              AutomationProperties.Name="Account sort order">
                                        <ComboBoxItem Tag="active" Content="Active first" />
                                        <ComboBoxItem Tag="usage-low" Content="Usage · most available" />
                                        <ComboBoxItem Tag="usage-high" Content="Usage · most used" />
                                        <ComboBoxItem Tag="name" Content="Name · A–Z" />
                                        <ComboBoxItem Tag="newest" Content="Recently added" />
                                        <ComboBoxItem Tag="oldest" Content="Oldest added" />
                                        <ComboBoxItem Tag="attention" Content="Needs attention" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="AccountManagerResultsText" Grid.Column="5"
                                           Foreground="{StaticResource Faint}" FontSize="10.5"
                                           Margin="16,20,2,0" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" CornerRadius="{StaticResource Rad12}" ClipToBounds="True">
                            <Grid Margin="10,9">
                                <Grid>
                                    <!-- Unified roster used by the All accounts filter. The implicit account-type
                                         templates above keep each provider actionable while sharing one sorted list. -->
                                    <Grid x:Name="AllAccountsPanel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="8,4,8,10">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding AllAccounts.Count, StringFormat={}{0} total}"
                                                       Foreground="{StaticResource Faint}" FontSize="10.5"
                                                       VerticalAlignment="Bottom" />
                                            <StackPanel>
                                                <TextBlock Text="All accounts" Foreground="{StaticResource Text}"
                                                           FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="Every saved AI account in one switchable list."
                                                           Foreground="{StaticResource Faint}" FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="AllAccountEmptyText" Grid.Row="1" Panel.ZIndex="2"
                                                   Text="No accounts match the current search or status filter."
                                                   Foreground="{StaticResource Faint}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="20" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Visibility="Collapsed" />
                                        <ListBox x:Name="AllAccountList" Grid.Row="1"
                                                 ItemContainerStyle="{StaticResource AccountManagerListItem}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                                    </Grid>

                                    <!-- Claude accounts -->
                                    <Grid x:Name="ClaudeAccountsPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="8,4,8,10">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Accounts.Count, StringFormat={}{0} saved}"
                                                       Foreground="{StaticResource Faint}" FontSize="10.5"
                                                       VerticalAlignment="Bottom" />
                                            <StackPanel>
                                                <TextBlock Text="Claude Code accounts" Foreground="{StaticResource Text}"
                                                           FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="Select an account to make Claude the provider for new chats."
                                                           Foreground="{StaticResource Faint}" FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="ClaudeAccountEmptyText" Grid.Row="1" Panel.ZIndex="2"
                                                   Text="No Claude accounts are saved yet. Add one below to get started."
                                                   Foreground="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap"
                                                   Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <ListBox x:Name="ClaudeAccountList" Grid.Row="1"
                                                 ItemContainerStyle="{StaticResource AccountManagerListItem}"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type svc:AccountInfo}">
                                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                            HorizontalAlignment="Stretch" Padding="10,7" Margin="0,1"
                                                            Click="OnSwitchAccount" ContextMenu="{StaticResource AccountMenu}"
                                                            PreviewMouseRightButtonDown="OnAccountRightDown"
                                                            ToolTip="Click to switch · right-click to test or remove"
                                                            AutomationProperties.Name="{Binding Label}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                                       FontSize="13" Foreground="{StaticResource Green}"
                                                                       VerticalAlignment="Center" Margin="12,0,2,0"
                                                                       Visibility="{Binding IsVibeCodeSelected, Converter={StaticResource BoolVis}}" />
                                                            <Border DockPanel.Dock="Right" Background="#33E0A64E" CornerRadius="{StaticResource Rad6}"
                                                                    Padding="7,3" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    Visibility="{Binding NeedsRelogin, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="sign in" FontSize="10" Foreground="{StaticResource Amber}" />
                                                            </Border>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SavedAt, StringFormat={}{0:MMM d}}"
                                                                       Width="68" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Faint}" FontSize="10" TextAlignment="Right"
                                                                       ToolTip="Date this login was saved" />
                                                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource Rad8}"
                                                                    Background="{StaticResource BrandGradient}" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13"
                                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource Text}"
                                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                                <TextBlock Text="{Binding ProviderLine}" FontSize="10"
                                                                           Foreground="{StaticResource Faint}" Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                <TextBlock Text="{Binding UsageDisplay}" FontSize="9.5"
                                                                           FontFamily="{StaticResource Mono}" Margin="0,2,0,0"
                                                                           Visibility="{Binding UsageDisplay, Converter={StaticResource ShowIf}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding AtLimit}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Grid.Row="2" Text="Showing your live login — no account selected yet"
                                                   Visibility="{Binding AccountIsFallback, Converter={StaticResource BoolVis}}"
                                                   Foreground="{StaticResource Faint}" FontSize="10.5" TextWrapping="Wrap"
                                                   Margin="12,8,12,4" />
                                    </Grid>

                                    <!-- OpenAI Codex accounts -->
                                    <Grid x:Name="CodexAccountsPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="8,4,8,10">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CodexAccounts.Count, StringFormat={}{0} saved}"
                                                       Foreground="{StaticResource Faint}" FontSize="10.5"
                                                       VerticalAlignment="Bottom" />
                                            <StackPanel>
                                                <TextBlock Text="OpenAI Codex accounts" Foreground="{StaticResource Text}"
                                                           FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="Each saved login stays isolated from your other Codex accounts."
                                                           Foreground="{StaticResource Faint}" FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="CodexAccountEmptyText" Grid.Row="1" Panel.ZIndex="2"
                                                   Text="No Codex accounts are saved yet. Add one below to get started."
                                                   Foreground="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap"
                                                   Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <ListBox x:Name="CodexAccountList" Grid.Row="1"
                                                 ItemContainerStyle="{StaticResource AccountManagerListItem}"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type svc:CodexAccountInfo}">
                                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                            HorizontalAlignment="Stretch" Padding="10,7" Margin="0,1"
                                                            Click="OnSwitchCodexAccount"
                                                            ContextMenu="{StaticResource CodexAccountMenu}"
                                                            PreviewMouseRightButtonDown="OnCodexAccountRightDown"
                                                            ToolTip="Click to switch · right-click to test or remove"
                                                            AutomationProperties.Name="{Binding Label}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                                       FontSize="13" Foreground="{StaticResource Green}"
                                                                       VerticalAlignment="Center" Margin="12,0,2,0"
                                                                       Visibility="{Binding IsVibeCodeSelected, Converter={StaticResource BoolVis}}" />
                                                            <Border DockPanel.Dock="Right" Background="#33E0A64E" CornerRadius="{StaticResource Rad6}"
                                                                    Padding="7,3" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    Visibility="{Binding NeedsRelogin, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="sign in" FontSize="10" Foreground="{StaticResource Amber}" />
                                                            </Border>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SavedAt, StringFormat={}{0:MMM d}}"
                                                                       Width="68" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Faint}" FontSize="10" TextAlignment="Right"
                                                                       ToolTip="Date this login was saved" />
                                                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource Rad8}"
                                                                    Background="{StaticResource BrandGradient}" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Initial}" Foreground="White"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource Text}"
                                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                                <TextBlock Text="{Binding ProviderLine}" FontSize="10"
                                                                           Foreground="{StaticResource Faint}" Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                <TextBlock Text="{Binding UsageDisplay}" FontSize="9.5"
                                                                           FontFamily="{StaticResource Mono}" Margin="0,2,0,0"
                                                                           Visibility="{Binding UsageDisplay, Converter={StaticResource ShowIf}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding AtLimit}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <!-- Kimi's CLI owns one shared OAuth login, but it still participates in the
                                         same provider selector and remains visible while signed out or uninstalled. -->
                                    <StackPanel x:Name="KimiAccountsPanel" Visibility="Collapsed">
                                        <DockPanel Margin="8,4,8,10">
                                            <TextBlock DockPanel.Dock="Right" Text="shared CLI login"
                                                       Foreground="{StaticResource Faint}" FontSize="10.5"
                                                       VerticalAlignment="Bottom" />
                                            <StackPanel>
                                                <TextBlock Text="Kimi Code account" Foreground="{StaticResource Text}"
                                                           FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="Kimi Code uses the account connected through its installed CLI."
                                                           Foreground="{StaticResource Faint}" FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Button x:Name="KimiAccountRow" Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Stretch"
                                                HorizontalAlignment="Stretch" Padding="10,7" Margin="0,1"
                                                Click="OnManageKimiAccount"
                                                ToolTip="Connect or use the Kimi Code CLI account"
                                                AutomationProperties.Name="Kimi Code account">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}"
                                                           FontSize="13" Foreground="{StaticResource Green}"
                                                           VerticalAlignment="Center" Margin="12,0,2,0"
                                                           Visibility="{Binding IsKimiSelected, Converter={StaticResource BoolVis}}" />
                                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource Rad8}"
                                                        Background="{StaticResource BrandGradient}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding KimiAccountInitial}" Foreground="White"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KimiAccountLabel}" FontSize="12.5"
                                                               Foreground="{StaticResource Text}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding KimiAccountSub}" FontSize="10"
                                                               Foreground="{StaticResource Faint}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding KimiAccountUsage}" FontSize="9.5"
                                                               FontFamily="{StaticResource Mono}" Foreground="{StaticResource Faint}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Visibility="{Binding KimiAccountUsage, Converter={StaticResource ShowIf}}"
                                                               ToolTip="Kimi Code does not expose account usage to VibeCode." />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        <TextBlock x:Name="KimiAccountEmptyText"
                                                   Text="The Kimi account does not match the current search or status filter."
                                                   Foreground="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap"
                                                   Margin="20,36" HorizontalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>

                                    <Grid x:Name="GrokAccountsPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="8,4,8,10">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding GrokAccounts.Count, StringFormat={}{0} saved}"
                                                       Foreground="{StaticResource Faint}" FontSize="10.5"
                                                       VerticalAlignment="Bottom" />
                                            <StackPanel>
                                                <TextBlock Text="Grok accounts" Foreground="{StaticResource Text}"
                                                           FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="Each xAI login is isolated; chats stay pinned to the account they started with."
                                                           Foreground="{StaticResource Faint}" FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="GrokAccountEmptyText" Grid.Row="1" Panel.ZIndex="2"
                                                   Text="No Grok accounts are saved yet. Add one below to get started."
                                                   Foreground="{StaticResource Faint}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="20" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Visibility="Collapsed" />
                                        <ListBox x:Name="GrokAccountList" Grid.Row="1"
                                                 ItemContainerStyle="{StaticResource AccountManagerListItem}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type svc:GrokAccountInfo}">
                                                    <Button Style="{StaticResource GhostButton}"
                                                            HorizontalContentAlignment="Stretch"
                                                            HorizontalAlignment="Stretch" Padding="10,7" Margin="0,1"
                                                            Click="OnSwitchGrokAccount"
                                                            ContextMenu="{StaticResource GrokAccountMenu}"
                                                            PreviewMouseRightButtonDown="OnGrokAccountRightDown"
                                                            ToolTip="Click to switch · right-click to test, sign out, or remove"
                                                            AutomationProperties.Name="{Binding Label}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="&#xE73E;"
                                                                       FontFamily="{StaticResource Icons}"
                                                                       FontSize="13" Foreground="{StaticResource Green}"
                                                                       VerticalAlignment="Center" Margin="12,0,2,0"
                                                                       Visibility="{Binding IsVibeCodeSelected, Converter={StaticResource BoolVis}}" />
                                                            <Border DockPanel.Dock="Right" Background="#33E0A64E"
                                                                    CornerRadius="{StaticResource Rad6}" Padding="7,3"
                                                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    Visibility="{Binding NeedsRelogin, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="sign in" FontSize="10"
                                                                           Foreground="{StaticResource Amber}" />
                                                            </Border>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding SavedAt, StringFormat={}{0:MMM d}}"
                                                                       Width="68" Margin="12,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Faint}" FontSize="10"
                                                                       TextAlignment="Right" />
                                                            <Border DockPanel.Dock="Left" Width="32" Height="32"
                                                                    CornerRadius="{StaticResource Rad8}"
                                                                    Background="{StaticResource BrandGradient}"
                                                                    Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Initial}" Foreground="White"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                                           Foreground="{StaticResource Text}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ProviderLine}" FontSize="10"
                                                                           Foreground="{StaticResource Faint}"
                                                                           Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding UsageDisplay}" FontSize="9.5"
                                                                           FontFamily="{StaticResource Mono}"
                                                                           Foreground="{StaticResource Faint}"
                                                                           Margin="0,2,0,0"
                                                                           Visibility="{Binding UsageDisplay, Converter={StaticResource ShowIf}}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <WrapPanel Grid.Row="2" Margin="8,8,8,2">
                                            <Button x:Name="GrokCookieImportButton" Style="{StaticResource GhostButton}"
                                                    Padding="12,7" Click="OnImportGrokCookies">
                                                <TextBlock Text="Paste Grok cookies" />
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="2,14,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AccountManagerFooterHint" Foreground="{StaticResource Faint}"
                                       FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                       HorizontalAlignment="Left" Margin="0,0,16,0" MaxWidth="380" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AccountResetFiltersButton" Style="{StaticResource GhostButton}"
                                        Padding="12,9" Margin="0,0,10,0" Click="OnResetAccountFilters"
                                        AutomationProperties.Name="Reset account filters" Visibility="Collapsed">
                                    <TextBlock Text="Reset filters" />
                                </Button>
                                <Button x:Name="AccountManagerAddKeyButton" Style="{StaticResource GhostButton}"
                                        Padding="12,9" Margin="0,0,10,0" Click="OnAddApiKeyAccount"
                                        AutomationProperties.Name="Add API key for selected provider">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE192;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Add API key" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AccountManagerAddButton" Style="{StaticResource PrimaryButton}" Padding="15,9"
                                        Click="OnAddAccount" AutomationProperties.Name="Add account for selected provider">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="AccountManagerAddLabel" Text="Add Claude account" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- image lightbox: double-click a chat image to expand it full-screen; click anywhere or press Esc to close -->
            <Grid x:Name="Lightbox" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="900" Visibility="Collapsed"
                  Background="#EC0B0A08" Focusable="True" KeyDown="OnLightboxKey"
                  MouseLeftButtonDown="OnCloseLightbox" Cursor="Hand">
                <!-- Hit-test so right-click can offer Copy image; left-click still closes via OnCloseLightbox. -->
                <Image x:Name="LightboxImage" Stretch="Uniform" Margin="56" IsHitTestVisible="True"
                       Cursor="Hand" MouseLeftButtonDown="OnCloseLightbox"
                       ContextMenu="{StaticResource ImageMenu}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" Width="40" Height="40"
                        Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,20,0"
                        Click="OnCloseLightbox" ToolTip="Close (Esc)" AutomationProperties.Name="Close image" />
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Background="#66000000"
                        CornerRadius="{StaticResource Rad8}" Padding="12,6" IsHitTestVisible="False">
                    <TextBlock Text="Click anywhere or Esc to close · right-click image to copy" Foreground="#CCFFFFFF" FontSize="11.5" />
                </Border>
            </Grid>

            <!-- Dedicated startup surface: it paints first, reports real stages, then fades into the workspace. -->
            <ui:StartupOverlay x:Name="StartupOverlay"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Panel.ZIndex="2000" />
        </Grid>
    </Border>
</Window>
