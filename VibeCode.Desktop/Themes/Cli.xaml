<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                     xmlns:ui="clr-namespace:VibeCode.UI">

    <!-- ================================================================
         VibeCode CLI mode - cmd.exe console look: light grey text on black,
         monospace everywhere, hard square corners, no shadows or gradients.
         Green survives only as a sparse accent (selection, primary action,
         status), like a prompt highlight - body text stays console grey.
         Defines EXACTLY the same keys as Dark.xaml so every window loads
         unchanged; only the values differ.
         ================================================================ -->

    <!-- palette: console black ladder, cmd grey text, green reserved for accent -->
    <Color x:Key="Bg0Color">#0C0C0C</Color>
    <Color x:Key="Bg1Color">#101010</Color>
    <Color x:Key="Bg2Color">#151515</Color>
    <Color x:Key="Bg3Color">#1E1E1E</Color>
    <Color x:Key="OverlayColor">#181818</Color>
    <Color x:Key="AccentColor">#2EE66B</Color>
    <Color x:Key="AccentHoverColor">#5CFF93</Color>
    <Color x:Key="AccentPressColor">#1FB350</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Overlay" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="CodeBg" Color="#060606" />
    <!-- terminals have no glass; near-opaque black keeps bridge panes readable on the flat backdrop -->
    <SolidColorBrush x:Key="GlassPane" Color="#E60C0C0C" />
    <SolidColorBrush x:Key="GlassBar" Color="#F2101010" />
    <!-- Spotify stays its brand green (scoped to the Spotify surfaces, same as the dark theme) -->
    <SolidColorBrush x:Key="SpotifyGreen" Color="#1DB954" />
    <SolidColorBrush x:Key="SpotifyGreenHover" Color="#24D062" />
    <SolidColorBrush x:Key="SpotifyGreenPress" Color="#159C46" />
    <SolidColorBrush x:Key="SpotifyGreenSoft" Color="#241DB954" />
    <SolidColorBrush x:Key="SpotifyGreenDim" Color="#2FA55F" />
    <!-- Weather keeps the same sky-blue guest accent as the dark theme: the radar imagery it sits next to is
         full colour anyway, so tinting these controls terminal-green would read as a status cue that isn't there. -->
    <SolidColorBrush x:Key="WeatherBlue" Color="#38A3E0" />
    <SolidColorBrush x:Key="WeatherBlueHover" Color="#54B7EE" />
    <SolidColorBrush x:Key="WeatherBluePress" Color="#2585BC" />
    <SolidColorBrush x:Key="WeatherBlueSoft" Color="#2438A3E0" />
    <!-- borders: neutral grey box-drawing lines -->
    <SolidColorBrush x:Key="Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BorderSoft" Color="#2A2A2A" />
    <SolidColorBrush x:Key="BorderHairline" Color="#1F1F1F" />
    <!-- cmd.exe console text: light grey body, dimmer greys for secondary - no green walls of text -->
    <SolidColorBrush x:Key="Text" Color="#CCCCCC" />
    <SolidColorBrush x:Key="Muted" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Faint" Color="#6A6A6A" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#242EE66B" />
    <SolidColorBrush x:Key="AccentDim" Color="#662EE66B" />
    <SolidColorBrush x:Key="OnAccent" Color="#061106" />
    <SolidColorBrush x:Key="Green" Color="#2EE66B" />
    <SolidColorBrush x:Key="GreenSoft" Color="#1E2EE66B" />
    <SolidColorBrush x:Key="Red" Color="#FF5F56" />
    <SolidColorBrush x:Key="RedSoft" Color="#22FF5F56" />
    <SolidColorBrush x:Key="Amber" Color="#E5C07B" />
    <SolidColorBrush x:Key="AmberSoft" Color="#1FE5C07B" />
    <SolidColorBrush x:Key="Yellow" Color="#E5C07B" />
    <SolidColorBrush x:Key="YellowSoft" Color="#22E5C07B" />
    <SolidColorBrush x:Key="Blue" Color="#56B6C2" />
    <SolidColorBrush x:Key="BlueSoft" Color="#1F56B6C2" />

    <!-- flat console grey; kept as gradients only because consumers expect the brush type -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A4A4A" Offset="0" />
        <GradientStop Color="#262626" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EE66B" Offset="0" />
        <GradientStop Color="#1FB350" Offset="1" />
    </LinearGradientBrush>

    <!-- no glow in a terminal: zero-opacity effect keeps key parity with Dark.xaml -->
    <DropShadowEffect x:Key="BrandGlow" Color="#000000" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <!-- CLI pane focus stays visually neutral; selecting text or an editor should not turn the whole pane green. -->
    <SolidColorBrush x:Key="PaneFocusBorder" Color="#2A2A2A" />

    <!-- chat status dots: terminal cursor green, blinking while working -->
    <Style x:Key="StatusDotBase" TargetType="Ellipse">
        <Setter Property="Fill" Value="{StaticResource Accent}" />
    </Style>
    <Style x:Key="StatusDot" TargetType="Ellipse" BasedOn="{StaticResource StatusDotBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="StatusDotPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25"
                                             Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="StatusDotPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ChatListStatusDot" TargetType="Ellipse" BasedOn="{StaticResource StatusDotBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ChatListIsWorking}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="ChatListStatusDotPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25"
                                             Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="ChatListStatusDotPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- corner radii: every one is 0 - terminals draw rectangles -->
    <CornerRadius x:Key="Rad1">0</CornerRadius>
    <CornerRadius x:Key="Rad2">0</CornerRadius>
    <CornerRadius x:Key="Rad3">0</CornerRadius>
    <CornerRadius x:Key="Rad4">0</CornerRadius>
    <CornerRadius x:Key="Rad5">0</CornerRadius>
    <CornerRadius x:Key="Rad6">0</CornerRadius>
    <CornerRadius x:Key="Rad7">0</CornerRadius>
    <CornerRadius x:Key="Rad8">0</CornerRadius>
    <CornerRadius x:Key="Rad9">0</CornerRadius>
    <CornerRadius x:Key="Rad10">0</CornerRadius>
    <CornerRadius x:Key="Rad11">0</CornerRadius>
    <CornerRadius x:Key="Rad12">0</CornerRadius>
    <CornerRadius x:Key="Rad13">0</CornerRadius>
    <CornerRadius x:Key="Rad14">0</CornerRadius>
    <CornerRadius x:Key="Rad16">0</CornerRadius>
    <CornerRadius x:Key="Rad17">0</CornerRadius>
    <CornerRadius x:Key="Rad22">0</CornerRadius>
    <CornerRadius x:Key="Rad28">0</CornerRadius>
    <CornerRadius x:Key="Rad99">0</CornerRadius>
    <CornerRadius x:Key="Rad999">0</CornerRadius>
    <CornerRadius x:Key="RadBubble">0</CornerRadius>
    <CornerRadius x:Key="RadTop12">0</CornerRadius>
    <CornerRadius x:Key="RadBottom12">0</CornerRadius>
    <CornerRadius x:Key="RadBottom10">0</CornerRadius>

    <!-- type: monospace for EVERYTHING - the terminal voice -->
    <FontFamily x:Key="Ui">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="Display">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- base text -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- section caption (small uppercase label) -->
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- fluent icon glyph -->
    <Style x:Key="Icon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ================= scrollbars: square block thumb ================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Resources>
                                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</sys:Double>
                            </Track.Resources>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="th" Background="#333333" Margin="2,2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="th" Property="Background" Value="#4A4A4A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Resources>
                                        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</sys:Double>
                                    </Track.Resources>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="th" Background="#333333" Margin="2,2" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="th" Property="Background" Value="#4A4A4A" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= buttons: terminal-dark surfaces with sparse green cues ================= -->
    <Style x:Key="BaseButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg1}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource BaseButton}" />

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <!-- Keep primary actions legible without turning every CTA into a neon slab. -->
        <Setter Property="Background" Value="#151A16" />
        <Setter Property="BorderBrush" Value="#7A2EE66B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#D7EBDD" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#331FB350" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#1FB350" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{StaticResource Red}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#55FF5F56" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RedSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 30x30 square ghost icon button (chat header, panel actions) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhostToggle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- titlebar window buttons -->
    <Style x:Key="TitlebarButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TitlebarClose" TargetType="Button" BasedOn="{StaticResource TitlebarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- segmented tab: square, bracketed feel via border -->
    <Style x:Key="PillTab" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= inputs: square, block caret green ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- read-only code block -->
    <Style x:Key="CodeBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource CodeBg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <!-- scroll the code box internally, then hand the wheel off to the page at its top/bottom edge -->
        <Setter Property="ui:WheelForward.AtBoundary" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="0">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= misc chrome ================= -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Overlay}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="0" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- popup surface: flat, hard grey border, no shadow -->
    <Style x:Key="PopupCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg1}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Margin" Value="12" />
    </Style>

    <!-- slim progress bar (neutral by default; usage bars override Foreground) -->
    <Style x:Key="SlimProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="{StaticResource CodeBg}" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="0" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="0" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- backdrop scrims: flat terminal black (no art shows in CLI mode; retuned at runtime anyway) -->
    <SolidColorBrush x:Key="ScrimHome" Color="#FF0C0C0C" />
    <SolidColorBrush x:Key="ScrimBridge" Color="#FF0C0C0C" />
    <SolidColorBrush x:Key="ScrimChat" Color="#FF0C0C0C" />

    <!-- slider -->
    <Style x:Key="DimSlider" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="5" Background="{StaticResource CodeBg}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent" Height="22">
                                                <Border Height="5" Background="{StaticResource Accent}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent" Height="22" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="15" Height="15">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Accent}"
                                                    BorderThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- checkbox: square [x] -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="17" Height="17" BorderThickness="1.5"
                                BorderBrush="{StaticResource Border}" Background="{StaticResource Bg2}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                       Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- terminal output doesn't slide in: near-instant fade only -->
    <Style x:Key="Appear" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.05" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
