<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                     xmlns:ui="clr-namespace:VibeCode.UI">

    <!-- ================================================================
         VibeCode dark theme - warm anthracite surfaces, terracotta accent.
         Elevation ladder: Code (recessed) < Bg0 canvas < Bg1 < Bg2 < Bg3 < Overlay.
         ================================================================ -->

    <!-- palette: neutral dark elevation ladder (cool grey), cool blue accent -->
    <Color x:Key="Bg0Color">#1A1A1D</Color>
    <Color x:Key="Bg1Color">#212226</Color>
    <Color x:Key="Bg2Color">#27282C</Color>
    <Color x:Key="Bg3Color">#2F3035</Color>
    <Color x:Key="OverlayColor">#37383E</Color>
    <Color x:Key="AccentColor">#4C8DF5</Color>
    <Color x:Key="AccentHoverColor">#6BA0F7</Color>
    <Color x:Key="AccentPressColor">#3B78D8</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Overlay" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="CodeBg" Color="#141518" />
    <!-- translucent 'glass' surfaces: let the animated backdrop show through (bridge panes / bars).
         Same hues as Bg1/Bg2 but with alpha, so the custom background reads behind the panes while
         the scrim + this floor keep message text legible. GlassBar is a touch more opaque to frame. -->
    <SolidColorBrush x:Key="GlassPane" Color="#B0212226" />
    <SolidColorBrush x:Key="GlassBar" Color="#C827282C" />

    <!-- ===== structural surfaces =====
         The app's own chrome: titlebar, sidebar, right panel, chat header, the Bridge panes and their bars.
         Keyed apart from the Bg* ladder they are drawn from purely so Themes/Borderless.xaml can remap THESE
         to transparent and nothing else - a button, chip, popup or message card that says Bg2 keeps its fill
         in every mode. Values here are identical to the keys each surface used before, so the default look is
         unchanged. -->
    <SolidColorBrush x:Key="SurfaceChrome" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="SurfaceCanvas" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="SurfacePane" Color="#B0212226" />
    <SolidColorBrush x:Key="SurfaceBar" Color="#C827282C" />
    <!-- the seam between two structural surfaces; borderless turns it into a black hairline -->
    <SolidColorBrush x:Key="SurfaceOutline" Color="#2C2D32" />
    <!-- The main chat's composer bubble. A Bridge pane's composer is painted with SurfaceBar, so it empties out
         with the rest of the pane in borderless while this one - the only composer a single chat has - stayed a
         filled slab, which is precisely the chat-vs-bridge gap the mode is supposed to close. Its own key, not
         Bg2, so a borderless override empties the composer without touching the buttons and chips that sit
         beside it. Same value the bubble used before, so the default look is unchanged. -->
    <SolidColorBrush x:Key="SurfaceComposer" Color="{StaticResource Bg2Color}" />
    <!-- Composer send button. Its own three keys rather than Accent/OnAccent directly, so Borderless can drop
         the filled disc without disturbing the accent anywhere else in the app: once the panels stop painting,
         that disc is the last piece of the panel look left on screen. The interrupt state is untouched either
         way - it already ghosts itself to a red outline while a turn is running. -->
    <SolidColorBrush x:Key="SendButtonFill" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SendButtonFillHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SendButtonGlyph" Color="#FFFFFF" />
    <!-- no ring here: the disc IS the shape. Borderless turns this one on and the fill off, so the circle
         survives as an outline instead of disappearing with the fill. -->
    <SolidColorBrush x:Key="SendButtonRing" Color="Transparent" />
    <!-- Spotify extension ONLY: a scoped guest accent. #1DB954 appears solely inside the Spotify card + its
         titlebar popup (enable switch, Connect button, play/pause circle, status dot). Everything else stays blue. -->
    <SolidColorBrush x:Key="SpotifyGreen" Color="#1DB954" />
    <SolidColorBrush x:Key="SpotifyGreenHover" Color="#24D062" />
    <SolidColorBrush x:Key="SpotifyGreenPress" Color="#159C46" />
    <SolidColorBrush x:Key="SpotifyGreenSoft" Color="#241DB954" />
    <!-- low-key active tint: a muted spotify green for 'enabled' toggles (shuffle) that shouldn't shout -->
    <SolidColorBrush x:Key="SpotifyGreenDim" Color="#2FA55F" />
    <!-- Weather extension ONLY: a scoped guest accent, same discipline as the Spotify green above. NWS sky-blue
         appears solely on the weather card, its titlebar chip and the radar window's own controls + location dot. -->
    <SolidColorBrush x:Key="WeatherBlue" Color="#38A3E0" />
    <SolidColorBrush x:Key="WeatherBlueHover" Color="#54B7EE" />
    <SolidColorBrush x:Key="WeatherBluePress" Color="#2585BC" />
    <SolidColorBrush x:Key="WeatherBlueSoft" Color="#2438A3E0" />
    <!-- three border tiers: controls > card edges > invisible seams between same-tone regions -->
    <SolidColorBrush x:Key="Border" Color="#3A3B42" />
    <SolidColorBrush x:Key="BorderSoft" Color="#2C2D32" />
    <SolidColorBrush x:Key="BorderHairline" Color="#232428" />
    <!-- Fill + outline of a small pill/chip that floats in a BAR rather than inside a card (the bridge header's
         account usage pills, the parked-pane restore chip). Their own keys because borderless overrides exactly
         these: once the bar behind them stops painting, a chip that keeps a filled body is the last grey slab in
         a row of bare glyph buttons - which is the one thing in a borderless bridge that still reads as a panel.
         Same values as Bg2 / BorderSoft everywhere else. -->
    <SolidColorBrush x:Key="ChipFill" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="ChipOutline" Color="#2C2D32" />
    <!-- A message from ANOTHER AGENT (peer message / manager work order). It arrives as a user turn, so without its
         own surface it is the same grey bubble as the human's prompts and reads as something the user said. Cool
         indigo: clearly not Bg2, and distinct from Accent so it does not compete with selection and focus. -->
    <SolidColorBrush x:Key="AgentMsgBg" Color="#22252F" />
    <SolidColorBrush x:Key="AgentMsgBorder" Color="#3A4260" />
    <SolidColorBrush x:Key="AgentMsgRail" Color="#6E7FC4" />
    <SolidColorBrush x:Key="AgentMsgHeader" Color="#9AA8DC" />
    <SolidColorBrush x:Key="Text" Color="#ECEDF1" />
    <SolidColorBrush x:Key="Muted" Color="#9EA0A8" />
    <SolidColorBrush x:Key="Faint" Color="#6C6E77" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#244C8DF5" />
    <SolidColorBrush x:Key="AccentDim" Color="#664C8DF5" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Green" Color="#7ED0A6" />
    <SolidColorBrush x:Key="GreenSoft" Color="#1E7ED0A6" />
    <SolidColorBrush x:Key="Red" Color="#E86A78" />
    <SolidColorBrush x:Key="RedSoft" Color="#22E86A78" />
    <SolidColorBrush x:Key="Amber" Color="#E0B24D" />
    <SolidColorBrush x:Key="AmberSoft" Color="#1FE0B24D" />
    <SolidColorBrush x:Key="Yellow" Color="#F5C542" />
    <SolidColorBrush x:Key="YellowSoft" Color="#22F5C542" />
    <SolidColorBrush x:Key="Blue" Color="#8FAEE6" />
    <SolidColorBrush x:Key="BlueSoft" Color="#1F8FAEE6" />

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C8DF5" Offset="0" />
        <GradientStop Color="#8B7CF6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5B96F7" Offset="0" />
        <GradientStop Color="#3B78D8" Offset="1" />
    </LinearGradientBrush>

    <!-- soft glow behind the home brand mark; the CLI theme maps this to a no-op (terminals don't glow) -->
    <DropShadowEffect x:Key="BrandGlow" Color="#4C8DF5" BlurRadius="44" ShadowDepth="0" Opacity="0.35" />
    <!-- bridge pane frame while that pane owns keyboard focus -->
    <SolidColorBrush x:Key="PaneFocusBorder" Color="#664C8DF5" />

    <!-- chat status dots: always blue; the normal one follows its pane while the sidebar variant can
         aggregate work from every pane in a live bridge. -->
    <Style x:Key="StatusDotBase" TargetType="Ellipse">
        <Setter Property="Fill" Value="{StaticResource Accent}" />
    </Style>
    <Style x:Key="StatusDot" TargetType="Ellipse" BasedOn="{StaticResource StatusDotBase}">
        <Style.Triggers>
            <!-- Demon Mode's one rule you can see from across the room: RED is the session you can type into, BLUE is
                 a read-only worker. Every other chat keeps the ordinary accent dot. -->
            <DataTrigger Binding="{Binding IsDemonOrchestrator}" Value="True">
                <Setter Property="Fill" Value="{StaticResource Red}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="StatusDotPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25"
                                             Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="StatusDotPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ChatListStatusDot" TargetType="Ellipse" BasedOn="{StaticResource StatusDotBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ChatListIsWorking}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="ChatListStatusDotPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25"
                                             Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="ChatListStatusDotPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- corner radii: windows reference these instead of literals so the CLI theme can square everything.
         Keys are named after THIS theme's value; the CLI theme maps them all to 0. -->
    <CornerRadius x:Key="Rad1">1</CornerRadius>
    <CornerRadius x:Key="Rad2">2</CornerRadius>
    <CornerRadius x:Key="Rad3">3</CornerRadius>
    <CornerRadius x:Key="Rad4">4</CornerRadius>
    <CornerRadius x:Key="Rad5">5</CornerRadius>
    <CornerRadius x:Key="Rad6">6</CornerRadius>
    <CornerRadius x:Key="Rad7">7</CornerRadius>
    <CornerRadius x:Key="Rad8">8</CornerRadius>
    <CornerRadius x:Key="Rad9">9</CornerRadius>
    <CornerRadius x:Key="Rad10">10</CornerRadius>
    <CornerRadius x:Key="Rad11">11</CornerRadius>
    <CornerRadius x:Key="Rad12">12</CornerRadius>
    <CornerRadius x:Key="Rad13">13</CornerRadius>
    <CornerRadius x:Key="Rad14">14</CornerRadius>
    <CornerRadius x:Key="Rad16">16</CornerRadius>
    <CornerRadius x:Key="Rad17">17</CornerRadius>
    <CornerRadius x:Key="Rad22">22</CornerRadius>
    <CornerRadius x:Key="Rad28">28</CornerRadius>
    <CornerRadius x:Key="Rad99">99</CornerRadius>
    <CornerRadius x:Key="Rad999">999</CornerRadius>
    <CornerRadius x:Key="RadBubble">14,14,4,14</CornerRadius>
    <!-- Bridge pane box and its header/composer bars. Their own keys, not Rad12, so borderless can square the
         panes off into plain outlined regions without flattening every rounded control in the app. -->
    <CornerRadius x:Key="RadPane">12</CornerRadius>
    <CornerRadius x:Key="RadPaneTop">12,12,0,0</CornerRadius>
    <CornerRadius x:Key="RadPaneBottom">0,0,12,12</CornerRadius>
    <CornerRadius x:Key="RadTop12">12,12,0,0</CornerRadius>
    <CornerRadius x:Key="RadBottom12">0,0,12,12</CornerRadius>
    <CornerRadius x:Key="RadBottom10">0,0,10,10</CornerRadius>

    <!-- type. Each stack ends in "VibeCode Linux Icons" - the compatibility font the Linux package installs,
         which carries the emoji this UI writes straight into strings (the crown beside the best model, the
         megaphone, the link). Windows never has that family, so it is skipped there and nothing changes; on
         Wine it is what stops those characters rendering as empty boxes. -->
    <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI, VibeCode Linux Icons</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI, VibeCode Linux Icons</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Cascadia Code, Consolas, VibeCode Linux Icons</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets, VibeCode Linux Icons</FontFamily>

    <!-- base text -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- section caption (small uppercase label) -->
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- fluent icon glyph -->
    <Style x:Key="Icon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ================= scrollbars ================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <!-- ScrollBar-mode Track ignores Thumb.MinHeight and calculates its own minimum as half
                                 this system metric. Feeding the minimum into Track prevents the rounded thumb from
                                 being arranged into a tiny slot and layout-clipped on very large transcripts. -->
                            <Track.Resources>
                                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</sys:Double>
                            </Track.Resources>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="th" Background="#3B3831" CornerRadius="4" Margin="2,2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="th" Property="Background" Value="#4C4941" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Resources>
                                        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</sys:Double>
                                    </Track.Resources>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="th" Background="#3B3831" CornerRadius="4" Margin="2,2" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="th" Property="Background" Value="#4C4941" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= buttons ================= -->
    <Style x:Key="BaseButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#4A4740" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg1}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource BaseButton}" />

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3B78D8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{StaticResource Red}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#55E0808B" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RedSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 30x30 square ghost icon button (chat header, panel actions) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhostToggle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- titlebar window buttons -->
    <Style x:Key="TitlebarButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TitlebarClose" TargetType="Button" BasedOn="{StaticResource TitlebarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- segmented pill tab -->
    <Style x:Key="PillTab" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= inputs ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- read-only code block -->
    <Style x:Key="CodeBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource CodeBg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <!-- scroll the code box internally, then hand the wheel off to the page at its top/bottom edge -->
        <Setter Property="ui:WheelForward.AtBoundary" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- combo box. WPF's stock ComboBox and its drop-down popup are light-themed (white field, white popup with
         near-invisible grey text), which is what left the "Add MCP server" pickers as unreadable white boxes.
         This gives every UNSTYLED ComboBox the same dark input treatment the TextBox above gets. Windows that
         ship a bespoke picker (the account manager's AccountProviderPicker, Settings' SoundPicker) keep their
         own keyed Style, and their explicit ItemContainerStyle overrides the implicit ComboBoxItem below, so
         they are unaffected. No editable combo boxes exist in the app, so the template omits PART_EditableTextBox. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="opt" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Rad8}"
                            Padding="{TemplateBinding Padding}" Margin="4,2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="opt" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="opt" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="picker" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="box" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource Rad10}">
                                        <Border HorizontalAlignment="Right" Width="32" Background="Transparent">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                       Foreground="{StaticResource Faint}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="box" Property="Background" Value="{StaticResource Bg3}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="11,0,34,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,5,0,0" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource Rad10}">
                                <ScrollViewer Margin="2" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="picker" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= misc chrome ================= -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Overlay}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- popup surface with depth -->
    <Style x:Key="PopupCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- slim progress bar (neutral by default; usage bars override Foreground) -->
    <Style x:Key="SlimProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="{StaticResource CodeBg}" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- backdrop scrims (retuned at runtime from settings) -->
    <SolidColorBrush x:Key="ScrimHome" Color="#C821201C" />
    <!-- bridge shows more art than chat: the translucent glass panes carry their own readability floor,
         so the backdrop behind/between them can breathe. Retuned at runtime alongside the others. -->
    <SolidColorBrush x:Key="ScrimBridge" Color="#D021201C" />
    <SolidColorBrush x:Key="ScrimChat" Color="#EC21201C" />

    <!-- slider -->
    <Style x:Key="DimSlider" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="5" CornerRadius="3" Background="{StaticResource CodeBg}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent" Height="22">
                                                <Border Height="5" CornerRadius="3" Background="{StaticResource Accent}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent" Height="22" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="15" Height="15">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource Text}" Stroke="{StaticResource Accent}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- checkbox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="17" Height="17" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{StaticResource Border}" Background="{StaticResource Bg2}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                       Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- fade + rise entrance for chat items -->
    <Style x:Key="Appear" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         From="6" To="0" Duration="0:0:0.16">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============ right-click menus ============
         These live in the THEME dictionary rather than MainWindow's, because the menus we build in code -
         the editing menu every TextBox is handed by UI/TextEditMenu.cs, and the transcript range menu in
         UI/TranscriptSelection.cs - resolve their style through Application.Resources and cannot see a key
         declared inside a window. WPF's stock editing menu is a white Win32 popup, i.e. white text on white:
         Cut/Copy/Paste were invisible on every surface in this app. That is what these replace. -->
    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Rad7}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <!-- shortcut hint: an empty InputGestureText simply measures to nothing -->
                            <TextBlock x:Name="gesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource Faint}" FontSize="11" Margin="22,0,2,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                        </Trigger>
                        <!-- Cut/Paste go dim rather than vanishing when the command can't run -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Faint}" />
                            <Setter TargetName="gesture" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkMenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Overlay}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="{StaticResource Rad10}" Padding="4">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- thin dark separator for the dark context menus (WPF's default is a white line) -->
    <Style x:Key="DarkSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource BorderSoft}" Margin="6,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fill drawn behind messages picked out by a cross-message drag (UI/TranscriptSelection.cs). Same hue as
         the SelectionBrush a single message uses, so a selection that spills into the next message still reads
         as one selection rather than two different mechanisms. -->
    <SolidColorBrush x:Key="TranscriptSelectionFill" Color="#4C4C8DF5" />

</ResourceDictionary>
