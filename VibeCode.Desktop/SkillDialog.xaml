<Window x:Class="VibeCode.SkillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add skill" Icon="pack://application:,,,/VibeCode;component/Assets/logo.png"
        Width="640" Height="720" MinWidth="560" MinHeight="600"
        Background="{StaticResource Bg0}" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Ui}" FontSize="13" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Add skill" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="A skill is a folder of instructions (SKILL.md) that Claude Code and Codex load when a task calls for it."
                           Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,0,8,0"
                            Click="OnCancel" IsCancel="True" />
                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install skill" Padding="18,8"
                            Click="OnInstall" IsDefault="True" AutomationProperties.Name="Install skill" />
                </StackPanel>
                <TextBlock x:Name="InstallStatusText" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel MaxWidth="570">
                <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Find with AI" FontFamily="{StaticResource Display}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Name or describe the skill. The selected AI looks up where it is published and fills this form for you to review. It will not install or save anything."
                                   Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <TextBox x:Name="AiPromptBox" AcceptsReturn="True" MinHeight="58" MaxHeight="110"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                 AutomationProperties.Name="Describe skill for AI"
                                 ToolTip="Example: impeccable, the frontend design skill." />
                        <TextBlock Text="Example: impeccable, the frontend design skill."
                                   Foreground="{StaticResource Faint}" FontSize="10.5" Margin="2,5,0,11" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AI provider" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="2,0,0,5" />
                                <ComboBox x:Name="AiProviderBox" SelectedValuePath="Tag" SelectionChanged="OnAiProviderChanged"
                                          AutomationProperties.Name="Skill search AI provider">
                                    <ComboBoxItem Content="Claude Code" Tag="claude" />
                                    <ComboBoxItem Content="OpenAI Codex" Tag="codex" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Model" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="2,0,0,5" />
                                <ComboBox x:Name="AiModelBox" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          AutomationProperties.Name="Skill search AI model" />
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="AiGenerateButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                    Content="Find skill" Padding="15,7" Click="OnGenerateWithAi"
                                    AutomationProperties.Name="Find skill with AI" />
                            <TextBlock x:Name="AiWorkingText" Text="Searching for the skill…"
                                       Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                       Visibility="Collapsed" />
                        </DockPanel>
                        <ProgressBar x:Name="AiProgress" Height="3" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                        <Border x:Name="AiLogPanel" Background="{StaticResource Bg0}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" CornerRadius="{StaticResource Rad9}" Padding="10,7" Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <ScrollViewer x:Name="AiLogScroll" MaxHeight="84" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="AiLogText" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}"
                                           FontSize="10" TextWrapping="Wrap" AutomationProperties.Name="Skill AI activity log" />
                            </ScrollViewer>
                        </Border>
                        <Border x:Name="AiStatusPanel" Background="{StaticResource GreenSoft}"
                                CornerRadius="{StaticResource Rad9}" Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AiStatusText" Foreground="{StaticResource Green}" FontSize="10.5" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Source" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,0,0,6" />
                <TextBox x:Name="SourceBox" AutomationProperties.Name="Skill source" />
                <TextBlock Text="A GitHub repository such as https://github.com/owner/repository, a link to the skill's folder inside it, or a direct .zip or .skill link."
                           Foreground="{StaticResource Faint}" FontSize="10.5" TextWrapping="Wrap" Margin="2,5,0,15" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Folder in the source · optional" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,0,0,6" />
                        <TextBox x:Name="FolderBox" FontFamily="{StaticResource Mono}" AutomationProperties.Name="Skill folder in source" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Branch, tag or commit · optional" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,0,0,6" />
                        <TextBox x:Name="RefBox" FontFamily="{StaticResource Mono}" AutomationProperties.Name="Skill source ref" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="The folder that holds SKILL.md, like skills/frontend-design. Leave it empty and VibeCode finds the skill, giving Claude and Codex their own versions when the source ships one per agent. Empty ref means the default branch."
                           Foreground="{StaticResource Faint}" FontSize="10.5" TextWrapping="Wrap" Margin="2,5,0,15" />

                <TextBlock Text="Install for" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,0,0,8" />
                <WrapPanel>
                    <CheckBox x:Name="ClaudeCheck" Content="Claude" IsChecked="True" Margin="0,0,22,8" />
                    <CheckBox x:Name="CodexCheck" Content="Codex" IsChecked="True" Margin="0,0,22,8" />
                </WrapPanel>
                <TextBlock x:Name="TargetsText" Foreground="{StaticResource Faint}" FontSize="10.5" TextWrapping="Wrap" Margin="2,0,0,0" />

                <ProgressBar x:Name="InstallProgress" Height="3" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                <Border x:Name="ValidationPanel" Background="{StaticResource RedSoft}" CornerRadius="{StaticResource Rad9}"
                        Padding="11,8" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ValidationText" Foreground="{StaticResource Red}" TextWrapping="Wrap" FontSize="11.5" />
                </Border>
                <TextBlock Text="Only install skills you trust: a skill's instructions and bundled scripts guide the agent, and its scripts can run with the chat's permissions."
                           Foreground="{StaticResource Faint}" FontSize="10.5" TextWrapping="Wrap" Margin="2,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
