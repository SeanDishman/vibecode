<UserControl x:Class="VibeCode.UI.SpotifyVolumeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:VibeCode.Services"
             Width="20" Height="20" Background="Transparent" Focusable="False"
             DataContext="{x:Static svc:SpotifyService.Instance}"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid>
        <Button x:Name="VolumeButton" Width="20" Height="20" Cursor="Hand"
                FontFamily="{StaticResource Icons}" FontSize="10"
                IsEnabled="{Binding SupportsVolume}" ToolTip="{Binding VolumeTooltip}"
                AutomationProperties.Name="{Binding VolumeTooltip}"
                AutomationProperties.HelpText="Click to adjust volume. Double-click to mute or restore."
                Click="OnVolumeButtonClick"
                PreviewMouseLeftButtonDown="OnVolumeButtonPreviewMouseLeftButtonDown">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOpen, ElementName=VolumePopup}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SpotifyGreenHover}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Grid>
                <TextBlock Text="{Binding VolumeGlyph}" FontFamily="{StaticResource Icons}" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Height="2" Width="8" CornerRadius="{StaticResource Rad1}" Margin="0,0,0,2"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SpotifyGreenDim}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOpen, ElementName=VolumePopup}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SpotifyGreen}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Button>

        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}"
               Placement="Bottom" HorizontalOffset="-80" VerticalOffset="7"
               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False" Focusable="False">
            <Border Width="190" Padding="12,10,12,9" CornerRadius="{StaticResource Rad10}"
                    Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,7">
                        <Border DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,9,0"
                                CornerRadius="{StaticResource Rad6}"
                                Background="{StaticResource SpotifyGreenSoft}"
                                BorderBrush="#451DB954" BorderThickness="1">
                            <TextBlock Text="{Binding VolumeGlyph}" FontFamily="{StaticResource Icons}"
                                       FontSize="11" Foreground="{StaticResource SpotifyGreenHover}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeText}" Margin="10,0,0,0"
                                   FontFamily="{StaticResource Mono}" FontSize="10.5"
                                   Foreground="{StaticResource SpotifyGreenHover}"
                                   VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Device volume" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" />
                            <TextBlock Text="Spotify playback" Margin="0,1,0,0" FontSize="9.5"
                                       Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </DockPanel>

                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"
                            Value="{Binding VolumePercent, Mode=OneWay}"
                            IsEnabled="{Binding SupportsVolume}"
                            IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="10" TickFrequency="5"
                            Height="22" ToolTip="{Binding VolumeText}"
                            ValueChanged="OnVolumeSliderValueChanged">
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid Height="22" Margin="1,0">
                                    <Track x:Name="PART_Track"
                                           VerticalAlignment="Center"
                                           IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="4"
                                                                Background="{StaticResource SpotifyGreen}"
                                                                CornerRadius="{StaticResource Rad2}" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="14" Height="14" Focusable="False">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid>
                                                            <Ellipse Fill="{StaticResource Bg2}"
                                                                     Stroke="{StaticResource SpotifyGreenHover}"
                                                                     StrokeThickness="2" />
                                                            <Ellipse Width="4" Height="4"
                                                                     Fill="{StaticResource SpotifyGreen}" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="4"
                                                                Background="{StaticResource Bg4}"
                                                                CornerRadius="{StaticResource Rad2}" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>

                    <DockPanel Margin="1,1,1,0" LastChildFill="True">
                        <TextBlock Text="0" FontFamily="{StaticResource Mono}" FontSize="8.5"
                                   Foreground="{StaticResource Faint}" />
                        <TextBlock DockPanel.Dock="Right" Text="100"
                                   FontFamily="{StaticResource Mono}" FontSize="8.5"
                                   Foreground="{StaticResource Faint}" />
                        <TextBlock Text="Double-click speaker to mute"
                                   FontSize="8.5" Foreground="{StaticResource Faint}"
                                   HorizontalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
