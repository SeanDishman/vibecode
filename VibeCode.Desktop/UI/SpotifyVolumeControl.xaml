<UserControl x:Class="VibeCode.UI.SpotifyVolumeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:VibeCode.Services"
             Height="20" Background="Transparent" Focusable="False"
             DataContext="{x:Static svc:SpotifyService.Instance}"
             ToolTipService.ShowOnDisabled="True"
             PreviewMouseWheel="OnVolumeWheel"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!--
      Speaker + inline slider, the way Spotify's own player does it. This deliberately has NO Popup.

      The previous version opened a popup panel on click, and every interaction bug it had came from
      one fact: a Popup with StaysOpen="False" takes a SubTree mouse capture the instant it opens, so
      the NEXT press is delivered to the PopupRoot and never reaches the button. That made the button
      un-closable by clicking it again, and silently ate the second half of the double-click that the
      control's own tooltip advertised as the way to mute. Measured, not guessed: with the popup open,
      Mouse.Captured is the PopupRoot.

      With the slider inline there is nothing to open, nothing to capture, and nothing to toggle:
      click the speaker to mute, drag the slider to set volume, wheel anywhere over the control.
    -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="VolumeButton" Width="20" Height="20" Cursor="Hand"
                FontFamily="{StaticResource Icons}" FontSize="10"
                IsEnabled="{Binding SupportsVolume}"
                ToolTip="{Binding VolumeTooltip}"
                ToolTipService.ShowOnDisabled="True"
                AutomationProperties.Name="{Binding VolumeTooltip}"
                AutomationProperties.HelpText="Mutes or restores the Spotify device volume."
                Click="OnVolumeButtonClick">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SpotifyGreenDim}" />
                        </DataTrigger>
                        <!-- last, so hovering a muted speaker still lights up -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SpotifyGreenHover}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- No "active" underline like shuffle/repeat have: the glyph itself already swaps to the
                 crossed-out speaker, and an empty track is sitting right next to it saying the same
                 thing. Spotify's own volume button doesn't mark muted with an accent either. -->
            <TextBlock Text="{Binding VolumeGlyph}" FontFamily="{StaticResource Icons}" FontSize="10"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="58" Height="20"
                Margin="3,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                Value="{Binding VolumePercent, Mode=OneWay}"
                IsEnabled="{Binding SupportsVolume}"
                IsMoveToPointEnabled="True"
                SmallChange="1" LargeChange="10"
                ToolTip="{Binding VolumeText}"
                ToolTipService.ShowOnDisabled="True"
                AutomationProperties.Name="Spotify volume"
                ValueChanged="OnVolumeSliderValueChanged">
            <Slider.Template>
                <ControlTemplate TargetType="Slider">
                    <!-- Transparent background, not none: the wheel and move-to-point need the full
                         20px strip to be hit-testable, otherwise only the 4px track responds. -->
                    <Grid Background="Transparent" Height="20" Margin="1,0">
                        <!-- One continuous groove behind the Track. Without it the hidden thumb leaves a
                             10px hole punched through the middle of the bar, because Track lays the
                             decrease button, the thumb and the increase button out end to end. -->
                        <Border Height="4" VerticalAlignment="Center" Background="{StaticResource CodeBg}"
                                CornerRadius="{StaticResource Rad2}" />
                        <!-- Height pinned to the strip: a Track sizes itself to the Thumb (10px here), and
                             the full-height hit grids inside the repeat buttons would then overhang the
                             bottom, rendering the fill 5px below the groove as two stacked bars. -->
                        <Track x:Name="PART_Track" Height="20" VerticalAlignment="Center" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- Full-height transparent hit area, 4px of visible fill. The
                                                 fill overhangs by half a thumb so it runs under the knob
                                                 instead of stopping short of it. -->
                                            <Grid Background="Transparent" Height="20">
                                                <Border x:Name="fill" Height="4" Margin="0,0,-5,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource Muted}"
                                                        CornerRadius="{StaticResource Rad2}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <!-- Spotify greens the filled part when you're on the control,
                                                     not just when you're on the 4px track itself. -->
                                                <DataTrigger Value="True"
                                                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Setter TargetName="fill" Property="Background" Value="{StaticResource SpotifyGreen}" />
                                                </DataTrigger>
                                                <!-- Last, so it wins over the hover colour. At zero the
                                                     decrease button has no width, but the half-thumb
                                                     overhang would still paint a 5px nub at the far left.
                                                     Bound to IsMuted (a bool) rather than to Slider.Value:
                                                     a DataTrigger compares its literal Value against a
                                                     double without converting it, so "0" never matches 0.0
                                                     and the trigger silently never fires. -->
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter TargetName="fill" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <!-- Hidden until the pointer is on the control, again like Spotify. Opacity
                                     rather than Visibility so the thumb keeps its size and the track does
                                     not reflow the moment you hover it. -->
                                <Thumb x:Name="knob" Width="10" Height="10" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid x:Name="knobRoot" Opacity="0">
                                                <Ellipse Fill="{StaticResource Text}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Setter TargetName="knobRoot" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <!-- keep it visible while dragging even if the pointer
                                                     slips off the 20px strip mid-drag -->
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="knobRoot" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <!-- Transparent: the unfilled side is the groove drawn behind the whole Track.
                                 Still needs a Background or clicking the empty half hits nothing.
                                 (The groove uses CodeBg, not a "Bg4" - there is no such rung, the ladder
                                 tops out at Bg3/Overlay, and asking for one threw
                                 ResourceReferenceKeyNotFoundException in both themes.) -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="20" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Slider.Template>
        </Slider>
    </StackPanel>
</UserControl>
