<UserControl x:Class="VibeCode.UI.BridgeAgentOptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Ui}" FontSize="12" Foreground="{DynamicResource Text}"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="0,0,0,7" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MaxDropDownHeight" Value="280" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" MinWidth="94" /></Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="Orchestrator model" Target="{Binding ElementName=OrchestratorModelBox}" />
                <ComboBox x:Name="OrchestratorModelBox" DisplayMemberPath="Display" SelectionChanged="OnOrchestratorModelChanged"
                          AutomationProperties.Name="Orchestrator model" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Effort" Target="{Binding ElementName=OrchestratorEffortBox}" />
                <ComboBox x:Name="OrchestratorEffortBox" DisplayMemberPath="Label" SelectionChanged="OnChoiceChanged"
                          AutomationProperties.Name="Orchestrator reasoning effort" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="Review" Target="{Binding ElementName=OrchestratorReviewBox}" />
                <ComboBox x:Name="OrchestratorReviewBox" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectionChanged="OnChoiceChanged" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}"
                          AutomationProperties.Name="Orchestrator review level" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="OrchestratorEffortNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11"
                   Margin="0,6,0,0" Visibility="Collapsed" />
        <ToggleButton x:Name="OrchestratorFastModeToggle" HorizontalAlignment="Left" Margin="0,8,0,0"
                      MinHeight="36" Padding="8,6" FocusVisualStyle="{x:Null}"
                      Checked="OnFastModeChanged" Unchecked="OnFastModeChanged" ToolTipService.ShowOnDisabled="True"
                      AutomationProperties.Name="Orchestrator fast mode">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="FastModeBorder" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Lightning" Width="14" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M 8,0 L 0,10 L 6,10 L 4,18 L 14,7 L 8,7 Z" Fill="Transparent"
                                  Stroke="{DynamicResource Muted}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            <TextBlock x:Name="FastModeLabel" Text="Fast mode off" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Lightning" Property="Fill" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Lightning" Property="Stroke" Value="{DynamicResource Accent}" />
                            <Setter TargetName="FastModeLabel" Property="Text" Value="Fast mode on" />
                            <Setter TargetName="FastModeLabel" Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FastModeBorder" Property="Background" Value="{DynamicResource Bg2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FastModeBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FastModeBorder" Property="Opacity" Value="0.5" />
                            <Setter TargetName="FastModeBorder" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <Label Content="Worker provider" Target="{Binding ElementName=WorkerProviderBox}" Margin="0,16,0,0" FontWeight="SemiBold" />
        <ComboBox x:Name="WorkerProviderBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="OnWorkerProviderChanged"
                  AutomationProperties.Name="Worker provider" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" MinWidth="94" /></Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="Worker model" Target="{Binding ElementName=WorkerModelBox}" />
                <ComboBox x:Name="WorkerModelBox" DisplayMemberPath="Display" SelectionChanged="OnWorkerModelChanged"
                          AutomationProperties.Name="Worker model" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Effort" Target="{Binding ElementName=WorkerEffortBox}" />
                <ComboBox x:Name="WorkerEffortBox" DisplayMemberPath="Label" SelectionChanged="OnChoiceChanged"
                          AutomationProperties.Name="Worker reasoning effort" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="Review" Target="{Binding ElementName=WorkerReviewBox}" />
                <ComboBox x:Name="WorkerReviewBox" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectionChanged="OnChoiceChanged" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}"
                          AutomationProperties.Name="Worker review level" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="WorkerEffortNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11"
                   Margin="0,6,0,0" Visibility="Collapsed" />
        <TextBlock Text="Review: None skips extra reviews · Low is quick · Normal is focused · High allows two passes."
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0" />
        <TextBlock Text="New workers use these settings. Each agent can be adjusted after launch." Foreground="{DynamicResource Muted}"
                   TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0" />
        <StackPanel x:Name="CentralFields" Visibility="Collapsed" Margin="0,20,0,0">
            <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,0,0,16" />
            <Label Content="Central planner" Target="{Binding ElementName=CentralProviderBox}" FontWeight="SemiBold" />
            <TextBlock Text="Divides the task between orchestrators, then leaves. Choose its provider and model independently."
                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <ComboBox x:Name="CentralProviderBox" DisplayMemberPath="Label" SelectedValuePath="Id"
                      SelectionChanged="OnCentralProviderChanged" AutomationProperties.Name="Central planner provider" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="Model" Target="{Binding ElementName=CentralModelBox}" />
                    <ComboBox x:Name="CentralModelBox" DisplayMemberPath="Display" SelectionChanged="OnCentralModelChanged"
                              AutomationProperties.Name="Central planner model" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="Effort" Target="{Binding ElementName=CentralEffortBox}" />
                    <ComboBox x:Name="CentralEffortBox" DisplayMemberPath="Label" SelectionChanged="OnChoiceChanged"
                              AutomationProperties.Name="Central planner reasoning effort" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="CentralEffortNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</UserControl>
