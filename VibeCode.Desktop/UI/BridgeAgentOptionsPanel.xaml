<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VibeCode.UI.BridgeAgentOptionsPanel" FontFamily="{DynamicResource Ui}" FontSize="12" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="0,0,0,7"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="164"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="94"/></Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="3">
                <Label Content="Orchestrator model" Target="{Binding ElementName=OrchestratorModelBox}"/>
                <ComboBox x:Name="OrchestratorModelBox" DisplayMemberPath="Display" SelectionChanged="OnOrchestratorModelChanged" AutomationProperties.Name="Orchestrator model"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Label Content="Effort" Target="{Binding ElementName=OrchestratorEffortBox}"/>
                <DockPanel LastChildFill="True">
                    <ToggleButton x:Name="OrchestratorUltrafastModeToggle" Tag="ultrafast" DockPanel.Dock="Right" MinHeight="36" FocusVisualStyle="{x:Null}" Visibility="Collapsed" Checked="OnFastModeChanged" Unchecked="OnFastModeChanged" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Orchestrator Ultrafast mode" Style="{StaticResource SpeedModeToggle}" Content="⚡⚡"/>
                    <ToggleButton x:Name="OrchestratorFastModeToggle" DockPanel.Dock="Right" MinHeight="36" FocusVisualStyle="{x:Null}" Checked="OnFastModeChanged" Unchecked="OnFastModeChanged" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Orchestrator fast mode" Style="{StaticResource SpeedModeToggle}" Content="⚡"/>
                    <ComboBox MinWidth="88" x:Name="OrchestratorEffortBox" DisplayMemberPath="Label" SelectionChanged="OnChoiceChanged" AutomationProperties.Name="Orchestrator reasoning effort"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                <Label Content="Review" Target="{Binding ElementName=OrchestratorReviewBox}"/>
                <ComboBox x:Name="OrchestratorReviewBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnChoiceChanged" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Orchestrator review level"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="OrchestratorEffortNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"/>
        <Label Content="Worker provider" Target="{Binding ElementName=WorkerProviderBox}" Margin="0,16,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="WorkerProviderBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="OnWorkerProviderChanged" AutomationProperties.Name="Worker provider"/>
        <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="164"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="94"/></Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="3">
                <Label Content="Worker model" Target="{Binding ElementName=WorkerModelBox}"/>
                <ComboBox x:Name="WorkerModelBox" DisplayMemberPath="Display" SelectionChanged="OnWorkerModelChanged" AutomationProperties.Name="Worker model"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Label Content="Effort" Target="{Binding ElementName=WorkerEffortBox}"/>
                <DockPanel LastChildFill="True">
                    <ToggleButton x:Name="WorkerUltrafastModeToggle" Tag="ultrafast" DockPanel.Dock="Right" MinHeight="36" FocusVisualStyle="{x:Null}" Visibility="Collapsed" Checked="OnFastModeChanged" Unchecked="OnFastModeChanged" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Worker Ultrafast mode" Style="{StaticResource SpeedModeToggle}" Content="⚡⚡"/>
                    <ComboBox MinWidth="88" x:Name="WorkerEffortBox" DisplayMemberPath="Label" SelectionChanged="OnChoiceChanged" AutomationProperties.Name="Worker reasoning effort"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                <Label Content="Review" Target="{Binding ElementName=WorkerReviewBox}"/>
                <ComboBox x:Name="WorkerReviewBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnChoiceChanged" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Worker review level"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="WorkerEffortNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"/>
        <TextBlock Text="Review: None skips extra reviews · Low is quick · Normal is focused · High allows two passes." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
        <TextBlock Text="New workers use these settings. Each agent can be adjusted after launch." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
        <StackPanel x:Name="CentralFields" Visibility="Collapsed" Margin="0,20,0,0">
            <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,0,0,16"/>
            <Label Content="Central planner" Target="{Binding ElementName=CentralProviderBox}" FontWeight="SemiBold"/>
            <TextBlock Text="Divides the task between orchestrators, then leaves. Choose its provider and model independently." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ComboBox x:Name="CentralProviderBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="OnCentralProviderChanged" AutomationProperties.Name="Central planner provider"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="164"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="Model" Target="{Binding ElementName=CentralModelBox}"/>
                    <ComboBox x:Name="CentralModelBox" DisplayMemberPath="Display" SelectionChanged="OnCentralModelChanged" AutomationProperties.Name="Central planner model"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="Effort" Target="{Binding ElementName=CentralEffortBox}"/>
                    <DockPanel LastChildFill="True">
                        <ToggleButton x:Name="CentralUltrafastModeToggle" Tag="ultrafast" DockPanel.Dock="Right" MinHeight="36" FocusVisualStyle="{x:Null}" Visibility="Collapsed" Checked="OnFastModeChanged" Unchecked="OnFastModeChanged" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Central planner Ultrafast mode" Style="{StaticResource SpeedModeToggle}" Content="⚡⚡"/>
                        <ToggleButton x:Name="CentralFastModeToggle" DockPanel.Dock="Right" MinHeight="36" FocusVisualStyle="{x:Null}" Checked="OnFastModeChanged" Unchecked="OnFastModeChanged" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Central planner fast mode" Style="{StaticResource SpeedModeToggle}" Content="⚡"/>
                        <ComboBox MinWidth="88" x:Name="CentralEffortBox" DisplayMemberPath="Label" SelectionChanged="OnChoiceChanged" AutomationProperties.Name="Central planner reasoning effort"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="CentralEffortNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </StackPanel>
</UserControl>