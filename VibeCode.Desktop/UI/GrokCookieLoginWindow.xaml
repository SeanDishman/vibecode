<Window x:Class="VibeCode.UI.GrokCookieLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Grok sign-in - VibeCode" Width="960" Height="720" MinWidth="720" MinHeight="520"
        Background="#0B0D10" Foreground="#F2F4F8" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#15191F" BorderBrush="#313740" BorderThickness="0,0,0,1" Padding="18,13">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancel" Padding="14,7"
                        Margin="18,0,0,0" MinWidth="82" Background="#20252D"
                        Foreground="#F2F4F8" BorderBrush="#3B434E" />
                <StackPanel>
                    <TextBlock Text="Signing in to Grok with your pasted session" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Cookies stay in this temporary browser profile and are cleared after the official xAI OAuth exchange."
                               Foreground="#9AA4B2" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="BrowserView" DefaultBackgroundColor="#0B0D10" />
            <Border x:Name="LoadingOverlay" Background="#F20B0D10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <ProgressBar IsIndeterminate="True" Height="3" Width="260" Margin="0,0,0,18" />
                    <TextBlock x:Name="LoadingText" Text="Preparing a private xAI sign-in window..."
                               FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="Only cookies for grok.com and x.ai are accepted. Values are never shown in VibeCode."
                               Foreground="#9AA4B2" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
