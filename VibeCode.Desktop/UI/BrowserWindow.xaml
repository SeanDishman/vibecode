<Window x:Class="VibeCode.UI.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="VibeCode Browser" Width="1180" Height="780" MinWidth="720" MinHeight="480"
        Background="#0B0D10" Foreground="#F2F4F8" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#171A20" />
            <Setter Property="Foreground" Value="#D9DEE8" />
            <Setter Property="BorderBrush" Value="#2A303A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101319" BorderBrush="#242A34" BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Content="←" Style="{StaticResource ToolbarButton}"
                        ToolTip="Back" Click="OnBack" />
                <Button x:Name="ForwardButton" Grid.Column="1" Content="→" Style="{StaticResource ToolbarButton}"
                        ToolTip="Forward" Click="OnForward" />
                <Button x:Name="ReloadButton" Grid.Column="2" Content="↻" Style="{StaticResource ToolbarButton}"
                        ToolTip="Reload" Click="OnReload" />

                <TextBox x:Name="AddressBox" Grid.Column="3" Height="32" Padding="10,5"
                         Background="#090B0F" Foreground="#EEF1F6" BorderBrush="#303846"
                         BorderThickness="1" VerticalContentAlignment="Center"
                         KeyDown="OnAddressKeyDown" />

                <Border Grid.Column="4" Margin="10,0,0,0" Padding="9,5" CornerRadius="5"
                        Background="#172A22" BorderBrush="#28553E" BorderThickness="1">
                    <TextBlock Text="Agent browser" Foreground="#73D49B" FontSize="12"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="BrowserView" DefaultBackgroundColor="#0B0D10" />
            <Border x:Name="LoadingOverlay" Background="#E60B0D10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Connecting browser…" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadingDetail" Text="Starting the secure WebView runtime"
                               Foreground="#939CAA" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
