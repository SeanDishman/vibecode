<UserControl x:Class="VibeCode.UI.StartupOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="False"
             IsHitTestVisible="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             AutomationProperties.Name="VibeCode is starting">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="StartupProgressFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#875DFF" Offset="0" />
            <GradientStop Color="#596CFF" Offset="0.48" />
            <GradientStop Color="#249BFF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="StartupProgressStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource StartupProgressFill}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Rad3}"
                                ClipToBounds="True">
                            <Grid x:Name="PART_Indicator"
                                  HorizontalAlignment="Left"
                                  ClipToBounds="True">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="{StaticResource Rad3}" />
                                <Rectangle Width="72" HorizontalAlignment="Right" Opacity="0.45">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#DFFFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="#0A0B11" ClipToBounds="True">
        <!-- Layered radial light keeps the splash dimensional without decoding another large backdrop. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.12,0.08"
                                     GradientOrigin="0.12,0.08"
                                     RadiusX="0.78"
                                     RadiusY="0.92">
                    <GradientStop Color="#342A1F78" Offset="0" />
                    <GradientStop Color="#17183354" Offset="0.42" />
                    <GradientStop Color="#000A0B11" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.92,0.9"
                                     GradientOrigin="0.92,0.9"
                                     RadiusX="0.72"
                                     RadiusY="0.78">
                    <GradientStop Color="#2A075B9A" Offset="0" />
                    <GradientStop Color="#10102A45" Offset="0.5" />
                    <GradientStop Color="#000A0B11" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Quiet framing lines echo an editor canvas instead of competing with the brand. -->
        <Border Margin="34"
                BorderBrush="#0BFFFFFF"
                BorderThickness="1"
                CornerRadius="{StaticResource Rad28}"
                IsHitTestVisible="False" />
        <Grid Margin="58" IsHitTestVisible="False" Opacity="0.7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <Ellipse DockPanel.Dock="Left"
                         Width="5"
                         Height="5"
                         Fill="#785DFF"
                         Margin="0,0,9,0"
                         VerticalAlignment="Center" />
                <TextBlock Text="VIBECODE / STARTUP"
                           FontFamily="{StaticResource Mono}"
                           FontSize="9.5"
                           Foreground="#68708C" />
            </DockPanel>
            <TextBlock Grid.Row="2"
                       Text="LOCAL WORKSPACE"
                       HorizontalAlignment="Right"
                       FontFamily="{StaticResource Mono}"
                       FontSize="9.5"
                       Foreground="#4D5369" />
        </Grid>

        <Border Width="520"
                Padding="54,42,54,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#E90F1119"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="{StaticResource Rad28}">
            <Border.Effect>
                <DropShadowEffect Color="#05060B"
                                  BlurRadius="54"
                                  ShadowDepth="18"
                                  Opacity="0.72" />
            </Border.Effect>

            <StackPanel>
                <Grid Width="154" Height="142" HorizontalAlignment="Center">
                    <Ellipse x:Name="LogoGlow" Width="150" Height="150" Opacity="0.38">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#6E5D72FF" Offset="0" />
                                <GradientStop Color="#225B78FF" Offset="0.48" />
                                <GradientStop Color="#005B78FF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="128"
                             Height="128"
                             Stroke="#345D72FF"
                             StrokeThickness="1"
                             StrokeDashArray="1,7"
                             StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LogoOrbitRotation" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Image x:Name="BrandLogo"
                           Width="112"
                           Height="112"
                           Source="pack://application:,,,/VibeCode;component/Assets/logo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0.5,0.5"
                           AutomationProperties.Name="VibeCode logo">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="LogoFloat" />
                        </Image.RenderTransform>
                    </Image>
                </Grid>

                <TextBlock Text="VibeCode"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           FontFamily="{StaticResource Display}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#F6F7FB" />
                <TextBlock Text="Your AI workspace is getting ready"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           FontSize="12.5"
                           Foreground="#8D93A8" />

                <Grid Margin="0,31,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="StartupStepText"
                                   DockPanel.Dock="Right"
                                   Text="00 / 04"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="9.5"
                                   Foreground="#717991" />
                        <TextBlock Text="PREPARING WORKSPACE"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="9.5"
                                   Foreground="#717991" />
                    </DockPanel>

                    <ProgressBar x:Name="StartupProgress"
                                 Grid.Row="1"
                                 Value="6"
                                 Style="{StaticResource StartupProgressStyle}"
                                 AutomationProperties.Name="Startup progress" />

                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="StartupPercentText"
                                   DockPanel.Dock="Right"
                                   Text="6%"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="10.5"
                                   Foreground="#8991A8"
                                   Margin="16,0,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ActivityDot"
                                     Width="6"
                                     Height="6"
                                     Fill="#6578FF"
                                     Margin="0,0,9,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StartupStatusText"
                                       Text="Starting VibeCode…"
                                       FontSize="11.5"
                                       Foreground="#AFB4C5"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       AutomationProperties.Name="Startup status"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <Border Height="1" Background="#13FFFFFF" Margin="0,28,0,18" />
                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{StaticResource Mono}"
                           FontSize="9.5"
                           Foreground="#525A70">
                    <Run Text="CODEX" />
                    <Run Text="  •  " Foreground="#343A4B" />
                    <Run Text="CLAUDE" />
                    <Run Text="  •  " Foreground="#343A4B" />
                    <Run Text="KIMI" />
                    <Run Text="  •  " Foreground="#343A4B" />
                    <Run Text="GROK" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LogoOrbitRotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="0"
                                     To="360"
                                     Duration="0:0:14"
                                     RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="LogoFloat"
                                     Storyboard.TargetProperty="Y"
                                     From="2"
                                     To="-3"
                                     Duration="0:0:1.8"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.32"
                                     To="0.66"
                                     Duration="0:0:1.8"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ActivityDot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.35"
                                     To="1"
                                     Duration="0:0:0.72"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
