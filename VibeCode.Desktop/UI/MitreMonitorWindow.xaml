<Window x:Class="VibeCode.UI.MitreMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VibeCode · MITRE ATT&amp;CK" Icon="pack://application:,,,/VibeCode;component/Assets/logo.png"
        Width="1040" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource Ui}" FontSize="13" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnWindowSizeChanged" Closed="OnClosed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <ControlTemplate x:Key="AgentSessionDetailsTemplate" TargetType="Expander">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <DockPanel x:Name="RuntimeLine" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource Icons}" Foreground="{DynamicResource Accent}" Margin="0,2,8,0" />
                        <TextBlock Text="{Binding Activity}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Text}" AutomationProperties.Name="Runtime activity" />
                    </DockPanel>
                    <TextBlock x:Name="TokenTotal" Grid.Column="1" Text="{Binding TokensText}" FontFamily="{DynamicResource Mono}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource Text}"
                               ToolTip="Total tokens used by this chat across all turns. Updates as the runtime reports usage. A dash means usage has not been reported yet."
                               AutomationProperties.Name="Total tokens used by this chat" />
                    <ToggleButton x:Name="DetailsToggle" Grid.Column="2" Style="{DynamicResource GhostToggle}" Padding="6,3"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  AutomationProperties.Name="Session details">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailsChevron" Text="&#xE76C;" FontFamily="{DynamicResource Icons}" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <ContentPresenter x:Name="DetailsContent" Grid.Row="1" ContentSource="Content" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="DetailsContent" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DetailsChevron" Property="Text" Value="&#xE70D;" />
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.CompactCards, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="RuntimeLine" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TokenTotal" Property="Grid.Column" Value="0" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Bg0}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0,8,0">
                    <Button DockPanel.Dock="Right" Click="OnClose" Style="{DynamicResource IconButton}" Width="36" Height="30"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close dashboard · reporting continues"
                            Content="&#xE8BB;" FontFamily="{DynamicResource Icons}" AutomationProperties.Name="Close activity dashboard" />
                    <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Click="OnMaximize" Style="{DynamicResource IconButton}" Width="36" Height="30"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Full screen (F11)"
                            Content="&#xE740;" FontFamily="{DynamicResource Icons}" AutomationProperties.Name="Toggle full screen" />
                    <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Click="OnMinimize" Style="{DynamicResource IconButton}" Width="36" Height="30"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize dashboard"
                            Content="&#xE921;" FontFamily="{DynamicResource Icons}" AutomationProperties.Name="Minimize dashboard" />
                    <ToggleButton x:Name="PinToggle" DockPanel.Dock="Right" Style="{DynamicResource IconToggle}" Width="36" Height="30"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Checked="OnPinChanged" Unchecked="OnPinChanged"
                                  ToolTip="Keep on top" Content="&#xE840;" FontFamily="{DynamicResource Icons}" AutomationProperties.Name="Keep dashboard on top" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource Icons}" Foreground="{DynamicResource Accent}" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="VIBECODE" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text=" /  AGENTS" Foreground="{DynamicResource Muted}" FontSize="11" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="24,0,24,0" MaxWidth="{Binding ContentMaxWidth}" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="8,22,8,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MITRE ATT&amp;CK" FontSize="30" FontWeight="SemiBold" FontFamily="{DynamicResource Display}" />
                            <TextBlock Text="Live agent activity" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" FontSize="14" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="22,0,24,0"><TextBlock Text="{Binding WorkingCount}" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource Green}" /><TextBlock Text="Working" Style="{StaticResource Eyebrow}" /></StackPanel>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="24,0,0,0"><StackPanel><TextBlock Text="{Binding AgentCount}" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="Agents" Style="{StaticResource Eyebrow}" /></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" VerticalAlignment="Top" Visibility="{Binding EmptyVisibility}" Margin="8,0" Padding="40,46" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" AutomationProperties.Name="No Codex sessions">
                        <StackPanel>
                            <TextBlock Text="Ready when you are" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="Open a Codex chat to see its activity here." FontSize="15" Margin="0,12,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                            <TextBlock Text="Reports begin on each chat’s next turn and continue while this dashboard is closed." Margin="0,24,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Grid x:Name="CardsViewport" Grid.Row="1" SizeChanged="OnWindowSizeChanged">
                    <ScrollViewer x:Name="AgentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AgentCards" ItemsSource="{Binding PageAgents}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="AgentCard" Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0,8,16"
                                        Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Grid x:Name="CardHeader" Margin="20,18,20,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CardTitle" Text="{Binding TaskTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding TaskTitle}" AutomationProperties.Name="AI task summary" />
                                            <TextBlock x:Name="CardDetail" Grid.Column="1" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="16,0" MaxWidth="210" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                            <Border Grid.Column="2" Background="{DynamicResource Bg3}" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Muted}" /><Style.Triggers><DataTrigger Binding="{Binding Working}" Value="True"><Setter Property="Fill" Value="{DynamicResource Green}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Blocked"><Setter Property="Fill" Value="{DynamicResource Red}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Waiting"><Setter Property="Fill" Value="{DynamicResource Accent}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border x:Name="ActivityPanel" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="20,18,20,16">
                                            <StackPanel>
                                                <TextBlock x:Name="ActivityHeadline" Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="Reported current activity" />
                                                <Border x:Name="ToolPanel" Background="{DynamicResource Bg0}" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Border Background="{DynamicResource Green}" CornerRadius="1" />
                                                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                                            <TextBlock Text="CURRENT TOOL" Style="{StaticResource Eyebrow}" />
                                                            <TextBlock x:Name="ToolText" Text="{Binding CurrentTool}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Current tool in use" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="StepPanel" Background="{DynamicResource Bg0}" CornerRadius="7" Padding="12,10">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Border Background="{DynamicResource Accent}" CornerRadius="1" />
                                                        <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="CURRENT STEP" Style="{StaticResource Eyebrow}" /><TextBlock x:Name="StepText" Text="{Binding Step}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="TacticsPanel" Margin="20,0,20,16">
                                            <DockPanel x:Name="TacticHeading" Margin="0,0,0,8"><TextBlock x:Name="StageText" Text="{Binding Stage}" Foreground="{DynamicResource Accent}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /></DockPanel>
                                            <ItemsControl ItemsSource="{Binding Tactics}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding DataContext.TacticColumns, RelativeSource={RelativeSource AncestorType=Window}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="TacticCell" Margin="0,0,5,5" Padding="5,9" CornerRadius="6" BorderThickness="1" ToolTip="{Binding Description}">
                                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Bg2}" /><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                            <TextBlock x:Name="TacticLabel" Text="{Binding Label}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.CompactCards, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter TargetName="TacticCell" Property="Padding" Value="3,4" />
                                                                <Setter TargetName="TacticCell" Property="Margin" Value="0,0,4,2" />
                                                                <Setter TargetName="TacticLabel" Property="FontSize" Value="10.5" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Border x:Name="CardFooter" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
                                                <Expander x:Name="SessionDetails" Template="{StaticResource AgentSessionDetailsTemplate}" Foreground="{DynamicResource Muted}" FontSize="12" Header="Session details" HorizontalContentAlignment="Stretch">
                                                    <StackPanel Margin="0,12,0,0">
                                                        <TextBlock x:Name="CompactRuntime" Text="{Binding Activity}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding LastOperation}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding AccessSummary}" TextWrapping="Wrap" ToolTip="{Binding AccessDetail}" AutomationProperties.Name="Session access policy" />
                                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"><Run Text="MITRE ATT&amp;CK · " /><Run Text="{Binding TacticName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TacticId, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding ReportLabel}" Margin="0,8,0,0" FontSize="11" />
                                                        <TextBlock Text="{Binding TelemetryDetail}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Expander>
                                        </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasCurrentTool}" Value="False">
                                        <Setter TargetName="ToolPanel" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.CompactCards, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="CardHeader" Property="Margin" Value="14,8,14,8" />
                                        <Setter TargetName="CardTitle" Property="FontSize" Value="15" />
                                        <Setter TargetName="CardTitle" Property="TextWrapping" Value="NoWrap" />
                                        <Setter TargetName="CardTitle" Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter TargetName="CardDetail" Property="FontSize" Value="11" />
                                        <Setter TargetName="CardDetail" Property="Margin" Value="10,0" />
                                        <Setter TargetName="CardDetail" Property="MaxWidth" Value="170" />
                                        <Setter TargetName="ActivityPanel" Property="Padding" Value="14,8,14,8" />
                                        <Setter TargetName="ActivityHeadline" Property="FontSize" Value="16" />
                                        <Setter TargetName="ActivityHeadline" Property="Margin" Value="0,0,0,7" />
                                        <Setter TargetName="ToolPanel" Property="Padding" Value="10,6" />
                                        <Setter TargetName="ToolPanel" Property="Margin" Value="0,0,0,7" />
                                        <Setter TargetName="ToolText" Property="FontSize" Value="13" />
                                        <Setter TargetName="ToolText" Property="Margin" Value="0,3,0,0" />
                                        <Setter TargetName="StepPanel" Property="Padding" Value="10,6" />
                                        <Setter TargetName="StepText" Property="FontSize" Value="13" />
                                        <Setter TargetName="StepText" Property="Margin" Value="0,3,0,0" />
                                        <Setter TargetName="TacticsPanel" Property="Margin" Value="14,0,14,6" />
                                        <Setter TargetName="TacticHeading" Property="Margin" Value="0,0,0,4" />
                                        <Setter TargetName="StageText" Property="FontSize" Value="14" />
                                        <Setter TargetName="CardFooter" Property="Padding" Value="14,6,14,7" />
                                        <Setter TargetName="CompactRuntime" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="SessionDetails" Property="Margin" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    </Grid>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
                <DockPanel Margin="24,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="{Binding PagerVisibility}">
                        <Button Click="OnPreviousPage" IsEnabled="{Binding CanPreviousPage}" Content="&#xE76B;" FontFamily="{DynamicResource Icons}" Style="{DynamicResource IconButton}" Width="28" Height="28" ToolTip="Previous four agents" AutomationProperties.Name="Previous agent page" />
                        <TextBlock Text="{Binding PageLabel}" MinWidth="42" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        <Button Click="OnNextPage" IsEnabled="{Binding CanNextPage}" Content="&#xE76C;" FontFamily="{DynamicResource Icons}" Style="{DynamicResource IconButton}" Width="28" Height="28" ToolTip="Next four agents" AutomationProperties.Name="Next agent page" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" FontFamily="{DynamicResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Click="OnOpenLogs" Content="Event logs" Style="{DynamicResource GhostButton}" FontSize="11" Margin="12,0,16,0" Padding="8,3" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Text="Reporting continues with the dashboard closed · F11 full screen · Esc to restore" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
