<Window x:Class="VibeCode.UI.CodeViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Code" Height="720" Width="1040" MinHeight="320" MinWidth="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg0}" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" FontFamily="{DynamicResource Ui}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderSoft}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True" Margin="12,0,8,0">
                    <!-- close -->
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Click="OnClose" Style="{DynamicResource IconButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="34" Height="30"
                            ToolTip="Close" AutomationProperties.Name="Close code viewer"
                            Content="&#xE8BB;" FontFamily="{DynamicResource Icons}" FontSize="12" />
                    <!-- copy -->
                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Click="OnCopy" Style="{DynamicResource GhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,5" Margin="0,0,4,0"
                            VerticalAlignment="Center" ToolTip="Copy the file text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource Icons}" FontSize="12"
                                       Foreground="{DynamicResource Muted}" Margin="0,0,6,0" />
                            <TextBlock Text="Copy" FontSize="12" Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Click="OnSave" Style="{DynamicResource GhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,5" Margin="0,0,4,0"
                            Visibility="Collapsed" IsEnabled="False" VerticalAlignment="Center"
                            ToolTip="Save changes (Ctrl+S)" AutomationProperties.Name="Save file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource Icons}" FontSize="12"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,6,0" />
                            <TextBlock Text="Save" FontSize="12" Foreground="{DynamicResource Text}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditButton" DockPanel.Dock="Right" Click="OnEdit" Style="{DynamicResource GhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,5" Margin="0,0,4,0"
                            IsEnabled="False" VerticalAlignment="Center" ToolTip="Edit the current file"
                            AutomationProperties.Name="Edit file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource Icons}" FontSize="12"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,6,0" />
                            <TextBlock Text="Edit" FontSize="12" Foreground="{DynamicResource Text}" />
                        </StackPanel>
                    </Button>

                    <!-- diff stat -->
                    <TextBlock x:Name="TitleStat" DockPanel.Dock="Right" FontFamily="{DynamicResource Mono}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <!-- mode chip -->
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Bg2}" CornerRadius="{StaticResource Rad5}" Padding="7,2"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="TitleLang" Text="Text" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7C3;" FontFamily="{DynamicResource Icons}" FontSize="14"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TitleFile" Text="file" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TitleDir" Text="" FontSize="10"
                                   Foreground="{DynamicResource Faint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- code surface -->
            <Border Grid.Row="1" Background="{DynamicResource CodeBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="EditorErrorBanner" Grid.Row="0" Visibility="Collapsed" Margin="12,10,12,2" Padding="12,9"
                            Background="{DynamicResource RedSoft}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Rad5}">
                        <TextBlock x:Name="EditorErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                                   FontSize="12" AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                <RichTextBox x:Name="Code" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource Text}"
                             FontFamily="{DynamicResource Mono}" FontSize="12.5" Padding="8,8,24,16"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="False" AcceptsTab="False" SelectionBrush="{DynamicResource AccentDim}"
                             VerticalContentAlignment="Top" />
                <editor:TextEditor x:Name="Editor" Grid.Row="1" Visibility="Collapsed" TextChanged="OnEditorTextChanged"
                                   Background="Transparent" Foreground="{DynamicResource Text}"
                                   FontFamily="{DynamicResource Mono}" FontSize="12.5" Padding="8,8,24,16"
                                   BorderThickness="0" ShowLineNumbers="True" LineNumbersForeground="{DynamicResource Faint}"
                                   WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   AutomationProperties.Name="Code editor" />
                </Grid>
            </Border>

            <!-- status strip -->
            <Border Grid.Row="2" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderSoft}"
                    BorderThickness="0,1,0,0" Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FootMode" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Faint}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="FootInfo" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Mono}"
                               Foreground="{DynamicResource Faint}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
