<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VibeCode.UI.CentralPlannerPane" AutomationProperties.Name="Central orchestrator activity">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
        <Style x:Key="PlannerKeyboardFocus" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate>
                <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" Margin="-2" CornerRadius="2"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{DynamicResource GhostToggle}" HorizontalAlignment="Left" Padding="2,4" Foreground="{DynamicResource Text}" FocusVisualStyle="{StaticResource PlannerKeyboardFocus}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{TemplateBinding Header}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Chevron" Text="" FontFamily="{DynamicResource Icons}" FontSize="9" Margin="0,0,7,0" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"/>
                                    <ContentPresenter ContentSource="Header"/>
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LogText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource PlannerKeyboardFocus}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfacePane}" CornerRadius="{DynamicResource RadPane}" BorderBrush="{DynamicResource SurfaceOutline}" BorderThickness="1" Margin="5">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBar}" CornerRadius="{DynamicResource RadPaneTop}" BorderBrush="{DynamicResource SurfaceOutline}" BorderThickness="0,0,0,1" Padding="12,10">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Elapsed}" DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <TextBlock Text="Central orchestrator" FontWeight="SemiBold" FontSize="13"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Configuration}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Text}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <StackPanel>
                    <TextBox Style="{StaticResource LogText}" Text="{Binding Events, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Muted}" AutomationProperties.Name="Central orchestrator progress log"/>
                    <Expander Header="Thinking" IsExpanded="True" Margin="0,18,0,0" Visibility="{Binding HasThinking, Converter={StaticResource VisibleWhen}}">
                        <TextBox Style="{StaticResource LogText}" Text="{Binding Thinking, Mode=OneWay}" Margin="0,8,0,0" AutomationProperties.Name="Central orchestrator thinking"/>
                    </Expander>
                    <Expander Header="Assignments" IsExpanded="True" Margin="0,18,0,0" Visibility="{Binding HasOutput, Converter={StaticResource VisibleWhen}}">
                        <TextBox Style="{StaticResource LogText}" Text="{Binding Output, Mode=OneWay}" Margin="0,8,0,0" AutomationProperties.Name="Central orchestrator output"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="12,10" BorderBrush="{DynamicResource SurfaceOutline}" BorderThickness="0,1,0,0">
                <TextBlock Text="Temporary agent · Leaves after assigning the work" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"/>
            </Border>
        </Grid>
    </Border>
</UserControl>