<Window x:Class='VibeCode.UI.MemoryMapWindow'
        xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
        xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
        xmlns:ui='clr-namespace:VibeCode.UI'
        xmlns:shell='clr-namespace:System.Windows.Shell;assembly=PresentationFramework'
        Title='Second Brain' Icon='pack://application:,,,/VibeCode;component/Assets/logo.png'
        Width='1220' Height='780' MinWidth='900' MinHeight='580'
        WindowStartupLocation='CenterOwner' WindowStyle='None' ResizeMode='CanResize'
        Background='{DynamicResource Bg0}' FontFamily='{DynamicResource Ui}' FontSize='13'
        TextOptions.TextFormattingMode='Ideal' UseLayoutRounding='True' SnapsToDevicePixels='True'
        ShowInTaskbar='False' Loaded='OnLoaded' Closed='OnClosed' KeyDown='OnWindowKeyDown'>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight='44' GlassFrameThickness='0' ResizeBorderThickness='7' CornerRadius='0' />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key='BrainCard' TargetType='Border'>
            <Setter Property='Background' Value='{DynamicResource Bg1}' />
            <Setter Property='BorderBrush' Value='{DynamicResource BorderSoft}' />
            <Setter Property='BorderThickness' Value='1' />
            <Setter Property='CornerRadius' Value='{DynamicResource Rad12}' />
        </Style>
        <Style x:Key='Metric' TargetType='TextBlock'>
            <Setter Property='FontFamily' Value='{DynamicResource Display}' />
            <Setter Property='FontSize' Value='21' />
            <Setter Property='FontWeight' Value='SemiBold' />
            <Setter Property='Foreground' Value='{DynamicResource Text}' />
            <Setter Property='TextWrapping' Value='NoWrap' />
        </Style>
        <Style x:Key='TinyLabel' TargetType='TextBlock'>
            <Setter Property='FontSize' Value='9.5' />
            <Setter Property='FontWeight' Value='SemiBold' />
            <Setter Property='Foreground' Value='{DynamicResource Faint}' />
            <Setter Property='TextWrapping' Value='NoWrap' />
        </Style>
        <Style x:Key='LegendDot' TargetType='Ellipse'>
            <Setter Property='Width' Value='8' />
            <Setter Property='Height' Value='8' />
            <Setter Property='Margin' Value='0,0,8,0' />
            <Setter Property='VerticalAlignment' Value='Center' />
        </Style>
        <Style x:Key='TagPill' TargetType='Border'>
            <Setter Property='Background' Value='{DynamicResource Bg3}' />
            <Setter Property='BorderBrush' Value='{DynamicResource BorderSoft}' />
            <Setter Property='BorderThickness' Value='1' />
            <Setter Property='CornerRadius' Value='{DynamicResource Rad99}' />
            <Setter Property='Padding' Value='8,4' />
            <Setter Property='Margin' Value='0,0,5,5' />
        </Style>
    </Window.Resources>
    <Border BorderBrush='{DynamicResource Border}' BorderThickness='1'>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height='38' />
                <RowDefinition Height='40' />
                <RowDefinition Height='*' />
                <RowDefinition Height='26' />
            </Grid.RowDefinitions>
            <Border Grid.Row='0' Background='{DynamicResource Bg1}' BorderBrush='{DynamicResource BorderSoft}' BorderThickness='0,0,0,1'>
                <DockPanel Margin='12,0,6,0' LastChildFill='False'>
                    <StackPanel DockPanel.Dock='Left' Orientation='Horizontal' VerticalAlignment='Center'>
                        <TextBlock Text='&#x1F9E0;' FontFamily='Segoe UI Emoji' FontSize='13' VerticalAlignment='Center' TextWrapping='NoWrap' />
                        <TextBlock Text='Second Brain' FontWeight='SemiBold' FontSize='12' Foreground='{DynamicResource Text}' Margin='8,0,0,0' VerticalAlignment='Center' />
                        <Border Margin='10,0,0,0' Padding='7,2' CornerRadius='{DynamicResource Rad99}' Background='{DynamicResource Bg2}' BorderBrush='{DynamicResource BorderSoft}' BorderThickness='1' VerticalAlignment='Center'>
                            <StackPanel Orientation='Horizontal'>
                                <Ellipse Width='6' Height='6' Margin='0,0,6,0' VerticalAlignment='Center'>
                                    <Ellipse.Style>
                                        <Style TargetType='Ellipse'>
                                            <Setter Property='Fill' Value='{DynamicResource Faint}' />
                                            <Style.Triggers>
                                                <DataTrigger Binding='{Binding Service.IsOnline}' Value='True'><Setter Property='Fill' Value='{DynamicResource Green}' /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text='{Binding Service.StatusText}' Foreground='{DynamicResource Muted}' FontSize='10' TextWrapping='NoWrap' />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button DockPanel.Dock='Right' Click='OnClose' Style='{DynamicResource IconButton}' shell:WindowChrome.IsHitTestVisibleInChrome='True' Width='32' Height='28' ToolTip='Close second brain' Content='&#xE8BB;' FontFamily='{DynamicResource Icons}' FontSize='11' AutomationProperties.Name='Close second brain' />
                    <Button DockPanel.Dock='Right' Click='OnRefresh' Style='{DynamicResource IconButton}' shell:WindowChrome.IsHitTestVisibleInChrome='True' Width='32' Height='28' Margin='0,0,3,0' ToolTip='Refresh memory map' Content='&#xE72C;' FontFamily='{DynamicResource Icons}' FontSize='11' AutomationProperties.Name='Refresh memory map' />
                    <Button DockPanel.Dock='Right' Click='OnForgetEverything' Style='{DynamicResource IconButton}' shell:WindowChrome.IsHitTestVisibleInChrome='True' Width='32' Height='28' Margin='0,0,3,0' Foreground='{DynamicResource Red}' ToolTip='Delete all memories - erases every stored memory, session, and observation. Cannot be undone.' Content='&#xE74D;' FontFamily='{DynamicResource Icons}' FontSize='12' AutomationProperties.Name='Delete all memories' />
                    <!-- Master switch. Off is not cosmetic: capture, recall, and the memory_save MCP proxy all stop. -->
                    <ToggleButton DockPanel.Dock='Right' Style='{DynamicResource GhostToggle}' Padding='8,3' Margin='0,0,8,0'
                                  shell:WindowChrome.IsHitTestVisibleInChrome='True' VerticalAlignment='Center'
                                  IsChecked='{Binding Service.MemoryEnabled, Mode=TwoWay}'
                                  ToolTip='{Binding Service.MemoryStateText}'
                                  AutomationProperties.Name='Agent memory master switch'>
                        <StackPanel Orientation='Horizontal'>
                            <Ellipse Width='7' Height='7' Margin='0,0,7,0' VerticalAlignment='Center'>
                                <Ellipse.Style>
                                    <Style TargetType='Ellipse'>
                                        <Setter Property='Fill' Value='{DynamicResource Red}' />
                                        <Style.Triggers>
                                            <DataTrigger Binding='{Binding Service.MemoryEnabled}' Value='True'><Setter Property='Fill' Value='{DynamicResource Green}' /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text='{Binding Service.MemoryToggleText}' FontSize='11' VerticalAlignment='Center' TextWrapping='NoWrap' />
                        </StackPanel>
                    </ToggleButton>
                </DockPanel>
            </Border>
            <Border Grid.Row='1' Background='{DynamicResource Bg0}' BorderBrush='{DynamicResource BorderSoft}' BorderThickness='0,0,0,1'>
                <DockPanel Margin='12,0,6,0' LastChildFill='False'>
                    <Grid DockPanel.Dock='Left' Width='330' VerticalAlignment='Center'>
                        <TextBox x:Name='SearchBox' Height='28' Padding='30,4,26,4' FontSize='12' VerticalContentAlignment='Center'
                                 ToolTip='Search every mapped memory: prompts, replies, files, projects, errors. Enter zooms to the matches.'
                                 TextChanged='OnSearchChanged' KeyDown='OnSearchKeyDown' AutomationProperties.Name='Search memories' />
                        <TextBlock Text='&#xE721;' FontFamily='{DynamicResource Icons}' FontSize='11' Foreground='{DynamicResource Faint}' Margin='11,0,0,0' HorizontalAlignment='Left' VerticalAlignment='Center' IsHitTestVisible='False' />
                        <TextBlock Text='Search memories' Foreground='{DynamicResource Faint}' FontSize='12' Margin='31,0,0,0'
                                   HorizontalAlignment='Left' VerticalAlignment='Center' IsHitTestVisible='False'>
                            <TextBlock.Style>
                                <Style TargetType='TextBlock'>
                                    <Setter Property='Visibility' Value='Collapsed' />
                                    <Style.Triggers>
                                        <DataTrigger Binding='{Binding Text, ElementName=SearchBox}' Value=''><Setter Property='Visibility' Value='Visible' /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid HorizontalAlignment='Right' VerticalAlignment='Center'>
                            <Grid.Style>
                                <Style TargetType='Grid'>
                                    <Setter Property='Visibility' Value='Visible' />
                                    <Style.Triggers>
                                        <DataTrigger Binding='{Binding Text, ElementName=SearchBox}' Value=''><Setter Property='Visibility' Value='Collapsed' /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Button Width='24' Height='24' Style='{DynamicResource IconButton}' Content='&#xE711;' FontFamily='{DynamicResource Icons}' FontSize='10' Foreground='{DynamicResource Faint}' Click='OnClearSearch' ToolTip='Clear search' AutomationProperties.Name='Clear memory search' />
                        </Grid>
                    </Grid>
                    <TextBlock DockPanel.Dock='Left' Text='{Binding SearchSummary}' Foreground='{DynamicResource Muted}' FontSize='10.5' VerticalAlignment='Center' Margin='12,0,0,0' TextWrapping='NoWrap' />
                    <StackPanel DockPanel.Dock='Right' Orientation='Horizontal' VerticalAlignment='Center'>
                        <Button Style='{DynamicResource IconButton}' Width='30' Height='28' Click='OnZoomOut' Content='&#xE738;' FontFamily='{DynamicResource Icons}' FontSize='11' ToolTip='Zoom out' AutomationProperties.Name='Zoom memory map out' />
                        <Button Style='{DynamicResource IconButton}' Width='30' Height='28' Click='OnFit' Content='&#xE9A6;' FontFamily='{DynamicResource Icons}' FontSize='11' ToolTip='Fit map' AutomationProperties.Name='Fit memory map' />
                        <Button Style='{DynamicResource IconButton}' Width='30' Height='28' Click='OnZoomIn' Content='&#xE710;' FontFamily='{DynamicResource Icons}' FontSize='11' ToolTip='Zoom in' AutomationProperties.Name='Zoom memory map in' />
                    </StackPanel>
                    <TextBlock DockPanel.Dock='Right' Text='{Binding GraphCaption}' Foreground='{DynamicResource Faint}' FontFamily='{DynamicResource Mono}' FontSize='9.5' VerticalAlignment='Center' Margin='0,0,12,0' TextWrapping='NoWrap' />
                </DockPanel>
            </Border>
            <Grid Grid.Row='2' Margin='8'>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width='166' /><ColumnDefinition Width='8' /><ColumnDefinition Width='*' />
                    <ColumnDefinition Width='Auto' />
                </Grid.ColumnDefinitions>
                <Border Grid.Column='0' Style='{StaticResource BrainCard}'>
                    <ScrollViewer VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Disabled'>
                        <StackPanel Margin='12'>
                            <TextBlock Text='MEMORY SIGNAL' Style='{DynamicResource Caption}' />
                            <Grid Margin='0,8,0,12'>
                                <Grid.ColumnDefinitions><ColumnDefinition Width='*' /><ColumnDefinition Width='*' /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column='0'><TextBlock Text='{Binding MemoryCountText}' Style='{StaticResource Metric}' /><TextBlock Text='REMEMBERED' Style='{StaticResource TinyLabel}' /></StackPanel>
                                <StackPanel Grid.Column='1'><TextBlock Text='{Binding SessionCountText}' Style='{StaticResource Metric}' /><TextBlock Text='SESSIONS' Style='{StaticResource TinyLabel}' /></StackPanel>
                            </Grid>
                            <TextBlock Text='{Binding DurableText}' Foreground='{DynamicResource Muted}' FontSize='10.5' TextWrapping='Wrap' LineHeight='14' Margin='0,0,0,12' />
                            <!-- A proxy that never starts is otherwise silent: the daemon is up, capture and recall
                                 keep working, and only the model's own memory_save/memory_recall quietly do not exist. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType='StackPanel'>
                                        <Setter Property='Visibility' Value='Collapsed' />
                                        <Style.Triggers>
                                            <DataTrigger Binding='{Binding Service.ShowModelToolsWarning}' Value='True'><Setter Property='Visibility' Value='Visible' /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background='#33E86A78' BorderBrush='{DynamicResource Red}' BorderThickness='1'
                                        CornerRadius='{DynamicResource Rad8}' Padding='9,7' Margin='0,0,0,12'>
                                    <StackPanel>
                                        <TextBlock Text='AGENT TOOLS' Style='{DynamicResource Caption}' Foreground='{DynamicResource Red}' />
                                        <TextBlock Text='{Binding Service.ModelToolsText}' Foreground='{DynamicResource Muted}'
                                                   FontSize='10.5' TextWrapping='Wrap' LineHeight='14' Margin='0,6,0,0' />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Height='1' Background='{DynamicResource BorderSoft}' Margin='0,0,0,12' />
                            <TextBlock Text='WHAT IS ON THE MAP' Style='{DynamicResource Caption}' Margin='0,0,0,8' />
                            <StackPanel Orientation='Horizontal' Margin='1,3'><Ellipse Style='{StaticResource LegendDot}' Fill='#F2A65A' /><TextBlock Text='Chat sessions' Foreground='{DynamicResource Muted}' FontSize='11' /></StackPanel>
                            <StackPanel Orientation='Horizontal' Margin='1,3'><Ellipse Style='{StaticResource LegendDot}' Fill='#8B7CF6' /><TextBlock Text='What you asked' Foreground='{DynamicResource Muted}' FontSize='11' /></StackPanel>
                            <StackPanel Orientation='Horizontal' Margin='1,3'><Ellipse Style='{StaticResource LegendDot}' Fill='#4C8DF5' /><TextBlock Text='What agents replied' Foreground='{DynamicResource Muted}' FontSize='11' /></StackPanel>
                            <StackPanel Orientation='Horizontal' Margin='1,3'><Ellipse Style='{StaticResource LegendDot}' Fill='#7ED0A6' /><TextBlock Text='Commands run' Foreground='{DynamicResource Muted}' FontSize='11' /></StackPanel>
                            <StackPanel Orientation='Horizontal' Margin='1,3'><Ellipse Style='{StaticResource LegendDot}' Fill='#8FAEE6' /><TextBlock Text='Files &amp; concepts' Foreground='{DynamicResource Muted}' FontSize='11' /></StackPanel>
                            <StackPanel Orientation='Horizontal' Margin='1,3'><Ellipse Style='{StaticResource LegendDot}' Fill='#E86A78' /><TextBlock Text='Errors' Foreground='{DynamicResource Muted}' FontSize='11' /></StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType='StackPanel'>
                                        <Setter Property='Visibility' Value='Collapsed' />
                                        <Style.Triggers>
                                            <DataTrigger Binding='{Binding Service.ShowOffline}' Value='True'><Setter Property='Visibility' Value='Visible' /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Height='1' Background='{DynamicResource BorderSoft}' Margin='0,12' />
                                <TextBlock Text='MEMORY ENGINE' Style='{DynamicResource Caption}' />
                                <TextBlock Text='{Binding Service.SetupHint}' Foreground='{DynamicResource Muted}' FontSize='10.5' LineHeight='15' Margin='0,8,0,10' TextWrapping='Wrap' />
                                <Button Style='{DynamicResource PrimaryButton}' Content='{Binding SetupButtonText}' Height='32' Padding='10,0'
                                        Click='OnStart' IsEnabled='{Binding Service.CanStart}' AutomationProperties.Name='Set up and start AgentMemory' />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column='2' Style='{StaticResource BrainCard}' ClipToBounds='True'>
                    <Grid>
                        <ui:MemoryGraphControl x:Name='MemoryGraph' Graph='{Binding Service.CurrentGraph}'
                                               SelectedNode='{Binding SelectedNode, Mode=TwoWay}'
                                               SearchText='{Binding Text, ElementName=SearchBox}'
                                               AutomationProperties.Name='Interactive memory graph' />
                        <Border HorizontalAlignment='Center' VerticalAlignment='Bottom' Margin='0,0,0,12'
                                Background='#DD212226' BorderBrush='{DynamicResource BorderSoft}' BorderThickness='1'
                                CornerRadius='{DynamicResource Rad99}' Padding='11,6' IsHitTestVisible='False'>
                            <TextBlock Text='drag to pan  ·  wheel to zoom  ·  click a memory to inspect'
                                       Foreground='{DynamicResource Faint}' FontSize='9.5' TextWrapping='NoWrap' />
                        </Border>
                        <Border HorizontalAlignment='Center' VerticalAlignment='Center' MaxWidth='390'
                                Background='#F2212226' BorderBrush='{DynamicResource Border}' BorderThickness='1'
                                CornerRadius='{DynamicResource Rad12}' Padding='22,18'>
                            <Border.Style>
                                <!-- ShowOffline, not !IsOnline: IsOnline starts false, so keying this overlay off it
                                     covered a healthy map with "The brain is offline" until the first probe answered. -->
                                <Style TargetType='Border'>
                                    <Setter Property='Visibility' Value='Collapsed' />
                                    <Style.Triggers>
                                        <DataTrigger Binding='{Binding Service.ShowOffline}' Value='True'><Setter Property='Visibility' Value='Visible' /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text='&#x1F9E0;' FontFamily='Segoe UI Emoji' FontSize='27' HorizontalAlignment='Center' TextWrapping='NoWrap' />
                                <TextBlock Text='{Binding Service.OfflineTitle}' FontFamily='{DynamicResource Display}' FontSize='16' FontWeight='SemiBold' HorizontalAlignment='Center' Margin='0,8,0,0' />
                                <TextBlock Text='{Binding Service.SetupHint}' Foreground='{DynamicResource Muted}' FontSize='11' TextAlignment='Center' Margin='0,6,0,12' />
                                <Button Content='Set up &amp; start' Style='{DynamicResource PrimaryButton}' Padding='14,7'
                                        HorizontalAlignment='Center' Click='OnStart' IsEnabled='{Binding Service.CanStart}'
                                        AutomationProperties.Name='Set up and start the second brain' />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <!-- The inspector only exists once a node is picked; an empty 300px placeholder is space the map wants. -->
                <Border Grid.Column='3' Width='300' Margin='8,0,0,0'>
                    <Border.Style>
                        <Style TargetType='Border' BasedOn='{StaticResource BrainCard}'>
                            <Setter Property='Visibility' Value='Visible' />
                            <Style.Triggers><DataTrigger Binding='{Binding SelectedNode}' Value='{x:Null}'><Setter Property='Visibility' Value='Collapsed' /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Disabled'>
                            <StackPanel Margin='16'>
                                <DockPanel LastChildFill='False'>
                                    <Border DockPanel.Dock='Left' Background='{DynamicResource AccentSoft}' BorderBrush='#554C8DF5' BorderThickness='1' CornerRadius='{DynamicResource Rad99}' Padding='8,4'>
                                        <TextBlock Text='{Binding SelectedNode.Type}' Foreground='{DynamicResource Accent}' FontSize='9.5' FontWeight='SemiBold' TextWrapping='NoWrap' />
                                    </Border>
                                    <Button DockPanel.Dock='Right' Style='{DynamicResource IconButton}' Width='26' Height='26' Content='&#xE8BB;' FontFamily='{DynamicResource Icons}' FontSize='10' Click='OnCloseDetails' ToolTip='Close details' AutomationProperties.Name='Close memory details' />
                                    <Button DockPanel.Dock='Right' Style='{DynamicResource IconButton}' Width='26' Height='26' Content='&#xE8C8;' FontFamily='{DynamicResource Icons}' FontSize='10' Click='OnCopyMemory' ToolTip='Copy memory' AutomationProperties.Name='Copy selected memory' />
                                </DockPanel>
                                <TextBlock Text='{Binding SelectedNode.Label}' FontFamily='{DynamicResource Display}' FontSize='18' FontWeight='SemiBold' LineHeight='23' Margin='0,12,0,0' />
                                <TextBlock Text='{Binding SelectedNode.Content}' Foreground='{DynamicResource Muted}' FontSize='11.5' LineHeight='17' Margin='0,9,0,0' />
                                <Grid Margin='0,15,0,0'>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width='*' /><ColumnDefinition Width='*' /></Grid.ColumnDefinitions>
                                    <Border Grid.Column='0' Background='{DynamicResource Bg2}' CornerRadius='{DynamicResource Rad8}' Padding='10,8' Margin='0,0,4,0'>
                                        <StackPanel><TextBlock Text='{Binding StrengthText}' FontWeight='SemiBold' /><TextBlock Text='STRENGTH' Style='{StaticResource TinyLabel}' Margin='0,2,0,0' /></StackPanel>
                                    </Border>
                                    <Border Grid.Column='1' Background='{DynamicResource Bg2}' CornerRadius='{DynamicResource Rad8}' Padding='10,8' Margin='4,0,0,0'>
                                        <StackPanel><TextBlock Text='{Binding UpdatedText}' FontWeight='SemiBold' TextTrimming='CharacterEllipsis' TextWrapping='NoWrap' /><TextBlock Text='UPDATED' Style='{StaticResource TinyLabel}' Margin='0,2,0,0' /></StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text='CONCEPTS' Style='{DynamicResource Caption}' Margin='0,17,0,8' />
                                <ItemsControl ItemsSource='{Binding SelectedNode.Concepts}'>
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Border Style='{StaticResource TagPill}'><TextBlock Text='{Binding}' Foreground='{DynamicResource Muted}' FontSize='10' TextWrapping='NoWrap' /></Border></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text='FILES &amp; SOURCES' Style='{DynamicResource Caption}' Margin='0,12,0,8' />
                                <ItemsControl ItemsSource='{Binding SelectedNode.Files}'>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Border Background='{DynamicResource CodeBg}' CornerRadius='{DynamicResource Rad6}' Padding='8,6' Margin='0,0,0,5'><TextBlock Text='{Binding}' FontFamily='{DynamicResource Mono}' FontSize='9.5' Foreground='{DynamicResource Muted}' TextTrimming='CharacterEllipsis' TextWrapping='NoWrap' ToolTip='{Binding}' /></Border></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row='3' Background='{DynamicResource Bg1}' BorderBrush='{DynamicResource BorderSoft}' BorderThickness='0,1,0,0'>
                <DockPanel Margin='12,0' LastChildFill='False'>
                    <TextBlock DockPanel.Dock='Left' Text='{Binding FooterText}' Foreground='{DynamicResource Faint}' FontSize='9.5' VerticalAlignment='Center' TextWrapping='NoWrap' />
                    <TextBlock DockPanel.Dock='Right' Text='AgentMemory · local-first' Foreground='{DynamicResource Faint}' FontFamily='{DynamicResource Mono}' FontSize='9' VerticalAlignment='Center' TextWrapping='NoWrap' />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
