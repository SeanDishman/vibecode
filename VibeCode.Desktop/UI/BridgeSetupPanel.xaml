<UserControl x:Class="VibeCode.UI.BridgeSetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:VibeCode.UI"
             FontFamily="{DynamicResource Ui}" FontSize="13" Foreground="{DynamicResource Text}"
             UseLayoutRounding="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="OnPanelKeyDown" SizeChanged="OnPanelSizeChanged">
    <UserControl.Resources>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource Bg3}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource Bg3}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDim}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="22,16,14,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource SetupAction}" Width="32" Padding="0"
                    Click="OnCancel" ToolTip="Close bridge setup" AutomationProperties.Name="Close bridge setup">
                <TextBlock FontFamily="{DynamicResource Icons}" Text="&#xE711;" FontSize="12" />
            </Button>
            <TextBlock x:Name="Heading" Text="Start a bridge" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="22,0,22,18">
            <StackPanel>
                <Border x:Name="ModeChoices" Background="{DynamicResource Bg0}" CornerRadius="9" Padding="3">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="RegularChoice" Content="Regular" GroupName="BridgeSetupMode"
                                     Style="{StaticResource Choice}" IsChecked="True" Checked="OnModeChanged"
                                     AutomationProperties.Name="Regular bridge" />
                        <RadioButton x:Name="AdvancedChoice" Content="Advanced" GroupName="BridgeSetupMode"
                                     Style="{StaticResource Choice}" Checked="OnModeChanged"
                                     AutomationProperties.Name="Advanced bridge" />
                    </UniformGrid>
                </Border>
                <TextBlock x:Name="ModeDescription" Margin="0,10,0,16" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap" LineHeight="18"
                           Text="Connect another AI to this chat. Both agents can message each other and work together." />

                <StackPanel x:Name="RegularFields">
                    <Label Content="Connect with" Target="{Binding ElementName=PeerProviderBox}" Padding="0,0,0,8" FontWeight="SemiBold" />
                    <ComboBox x:Name="PeerProviderBox" MinHeight="36" DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectionChanged="OnSettingsChanged" AutomationProperties.Name="Bridge partner provider" />
                    <TextBlock x:Name="RegularSummary" Margin="0,9,0,0" Foreground="{DynamicResource Muted}"
                               TextWrapping="Wrap" FontSize="12" />
                </StackPanel>

                <Grid x:Name="AdvancedFields" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TaskFields">
                    <Label Content="Give the team a task" Target="{Binding ElementName=ObjectiveBox}"
                           Padding="0,0,0,8" FontWeight="SemiBold" />
                    <Border x:Name="TaskBorder" Background="{DynamicResource Bg2}" BorderThickness="1" CornerRadius="9">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <TextBox x:Name="ObjectiveBox" MinHeight="144" MaxHeight="220" Padding="0"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                         TextChanged="OnObjectiveChanged" AutomationProperties.Name="Team task"
                                         AutomationProperties.HelpText="Type or dictate the task, then start the bridge. Control Enter starts the team.">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,10"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock x:Name="ObjectivePlaceholder" Text="What should the team build or fix?" Margin="12,10"
                                           Foreground="{DynamicResource Muted}" IsHitTestVisible="False" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text.Length, ElementName=ObjectiveBox}" Value="0" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ObjectiveBox}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ui:MicLevelMeter x:Name="TaskMicMeter" Margin="12,0,12,6"
                                              RecordingOwner="{Binding RelativeSource={RelativeSource AncestorType={x:Type ui:BridgeSetupPanel}}}" />
                            <DockPanel Margin="6,0,8,6">
                                <Button x:Name="MicButton" DockPanel.Dock="Left" Style="{StaticResource SetupAction}"
                                        Width="32" Padding="0" PreviewMouseLeftButtonDown="OnMicArm" Click="OnMic"
                                        ToolTip="Dictate task" AutomationProperties.Name="Dictate team task">
                                    <TextBlock x:Name="MicGlyph" Text="&#xE720;" FontFamily="{DynamicResource Icons}" FontSize="15" />
                                </Button>
                                <TextBlock x:Name="SpeechText" Text="Type or dictate" Foreground="{DynamicResource Muted}"
                                           FontSize="11" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SuggestionText" Foreground="{DynamicResource Muted}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <Grid Margin="0,22,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="Orchestrators" Target="{Binding ElementName=OrchestratorCountBox}" Padding="0,0,0,8" FontWeight="SemiBold" />
                                <ComboBox x:Name="OrchestratorCountBox" MinHeight="36" SelectionChanged="OnSettingsChanged" AutomationProperties.Name="Number of orchestrators" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Total workers" Target="{Binding ElementName=WorkerCountBox}" Padding="0,0,0,8" FontWeight="SemiBold" />
                                <ComboBox x:Name="WorkerCountBox" MinHeight="36" SelectionChanged="OnSettingsChanged" AutomationProperties.Name="Number of worker AIs" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CountNote" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel x:Name="AllocationFields" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Workers in each group" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl x:Name="GroupAllocation">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" MinHeight="32" ItemsSource="{Binding WorkerChoices}"
                                                  SelectedItem="{Binding WorkerCount, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Label, StringFormat=Workers for {0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock x:Name="AllocationNote" Foreground="{DynamicResource Muted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,16" />
                <StackPanel x:Name="LayoutFields" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="Terminal layout" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource Bg0}" CornerRadius="9" Padding="3">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="SingleTerminalChoice" Content="Single terminal" GroupName="BridgeSetupLayout"
                                         Style="{StaticResource Choice}" IsChecked="True" Checked="OnSettingsChanged"
                                         AutomationProperties.Name="Single terminal bridge" />
                            <RadioButton x:Name="SeparateTerminalsChoice" Content="Multiple terminals" GroupName="BridgeSetupLayout"
                                         Style="{StaticResource Choice}" Checked="OnSettingsChanged"
                                         AutomationProperties.Name="Multiple terminals bridge" />
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="LayoutNote" Text="One shared view. Switch agents while everyone keeps working."
                               Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ModelFields" Grid.Column="2">
                        <Label Content="Orchestrator provider" Target="{Binding ElementName=OrchestratorProviderBox}" Padding="0,0,0,8" FontWeight="SemiBold" />
                        <ComboBox x:Name="OrchestratorProviderBox" MinHeight="36" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectionChanged="OnSettingsChanged" AutomationProperties.Name="Orchestrator provider" />
                        <ui:BridgeAgentOptionsPanel x:Name="AgentOptions" Margin="0,10,0,0" ConfigurationChanged="OnAgentConfigurationChanged" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Red}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="22,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSoft}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="TeamSizeText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="StartButton" Grid.Column="1" Content="Start bridge" Padding="18,10" MinHeight="38"
                        Style="{StaticResource PrimaryButton}" Click="OnStart" AutomationProperties.Name="Start bridge">
                    <Button.Resources>
                        <Style TargetType="Border"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=StartButton}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
