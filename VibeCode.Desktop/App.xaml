<Application x:Class="VibeCode.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:VibeCode.UI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- App-scoped so standalone UserControls (e.g. the Games popup card, which is built
                 outside MainWindow's resource scope) can bind through it. -->
            <ui:NonEmptyToVisibilityConverter x:Key="NonEmptyVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
