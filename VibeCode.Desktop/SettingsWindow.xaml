<Window x:Class="VibeCode.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VibeCode.UI"
        xmlns:svc="clr-namespace:VibeCode.Services"
        Title="Settings" Icon="pack://application:,,,/VibeCode;component/Assets/logo.png"
        Width="900" Height="780" MinWidth="740" MinHeight="520"
        Background="{StaticResource Bg0}" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Ui}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False" PreviewKeyDown="OnSettingsSearchKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:NonEmptyToVisibilityConverter x:Key="ShowIfLocal" />
        <ui:HintVisibilityConverter x:Key="HintVisLocal" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- category rail item: AccentSoft pill + accent indicator when selected -->
        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="pill" CornerRadius="{StaticResource Rad8}" Height="40" Background="Transparent">
                            <Grid>
                                <Rectangle x:Name="ind" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource Accent}" HorizontalAlignment="Left" Margin="4,0,0,0"
                                           Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" Margin="14,0,10,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{StaticResource Bg3}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="ind" Property="Visibility" Value="Visible" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource Accent}" />
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- on/off switch (used by the Spotify enable toggle); green when on -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="40" Height="22" CornerRadius="{StaticResource Rad11}" Background="{StaticResource Bg3}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="{StaticResource Muted}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource SpotifyGreen}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource SpotifyGreen}" />
                                <Setter TargetName="knob" Property="Fill" Value="White" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== one setting, one shape =====
             Every row in this window is a SettingCard, so paddings, type sizes and the icon tile are defined
             once here instead of being re-typed (and quietly drifting) at each of the ~20 call sites. -->
        <Style TargetType="ui:SettingCard">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:SettingCard">
                        <Border x:Name="row" Background="Transparent" Padding="15,13"
                                BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="tile" DockPanel.Dock="Left" Width="30" Height="30"
                                            CornerRadius="{StaticResource Rad8}" Background="{StaticResource AccentSoft}"
                                            Margin="0,1,13,0" VerticalAlignment="Top">
                                        <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{StaticResource Icons}"
                                                   FontSize="14" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ContentPresenter DockPanel.Dock="Right" Margin="14,0,0,0"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock x:Name="value" DockPanel.Dock="Right" Margin="12,0,0,0"
                                                       Text="{TemplateBinding ValueText}" FontFamily="{StaticResource Mono}"
                                                       FontSize="12.5" Foreground="{StaticResource Accent}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="desc" Text="{TemplateBinding Description}" FontSize="11.5"
                                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ContentPresenter x:Name="footer" ContentSource="Footer" Margin="43,12,0,2" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ShowDivider" Value="False">
                                <Setter TargetName="row" Property="BorderThickness" Value="0" />
                            </Trigger>
                            <Trigger Property="Description" Value="">
                                <Setter TargetName="desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="ValueText" Value="">
                                <Setter TargetName="value" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Footer" Value="{x:Null}">
                                <Setter TargetName="footer" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Glyph" Value="{x:Null}">
                                <Setter TargetName="tile" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="footer" Property="Margin" Value="0,12,0,2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="row" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a captioned run of setting rows sharing one card, hairline-divided -->
        <Style TargetType="ui:SettingGroup">
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:SettingGroup">
                        <StackPanel>
                            <TextBlock x:Name="header" Text="{TemplateBinding Header}" Style="{StaticResource Caption}"
                                       Margin="2,0,0,7" />
                            <TextBlock x:Name="desc" Text="{TemplateBinding Description}" FontSize="11.5"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,0,9" />
                            <Border Style="{StaticResource Card}">
                                <ItemsPresenter />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Header" Value="">
                                <Setter TargetName="header" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Description" Value="">
                                <Setter TargetName="desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== notification sound picker =====
             WPF's stock ComboBox popup is light-themed and unstyleable from the outside, so the picker carries
             its own template. It follows the account-manager picker in MainWindow.xaml (window-local there, so
             not reusable) at settings scale. Every corner is a Rad* key, which the CLI theme squares to 0. -->
        <DataTemplate x:Key="SoundPickerSelection">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" VerticalAlignment="Center"
                           Foreground="{StaticResource Faint}" FontSize="10" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource Text}"
                           FontSize="12.5" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- Dropdown row. Carries its own play button so a sound can be auditioned without committing to it;
             the collapsed box uses SoundPickerSelection instead, where that button would be dead chrome. -->
        <DataTemplate x:Key="SoundPickerRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                        Width="24" Height="24" Padding="0" Margin="0,0,8,0"
                        Click="OnPlayNotificationSoundRow"
                        ToolTip="Play this sound"
                        AutomationProperties.Name="Play this sound">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="11" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{StaticResource Text}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Badge}" VerticalAlignment="Center"
                           Foreground="{StaticResource Faint}" FontSize="10" Margin="8,0,2,0" />
            </Grid>
        </DataTemplate>

        <Style x:Key="SoundPickerOption" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="opt" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Rad6}" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="opt" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="opt" Property="Background" Value="#2A6AA9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoundPicker" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemTemplate" Value="{StaticResource SoundPickerRow}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SoundPickerOption}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="picker" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="box" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource Rad8}">
                                            <Border HorizontalAlignment="Right" Width="30" Background="Transparent">
                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                           Foreground="{StaticResource Faint}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="box" Property="Background" Value="{StaticResource Bg3}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="11,0,34,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{StaticResource SoundPickerSelection}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0"
                                        Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="{StaticResource Rad8}">
                                    <ScrollViewer Margin="2" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="picker" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- segmented filter control (usage time range, chart metric) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" CornerRadius="{StaticResource Rad8}" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="label" Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{StaticResource Muted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource Bg3}" />
                                <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="label" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- circular transport button (prev / next), ghost -->
        <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <!-- ===== one extension, one shape =====
             The five cards in Extensions used to hand-roll this header each, and drifted: three ran their body
             full-bleed while Phone indented it, and the in-card rule was a hairline you could not see. Defined
             once here so the whole pane keeps a single left rail down the title column. -->
        <Style TargetType="ui:ExtensionCard">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="GlyphFont" Value="{StaticResource Icons}" />
            <Setter Property="Tint" Value="{StaticResource Accent}" />
            <Setter Property="TintSoft" Value="{StaticResource AccentSoft}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:ExtensionCard">
                        <Border Style="{StaticResource Card}" SnapsToDevicePixels="True">
                            <StackPanel>
                                <!-- header: tile | title + description | pill + switch -->
                                <DockPanel Margin="16,14,16,14">
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" VerticalAlignment="Top"
                                            CornerRadius="{StaticResource Rad10}" Background="{TemplateBinding TintSoft}"
                                            Margin="0,0,13,0">
                                        <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{TemplateBinding GlyphFont}"
                                                   FontSize="16" Foreground="{TemplateBinding Tint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="14,0,0,0">
                                        <ContentPresenter ContentSource="Status" VerticalAlignment="Center"
                                                          Margin="0,0,10,0" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}" />
                                        <TextBlock Text="{TemplateBinding Description}" FontSize="11.5"
                                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- body: indented to the title column, so 63px is the page's one left rail -->
                                <Border x:Name="body" Visibility="Collapsed" Padding="16,14,16,16"
                                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0">
                                    <ContentPresenter ContentSource="Body" Margin="47,0,0,0" />
                                </Border>

                                <!-- and what turning it on would get you, while it is off -->
                                <TextBlock x:Name="hint" Text="{TemplateBinding OffHint}" Visibility="Collapsed"
                                           FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                           Margin="63,0,16,15" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsOn" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsOn" Value="False">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- after the IsOn pair: a card with nothing to show keeps its header only -->
                            <Trigger Property="Body" Value="{x:Null}">
                                <Setter TargetName="body" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="OffHint" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- State pill beside a switch. Only ever says something the switch cannot ("Connected", "Needs a key"),
             so it is never the same word twice on one row. -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Rad99}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- The one secondary button on this page. Disconnect, Search, Use my location, Open maps and Remove key
             were five different treatments - a borderless ghost, a saturated blue slab, a bare word - which is
             most of why the pane read as unfinished. -->
        <Style x:Key="Outline" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ob" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource Rad8}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ob" Property="Background" Value="{StaticResource Bg3}" />
                                <Setter TargetName="ob" Property="BorderBrush" Value="{StaticResource Overlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ob" Property="Background" Value="{StaticResource Bg1}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled primary: exactly one per setup flow, so the eye has a single place to land. -->
        <Style x:Key="PrimaryAccent" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pb" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Rad10}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pb" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="pb" Property="Background" Value="{StaticResource Overlay}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimarySpotify" TargetType="Button" BasedOn="{StaticResource PrimaryAccent}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource SpotifyGreen}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="sb" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Rad10}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sb" Property="Background" Value="{StaticResource SpotifyGreenHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sb" Property="Background" Value="{StaticResource SpotifyGreenPress}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="sb" Property="Background" Value="{StaticResource Overlay}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- titlebar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitlebarClose}" Content="&#xE8BB;"
                        Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close settings" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" Padding="16,10"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBox x:Name="SettingsSearchBox" FontSize="13" Padding="33,8,38,8"
                         TextChanged="OnSettingsSearchChanged" AutomationProperties.Name="Search settings"
                         ToolTip="Search settings across all categories (Ctrl+F)" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}"
                           Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="SettingsSearchHint" Text="Search settings…" Foreground="{StaticResource Faint}"
                           Margin="34,0,38,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Button x:Name="ClearSettingsSearch" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource GhostButton}" Width="28" Height="28" Margin="0,0,5,0" Padding="0"
                        Visibility="Collapsed" Click="OnClearSettingsSearch" ToolTip="Clear search (Esc)"
                        AutomationProperties.Name="Clear settings search">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Wide enough for the longest label ("Bridge & agents") in CLI mode's monospace face, which
                     is noticeably wider than the default UI font and was clipping it. -->
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== category rail ===== -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="Rail" Background="Transparent" BorderThickness="0" Padding="0,8"
                         ItemContainerStyle="{StaticResource RailItem}" SelectionChanged="OnRailChanged"
                         SelectedIndex="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem AutomationProperties.Name="General">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="General" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE771;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Appearance" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Notifications">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7ED;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Notifications" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Bridge and agents">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Bridge &amp; agents" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Usage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Usage" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Projects">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Projects" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="MCP servers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="MCP servers" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Extensions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA86;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Extensions" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Privacy">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Privacy" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="About" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- ===== content panes ===== -->
            <Grid Grid.Column="1">
                <Grid x:Name="SettingsSearchPane" Visibility="Collapsed" Margin="24,22,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Search results" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="SettingsSearchCount" Grid.Row="1" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="0,6,0,14" AutomationProperties.LiveSetting="Polite" />
                    <ListBox x:Name="SettingsSearchResults" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Settings search results">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="result" Background="Transparent" CornerRadius="{StaticResource Rad8}">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="result" Property="Background" Value="{StaticResource Bg3}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="result" Property="Background" Value="{StaticResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                        Padding="12,11" Focusable="False" Click="OnOpenSettingsSearchResult"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Accent}" FontSize="11" />
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontWeight="SemiBold"
                                                   FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11.5"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="SettingsSearchEmpty" Grid.Row="2" VerticalAlignment="Top" Margin="12,20,12,0"
                               Text="No settings match. Try a different word or clear the search."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>
                <!-- General -->
                <ScrollViewer x:Name="PaneGeneral" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,24,30,30" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="General" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="How VibeCode behaves as an application — what the close button means while agents are still working."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,20" TextWrapping="Wrap" />

                        <ui:SettingGroup Header="WHEN YOU CLOSE THE WINDOW">
                            <ui:SettingCard Glyph="&#xE7C4;" Title="Run in background"
                                            Description="On: closing the window puts VibeCode in the notification area and every chat, Bridge peer and Demon worker keeps coding. Click the icon to bring the window back, or right-click it to quit. Off: the close button ends VibeCode there and then, and every running agent with it.">
                                <ToggleButton x:Name="RunInBackgroundToggle" Style="{StaticResource Switch}"
                                              Checked="OnRunInBackgroundChanged" Unchecked="OnRunInBackgroundChanged"
                                              AutomationProperties.Name="Run in background" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <TextBlock Text="Notifications are the way a background VibeCode reaches you — turn on “When a chat finishes” under Notifications and a finished agent will still say so with no window open."
                                   Foreground="{StaticResource Faint}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Appearance -->
                <ScrollViewer x:Name="PaneAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="28,22,28,28" MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Text="Appearance" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Control how conversations are presented and pick the art behind the chat."
                                   Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,16" TextWrapping="Wrap" />

                        <TextBlock Text="MODE" Style="{StaticResource Caption}" Margin="0,0,0,7" />
                        <UniformGrid Columns="2">
                            <Button x:Name="ModeCardBackground" Click="OnPickMode" Margin="0,0,5,0" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}" BorderBrush="{StaticResource BorderSoft}"
                                    AutomationProperties.Name="Custom background mode">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" CornerRadius="{StaticResource Rad12}" BorderThickness="2"
                                                BorderBrush="{TemplateBinding BorderBrush}" Background="{StaticResource Bg2}"
                                                Padding="14,12">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="{StaticResource Bg3}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="ModeCheckBackground" DockPanel.Dock="Right" Text="&#xE73E;"
                                                   FontFamily="{StaticResource Icons}" FontSize="12"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <TextBlock Text="&#xE771;" FontFamily="{StaticResource Icons}" FontSize="14"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Custom background" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="The standard look — art behind the chat, soft cards, rounded corners."
                                               FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeCardCli" Click="OnPickMode" Margin="5,0,0,0" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}" BorderBrush="{StaticResource BorderSoft}"
                                    AutomationProperties.Name="CLI mode">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" CornerRadius="{StaticResource Rad12}" BorderThickness="2"
                                                BorderBrush="{TemplateBinding BorderBrush}" Background="{StaticResource Bg2}"
                                                Padding="14,12">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="{StaticResource Bg3}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="ModeCheckCli" DockPanel.Dock="Right" Text="&#xE73E;"
                                                   FontFamily="{StaticResource Icons}" FontSize="12"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <TextBlock Text="&#xE756;" FontFamily="{StaticResource Icons}" FontSize="14"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="CLI mode" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="Terminal look — cmd-style grey on black, monospace, hard edges. Same features."
                                               FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock Text="Switching modes re-skins VibeCode straight away. Running chats keep running — nothing restarts."
                                   Foreground="{StaticResource Faint}" FontSize="10.5" Margin="0,6,0,16" TextWrapping="Wrap" />

                        <!-- Borderless belongs to Custom background: it is the background art it uncovers.
                             RefreshModeCards() hides the whole group in CLI mode rather than greying it out. -->
                        <ui:SettingGroup x:Name="BorderlessSection" Header="SURFACES">
                            <ui:SettingCard Glyph="&#xE737;" Title="Borderless"
                                            Description="Drops the grey panels. The titlebar, sidebar, chat and every Bridge pane stop painting themselves, so your background is the background of the whole window and each region is picked out by a thin black outline instead. Your messages, tool cards and code blocks keep their fill so they stay readable — turn Art visibility down if a busy image fights the text.">
                                <ToggleButton x:Name="BorderlessToggle" Style="{StaticResource Switch}"
                                              Checked="OnBorderlessChanged" Unchecked="OnBorderlessChanged"
                                              AutomationProperties.Name="Borderless" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="CHAT">
                            <ui:SettingCard Glyph="&#xE8A7;" Title="Compact mode"
                                            Description="Groups consecutive bash commands, edits, web searches, and MCP/browser calls. Open a group for the one-line activity list, then open any row for full details.">
                                <ToggleButton x:Name="CompactModeToggle" Style="{StaticResource Switch}"
                                              Checked="OnCompactModeChanged" Unchecked="OnCompactModeChanged"
                                              AutomationProperties.Name="Compact mode" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <TextBlock x:Name="CliModeHint" Visibility="Collapsed"
                                   Text="Backgrounds don't apply in CLI mode — the terminal stays flat black. Switch back to Custom background to use them."
                                   Foreground="{StaticResource Faint}" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <StackPanel x:Name="BackgroundSection">
                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,20" />
                        <TextBlock Text="BACKGROUND" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <TextBlock Text="GIFs animate; added images are copied into VibeCode's own folder."
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />

                        <ItemsControl x:Name="BgList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnPickBackground" Cursor="Hand" Margin="0,0,10,10" Padding="0"
                                            FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding AutomationName}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="card" Width="150" Height="104" CornerRadius="{StaticResource Rad12}" BorderThickness="2"
                                                        BorderBrush="{StaticResource BorderSoft}" Background="{StaticResource CodeBg}">
                                                    <Grid>
                                                        <Border CornerRadius="{StaticResource Rad10}" Margin="1">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" CornerRadius="{StaticResource RadBottom10}" Padding="9,4">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="#CC17181B" />
                                                            </Border.Background>
                                                            <DockPanel>
                                                                <TextBlock x:Name="check" DockPanel.Dock="Right" Text="&#xE73E;"
                                                                           FontFamily="{StaticResource Icons}" FontSize="11"
                                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                                           Visibility="Collapsed" />
                                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource Muted}"
                                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            </DockPanel>
                                                        </Border>
                                                        <Button x:Name="remove" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Margin="0,6,6,0" Width="24" Height="24" Padding="0" Content="&#xE711;"
                                                                FontFamily="{StaticResource Icons}" FontSize="9" Click="OnRemoveBackground"
                                                                Visibility="Collapsed" ToolTip="Remove"
                                                                AutomationProperties.Name="{Binding RemoveAutomationName}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="rb" Background="#B01A1A1D" CornerRadius="{StaticResource Rad7}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="rb" Property="Background" Value="{StaticResource Red}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            <Condition Binding="{Binding IsBuiltin}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="remove" Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Click="OnAddBackground" Padding="14,7" AutomationProperties.Name="Add background">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="Add image…" FontSize="12.5" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <CheckBox x:Name="RandomCheck" Content="Pick one at random on launch" Margin="16,0,0,0"
                                      VerticalAlignment="Center" FontSize="12.5" Checked="OnRandomChanged" Unchecked="OnRandomChanged"
                                      AutomationProperties.Name="Random background" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,20" />

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Art visibility" FontSize="12.5" Foreground="{StaticResource Text}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock DockPanel.Dock="Right" FontSize="12" FontFamily="{StaticResource Mono}"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" Width="34"
                                       Text="{Binding Value, ElementName=VisSlider, StringFormat={}{0:0}%}" />
                            <Slider x:Name="VisSlider" Style="{StaticResource DimSlider}" Minimum="0" Maximum="80"
                                    SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                    ValueChanged="OnVisibilityChanged" AutomationProperties.Name="Art visibility" />
                        </DockPanel>
                        <TextBlock Text="Chat dims the art a little extra so messages stay readable (80% is the max)."
                                   Foreground="{StaticResource Faint}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Notifications -->
                <ScrollViewer x:Name="PaneNotifications" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,24,30,30" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Notifications" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Both are off by default. A toast is only ever shown when the chat it concerns is not already fully visible on your screen, so you are never told about something that is right in front of you."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,20" TextWrapping="Wrap" />

                        <ui:SettingGroup Header="DESKTOP TOASTS">
                            <ui:SettingCard Glyph="&#xE7ED;" Title="When a chat finishes"
                                            Description="Fires whenever any chat or Bridge agent finishes its turn — the agent's name (or the chat) plus a snippet of the reply.">
                                <ToggleButton x:Name="NotifyTurnEndToggle" Style="{StaticResource Switch}"
                                              Checked="OnNotifyTurnEndChanged" Unchecked="OnNotifyTurnEndChanged"
                                              AutomationProperties.Name="Notify when a chat finishes" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE9CE;" Title="When an agent is waiting on you"
                                            Description="Fires when an agent stops to ask a question, present a plan, or request permission — so it never sits blocked while you are in another app.">
                                <ToggleButton x:Name="NotifyAwaitingInputToggle" Style="{StaticResource Switch}"
                                              Checked="OnNotifyAwaitingInputChanged" Unchecked="OnNotifyAwaitingInputChanged"
                                              AutomationProperties.Name="Notify when an agent is waiting on you" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="SOUND">
                            <ui:SettingCard Glyph="&#xE767;" Title="Notification sound"
                                            Description="Pick any chime to hear it straight away — the preview is the same sound a real toast plays, at the same volume. Thirty are built in; drop your own MP3 or WAV files into the sounds folder and they appear in the dropdown too.">
                                <ui:SettingCard.Footer>
                                    <StackPanel MinWidth="330">
                                        <ComboBox x:Name="NotificationSoundPicker" Style="{StaticResource SoundPicker}"
                                                  SelectionChanged="OnNotificationSoundChanged"
                                                  AutomationProperties.Name="Notification sound" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource GhostButton}" Padding="12,6"
                                                    Click="OnPreviewNotificationSound"
                                                    AutomationProperties.Name="Play the selected notification sound">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="Play" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0"
                                                    Click="OnOpenSoundsFolder"
                                                    ToolTip="Opens %APPDATA%\VibeCode\Sounds. Drop MP3 or WAV files in, then hit Rescan."
                                                    AutomationProperties.Name="Open the sounds folder">
                                                <TextBlock Text="Add your own…" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0"
                                                    Click="OnRescanSounds"
                                                    AutomationProperties.Name="Rescan the sounds folder">
                                                <TextBlock Text="Rescan" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                        </ui:SettingGroup>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bridge & agents -->
                <ScrollViewer x:Name="PaneBridge" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,24,30,30" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Bridge &amp; agents" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="How many agents may run together, how much they tell each other, and whether one chat can command child workers of its own."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,20" TextWrapping="Wrap" />

                        <ui:SettingGroup Header="BRIDGE">
                            <ui:SettingCard Glyph="&#xE7F4;" Title="Maximum agents per Bridge"
                                            Description="Each Bridge can grow to this many agents. Lowering the limit never closes agents that are already running. Nine is the default."
                                            ValueText="{Binding Value, ElementName=BridgeAgentLimitSlider, StringFormat={}{0:0}}">
                                <ui:SettingCard.Footer>
                                    <Slider x:Name="BridgeAgentLimitSlider" Style="{StaticResource DimSlider}" Minimum="4" Maximum="17" TickFrequency="1"
                                            IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                            ValueChanged="OnBridgeAgentLimitChanged"
                                            AutomationProperties.Name="Maximum agents per Bridge" />
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE72D;" Title="Real-time sharing"
                                            Description="Agents also keep a live-activity board: which files each one is editing right now and what it is adding there, rewritten in place at checkpoints. Much richer awareness for a small token cost, and it applies to running bridges immediately.">
                                <ToggleButton x:Name="BridgeRealtimeSharingToggle" Style="{StaticResource Switch}"
                                              Checked="OnBridgeRealtimeSharingChanged" Unchecked="OnBridgeRealtimeSharingChanged"
                                              AutomationProperties.Name="Real-time bridge sharing" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE8BD;" Title="Agents can message each other"
                                            Description="Any agent can send a prompt straight to another with @@MSG agent=N — to hand over work outside its lane, ask the agent that owns an area, or escalate to the manager. Without this the status board is the only sideways channel. Chains are cut after a few hops so two agents cannot answer each other forever.">
                                <ToggleButton x:Name="BridgePeerMessagingToggle" Style="{StaticResource Switch}"
                                              Checked="OnBridgePeerMessagingChanged" Unchecked="OnBridgePeerMessagingChanged"
                                              AutomationProperties.Name="Agents can message each other" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="AGENT SWARMS"
                                         Description="Lets one Claude, Codex, or Grok conversation coordinate a small set of native child agents. A swarm is not a Bridge: a Bridge coordinates several top-level CLI sessions, while a swarm is owned by one session whose parent waits, verifies, and integrates the children. Kimi is intentionally excluded.">
                            <ui:SettingCard Glyph="&#xE716;" Title="Enable agent swarms"
                                            Description="Adds a one-shot swarm button to Claude, Codex, and Grok chats. An ordinary message still uses one agent.">
                                <ToggleButton x:Name="SwarmsEnabledToggle" Style="{StaticResource Switch}"
                                              Checked="OnSwarmsEnabledChanged" Unchecked="OnSwarmsEnabledChanged"
                                              AutomationProperties.Name="Enable agent swarms" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE7C4;" Title="Maximum child workers"
                                            Description="The parent picks the smallest useful swarm, from 1 up to this ceiling. Six is the balanced default; sixteen is the hard safety limit."
                                            ValueText="{Binding Value, ElementName=SwarmMaxSlider, StringFormat={}{0:0}}"
                                            IsEnabled="{Binding IsChecked, ElementName=SwarmsEnabledToggle}">
                                <ui:SettingCard.Footer>
                                    <Slider x:Name="SwarmMaxSlider" Style="{StaticResource DimSlider}" Minimum="2" Maximum="16" TickFrequency="1"
                                            IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                            ValueChanged="OnSwarmMaxChanged" AutomationProperties.Name="Maximum swarm workers" />
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE8AB;" Title="Allow swarms inside Bridge"
                                            Description="Off by default. When enabled, each Claude, Codex, or Grok Bridge pane may arm its own bounded child swarm; Bridge peers stay separate root CLIs."
                                            IsEnabled="{Binding IsChecked, ElementName=SwarmsEnabledToggle}">
                                <ToggleButton x:Name="BridgeSwarmsToggle" Style="{StaticResource Switch}"
                                              Checked="OnBridgeSwarmsChanged" Unchecked="OnBridgeSwarmsChanged"
                                              AutomationProperties.Name="Allow swarms inside Bridge" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="SUPERVISION"
                                         Description="A dispatched agent can hang mid-tool, end a turn with nothing to say, loop, or die — and none of those announce themselves. Supervision watches every delegated agent and escalates on a bounded ladder: ask it to finish, then cancel and re-run it on the same task, then hand the task to the orchestrator. Every step is written to supervision-log.txt.">
                            <ui:SettingCard Glyph="&#xE9D9;" Title="Supervise delegated agents"
                                            Description="Applies to any Bridge with a manager. Always on in Demon Mode, where a read-only worker has no other way to be rescued.">
                                <ToggleButton x:Name="SupervisionEnabledToggle" Style="{StaticResource Switch}"
                                              Checked="OnSupervisionEnabledChanged" Unchecked="OnSupervisionEnabledChanged"
                                              AutomationProperties.Name="Supervise delegated agents" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE916;" Title="Stalled after"
                                            Description="Seconds an agent may run without producing any output before it counts as stalled."
                                            ValueText="{Binding Value, ElementName=SupervisionStaleSlider, StringFormat={}{0:0}s}"
                                            IsEnabled="{Binding IsChecked, ElementName=SupervisionEnabledToggle}">
                                <ui:SettingCard.Footer>
                                    <Slider x:Name="SupervisionStaleSlider" Style="{StaticResource DimSlider}" Minimum="30" Maximum="1800"
                                            TickFrequency="30" IsSnapToTickEnabled="True" SmallChange="30" LargeChange="120"
                                            ValueChanged="OnSupervisionStaleChanged" AutomationProperties.Name="Stalled after" />
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE823;" Title="Reply window after a nudge"
                                            Description="Seconds a nudged agent has to answer before the supervisor escalates to a restart."
                                            ValueText="{Binding Value, ElementName=SupervisionGraceSlider, StringFormat={}{0:0}s}"
                                            IsEnabled="{Binding IsChecked, ElementName=SupervisionEnabledToggle}">
                                <ui:SettingCard.Footer>
                                    <Slider x:Name="SupervisionGraceSlider" Style="{StaticResource DimSlider}" Minimum="30" Maximum="600"
                                            TickFrequency="15" IsSnapToTickEnabled="True" SmallChange="15" LargeChange="60"
                                            ValueChanged="OnSupervisionGraceChanged" AutomationProperties.Name="Reply window after a nudge" />
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE72C;" Title="Restarts before takeover"
                                            Description="How many times a stuck agent is cancelled and re-run on the same task before the orchestrator completes it directly. Zero means go straight to takeover."
                                            ValueText="{Binding Value, ElementName=SupervisionRestartsSlider, StringFormat={}{0:0}}"
                                            IsEnabled="{Binding IsChecked, ElementName=SupervisionEnabledToggle}">
                                <ui:SettingCard.Footer>
                                    <Slider x:Name="SupervisionRestartsSlider" Style="{StaticResource DimSlider}" Minimum="0" Maximum="3"
                                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                            ValueChanged="OnSupervisionRestartsChanged" AutomationProperties.Name="Restarts before takeover" />
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="DEMON MODE"
                                         Description="A team of 4 to 17 sessions on one project: an orchestrator you type into, and read-only workers it plans for and dispatches to. The orchestrator does not review their work — it plans, dispatches, and keeps the team alive. This switch is the only way in and out: turning it on asks which folder to run in, how many sessions to open and which account they run on, then starts the team there; turning it off stops every session. A Demon team is never resumed later, so it is off again each time VibeCode starts.">
                            <ui:SettingCard Glyph="&#xE945;" Title="Run a Demon Mode team"
                                            Description="Asks for a project folder, then for the team size (4–17 sessions, remembered for next time), the account and the model. The sessions start a fraction of a second apart so the wall stays usable while the team comes up. Switch off to end the team and stop every session.">
                                <ToggleButton x:Name="DemonModeToggle" Style="{StaticResource Switch}"
                                              Checked="OnDemonModeChanged" Unchecked="OnDemonModeChanged"
                                              AutomationProperties.Name="Run a Demon Mode team" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE8A1;" Title="Orchestrator reviews worker output"
                                            Description="Off by design: the orchestrator plans and dispatches only, and records a lane as done when its worker reports. Turn this on to have it check, correct and validate each result before moving on — more thorough, and considerably slower. Set it before you start a team; it is read when the team is briefed.">
                                <ToggleButton x:Name="DemonReviewToggle" Style="{StaticResource Switch}"
                                              Checked="OnDemonReviewChanged" Unchecked="OnDemonReviewChanged"
                                              AutomationProperties.Name="Orchestrator reviews worker output" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="DUAL MONITOR"
                                         Description="Both windows share one app and close together.">
                            <!-- Demon Mode and the second display are mutually exclusive (DualMonitorBridgePolicy).
                                 Both switches are disabled while a team is running rather than accepted and quietly
                                 ignored, and this line is why - a dead switch with no reason is worse than none. -->
                            <TextBlock x:Name="DemonBlocksDualMonitorNote" Visibility="Collapsed"
                                       FontSize="11" Foreground="{StaticResource Amber}" TextWrapping="Wrap"
                                       Margin="2,0,0,10" />
                            <ui:SettingCard Glyph="&#xE7F4;" Title="Spread Bridge across displays"
                                            Description="With 3 or more agents, keep agents 1–2 here and open the remaining Bridge panes on another display.">
                                <ToggleButton x:Name="DualMonitorBridgeToggle" Style="{StaticResource Switch}"
                                              Checked="OnDualMonitorBridgeChanged" Unchecked="OnDualMonitorBridgeChanged"
                                              AutomationProperties.Name="Dual-monitor Bridge" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE737;" Title="Second working shell"
                                            Description="Opens a second full VibeCode shell on another display. Each window remembers its own active chat; both share live sessions and chat controls, while accounts and Settings stay in the primary window.">
                                <ToggleButton x:Name="DualMonitorDoubleSessionsToggle" Style="{StaticResource Switch}"
                                              Checked="OnDualMonitorDoubleSessionsChanged" Unchecked="OnDualMonitorDoubleSessionsChanged"
                                              AutomationProperties.Name="Dual-monitor double sessions" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <TextBlock Text="Turning swarm support on, or raising its limit, applies when an existing chat next reconnects. Lower limits, one-shot choices, and the Bridge opt-in apply immediately."
                                   FontSize="10.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="2,0,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Usage -->
                <ScrollViewer x:Name="PaneUsage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,24,30,30" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Usage" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Every model call VibeCode makes is recorded on this machine — which model, how many tokens in and out, and what those tokens are worth at the provider's public list price. Nothing is uploaded anywhere."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap" />

                        <!-- One filter row above everything it scopes: every chart and the table below redraw
                             against the same slice, so no card carries a range control of its own. -->
                        <Border Background="{StaticResource Bg1}" CornerRadius="{StaticResource Rad10}"
                                Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RangeToday" Style="{StaticResource Chip}" Content="Today"
                                             GroupName="UsageRange" Checked="OnUsageRangeChanged" />
                                <RadioButton x:Name="RangeWeek" Style="{StaticResource Chip}" Content="7 days"
                                             GroupName="UsageRange" Checked="OnUsageRangeChanged" IsChecked="True" />
                                <RadioButton x:Name="RangeMonth" Style="{StaticResource Chip}" Content="30 days"
                                             GroupName="UsageRange" Checked="OnUsageRangeChanged" />
                                <RadioButton x:Name="RangeAll" Style="{StaticResource Chip}" Content="All time"
                                             GroupName="UsageRange" Checked="OnUsageRangeChanged" />
                            </StackPanel>
                        </Border>

                        <!-- Hero: the one number this page leads with, then the supporting tiles. -->
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <TextBlock x:Name="UsageHeroLabel" Text="ESTIMATED SPEND · LAST 7 DAYS" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="UsageHero" Text="$0" FontFamily="{StaticResource Ui}" FontSize="40"
                                           FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,4,0,0" />
                                <TextBlock x:Name="UsageHeroSub" Text="No model calls recorded yet."
                                           FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Tokens in" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageTileIn" Text="0" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Tokens out" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageTileOut" Text="0" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Served from cache" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageTileCache" Text="0%" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Turns" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageTileTurns" Text="0" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,20,0,8">
                            <Border DockPanel.Dock="Right" Background="{StaticResource Bg1}" CornerRadius="{StaticResource Rad8}" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ShareByCost" Style="{StaticResource Chip}" Content="Cost"
                                                 Padding="10,3" GroupName="UsageShare" IsChecked="True" Checked="OnUsageShareMetricChanged" />
                                    <RadioButton x:Name="ShareByTokens" Style="{StaticResource Chip}" Content="Tokens"
                                                 Padding="10,3" GroupName="UsageShare" Checked="OnUsageShareMetricChanged" />
                                    <RadioButton x:Name="ShareByEnergy" Style="{StaticResource Chip}" Content="Electricity"
                                                 Padding="10,3" GroupName="UsageShare" Checked="OnUsageShareMetricChanged" />
                                    <RadioButton x:Name="ShareByWater" Style="{StaticResource Chip}" Content="Water"
                                                 Padding="10,3" GroupName="UsageShare" Checked="OnUsageShareMetricChanged" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="SHARE BY MODEL" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <ui:ModelShareDonut x:Name="UsageDonut" SurfaceKey="Bg2" />
                        </Border>

                        <TextBlock Text="TOKENS IN AND OUT, BY MODEL" Style="{StaticResource Caption}" Margin="2,20,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <ui:ModelTokenBarChart x:Name="UsageBars" SurfaceKey="Bg2" />
                        </Border>

                        <DockPanel Margin="0,20,0,8">
                            <Border DockPanel.Dock="Right" Background="{StaticResource Bg1}" CornerRadius="{StaticResource Rad8}" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TrendByCost" Style="{StaticResource Chip}" Content="Cost"
                                                 Padding="10,3" GroupName="UsageTrend" IsChecked="True" Checked="OnUsageTrendMetricChanged" />
                                    <RadioButton x:Name="TrendByTokens" Style="{StaticResource Chip}" Content="Tokens"
                                                 Padding="10,3" GroupName="UsageTrend" Checked="OnUsageTrendMetricChanged" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="UsageTrendCaption" Text="DAILY SPEND" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <ui:DailyTrend x:Name="UsageTrend" SurfaceKey="Bg2" />
                        </Border>

                        <TextBlock Text="BREAKDOWN" Style="{StaticResource Caption}" Margin="2,20,0,8" />
                        <Border Style="{StaticResource Card}" Padding="4,2">
                            <StackPanel>
                                <!-- The table view: the WCAG-clean twin of every chart above, so no value on this
                                     page is reachable only by hovering a mark. -->
                                <Grid Margin="12,10,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Model" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="TURNS" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="IN" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="OUT" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="COST" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="ENERGY" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="WATER" Style="{StaticResource Caption}" TextAlignment="Right" />
                                </Grid>
                                <Rectangle Height="1" Fill="{StaticResource BorderHairline}" />
                                <ItemsControl x:Name="UsageTable">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="{StaticResource Rad2}"
                                                            Background="{Binding Swatch}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Display}" FontSize="12" Margin="9,0,8,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                    <TextBlock Text="est." FontSize="9.5" Foreground="{StaticResource Faint}"
                                                               VerticalAlignment="Center" ToolTip="No published price for this model — priced at the Opus tier."
                                                               Visibility="{Binding EstimateFlagVisibility}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Turns}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding TokensIn}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding TokensOut}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Cost}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding Energy}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding Water}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="UsageTableEmpty" Text="Nothing recorded in this range yet."
                                           FontSize="11.5" Foreground="{StaticResource Faint}" Margin="12,14,12,16" />
                            </StackPanel>
                        </Border>

                        <!-- The physical bill behind the money one. It sits AFTER the metered numbers on purpose:
                             everything above is counted, this is modelled, and reading it last means the page
                             leads with what it knows. Its own card, its own trend, and the note under the tiles
                             is part of the number rather than a footnote to it. -->
                        <DockPanel Margin="0,26,0,8">
                            <Border DockPanel.Dock="Right" Background="{StaticResource Bg1}" CornerRadius="{StaticResource Rad8}" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FootprintByEnergy" Style="{StaticResource Chip}" Content="Electricity"
                                                 Padding="10,3" GroupName="UsageFootprint" IsChecked="True" Checked="OnUsageFootprintMetricChanged" />
                                    <RadioButton x:Name="FootprintByWater" Style="{StaticResource Chip}" Content="Water"
                                                 Padding="10,3" GroupName="UsageFootprint" Checked="OnUsageFootprintMetricChanged" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ELECTRICITY AND WATER" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Electricity" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageEnergy" Text="0 Wh" FontFamily="{StaticResource Ui}"
                                                   FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                   Margin="0,3,0,0" />
                                        <TextBlock x:Name="UsageEnergySub" FontSize="11" Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Water" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageWater" Text="0 mL" FontFamily="{StaticResource Ui}"
                                                   FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                   Margin="0,3,0,0" />
                                        <TextBlock x:Name="UsageWaterSub" FontSize="11" Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                                <!-- Its own daily trend, one measure at a time. Water is a fixed multiple of
                                     electricity, so overlaying them would draw the same curve twice. -->
                                <TextBlock x:Name="UsageFootprintTrendCaption" Text="ELECTRICITY PER DAY"
                                           Style="{StaticResource Caption}" Margin="0,18,0,2" />
                                <!-- Metric is set here as well as on the chip: the chip's Checked fires during
                                     InitializeComponent, before _ready, so the handler cannot be what establishes
                                     the initial state. Markup and chip must agree. -->
                                <ui:DailyTrend x:Name="UsageFootprintTrend" Metric="Energy" SurfaceKey="Bg2" />
                                <TextBlock x:Name="UsageFootprintNote" FontSize="11" Foreground="{StaticResource Faint}"
                                           TextWrapping="Wrap" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                CornerRadius="{StaticResource Rad10}" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock x:Name="UsageFootnote" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"
                                           Text="Costs are an estimate of what these tokens would bill at each provider's public list price, including the cheaper cache-write and cache-read rates. On a subscription you are not charged per token, so treat this as the value of the work rather than an invoice." />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource GhostButton}" Padding="11,6" Click="OnExportUsage"
                                            AutomationProperties.Name="Export usage history as CSV">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            <TextBlock Text="Export CSV" FontSize="11.5" Foreground="{StaticResource Text}" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Padding="11,6" Margin="6,0,0,0" Click="OnClearUsage"
                                            AutomationProperties.Name="Clear usage history">
                                        <TextBlock Text="Clear history" FontSize="11.5" Foreground="{StaticResource Red}" />
                                    </Button>
                                    <TextBlock x:Name="UsageStorageNote" FontSize="10.5" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- The live windows sit BELOW everything the range filter scopes, and outside its reach:
                             nothing in this group is filtered by it - these are actions, and both windows carry
                             their own range control. Reading order is the page's own numbers first, then the two
                             ways to leave them running on another screen. -->
                        <ui:SettingGroup Header="LIVE TELEMETRY" Margin="0,26,0,20">
                            <ui:SettingCard Glyph="&#xE9D9;" Title="Telemetry HUD"
                                            Description="A compact always-on-top window covering the last 24 hours — spend, tokens, electricity and water, throughput hour by hour, and the split by model. Built to be parked on a spare screen and left running. The full-screen wall shows the same telemetry over anything from the last hour to the last 30 days, and remembers the range you leave it on.">
                                <ui:SettingCard.Footer>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Padding="13,6" Click="OnOpenTelemetryHud"
                                                AutomationProperties.Name="Open the telemetry HUD">
                                            <TextBlock Text="Open HUD" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="13,6" Margin="8,0,0,0"
                                                Click="OnOpenTelemetryWall"
                                                AutomationProperties.Name="Open the full-screen telemetry wall">
                                            <TextBlock Text="Full-screen wall" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE83D;" Title="Agent activity monitor"
                                            Description="See each agent's current activity, step and stage. Reporting and event logging continue while the dashboard is closed. Open it whenever you want to view progress. Existing chats pick up setting changes on their next turn.">
                                <ToggleButton x:Name="MitreMonitorToggle" Style="{StaticResource Switch}"
                                              Checked="OnMitreMonitorChanged" Unchecked="OnMitreMonitorChanged"
                                              AutomationProperties.Name="Enable the agent activity dashboard" />
                                <ui:SettingCard.Footer>
                                    <Button Style="{StaticResource GhostButton}" Padding="13,6" HorizontalAlignment="Left"
                                            Click="OnOpenMitreMonitor" AutomationProperties.Name="Open the Agent activity monitor">
                                        <TextBlock Text="Open MITRE monitor" FontSize="12" />
                                    </Button>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE7F4;" Title="Open on the second display"
                                            Description="Sends it to whichever display VibeCode is not on, so watching it never means covering the thing it is reporting on. Drag it elsewhere and it stays there — this only decides where it goes when it would otherwise land on top of the app.">
                                <ToggleButton x:Name="TelemetryCompanionDisplayToggle" Style="{StaticResource Switch}"
                                              Checked="OnTelemetryCompanionDisplayChanged" Unchecked="OnTelemetryCompanionDisplayChanged"
                                              AutomationProperties.Name="Open telemetry on the second display" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE9D2;" Title="Live animation"
                                            Description="Bars and trend lines travel to each new reading instead of jumping to it, the headline figures count across, and the sparklines keep a slow ripple so a glance tells you the window is still live. Every figure still settles on the real one.">
                                <ToggleButton x:Name="TelemetryAnimationToggle" Style="{StaticResource Switch}"
                                              Checked="OnTelemetryAnimationChanged" Unchecked="OnTelemetryAnimationChanged"
                                              AutomationProperties.Name="Animate the telemetry windows" />
                            </ui:SettingCard>
                        </ui:SettingGroup>
                    </StackPanel>
                </ScrollViewer>

                <!-- Projects -->
                <ScrollViewer x:Name="PaneProjects" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="28,22,28,28" MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Text="Projects" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Control which projects and chats appear in the sidebar."
                                   Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,16" TextWrapping="Wrap" />

                        <TextBlock Text="SIDEBAR" Style="{StaticResource Caption}" />
                        <TextBlock Text="By default only chats you create or open in VibeCode are listed. Turn this on to browse your whole Claude Code history."
                                   Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,10" TextWrapping="Wrap" />
                        <CheckBox x:Name="ShowAllCheck" Content="Show all Claude Code projects" VerticalAlignment="Center" FontSize="12.5"
                                  Checked="OnShowAllChanged" Unchecked="OnShowAllChanged"
                                  AutomationProperties.Name="Show all Claude Code projects" />

                        <TextBlock Text="Your chats stay in the sidebar when you switch Claude, Codex or Grok accounts — each row shows the login it runs under, and it keeps running under that login. Turn this on for the old behaviour, where every account has its own separate workspace."
                                   Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,16,0,10" TextWrapping="Wrap" />
                        <CheckBox x:Name="IsolateChatsCheck" Content="Only show chats from the active account" VerticalAlignment="Center" FontSize="12.5"
                                  Checked="OnIsolateChatsChanged" Unchecked="OnIsolateChatsChanged"
                                  AutomationProperties.Name="Only show chats from the active account" />

                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,20" />

                        <!-- Restore all is the counterweight to the sidebar's Hide all: without it, one click of
                             that button costs one click per project to undo. It only appears when the search box
                             is not filtering, because "all" would then mean "all the ones you can see". -->
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="HIDDEN PROJECTS" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" DockPanel.Dock="Left" />
                            <Button x:Name="RestoreAllButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Padding="9,3" Click="OnRestoreAllProjects" Visibility="Collapsed"
                                    AutomationProperties.Name="Restore all hidden projects">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" FontSize="10.5"
                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RestoreAllLabel" Text="Restore all" FontSize="11.5"
                                               Foreground="{StaticResource Accent}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <TextBlock Text="Hover a project in the sidebar and hit ✕ to hide it, or use Hide all on the PROJECTS header. Restore any of them here."
                                   Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,10" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="HiddenSearch" FontSize="12.5" TextChanged="OnHiddenSearch" Padding="30,7,10,7"
                                     AutomationProperties.Name="Search hidden projects" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12"
                                       Foreground="{StaticResource Faint}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <TextBlock Text="Search hidden projects…" Foreground="{StaticResource Faint}" FontSize="12.5"
                                       Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource HintVisLocal}">
                                        <Binding Path="Text" ElementName="HiddenSearch" />
                                        <Binding Path="IsKeyboardFocusWithin" ElementName="HiddenSearch" />
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>

                        <Border x:Name="HiddenEmpty" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" CornerRadius="{StaticResource Rad12}" Padding="24" Margin="0,4,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="20"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="HiddenEmptyText" Text="Nothing hidden yet" Foreground="{StaticResource Muted}"
                                           FontSize="12.5" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Hover a project in the sidebar and hit ✕ to hide it." Foreground="{StaticResource Faint}"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="HiddenList" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                            CornerRadius="{StaticResource Rad10}" Padding="12,7" Margin="0,3">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,4"
                                                    Click="OnRestoreProject" AutomationProperties.Name="{Binding RestoreAutomationName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" FontSize="10.5"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Restore" FontSize="11.5" Foreground="{StaticResource Accent}"
                                                               Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                       Foreground="{StaticResource Faint}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Path}" FontSize="10" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- MCP servers -->
                <ScrollViewer x:Name="PaneMcp" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="28,22,28,28" MaxWidth="540" HorizontalAlignment="Left">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="13,7"
                                    Click="OnAddMcpServer" AutomationProperties.Name="Add MCP server">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="Add server" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="MCP servers" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="McpCountText" Text="No VibeCode servers" Foreground="{StaticResource Muted}"
                                           FontSize="11.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Create one VibeCode definition and choose which CLIs receive it. Claude, Codex, Kimi, and Grok remain the MCP clients; VibeCode translates their different launch formats without editing any provider's native config files."
                                   Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,13,0,0" TextWrapping="Wrap" />

                        <Border Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Rad10}" Padding="12,9" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Common path: stdio + Streamable HTTP" Foreground="{StaticResource Accent}"
                                           FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="Legacy SSE works in Claude, Kimi, and Grok but is skipped for Codex. Server changes apply when a chat next starts or reconnects."
                                           Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="OAuth sign-in remains provider-owned; the shared catalog supports environment-backed bearer tokens and static headers."
                                           Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="McpEmpty" Margin="0,30,0,0">
                            <TextBlock Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="26"
                                       Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                            <TextBlock Text="No universal MCP servers yet" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,9,0,0" />
                            <TextBlock Text="Provider-native MCP configuration is left untouched."
                                       Foreground="{StaticResource Faint}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <ItemsControl x:Name="McpList" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}" Checked="OnMcpEnabledChanged"
                                                              Unchecked="OnMcpEnabledChanged" AutomationProperties.Name="Enable MCP server" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Text}" />
                                                    <TextBlock Text="{Binding TransportLabel}" FontSize="10.5" Foreground="{StaticResource Accent}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding RuntimeNameLabel}" FontFamily="{StaticResource Mono}" FontSize="9.5"
                                                               Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Background="{StaticResource CodeBg}" CornerRadius="{StaticResource Rad7}" Padding="9,6" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding EndpointSummary}" FontFamily="{StaticResource Mono}" FontSize="10.5"
                                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <TextBlock Text="{Binding TargetsSummary}" FontSize="11" Foreground="{StaticResource Text}"
                                                       Margin="0,9,0,0" />
                                            <TextBlock Text="{Binding CompatibilityNote}" FontSize="10.5" Foreground="{StaticResource Faint}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <DockPanel Margin="0,11,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4"
                                                        Click="OnRemoveMcpServer" AutomationProperties.Name="Remove MCP server">
                                                    <TextBlock Text="Remove" Foreground="{StaticResource Red}" FontSize="11.5" />
                                                </Button>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                                        Click="OnEditMcpServer" AutomationProperties.Name="Edit MCP server">
                                                    <TextBlock Text="Edit" Foreground="{StaticResource Muted}" FontSize="11.5" />
                                                </Button>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Security boundary" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Only add servers you trust: stdio entries execute a local command, while remote entries can expose tools and data to the selected agent. Tool approvals still follow each chat's permission mode. Use ${TOKEN_NAME} references instead of pasting secrets when possible."
                                           FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Extensions -->
                <ScrollViewer x:Name="PaneExtensions" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,24,30,30" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Extensions" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Optional services and titlebar tools that run alongside Claude Code. Switching one off puts away everything it added."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,20" TextWrapping="Wrap" />

                        <!-- ===== Spotify ===== -->
                        <ui:ExtensionCard DataContext="{x:Static svc:SpotifyService.Instance}"
                                          Glyph="&#xEC4F;" Tint="{StaticResource SpotifyGreen}"
                                          TintSoft="{StaticResource SpotifyGreenSoft}"
                                          Title="Spotify" Description="Control playback from VibeCode"
                                          IsOn="{Binding Enabled}"
                                          OffHint="Turn on to connect your Spotify account and drive playback without leaving the app.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Checked="OnSpotifyEnabledChanged" Unchecked="OnSpotifyEnabledChanged"
                                          AutomationProperties.Name="Enable Spotify" />

                            <ui:ExtensionCard.Status>
                                <Grid Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource SpotifyGreenSoft}"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{StaticResource SpotifyGreen}" />
                                            <TextBlock Text="Connected" Style="{StaticResource PillText}"
                                                       Foreground="{StaticResource SpotifyGreen}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}"
                                            Visibility="{Binding IsConnected, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                        <TextBlock Text="Needs setup" Style="{StaticResource PillText}"
                                                   Foreground="{StaticResource Amber}" />
                                    </Border>
                                </Grid>
                            </ui:ExtensionCard.Status>

                            <ui:ExtensionCard.Body>
                                <!-- Two mutually exclusive halves, stacked: a Grid takes the height of whichever one
                                     is showing, because a collapsed child never gets measured. -->
                                <Grid>
                                    <!-- not connected: the two-step setup -->
                                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                        <TextBlock Style="{StaticResource Caption}" Text="1 — CREATE A FREE SPOTIFY APP" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0">
                                            <Run Text="At " /><Hyperlink Foreground="{StaticResource Accent}" Cursor="Hand"
                                                       Click="OnCopyDevLink" ToolTip="Copy link to clipboard">developer.spotify.com/dashboard</Hyperlink><Run Text=", add this exact Redirect URI:" />
                                        </TextBlock>
                                        <TextBlock x:Name="DevCopied" Text="&#x2713; Copied link to clipboard" FontSize="11"
                                                   Foreground="{StaticResource SpotifyGreen}" Margin="0,5,0,0" Visibility="Collapsed" />
                                        <Border Background="{StaticResource CodeBg}" CornerRadius="{StaticResource Rad8}"
                                                Padding="11,8" Margin="0,7,0,0">
                                            <TextBox Text="{Binding Source={x:Static svc:SpotifyService.RedirectUri}, Mode=OneWay}"
                                                     IsReadOnly="True" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                                     FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                     AutomationProperties.Name="Redirect URI" />
                                        </Border>

                                        <TextBlock Style="{StaticResource Caption}" Text="2 — PASTE ITS CLIENT ID" Margin="0,16,0,6" />
                                        <TextBox x:Name="ClientIdBox" FontSize="12.5" Padding="11,8" FontFamily="{StaticResource Mono}"
                                                 AutomationProperties.Name="Spotify Client ID" />

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="ConnectBtn" Style="{StaticResource PrimarySpotify}"
                                                    Click="OnSpotifyConnect" AutomationProperties.Name="Connect Spotify">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                               Foreground="White" VerticalAlignment="Center" />
                                                    <TextBlock Text="Connect Spotify" Foreground="White" FontWeight="SemiBold"
                                                               FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="ConnectStatus" Text="Not connected" FontSize="11.5"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Opens Spotify in your browser to authorize. Playback control requires Spotify Premium."
                                                   FontSize="11" Foreground="{StaticResource Faint}" Margin="0,11,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- connected: the player, and the way back out -->
                                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}">
                                        <Border Background="{StaticResource CodeBg}" CornerRadius="{StaticResource Rad10}" Padding="12">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Button Style="{StaticResource Transport}" Content="&#xE892;" Click="OnSpotifyPrev"
                                                            AutomationProperties.Name="Previous track" />
                                                    <Button Click="OnSpotifyToggle" Width="34" Height="34" Margin="4,0" Cursor="Hand"
                                                            AutomationProperties.Name="Play or pause">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="pc" Width="34" Height="34" CornerRadius="{StaticResource Rad17}"
                                                                        Background="{StaticResource SpotifyGreen}">
                                                                    <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="{StaticResource Icons}"
                                                                               FontSize="13" Foreground="White" HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="pc" Property="Background" Value="{StaticResource SpotifyGreenHover}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Style="{StaticResource Transport}" Content="&#xE893;" Click="OnSpotifyNext"
                                                            AutomationProperties.Name="Next track" />
                                                </StackPanel>
                                                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="{StaticResource Rad8}"
                                                        Background="{StaticResource Bg3}" Margin="0,0,12,0" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="17"
                                                                   Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Track}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Text}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               Visibility="{Binding HasTrack, Converter={StaticResource BoolVis}}" />
                                                    <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               Visibility="{Binding HasTrack, Converter={StaticResource BoolVis}}" />
                                                    <TextBlock Text="Nothing playing" FontSize="12.5" Foreground="{StaticResource Muted}"
                                                               Visibility="{Binding HasTrack, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}" />
                                                    <TextBlock Text="Start playback on any device" FontSize="11" Foreground="{StaticResource Faint}"
                                                               Visibility="{Binding HasTrack, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Button Style="{StaticResource Outline}" Content="Disconnect" Padding="11,5"
                                                HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnSpotifyDisconnect"
                                                AutomationProperties.Name="Disconnect Spotify" />
                                    </StackPanel>
                                </Grid>
                            </ui:ExtensionCard.Body>
                        </ui:ExtensionCard>

                        <!-- ===== Weather ===== -->
                        <ui:ExtensionCard DataContext="{x:Static svc:WeatherService.Instance}"
                                          Glyph="&#xE753;" Tint="{StaticResource WeatherBlue}"
                                          TintSoft="{StaticResource WeatherBlueSoft}"
                                          Title="Weather" Description="Conditions, NWS radar, and SPC Day 1–3 outlooks"
                                          IsOn="{Binding Enabled}"
                                          OffHint="Turn on to show U.S. or Canadian conditions next to the settings gear, and to open radar and SPC outlook maps.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Checked="OnWeatherEnabledChanged" Unchecked="OnWeatherEnabledChanged"
                                          AutomationProperties.Name="Enable weather" />

                            <ui:ExtensionCard.Status>
                                <Grid Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}"
                                            Visibility="{Binding HasLocation, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                        <TextBlock Text="No location" Style="{StaticResource PillText}"
                                                   Foreground="{StaticResource Amber}" />
                                    </Border>
                                </Grid>
                            </ui:ExtensionCard.Status>

                            <ui:ExtensionCard.Body>
                                <StackPanel>
                                    <!-- what the titlebar chip is showing right now. No reading yet simply says
                                         nothing at all: the titlebar chip is one line wide and has to print a
                                         placeholder, this card has the room not to. -->
                                    <DockPanel Margin="0,0,0,18"
                                               Visibility="{Binding HasLocation, Converter={StaticResource BoolVis}}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="Open maps"
                                                Margin="12,0,0,0" VerticalAlignment="Center" Click="OnOpenRadar"
                                                AutomationProperties.Name="Open weather maps" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding ConditionGlyph}"
                                                   FontFamily="{StaticResource Icons}" FontSize="19"
                                                   Foreground="{StaticResource WeatherBlue}" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Place}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0"
                                                       Visibility="{Binding HasReading, Converter={StaticResource BoolVis}}">
                                                <Run Text="{Binding TempText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Conditions, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Style="{StaticResource Caption}" Text="CHANGE LOCATION" Margin="0,0,0,7"
                                               Visibility="{Binding HasLocation, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="PICK A LOCATION" Margin="0,0,0,7"
                                               Visibility="{Binding HasLocation, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}" />

                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="Search"
                                                Padding="17,7" Margin="8,0,0,0" Click="OnWeatherSearch"
                                                AutomationProperties.Name="Search places" />
                                        <!-- The magnifier and the placeholder sit on top of the box rather than beside
                                             it, so the field reads as one control instead of a bare rectangle. -->
                                        <Grid>
                                            <TextBox x:Name="WeatherSearchBox" FontSize="12.5" Padding="33,7,10,7"
                                                     KeyDown="OnWeatherSearchKey" TextChanged="OnWeatherSearchTextChanged"
                                                     GotKeyboardFocus="OnWeatherSearchFocusChanged"
                                                     LostKeyboardFocus="OnWeatherSearchFocusChanged"
                                                     ToolTip="Type at least 3 characters for suggestions"
                                                     AutomationProperties.Name="Place search"
                                                     AutomationProperties.HelpText="Suggestions appear as you type" />
                                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                       Foreground="{StaticResource Faint}" IsHitTestVisible="False"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <!-- Driven from code-behind rather than by HintVisLocal: this lives in
                                                 the card's Body, so its logical parent is a ContentPresenter inside
                                                 the ExtensionCard TEMPLATE, and an ElementName binding resolves
                                                 against the template's namescope - where WeatherSearchBox is not. -->
                                            <TextBlock x:Name="WeatherSearchHint" Text="Search a U.S. or Canadian city"
                                                       FontSize="12.5" Foreground="{StaticResource Faint}"
                                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                                       Margin="34,0,0,0" TextWrapping="NoWrap" />
                                        </Grid>
                                    </DockPanel>

                                    <DockPanel Margin="0,9,0,0">
                                        <Button x:Name="WeatherLocationButton" DockPanel.Dock="Left"
                                                Style="{StaticResource Outline}" Padding="11,5" Click="OnWeatherGetLocation"
                                                ToolTip="Uses your approximate network location"
                                                AutomationProperties.Name="Get my location">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource Icons}" FontSize="11.5"
                                                           Foreground="{StaticResource WeatherBlue}" Margin="0,0,7,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Use my location" FontSize="11.5" Foreground="{StaticResource Text}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="WeatherStatus" FontSize="11" Foreground="{StaticResource Faint}"
                                                   Margin="11,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </DockPanel>

                                    <!-- Self-relative rather than ElementName for the same namescope reason as the
                                         placeholder above; Content is the ItemsControl, and HasItems notifies. -->
                                    <ScrollViewer Margin="0,10,0,0" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding Content.HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolVis}}">
                                        <ItemsControl x:Name="WeatherResults">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                            HorizontalAlignment="Stretch" Padding="11,7" Margin="0,0,0,2"
                                                            Click="OnWeatherPickPlace" AutomationProperties.Name="{Binding Display}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Display}" FontSize="12.5"
                                                                       Foreground="{StaticResource Text}" />
                                                            <TextBlock Text="{Binding Country}" FontSize="10.5"
                                                                       Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </ui:ExtensionCard.Body>
                        </ui:ExtensionCard>

                        <!-- ===== Speech to text (Groq) =====
                             Ships OFF: dictation already works offline with the local model, and this one uploads
                             the clip to a third party, so it stays opt-in and says so. -->
                        <ui:ExtensionCard DataContext="{x:Static svc:GroqSpeechService.Instance}"
                                          Glyph="&#xE720;" Title="Speech to text"
                                          Description="Groq's Whisper large-v3 instead of the offline medium.en"
                                          IsOn="{Binding Enabled}"
                                          OffHint="Off, the mic button transcribes on this machine with Whisper medium.en and no audio ever leaves it.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Checked="OnGroqSpeechEnabledChanged" Unchecked="OnGroqSpeechEnabledChanged"
                                          AutomationProperties.Name="Use Groq for speech to text" />

                            <ui:ExtensionCard.Status>
                                <Grid Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource GreenSoft}"
                                            Visibility="{Binding HasKey, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{StaticResource Green}" />
                                            <TextBlock Text="Key saved" Style="{StaticResource PillText}"
                                                       Foreground="{StaticResource Green}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}"
                                            Visibility="{Binding HasKey, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                        <TextBlock Text="Needs a key" Style="{StaticResource PillText}"
                                                   Foreground="{StaticResource Amber}" />
                                    </Border>
                                </Grid>
                            </ui:ExtensionCard.Status>

                            <ui:ExtensionCard.Body>
                                <StackPanel>
                                    <Grid>
                                        <!-- no key yet -->
                                        <StackPanel Visibility="{Binding HasKey, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}">
                                                <Run Text="Create a free key at " /><Hyperlink Foreground="{StaticResource Accent}" Cursor="Hand"
                                                           Click="OnCopyGroqKeyLink" ToolTip="Copy link to clipboard">console.groq.com/keys</Hyperlink><Run Text=" and paste it here. It starts with &quot;gsk_&quot;." />
                                            </TextBlock>
                                            <TextBlock x:Name="GroqLinkCopied" Text="&#x2713; Copied link to clipboard" FontSize="11"
                                                       Foreground="{StaticResource Green}" Margin="0,5,0,0" Visibility="Collapsed" />
                                            <TextBlock Style="{StaticResource Caption}" Text="GROQ API KEY" Margin="0,14,0,6" />
                                            <PasswordBox x:Name="GroqKeyBox" FontSize="12.5" Padding="11,8"
                                                         FontFamily="{StaticResource Mono}" Background="{StaticResource Bg2}"
                                                         Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                                         BorderThickness="1" CaretBrush="{StaticResource Text}"
                                                         AutomationProperties.Name="Groq API key" />
                                            <Button x:Name="GroqSaveBtn" Style="{StaticResource PrimaryAccent}"
                                                    Content="Verify and save" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                    Click="OnSaveGroqKey" AutomationProperties.Name="Verify and save Groq API key" />
                                            <TextBlock x:Name="GroqKeyStatus" Text="Dictation still runs offline until a key is saved."
                                                       FontSize="11.5" Foreground="{StaticResource Amber}" TextWrapping="Wrap"
                                                       Margin="0,9,0,0" />
                                        </StackPanel>

                                        <!-- key saved -->
                                        <DockPanel Visibility="{Binding HasKey, Converter={StaticResource BoolVis}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="Remove key"
                                                    Padding="11,5" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Click="OnRemoveGroqKey" AutomationProperties.Name="Remove Groq API key" />
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="12.5"
                                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                    </Grid>

                                    <TextBlock Text="The mic button works exactly as before — this only changes what does the transcribing. Your recording is uploaded to Groq and billed to your key; the offline path runs Whisper medium.en on this machine and never sends the audio anywhere, so switch this off for private dictation. Leaving it off downloads that model once, about 1.5 GB, the first time you dictate."
                                               FontSize="11" Foreground="{StaticResource Faint}" Margin="0,14,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:ExtensionCard.Body>
                        </ui:ExtensionCard>

                        <!-- ===== Games ===== Ships ON, so this mostly lets you turn the arcade off. -->
                        <ui:ExtensionCard DataContext="{x:Static svc:GamesService.Instance}"
                                          Glyph="&#x1F3AE;" GlyphFont="Segoe UI Emoji"
                                          Title="Games" Description="Controller icon in the title bar"
                                          IsOn="{Binding Enabled}"
                                          OffHint="Turn on to put a controller button in the title bar, with a small arcade behind it.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Checked="OnGamesEnabledChanged" Unchecked="OnGamesEnabledChanged"
                                          AutomationProperties.Name="Enable games" />
                            <!-- No body: there is nothing to configure once it is on, and a card whose only body is
                                 one dim sentence reads as an off-state hint that forgot to disappear. -->
                        </ui:ExtensionCard>

                        <!-- ===== Phone =====
                             Ships OFF: the phone button opens a window that can start a listening socket, so it stays
                             out of the titlebar until it is asked for. Turning this off again also stops the bridge -
                             see PhoneBridgeService.Enabled. -->
                        <ui:ExtensionCard DataContext="{x:Static svc:PhoneBridgeService.Instance}"
                                          Glyph="&#xE8EA;" Title="Phone"
                                          Description="Read and reply to your chats from your phone"
                                          IsOn="{Binding Enabled}"
                                          OffHint="Turn on to put a phone button in the title bar, where pairing and the bridge itself live.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Checked="OnPhoneEnabledChanged" Unchecked="OnPhoneEnabledChanged"
                                          AutomationProperties.Name="Enable phone" />
                            <ui:ExtensionCard.Body>
                                <StackPanel>
                                    <!-- Labelled, because StatusText is the socket's state ("Off"), not the
                                         extension's - unprefixed it reads as contradicting the switch above it. -->
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                                        <Run Text="Bridge · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="Pairing, the generated app, and the bridge itself all live in that window — turning this off closes the bridge too."
                                               FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </ui:ExtensionCard.Body>
                        </ui:ExtensionCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- Privacy -->
                <ScrollViewer x:Name="PanePrivacy" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="28,22,28,28" MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Text="Privacy" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Control what personal information VibeCode shows on screen."
                                   Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,16" TextWrapping="Wrap" />

                        <Border Style="{StaticResource Card}" Padding="16">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource Rad8}"
                                        Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="15"
                                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ToggleButton x:Name="HideEmailsToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" Margin="12,0,0,0" Checked="OnHideEmailsChanged"
                                              Unchecked="OnHideEmailsChanged" AutomationProperties.Name="Hide emails" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hide emails" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Removes account emails from detailed views so it's safe to screen-share. Account names and provider plans stay visible."
                                               FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- About -->
                <ScrollViewer x:Name="PaneAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="28,22,28,28" MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Text="About" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Width="44" Height="44" CornerRadius="{StaticResource Rad13}" Background="{StaticResource BrandGradient}">
                                <TextBlock Text="✦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="VibeCode" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="A fresh coat of paint for Claude Code" FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="AboutVersionText" Text="Version 1.0.0" FontSize="11.5"
                                           FontFamily="{StaticResource Mono}" Foreground="{StaticResource Faint}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,20" />
                        <TextBlock Text="Spotify is a trademark of Spotify AB. Playback control requires a Spotify Premium account and the Spotify Web API."
                                   FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
