<Window x:Class="VibeCode.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VibeCode.UI"
        xmlns:svc="clr-namespace:VibeCode.Services"
        Title="Settings" Icon="pack://application:,,,/VibeCode;component/Assets/logo.png"
        Width="900" Height="780" MinWidth="740" MinHeight="520"
        Background="{StaticResource Bg0}" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Ui}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False" PreviewKeyDown="OnSettingsSearchKeyDown"
        PreviewMouseWheel="OnSettingsPreviewMouseWheel">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:NonEmptyToVisibilityConverter x:Key="ShowIfLocal" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <ui:UpperCaseConverter x:Key="Upper" />

        <!-- category rail item: AccentSoft pill + accent indicator when selected -->
        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="pill" CornerRadius="{StaticResource Rad8}" Height="40" Background="Transparent">
                            <Grid>
                                <Rectangle x:Name="ind" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource Accent}" HorizontalAlignment="Left" Margin="4,0,0,0"
                                           Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" Margin="14,0,10,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{StaticResource Bg3}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="ind" Property="Visibility" Value="Visible" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource Accent}" />
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== the shared settings kit =====
             Everything below this line is the one definition of its control for the whole window: one switch,
             one dropdown, one slider, one text field, one button, one row. A page that needs a setting writes a
             ui:SettingCard and drops the control in; it does not style anything itself. Only Usage's charts and
             the inside of an extension or an MCP server are bespoke, because those are not settings rows.
             Every corner is a Rad* key, which the CLI theme squares to 0. -->

        <!-- keyboard focus, drawn the same way on every control this window styles -->
        <Style x:Key="SettingFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                CornerRadius="{StaticResource Rad13}" Margin="-3" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                CornerRadius="{StaticResource Rad14}" Margin="-3" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- on/off switch; green when on. The only boolean control in Settings. -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SwitchFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="40" Height="22" CornerRadius="{StaticResource Rad11}" Background="{StaticResource Bg3}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="{StaticResource Muted}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource SpotifyGreen}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource SpotifyGreen}" />
                                <Setter TargetName="knob" Property="Fill" Value="White" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the "i" beside a title: the explanation that used to be printed under every row -->
        <Style TargetType="ui:InfoTip">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="More information" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:InfoTip">
                        <Border x:Name="hit" Background="Transparent" CornerRadius="{StaticResource Rad99}">
                            <TextBlock x:Name="glyph" Text="&#xE946;" FontFamily="{StaticResource Icons}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="Normal"
                                       Foreground="{StaticResource Faint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="hit" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="hit" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- the chevron on a dropdown row (MCP servers, Hidden projects) -->
        <Style x:Key="SettingChevron" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Rad8}">
                            <TextBlock x:Name="glyph" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                       Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="glyph" Property="Text" Value="&#xE70E;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== one setting, one shape =====
             tile | title + info | status | control | value | chevron, then an optional full-width footer.
             The explanation is never printed: it is the info button's tooltip. -->
        <Style TargetType="ui:SettingCard">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="GlyphFont" Value="{StaticResource Icons}" />
            <Setter Property="Tint" Value="{StaticResource Accent}" />
            <Setter Property="TintSoft" Value="{StaticResource AccentSoft}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:SettingCard">
                        <Border x:Name="row" Background="Transparent"
                                BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,1,0,0">
                            <Grid>
                                <!-- inset and rounded, so neither ever pokes through the card's own corners -->
                                <Border x:Name="PART_Highlight" Background="{StaticResource AccentSoft}" Opacity="0"
                                        CornerRadius="{StaticResource Rad8}" Margin="4,3" IsHitTestVisible="False" />
                                <StackPanel>
                                    <Grid>
                                        <Border x:Name="hover" Background="{StaticResource Bg3}" Visibility="Collapsed"
                                                CornerRadius="{StaticResource Rad8}" Margin="4,3" IsHitTestVisible="False" />
                                        <Border x:Name="PART_Header" Background="Transparent" Padding="15,9">
                                            <Grid MinHeight="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="tile" Width="30" Height="30" Margin="0,0,13,0"
                                                        CornerRadius="{StaticResource Rad8}" VerticalAlignment="Center"
                                                        Background="{TemplateBinding TintSoft}">
                                                    <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{TemplateBinding GlyphFont}"
                                                               FontSize="14" Foreground="{TemplateBinding Tint}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <!-- Left-aligned, so the star column is only as wide as the title and the info
                                                     button sits right after it; when the title has to wrap, the button stays
                                                     beside the block instead of dropping onto a line of its own. -->
                                                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="title" Text="{TemplateBinding Title}" FontSize="13"
                                                               Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <ui:InfoTip Grid.Column="1" Text="{TemplateBinding Description}" />
                                                </Grid>
                                                <ContentPresenter Grid.Column="2" ContentSource="Status" Margin="12,0,0,0"
                                                                  VerticalAlignment="Center" />
                                                <ContentPresenter Grid.Column="3" Margin="12,0,0,0"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                <TextBlock x:Name="value" Grid.Column="4" Text="{TemplateBinding ValueText}"
                                                           MinWidth="42" Margin="8,0,0,0" TextAlignment="Right" TextWrapping="NoWrap"
                                                           FontFamily="{StaticResource Mono}" FontSize="12"
                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                <ToggleButton x:Name="chevron" Grid.Column="5" Style="{StaticResource SettingChevron}"
                                                              Margin="6,0,-5,0" Visibility="Collapsed"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Show or hide {0}'}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <!-- Follows its content's own Visibility, so a footer that is only a status line
                                         costs no space while that line has nothing to say. -->
                                    <ContentPresenter x:Name="footer" ContentSource="Footer" Margin="58,1,15,14"
                                                      Visibility="{Binding Footer.Visibility, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Visible}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ShowDivider" Value="False">
                                <Setter TargetName="row" Property="BorderThickness" Value="0" />
                            </Trigger>
                            <Trigger Property="ValueText" Value="">
                                <Setter TargetName="value" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Glyph" Value="{x:Null}">
                                <Setter TargetName="tile" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="footer" Property="Margin" Value="15,1,15,14" />
                            </Trigger>
                            <Trigger Property="Footer" Value="{x:Null}">
                                <Setter TargetName="footer" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="footer" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsExpandable" Value="True">
                                <Setter TargetName="chevron" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Header" Property="Cursor" Value="Hand" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsExpandable" Value="True" />
                                    <Condition SourceName="PART_Header" Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="hover" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="row" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a captioned run of setting rows sharing one card, hairline-divided -->
        <Style TargetType="ui:SettingGroup">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:SettingGroup">
                        <StackPanel>
                            <StackPanel x:Name="header" Orientation="Horizontal" Margin="2,0,0,5">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                           Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Upper}}" />
                                <ui:InfoTip Width="17" Height="17" FontSize="11" Margin="3,0,0,0"
                                            Text="{TemplateBinding Description}" />
                            </StackPanel>
                            <Grid>
                                <Border Style="{StaticResource Card}">
                                    <ItemsPresenter />
                                </Border>
                                <Border x:Name="PART_Highlight" BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                        CornerRadius="{StaticResource Rad12}" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Header" Value="">
                                <Setter TargetName="header" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a page's title -->
        <Style TargetType="ui:SettingHeading">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:SettingHeading">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Title}" FontFamily="{StaticResource Display}" FontSize="19"
                                       FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                            <ui:InfoTip Width="22" Height="22" FontSize="13.5" Margin="7,1,0,0"
                                        Text="{TemplateBinding Description}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every page: the same margins, the same measure. The right margin is 10 short of the left because each
             pane keeps its scrollbar gutter permanently - with an Auto scrollbar a page that scrolls came out
             narrower than one that does not, and the content jumped sideways between categories. -->
        <Style TargetType="ui:SettingPage">
            <Setter Property="Margin" Value="28,22,18,28" />
        </Style>

        <!-- ===== the one dropdown =====
             The theme's own ComboBox (so CLI mode stays CLI), sized for the control slot. -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <!-- the window at its narrowest: give the title its room back -->
                <Trigger Property="ui:SettingPage.IsCompact" Value="True">
                    <Setter Property="Width" Value="190" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- one line, trimmed: the implicit TextBlock wraps, and a long voice name must not grow the box -->
        <Style x:Key="PickerText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Notification sound rows. The play button lets a sound be auditioned without committing to it; it
             only exists inside the open list, because in the collapsed box it would be dead chrome. -->
        <DataTemplate x:Key="SoundPickerRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" Margin="-3,0,7,0"
                        Click="OnPlayNotificationSoundRow" ToolTip="Play this sound"
                        AutomationProperties.Name="Play this sound"
                        Visibility="{Binding Path=(ui:SettingPicker.IsDropDownRow), RelativeSource={RelativeSource Self}, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="11" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource PickerText}" />
                <TextBlock Grid.Column="2" Text="{Binding Badge}" VerticalAlignment="Center"
                           Foreground="{StaticResource Faint}" FontSize="10" Margin="8,0,2,0" />
            </Grid>
        </DataTemplate>

        <Style x:Key="SoundPickerOption" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="ui:SettingPicker.IsDropDownRow" Value="True" />
        </Style>

        <!-- ===== the one slider ===== -->
        <Style TargetType="Slider" BasedOn="{StaticResource DimSlider}">
            <Setter Property="Width" Value="160" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingFocusVisual}" />
            <Style.Triggers>
                <Trigger Property="ui:SettingPage.IsCompact" Value="True">
                    <Setter Property="Width" Value="112" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== the one text field =====
             The theme's TextBox pads its content host AND lets WPF pad it again, so a field came out twice as
             tall as its Padding said. This one pads once. -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Rad10}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Rad10}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== the one search field =====
             Magnifier, placeholder (the Tag), text and clear button are one template, so the placeholder and
             the caret share an origin by construction. They used to be three elements overlaid on a TextBox,
             and because that TextBox padded twice the caret landed 35px to the right of the words it was
             meant to replace - a blue line blinking in the middle of "Search settings…". The placeholder
             leaves as soon as the field is focused. -->
        <Style x:Key="SearchField" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Rad10}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           Foreground="{StaticResource Faint}" Margin="11,0,6,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <!-- 2px: where the text view starts drawing inside its host -->
                                <TextBlock x:Name="hint" Grid.Column="1" Grid.ColumnSpan="2" Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource Faint}" Margin="2,0,8,0" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                                <Button x:Name="clear" Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Width="24" Height="24" Padding="0" Focusable="False" Cursor="Hand"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Click="OnSearchFieldClear" ToolTip="Clear (Esc)"
                                        AutomationProperties.Name="Clear search">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" />
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="clear" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                    <Condition Property="IsKeyboardFocused" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== the one "pick one of a few" control: chips in a segmented tray ===== -->
        <Style x:Key="Segmented" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="CornerRadius" Value="{StaticResource Rad10}" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingFocusVisual}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" CornerRadius="{StaticResource Rad8}" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="label" Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{StaticResource Muted}" TextWrapping="NoWrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource Bg3}" />
                                <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="label" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== the one button =====
             The theme's own button at control-slot size: secondary by default, one Primary per flow. -->
        <Style x:Key="SettingButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingFocusVisual}" />
        </Style>

        <Style x:Key="SettingButtonPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingFocusVisual}" />
        </Style>

        <!-- a glyph-only button (play, stop) -->
        <Style x:Key="SettingIconButton" TargetType="Button" BasedOn="{StaticResource SettingButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Spotify's own primary: its brand green, where an accent-coloured button would read as ours -->
        <Style x:Key="SettingButtonSpotify" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="{StaticResource SpotifyGreen}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="sb" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Rad10}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sb" Property="Background" Value="{StaticResource SpotifyGreenHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sb" Property="Background" Value="{StaticResource SpotifyGreenPress}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="sb" Property="Background" Value="{StaticResource Overlay}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- circular transport button (prev / next), ghost -->
        <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <!-- State pill beside a switch. Only ever says something the switch cannot ("Connected", "Needs a key"),
             so it is never the same word twice on one row. -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Rad99}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- a plain-text readout in a row's status slot ("3 servers", "Bridge · Off") -->
        <Style x:Key="RowStatus" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- one line of live feedback under a row ("Playing voice preview…"). Gone while it has nothing to say. -->
        <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource ShowIfLocal}}" />
        </Style>

        <!-- an item inside a dropdown row's list (an MCP server, a hidden project): inset against the card -->
        <Style x:Key="InsetItem" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Rad10}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- titlebar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitlebarClose}" Content="&#xE8BB;"
                        Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close settings" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Wide enough for the longest label ("MCP & extensions") in CLI mode's monospace face, which
                     is noticeably wider than the default UI font, and for the search placeholder above it. -->
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== search + category rail ===== -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBox x:Name="SettingsSearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchField}"
                             Margin="10,12,10,4" Background="{StaticResource Bg0}" Tag="Search settings…"
                             TextChanged="OnSettingsSearchChanged" ToolTip="Search every category (Ctrl+F)"
                             AutomationProperties.Name="Search settings" />
                    <ListBox x:Name="Rail" Background="Transparent" BorderThickness="0" Padding="0,6"
                             ItemContainerStyle="{StaticResource RailItem}" SelectionChanged="OnRailChanged"
                             SelectedIndex="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem AutomationProperties.Name="General">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="General" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Appearance">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE771;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Appearance" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Bridge and agents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Bridge &amp; agents" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Jarvis">
                            <StackPanel Orientation="Horizontal">
                                <ui:JarvisOrb Width="22" Height="22" Margin="-2,0,2,0" />
                                <TextBlock Text="Jarvis" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="MCP and extensions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA86;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="MCP &amp; extensions" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="Usage">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Usage" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== content panes ===== -->
            <Grid Grid.Column="1">
                <Grid x:Name="SettingsSearchPane" Visibility="Collapsed" Margin="28,22,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Search results" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="SettingsSearchCount" Grid.Row="1" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="0,6,0,12" AutomationProperties.LiveSetting="Polite" />
                    <ListBox x:Name="SettingsSearchResults" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Settings search results">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,8,4" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="result" Background="Transparent" CornerRadius="{StaticResource Rad8}">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="result" Property="Background" Value="{StaticResource Bg3}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="result" Property="Background" Value="{StaticResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                        Padding="12,9" Focusable="False" Click="OnOpenSettingsSearchResult"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13" />
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Accent}" FontSize="11"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11.5"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                   Visibility="{Binding Description, Converter={StaticResource ShowIfLocal}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="SettingsSearchEmpty" Grid.Row="2" VerticalAlignment="Top" Margin="2,8,12,0"
                               Text="No settings match. Try a different word or clear the search."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>

                <!-- ============================== General ==============================
                     Also home to what used to be the Notifications, Privacy, Projects and About categories:
                     each was one to four rows, which is a group, not a page. Their sections keep an x:Name so
                     search and Jarvis can still land on them (see SelectCategory). -->
                <ScrollViewer x:Name="PaneGeneral" VerticalScrollBarVisibility="Visible">
                    <ui:SettingPage>
                        <ui:SettingHeading Title="General" />

                        <ui:SettingGroup Header="App" Keywords="window close chats recovery">
                            <ui:SettingCard Glyph="&#xE777;" Title="Continue after limit resets"
                                            Keywords="usage limit rate quota resume recovery"
                                            Description="Automatically continue chats stopped by a usage limit when allowance returns. Applies to all providers, normal chats, and regular and Advanced Bridges while VibeCode is open.">
                                <ToggleButton x:Name="ContinueAfterLimitResetsToggle" Style="{StaticResource Switch}"
                                              Checked="OnContinueAfterLimitResetsChanged" Unchecked="OnContinueAfterLimitResetsChanged"
                                              AutomationProperties.Name="Continue after limit resets" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE7C4;" Title="Run in background"
                                            Keywords="tray notification area close quit minimise minimize"
                                            Description="On: closing the window puts VibeCode in the notification area and every chat and Bridge peer keeps coding. Click the icon to bring the window back, or right-click it to quit. Off: the close button ends VibeCode there and then, and every running agent with it.&#x0a;&#x0a;Notifications are the way a background VibeCode reaches you — turn on “When a chat finishes” below and a finished agent will still say so with no window open.">
                                <ToggleButton x:Name="RunInBackgroundToggle" Style="{StaticResource Switch}"
                                              Checked="OnRunInBackgroundChanged" Unchecked="OnRunInBackgroundChanged"
                                              AutomationProperties.Name="Run in background" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup x:Name="SectionNotifications" Header="Notifications"
                                         Keywords="toast alert desktop sound chime"
                                         Description="Both toasts are off by default. A toast is only ever shown when the chat it concerns is not already fully visible on your screen, so you are never told about something that is right in front of you.">
                            <ui:SettingCard Glyph="&#xE7ED;" Title="When a chat finishes"
                                            Description="Fires whenever any chat or Bridge agent finishes its turn — the agent's name (or the chat) plus a snippet of the reply.">
                                <ToggleButton x:Name="NotifyTurnEndToggle" Style="{StaticResource Switch}"
                                              Checked="OnNotifyTurnEndChanged" Unchecked="OnNotifyTurnEndChanged"
                                              AutomationProperties.Name="Notify when a chat finishes" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE9CE;" Title="When an agent is waiting on you"
                                            Description="Fires when an agent stops to ask a question, present a plan, or request permission — so it never sits blocked while you are in another app.">
                                <ToggleButton x:Name="NotifyAwaitingInputToggle" Style="{StaticResource Switch}"
                                              Checked="OnNotifyAwaitingInputChanged" Unchecked="OnNotifyAwaitingInputChanged"
                                              AutomationProperties.Name="Notify when an agent is waiting on you" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE767;" Title="Notification sound" Keywords="ringtone audio preview play"
                                            Description="Pick any chime to hear it straight away — the preview is the same sound a real toast plays, at the same volume. Thirty are built in.">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SettingIconButton}" Content="&#xE768;"
                                            Click="OnPreviewNotificationSound" ToolTip="Play the selected sound"
                                            AutomationProperties.Name="Play the selected notification sound" />
                                    <ComboBox x:Name="NotificationSoundPicker" Margin="6,0,0,0"
                                              ItemTemplate="{StaticResource SoundPickerRow}"
                                              ItemContainerStyle="{StaticResource SoundPickerOption}"
                                              TextSearch.TextPath="Name"
                                              SelectionChanged="OnNotificationSoundChanged"
                                              AutomationProperties.Name="Notification sound" />
                                </StackPanel>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE838;" Title="Your own sounds" Keywords="custom mp3 wav folder import add"
                                            Description="Drop MP3 or WAV files into the sounds folder (%APPDATA%\VibeCode\Sounds), then hit Rescan — they join the dropdown above, tagged as yours.">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SettingButton}" Content="Open folder"
                                            Click="OnOpenSoundsFolder" AutomationProperties.Name="Open the sounds folder" />
                                    <Button Style="{StaticResource SettingButton}" Content="Rescan" Margin="6,0,0,0"
                                            Click="OnRescanSounds" AutomationProperties.Name="Rescan the sounds folder" />
                                </StackPanel>
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup x:Name="SectionPrivacy" Header="Privacy" Keywords="screen share mask">
                            <ui:SettingCard Glyph="&#xE72E;" Title="Hide emails"
                                            Description="Removes account emails from detailed views so it's safe to screen-share. Account names and provider plans stay visible.">
                                <ToggleButton x:Name="HideEmailsToggle" Style="{StaticResource Switch}"
                                              Checked="OnHideEmailsChanged" Unchecked="OnHideEmailsChanged"
                                              AutomationProperties.Name="Hide emails" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup x:Name="SectionProjects" Header="Projects"
                                         Keywords="sidebar chats accounts hidden restore">
                            <ui:SettingCard Glyph="&#xE8B7;" Title="Show all Claude Code projects"
                                            Description="By default only chats you create or open in VibeCode are listed. Turn this on to browse your whole Claude Code history.">
                                <ToggleButton x:Name="ShowAllCheck" Style="{StaticResource Switch}"
                                              Checked="OnShowAllChanged" Unchecked="OnShowAllChanged"
                                              AutomationProperties.Name="Show all Claude Code projects" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE77B;" Title="Only show chats from the active account"
                                            Description="Your chats stay in the sidebar when you switch Claude, Codex or Grok accounts — each row shows the login it runs under, and it keeps running under that login. Turn this on for the old behaviour, where every account has its own separate workspace.">
                                <ToggleButton x:Name="IsolateChatsCheck" Style="{StaticResource Switch}"
                                              Checked="OnIsolateChatsChanged" Unchecked="OnIsolateChatsChanged"
                                              AutomationProperties.Name="Only show chats from the active account" />
                            </ui:SettingCard>
                            <!-- A dropdown, like MCP servers: a list you manage, not a setting you glance at.
                                 Restore all is the counterweight to the sidebar's Hide all: without it, one click
                                 of that button costs one click per project to undo. It only appears when the
                                 search box is not filtering, because "all" would then mean "all the ones you can
                                 see". -->
                            <ui:SettingCard x:Name="HiddenProjectsCard" Glyph="&#xED1A;" Title="Hidden projects"
                                            IsExpandable="True" IsExpanded="False"
                                            Description="Hover a project in the sidebar and hit ✕ to hide it, or use Hide all on the PROJECTS header. Restore any of them here.">
                                <ui:SettingCard.Status>
                                    <TextBlock x:Name="HiddenCountText" Style="{StaticResource RowStatus}" Text="None" />
                                </ui:SettingCard.Status>
                                <Button x:Name="RestoreAllButton" Style="{StaticResource SettingButton}"
                                        Click="OnRestoreAllProjects" Visibility="Collapsed"
                                        AutomationProperties.Name="Restore all hidden projects">
                                    <TextBlock x:Name="RestoreAllLabel" Text="Restore all" FontSize="12" TextWrapping="NoWrap" />
                                </Button>
                                <ui:SettingCard.Footer>
                                    <StackPanel>
                                        <TextBox x:Name="HiddenSearch" Style="{StaticResource SearchField}" Margin="0,0,0,8"
                                                 Tag="Search hidden projects…" TextChanged="OnHiddenSearch"
                                                 AutomationProperties.Name="Search hidden projects" />
                                        <Border x:Name="HiddenEmpty">
                                            <TextBlock x:Name="HiddenEmptyText" Text="Nothing hidden yet"
                                                       Foreground="{StaticResource Muted}" FontSize="11.5" />
                                        </Border>
                                        <ItemsControl x:Name="HiddenList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource InsetItem}" Padding="11,5,5,5" Margin="0,0,0,5">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,4"
                                                                    Click="OnRestoreProject" AutomationProperties.Name="{Binding RestoreAutomationName}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" FontSize="10.5"
                                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Restore" FontSize="11.5" Foreground="{StaticResource Accent}"
                                                                               Margin="6,0,0,0" />
                                                                </StackPanel>
                                                            </Button>
                                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                                       Foreground="{StaticResource Faint}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                                <TextBlock Text="{Binding Path}" FontSize="10" FontFamily="{StaticResource Mono}"
                                                                           Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup x:Name="SectionAbout" Header="About" Keywords="version build application">
                            <ui:SettingCard Glyph="✦" GlyphFont="{StaticResource Ui}" Tint="White"
                                            TintSoft="{StaticResource BrandGradient}" Title="VibeCode"
                                            Description="A fresh coat of paint for Claude Code.&#x0a;&#x0a;Spotify is a trademark of Spotify AB. Playback control requires a Spotify Premium account and the Spotify Web API.">
                                <TextBlock x:Name="AboutVersionText" Text="Version 1.0.0" FontSize="12"
                                           FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"
                                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                            </ui:SettingCard>
                        </ui:SettingGroup>
                    </ui:SettingPage>
                </ScrollViewer>

                <!-- ============================== Appearance ============================== -->
                <ScrollViewer x:Name="PaneAppearance" VerticalScrollBarVisibility="Visible" Visibility="Collapsed">
                    <ui:SettingPage>
                        <ui:SettingHeading Title="Appearance" Keywords="theme terminal CLI look background" />

                        <ui:SettingGroup Header="Theme">
                            <ui:SettingCard Glyph="&#xE790;" Title="Mode" Keywords="theme terminal cli custom background skin look"
                                            Description="Custom background is the standard look: art behind the chat, soft cards, rounded corners. CLI is the terminal look: cmd-style grey on black, monospace, hard edges. Same features either way.&#x0a;&#x0a;Switching re-skins VibeCode straight away. Running chats keep running — nothing restarts.">
                                <Border Style="{StaticResource Segmented}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeCardBackground" Style="{StaticResource Chip}"
                                                     Content="Custom background" Click="OnPickMode"
                                                     AutomationProperties.Name="Custom background mode" />
                                        <RadioButton x:Name="ModeCardCli" Style="{StaticResource Chip}"
                                                     Content="CLI" Click="OnPickMode"
                                                     AutomationProperties.Name="CLI mode" />
                                    </StackPanel>
                                </Border>
                            </ui:SettingCard>
                            <!-- Borderless belongs to Custom background: it is the background art it uncovers.
                                 RefreshModeCards() hides the row in CLI mode rather than greying it out. -->
                            <ui:SettingCard x:Name="BorderlessSection" Glyph="&#xE737;" Title="Borderless"
                                            Keywords="surfaces panels transparent outline"
                                            Description="Drops the grey panels. The titlebar, sidebar, chat and every Bridge pane stop painting themselves, so your background is the background of the whole window and each region is picked out by a thin black outline instead. Tool activity rows also lose their fill and outline. Your messages and code blocks keep their fill so they stay readable — turn Art visibility down if a busy image fights the text.">
                                <ToggleButton x:Name="BorderlessToggle" Style="{StaticResource Switch}"
                                              Checked="OnBorderlessChanged" Unchecked="OnBorderlessChanged"
                                              AutomationProperties.Name="Borderless" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="Chat">
                            <ui:SettingCard Glyph="&#xE8A7;" Title="Compact mode" Keywords="group tools commands collapse dense"
                                            Description="Groups consecutive bash commands, edits, web searches, and MCP/browser calls. Open a group for the one-line activity list, then open any row for full details.">
                                <ToggleButton x:Name="CompactModeToggle" Style="{StaticResource Switch}"
                                              Checked="OnCompactModeChanged" Unchecked="OnCompactModeChanged"
                                              AutomationProperties.Name="Compact mode" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE8FD;" Title="Agent message dividers" Keywords="separator lines bridge terminal"
                                            Description="Show separator lines between agent messages in the shared Bridge terminal.">
                                <ToggleButton x:Name="AgentMessageDividersToggle" Style="{StaticResource Switch}"
                                              Checked="OnAgentMessageDividersChanged" Unchecked="OnAgentMessageDividersChanged"
                                              AutomationProperties.Name="Agent message dividers" />
                            </ui:SettingCard>
                            <!-- The one row in this window whose control cannot be a dropdown: you choose an
                                 animation by watching it, so every option stays on screen and moving. -->
                            <ui:SettingCard x:Name="ThinkingOrbSetting" Glyph="&#xE9D9;" Title="Thinking orbs"
                                            Keywords="spinner animation globe gyroscope atom morph nebula spark"
                                            Description="Choose the animation shown while an agent is thinking. Applies to every chat and Bridge pane. The small orb on the right is your choice at the size it has in a chat.">
                                <ui:OrbitSpinner Width="22" Height="22" Ink="{DynamicResource Accent}"
                                                 VerticalAlignment="Center" />
                                <ui:SettingCard.Footer>
                                    <ListBox x:Name="ThinkingOrbPicker" SelectionMode="Single"
                                             SelectionChanged="OnThinkingOrbChanged"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             KeyboardNavigation.DirectionalNavigation="Contained"
                                             AutomationProperties.Name="Thinking orb style"
                                             AutomationProperties.HelpText="Select an orb to use its animation in all chats.">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- three across; two when the window is at its narrowest, where a third
                                                     column would cut "Gyroscope" short -->
                                                <UniformGrid>
                                                    <UniformGrid.Style>
                                                        <Style TargetType="UniformGrid">
                                                            <Setter Property="Columns" Value="3" />
                                                            <Style.Triggers>
                                                                <Trigger Property="ui:SettingPage.IsCompact" Value="True">
                                                                    <Setter Property="Columns" Value="2" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </UniformGrid.Style>
                                                </UniformGrid>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Margin" Value="0,0,4,4" />
                                                <Setter Property="Padding" Value="7,8" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="ToolTip" Value="{Binding Description}" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="option" Background="Transparent"
                                                                    BorderBrush="Transparent" BorderThickness="1"
                                                                    CornerRadius="{StaticResource Rad8}" Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="14" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter />
                                                                    <TextBlock x:Name="selected" Grid.Column="1" Text="&#xE73E;"
                                                                               FontFamily="{StaticResource Icons}" FontSize="10"
                                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                                               HorizontalAlignment="Right" Visibility="Collapsed" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="option" Property="Background" Value="{StaticResource Bg3}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="option" Property="Background" Value="{StaticResource AccentSoft}" />
                                                                    <Setter TargetName="selected" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="option" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:OrbitSpinner Width="32" Height="32" StyleKind="{Binding Style}"
                                                                     Ink="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                               Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="3,0,2,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <TextBlock x:Name="CliModeHint" Visibility="Collapsed"
                                   Text="Backgrounds are off in CLI mode — the terminal stays flat black."
                                   Foreground="{StaticResource Faint}" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap" />
                        <ui:SettingGroup x:Name="BackgroundSection" Header="Background"
                                         Keywords="wallpaper gif animation opacity random art image"
                                         Description="GIFs animate; added images are copied into VibeCode's own folder.">
                            <ui:SettingCard Glyph="&#xE8B9;" Title="Background image" Keywords="picture gallery add remove"
                                            Description="The art behind the chat. Click an image to use it; hover one you added to remove it.">
                                <Button Style="{StaticResource SettingButton}" Content="Add image…" Click="OnAddBackground"
                                        AutomationProperties.Name="Add background" />
                                <ui:SettingCard.Footer>
                                    <ItemsControl x:Name="BgList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="OnPickBackground" Cursor="Hand" Margin="0,0,8,8" Padding="0"
                                                        FocusVisualStyle="{StaticResource SettingFocusVisual}"
                                                        AutomationProperties.Name="{Binding AutomationName}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="card" Width="132" Height="92" CornerRadius="{StaticResource Rad10}" BorderThickness="2"
                                                                    BorderBrush="{StaticResource BorderSoft}" Background="{StaticResource CodeBg}">
                                                                <Grid>
                                                                    <Border CornerRadius="{StaticResource Rad8}" Margin="1">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <Border VerticalAlignment="Bottom" CornerRadius="{StaticResource RadBottom10}" Padding="8,3">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="#CC17181B" />
                                                                        </Border.Background>
                                                                        <DockPanel>
                                                                            <TextBlock x:Name="check" DockPanel.Dock="Right" Text="&#xE73E;"
                                                                                       FontFamily="{StaticResource Icons}" FontSize="11"
                                                                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                                                       Visibility="Collapsed" />
                                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                        </DockPanel>
                                                                    </Border>
                                                                    <Button x:Name="remove" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                            Margin="0,6,6,0" Width="24" Height="24" Padding="0" Content="&#xE711;"
                                                                            FontFamily="{StaticResource Icons}" FontSize="9" Click="OnRemoveBackground"
                                                                            Visibility="Collapsed" ToolTip="Remove"
                                                                            AutomationProperties.Name="{Binding RemoveAutomationName}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="rb" Background="#B01A1A1D" CornerRadius="{StaticResource Rad7}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="rb" Property="Background" Value="{StaticResource Red}" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                    <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                        <Condition Binding="{Binding IsBuiltin}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="remove" Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE8B1;" Title="Random on launch" Keywords="shuffle pick"
                                            Description="Each launch shows one image picked at random from this gallery, the built-in one included. It takes effect once you have added at least one image of your own.">
                                <ToggleButton x:Name="RandomCheck" Style="{StaticResource Switch}"
                                              Checked="OnRandomChanged" Unchecked="OnRandomChanged"
                                              AutomationProperties.Name="Random background" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE706;" Title="Art visibility" Keywords="opacity dim brightness"
                                            ValueText="{Binding Value, ElementName=VisSlider, StringFormat={}{0:0}%}"
                                            Description="How much of the art shows through. Chat dims the art a little extra so messages stay readable (80% is the max).">
                                <Slider x:Name="VisSlider" Minimum="0" Maximum="80" SmallChange="1" LargeChange="10"
                                        ValueChanged="OnVisibilityChanged" AutomationProperties.Name="Art visibility" />
                            </ui:SettingCard>
                        </ui:SettingGroup>
                    </ui:SettingPage>
                </ScrollViewer>

                <!-- ============================== Bridge & agents ============================== -->
                <ScrollViewer x:Name="PaneBridge" VerticalScrollBarVisibility="Visible" Visibility="Collapsed">
                    <ui:SettingPage>
                        <ui:SettingHeading Title="Bridge &amp; agents"
                                           Keywords="bridge agents peer messages mailbox unread read answered swarm workers supervision"
                                           Description="How many agents may run together, how much they tell each other, and whether one chat can command child workers of its own." />

                        <ui:SettingGroup Header="Bridge">
                            <ui:SettingCard Glyph="&#xE7F4;" Title="Maximum agents per Bridge" Keywords="limit count"
                                            ValueText="{Binding Value, ElementName=BridgeAgentLimitSlider, StringFormat={}{0:0}}"
                                            Description="Each Bridge can grow to this many agents. Lowering the limit never closes agents that are already running. Nine is the default.">
                                <Slider x:Name="BridgeAgentLimitSlider" Minimum="4" Maximum="17" TickFrequency="1"
                                        IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                        ValueChanged="OnBridgeAgentLimitChanged"
                                        AutomationProperties.Name="Maximum agents per Bridge" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE72D;" Title="Real-time sharing" Keywords="live activity board files"
                                            Description="Agents also keep a live-activity board: which files each one is editing right now and what it is adding there, rewritten in place at checkpoints. Much richer awareness for a small token cost, and it applies to running bridges immediately.">
                                <ToggleButton x:Name="BridgeRealtimeSharingToggle" Style="{StaticResource Switch}"
                                              Checked="OnBridgeRealtimeSharingChanged" Unchecked="OnBridgeRealtimeSharingChanged"
                                              AutomationProperties.Name="Real-time bridge sharing" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE8BD;" Title="Agents can message each other" Keywords="peer mailbox msg"
                                            Description="Any agent can send a prompt straight to another with @@MSG agent=N — to hand over work outside its lane, ask the agent that owns an area, or escalate to the manager. Without this the status board is the only sideways channel. Chains are cut after a few hops so two agents cannot answer each other forever.">
                                <ToggleButton x:Name="BridgePeerMessagingToggle" Style="{StaticResource Switch}"
                                              Checked="OnBridgePeerMessagingChanged" Unchecked="OnBridgePeerMessagingChanged"
                                              AutomationProperties.Name="Agents can message each other" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="Agent swarms" Keywords="child workers subagents"
                                         Description="Lets one Claude, Codex, or Grok conversation coordinate a small set of native child agents. A swarm is not a Bridge: a Bridge coordinates several top-level CLI sessions, while a swarm is owned by one session whose parent waits, verifies, and integrates the children. Kimi is intentionally excluded.&#x0a;&#x0a;Turning swarm support on, or raising its limit, applies when an existing chat next reconnects. Lower limits, one-shot choices, and the Bridge opt-in apply immediately.">
                            <ui:SettingCard Glyph="&#xE716;" Title="Enable agent swarms"
                                            Description="Adds a one-shot swarm button to Claude, Codex, and Grok chats. An ordinary message still uses one agent.">
                                <ToggleButton x:Name="SwarmsEnabledToggle" Style="{StaticResource Switch}"
                                              Checked="OnSwarmsEnabledChanged" Unchecked="OnSwarmsEnabledChanged"
                                              AutomationProperties.Name="Enable agent swarms" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE7C4;" Title="Maximum child workers"
                                            ValueText="{Binding Value, ElementName=SwarmMaxSlider, StringFormat={}{0:0}}"
                                            IsEnabled="{Binding IsChecked, ElementName=SwarmsEnabledToggle}"
                                            Description="The parent picks the smallest useful swarm, from 1 up to this ceiling. Six is the balanced default; sixteen is the hard safety limit.">
                                <Slider x:Name="SwarmMaxSlider" Minimum="2" Maximum="16" TickFrequency="1"
                                        IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                        ValueChanged="OnSwarmMaxChanged" AutomationProperties.Name="Maximum swarm workers" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE8AB;" Title="Allow swarms inside Bridge"
                                            IsEnabled="{Binding IsChecked, ElementName=SwarmsEnabledToggle}"
                                            Description="Off by default. When enabled, each Claude, Codex, or Grok Bridge pane may arm its own bounded child swarm; Bridge peers stay separate root CLIs.">
                                <ToggleButton x:Name="BridgeSwarmsToggle" Style="{StaticResource Switch}"
                                              Checked="OnBridgeSwarmsChanged" Unchecked="OnBridgeSwarmsChanged"
                                              AutomationProperties.Name="Allow swarms inside Bridge" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="Supervision" Keywords="stalled stuck nudge restart takeover watchdog"
                                         Description="A dispatched agent can hang mid-tool, end a turn with nothing to say, loop, or die — and none of those announce themselves. Supervision watches every delegated agent and escalates on a bounded ladder: ask it to finish, then cancel and re-run it on the same task, then hand the task to the orchestrator. Every step is written to supervision-log.txt.">
                            <ui:SettingCard Glyph="&#xE9D9;" Title="Supervise delegated agents"
                                            Description="Applies to any Bridge with a manager.">
                                <ToggleButton x:Name="SupervisionEnabledToggle" Style="{StaticResource Switch}"
                                              Checked="OnSupervisionEnabledChanged" Unchecked="OnSupervisionEnabledChanged"
                                              AutomationProperties.Name="Supervise delegated agents" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE916;" Title="Stalled after"
                                            ValueText="{Binding Value, ElementName=SupervisionStaleSlider, StringFormat={}{0:0}s}"
                                            IsEnabled="{Binding IsChecked, ElementName=SupervisionEnabledToggle}"
                                            Description="Seconds an agent may run without producing any output before it counts as stalled.">
                                <Slider x:Name="SupervisionStaleSlider" Minimum="30" Maximum="1800"
                                        TickFrequency="30" IsSnapToTickEnabled="True" SmallChange="30" LargeChange="120"
                                        ValueChanged="OnSupervisionStaleChanged" AutomationProperties.Name="Stalled after" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE823;" Title="Reply window after a nudge"
                                            ValueText="{Binding Value, ElementName=SupervisionGraceSlider, StringFormat={}{0:0}s}"
                                            IsEnabled="{Binding IsChecked, ElementName=SupervisionEnabledToggle}"
                                            Description="Seconds a nudged agent has to answer before the supervisor escalates to a restart.">
                                <Slider x:Name="SupervisionGraceSlider" Minimum="30" Maximum="600"
                                        TickFrequency="15" IsSnapToTickEnabled="True" SmallChange="15" LargeChange="60"
                                        ValueChanged="OnSupervisionGraceChanged" AutomationProperties.Name="Reply window after a nudge" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE72C;" Title="Restarts before takeover"
                                            ValueText="{Binding Value, ElementName=SupervisionRestartsSlider, StringFormat={}{0:0}}"
                                            IsEnabled="{Binding IsChecked, ElementName=SupervisionEnabledToggle}"
                                            Description="How many times a stuck agent is cancelled and re-run on the same task before the orchestrator completes it directly. Zero means go straight to takeover.">
                                <Slider x:Name="SupervisionRestartsSlider" Minimum="0" Maximum="3"
                                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                        ValueChanged="OnSupervisionRestartsChanged" AutomationProperties.Name="Restarts before takeover" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="Dual monitor" Keywords="display screen second window"
                                         Description="Both windows share one app and close together.">
                            <ui:SettingCard Glyph="&#xE7F4;" Title="Spread Bridge across displays"
                                            Description="With 3 or more agents, keep agents 1–2 here and open the remaining Bridge panes on another display.">
                                <ToggleButton x:Name="DualMonitorBridgeToggle" Style="{StaticResource Switch}"
                                              Checked="OnDualMonitorBridgeChanged" Unchecked="OnDualMonitorBridgeChanged"
                                              AutomationProperties.Name="Dual-monitor Bridge" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE737;" Title="Second working shell"
                                            Description="Opens a second full VibeCode shell on another display. Each window remembers its own active chat; both share live sessions and chat controls, while accounts and Settings stay in the primary window.">
                                <ToggleButton x:Name="DualMonitorDoubleSessionsToggle" Style="{StaticResource Switch}"
                                              Checked="OnDualMonitorDoubleSessionsChanged" Unchecked="OnDualMonitorDoubleSessionsChanged"
                                              AutomationProperties.Name="Dual-monitor double sessions" />
                            </ui:SettingCard>
                        </ui:SettingGroup>
                    </ui:SettingPage>
                </ScrollViewer>

                <!-- ============================== Jarvis ============================== -->
                <ScrollViewer x:Name="PaneJarvis" VerticalScrollBarVisibility="Visible" Visibility="Collapsed">
                    <ui:SettingPage>
                        <ui:SettingHeading Title="Jarvis"
                                           Keywords="assistant conversation voice AI provider model microphone speech British"
                                           Description="Your personal desktop assistant for everyday questions, Windows apps, files and VibeCode chats. Its AI choice is saved separately from your chat defaults." />

                        <ui:SettingGroup Header="AI">
                            <ui:SettingCard Glyph="&#xE8F2;" Title="Provider"
                                            Description="Uses the selected account for this provider.">
                                <ComboBox x:Name="JarvisProviderPicker" SelectedValuePath="Id" TextSearch.TextPath="Name"
                                          SelectionChanged="OnJarvisProviderChanged" AutomationProperties.Name="Jarvis AI provider">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource PickerText}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE950;" Title="Model"
                                            Description="GPT Luna is preferred when it is available. Choose another model at any time.">
                                <ComboBox x:Name="JarvisModelPicker" SelectedValuePath="Value" TextSearch.TextPath="Display"
                                          SelectionChanged="OnJarvisModelChanged" AutomationProperties.Name="Jarvis AI model">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Display}" Style="{StaticResource PickerText}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE9CE;" Title="Thinking effort" Keywords="reasoning"
                                            Description="Only choices supported by the selected model appear.">
                                <ComboBox x:Name="JarvisEffortPicker" SelectedValuePath="Value" TextSearch.TextPath="Label"
                                          SelectionChanged="OnJarvisEffortChanged" AutomationProperties.Name="Jarvis thinking effort">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" Style="{StaticResource PickerText}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="Voice" Keywords="speech speak aloud tts">
                            <ui:SettingCard Glyph="&#xE767;" Title="Spoken replies"
                                            Description="Read Jarvis replies aloud. Your microphone starts only when you choose Talk.">
                                <ToggleButton x:Name="JarvisVoiceToggle" Style="{StaticResource Switch}"
                                              Checked="OnJarvisVoiceEnabledChanged" Unchecked="OnJarvisVoiceEnabledChanged"
                                              AutomationProperties.Name="Read Jarvis replies aloud" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE8D6;" Title="Voice" Keywords="british kokoro windows preview"
                                            Description="Choose a British stock voice or an installed Windows voice. Speech runs locally: British voices download a 164 MB speech model on first use, and text conversation is available straight away.">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="JarvisPreviewButton" Style="{StaticResource SettingIconButton}" Content="&#xE768;"
                                            Click="OnPreviewJarvisVoice" ToolTip="Preview this voice"
                                            AutomationProperties.Name="Preview Jarvis voice" />
                                    <Button x:Name="JarvisStopPreviewButton" Style="{StaticResource SettingIconButton}" Content="&#xE71A;"
                                            Margin="4,0,0,0" Click="OnStopJarvisVoice" IsEnabled="False" ToolTip="Stop the preview"
                                            AutomationProperties.Name="Stop Jarvis voice preview" />
                                    <ComboBox x:Name="JarvisVoicePicker" Margin="6,0,0,0" SelectedValuePath="Id"
                                              TextSearch.TextPath="Display" SelectionChanged="OnJarvisVoiceChanged"
                                              AutomationProperties.Name="Jarvis speaking voice">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Display}" Style="{StaticResource PickerText}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <ui:SettingCard.Footer>
                                    <TextBlock x:Name="JarvisVoiceStatus" Style="{StaticResource StatusLine}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE945;" Title="Speech speed" Keywords="rate pace"
                                            ValueText="{Binding Value, ElementName=JarvisSpeedSlider, StringFormat={}{0:0.00}×}"
                                            Description="Adjust the pace of spoken replies.">
                                <Slider x:Name="JarvisSpeedSlider" Minimum="0.6" Maximum="1.5" TickFrequency="0.05"
                                        SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True"
                                        ValueChanged="OnJarvisSpeedChanged" AutomationProperties.Name="Jarvis speech speed" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE995;" Title="Volume" Keywords="loudness"
                                            ValueText="{Binding Value, ElementName=JarvisVolumeSlider, StringFormat={}{0:0}%}"
                                            Description="Adjust Jarvis playback volume.">
                                <Slider x:Name="JarvisVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                        SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True"
                                        ValueChanged="OnJarvisVolumeChanged" AutomationProperties.Name="Jarvis speech volume" />
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <ui:SettingGroup Header="Microphone" Keywords="mic input record transcription dictation">
                            <ui:SettingCard Glyph="&#xE720;" Title="Microphone test"
                                            Description="Record a short test and show what Jarvis heard. This test does not send a message to AI. It uses your default microphone; finish the recording to see its transcript. Offline transcription may download a model on first use.">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="JarvisMicrophoneTestButton" Style="{StaticResource SettingButton}"
                                            Content="Test microphone" Click="OnTestJarvisMicrophone"
                                            AutomationProperties.Name="Test Jarvis microphone" />
                                    <Button x:Name="JarvisStopMicrophoneTestButton" Style="{StaticResource SettingButton}"
                                            Content="Stop" Margin="6,0,0,0" Click="OnStopJarvisMicrophoneTest" IsEnabled="False"
                                            AutomationProperties.Name="Cancel Jarvis microphone test" />
                                </StackPanel>
                                <ui:SettingCard.Footer>
                                    <TextBlock x:Name="JarvisMicrophoneStatus" Style="{StaticResource StatusLine}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                        </ui:SettingGroup>
                        <TextBlock x:Name="JarvisSettingsError" Foreground="{StaticResource Red}" FontSize="12" TextWrapping="Wrap"
                                   Margin="2,0,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
                    </ui:SettingPage>
                </ScrollViewer>

                <!-- ============================== MCP & extensions ==============================
                     Two categories became one: both are "things plugged into VibeCode". MCP servers sit on top,
                     folded into a dropdown, because a list of server definitions is something you open when you
                     need it rather than something every visit should scroll past. -->
                <ScrollViewer x:Name="PaneExtensions" VerticalScrollBarVisibility="Visible" Visibility="Collapsed">
                    <ui:SettingPage>
                        <ui:SettingHeading Title="MCP &amp; extensions" />

                        <ui:SettingGroup x:Name="SectionMcp" Header="MCP servers"
                                         Keywords="model context protocol servers tools stdio http sse">
                            <ui:SettingCard x:Name="McpServersCard" Glyph="&#xE950;" Title="MCP servers"
                                            IsExpandable="True" IsExpanded="False" Keywords="add server definition catalog"
                                            Description="Create one VibeCode definition and choose which CLIs receive it. Claude, Codex, Kimi, and Grok remain the MCP clients; VibeCode translates their different launch formats without editing any provider's native config files.&#x0a;&#x0a;Common path: stdio + Streamable HTTP. Legacy SSE works in Claude, Kimi, and Grok but is skipped for Codex. Server changes apply when a chat next starts or reconnects. OAuth sign-in remains provider-owned; the shared catalog supports environment-backed bearer tokens and static headers.">
                                <ui:SettingCard.Status>
                                    <TextBlock x:Name="McpCountText" Style="{StaticResource RowStatus}" Text="No servers" />
                                </ui:SettingCard.Status>
                                <Button Style="{StaticResource SettingButtonPrimary}" Click="OnAddMcpServer"
                                        AutomationProperties.Name="Add MCP server">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Add server" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                                <ui:SettingCard.Footer>
                                    <StackPanel>
                                        <TextBlock x:Name="McpEmpty" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,8"
                                                   Text="No universal MCP servers yet. Provider-native MCP configuration is left untouched." />
                                        <ItemsControl x:Name="McpList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource InsetItem}" Padding="12,10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="10,0,0,0"
                                                                              IsChecked="{Binding Enabled, Mode=TwoWay}" Checked="OnMcpEnabledChanged"
                                                                              Unchecked="OnMcpEnabledChanged" AutomationProperties.Name="Enable MCP server" />
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4"
                                                                        VerticalAlignment="Center"
                                                                        Click="OnRemoveMcpServer" AutomationProperties.Name="Remove MCP server">
                                                                    <TextBlock Text="Remove" Foreground="{StaticResource Red}" FontSize="11.5" />
                                                                </Button>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,2,0"
                                                                        VerticalAlignment="Center"
                                                                        Click="OnEditMcpServer" AutomationProperties.Name="Edit MCP server">
                                                                    <TextBlock Text="Edit" Foreground="{StaticResource Muted}" FontSize="11.5" />
                                                                </Button>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <Grid HorizontalAlignment="Left">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text}"
                                                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        <ui:InfoTip Grid.Column="1" Width="17" Height="17" FontSize="11" Margin="4,0,0,0">
                                                                            <ui:InfoTip.Text>
                                                                                <MultiBinding StringFormat="{}{0}&#x0a;{1}">
                                                                                    <Binding Path="RuntimeNameLabel" />
                                                                                    <Binding Path="CompatibilityNote" />
                                                                                </MultiBinding>
                                                                            </ui:InfoTip.Text>
                                                                        </ui:InfoTip>
                                                                    </Grid>
                                                                    <TextBlock FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                                                               TextWrapping="Wrap">
                                                                        <Run Text="{Binding TransportLabel, Mode=OneWay}" Foreground="{StaticResource Accent}" /><Run Text="  ·  " /><Run Text="{Binding TargetsSummary, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <Border Background="{StaticResource CodeBg}" CornerRadius="{StaticResource Rad7}" Padding="9,6" Margin="0,9,0,0">
                                                                <TextBlock Text="{Binding EndpointSummary}" FontFamily="{StaticResource Mono}" FontSize="10.5"
                                                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- The one caution that stays in plain sight: it is a warning, not an explanation. -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Only add servers you trust." FontSize="11" Foreground="{StaticResource Faint}"
                                                       VerticalAlignment="Center" />
                                            <ui:InfoTip Width="17" Height="17" FontSize="11" Margin="3,0,0,0"
                                                        Text="Security boundary: stdio entries execute a local command, while remote entries can expose tools and data to the selected agent. Tool approvals still follow each chat's permission mode. Use ${TOKEN_NAME} references instead of pasting secrets when possible." />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>
                        </ui:SettingGroup>

                        <!-- Each extension is an ordinary row; switched on, it opens its own setup underneath.
                             IsExpanded follows the service's persisted Enabled flag rather than the switch. -->
                        <ui:SettingGroup x:Name="SectionExtensions" Header="Extensions"
                                         Keywords="optional services titlebar tools plugins"
                                         Description="Optional services and titlebar tools that run alongside Claude Code. Switching one off puts away everything it added.">
                            <ui:SettingCard x:Name="SecondBrainExtensionCard" Glyph="&#xE8F1;" Title="Second Brain"
                                            Keywords="memory recall remember opt in agentmemory knowledge map"
                                            Description="Remember and recall across your chats. Off until you choose to enable it: turning it on allows local memory capture and recall, and you can still mute individual chats. The memory map is where you set up the local service and manage saved memories. Switching this off preserves everything already saved.">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SettingButton}" Content="Open memory map" Margin="0,0,12,0"
                                            Click="OnOpenSecondBrainSettings"
                                            Visibility="{Binding IsChecked, ElementName=SecondBrainToggle, Converter={StaticResource BoolVis}}"
                                            AutomationProperties.Name="Open Second Brain memory map" />
                                    <ToggleButton x:Name="SecondBrainToggle" Style="{StaticResource Switch}"
                                                  Checked="OnSecondBrainEnabledChanged" Unchecked="OnSecondBrainEnabledChanged"
                                                  AutomationProperties.Name="Enable Second Brain extension" />
                                </StackPanel>
                            </ui:SettingCard>

                            <!-- ===== Spotify ===== -->
                            <ui:SettingCard DataContext="{x:Static svc:SpotifyService.Instance}" Glyph="&#xEC4F;"
                                            Tint="{StaticResource SpotifyGreen}" TintSoft="{StaticResource SpotifyGreenSoft}"
                                            Title="Spotify" Keywords="music playback client id connect account premium"
                                            IsExpanded="{Binding Enabled, Mode=OneWay}"
                                            Description="Control playback from VibeCode: connect your Spotify account and drive playback without leaving the app. Connecting opens Spotify in your browser to authorize. Playback control requires Spotify Premium.">
                                <ui:SettingCard.Status>
                                    <Grid Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource SpotifyGreenSoft}"
                                                Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource SpotifyGreen}" />
                                                <TextBlock Text="Connected" Style="{StaticResource PillText}"
                                                           Foreground="{StaticResource SpotifyGreen}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}"
                                                Visibility="{Binding IsConnected, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                            <TextBlock Text="Needs setup" Style="{StaticResource PillText}"
                                                       Foreground="{StaticResource Amber}" />
                                        </Border>
                                    </Grid>
                                </ui:SettingCard.Status>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Checked="OnSpotifyEnabledChanged" Unchecked="OnSpotifyEnabledChanged"
                                              AutomationProperties.Name="Enable Spotify" />
                                <ui:SettingCard.Footer>
                                    <!-- Two mutually exclusive halves, stacked: a Grid takes the height of whichever one
                                         is showing, because a collapsed child never gets measured. -->
                                    <Grid>
                                        <!-- not connected: the two-step setup -->
                                        <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                            <TextBlock Style="{StaticResource Caption}" Text="1 — CREATE A FREE SPOTIFY APP" />
                                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0">
                                                <Run Text="At " /><Hyperlink Foreground="{StaticResource Accent}" Cursor="Hand"
                                                           Click="OnCopyDevLink" ToolTip="Copy link to clipboard">developer.spotify.com/dashboard</Hyperlink><Run Text=", add this exact Redirect URI:" />
                                            </TextBlock>
                                            <TextBlock x:Name="DevCopied" Text="&#x2713; Copied link to clipboard" FontSize="11"
                                                       Foreground="{StaticResource SpotifyGreen}" Margin="0,5,0,0" Visibility="Collapsed" />
                                            <Border Background="{StaticResource CodeBg}" CornerRadius="{StaticResource Rad8}"
                                                    Padding="11,8" Margin="0,7,0,0">
                                                <TextBox Text="{Binding Source={x:Static svc:SpotifyService.RedirectUri}, Mode=OneWay}"
                                                         IsReadOnly="True" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                                         FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                         AutomationProperties.Name="Redirect URI" />
                                            </Border>

                                            <TextBlock Style="{StaticResource Caption}" Text="2 — PASTE ITS CLIENT ID" Margin="0,14,0,6" />
                                            <TextBox x:Name="ClientIdBox" FontFamily="{StaticResource Mono}"
                                                     AutomationProperties.Name="Spotify Client ID" />

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="ConnectBtn" Style="{StaticResource SettingButtonSpotify}"
                                                        Click="OnSpotifyConnect" AutomationProperties.Name="Connect Spotify">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                                   Foreground="White" VerticalAlignment="Center" />
                                                        <TextBlock Text="Connect Spotify" Foreground="White" FontWeight="SemiBold"
                                                                   FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock x:Name="ConnectStatus" Text="Not connected" FontSize="11.5"
                                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- connected: the player, and the way back out -->
                                        <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}">
                                            <Border Background="{StaticResource CodeBg}" CornerRadius="{StaticResource Rad10}" Padding="12">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <Button Style="{StaticResource Transport}" Content="&#xE892;" Click="OnSpotifyPrev"
                                                                AutomationProperties.Name="Previous track" />
                                                        <Button Click="OnSpotifyToggle" Width="34" Height="34" Margin="4,0" Cursor="Hand"
                                                                AutomationProperties.Name="Play or pause">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="pc" Width="34" Height="34" CornerRadius="{StaticResource Rad17}"
                                                                            Background="{StaticResource SpotifyGreen}">
                                                                        <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="{StaticResource Icons}"
                                                                                   FontSize="13" Foreground="White" HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="pc" Property="Background" Value="{StaticResource SpotifyGreenHover}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Style="{StaticResource Transport}" Content="&#xE893;" Click="OnSpotifyNext"
                                                                AutomationProperties.Name="Next track" />
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="{StaticResource Rad8}"
                                                            Background="{StaticResource Bg3}" Margin="0,0,12,0" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="17"
                                                                       Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Track}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Text}"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   Visibility="{Binding HasTrack, Converter={StaticResource BoolVis}}" />
                                                        <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   Visibility="{Binding HasTrack, Converter={StaticResource BoolVis}}" />
                                                        <TextBlock Text="Nothing playing" FontSize="12.5" Foreground="{StaticResource Muted}"
                                                                   Visibility="{Binding HasTrack, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}" />
                                                        <TextBlock Text="Start playback on any device" FontSize="11" Foreground="{StaticResource Faint}"
                                                                   Visibility="{Binding HasTrack, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <Button Style="{StaticResource SettingButton}" Content="Disconnect"
                                                    HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnSpotifyDisconnect"
                                                    AutomationProperties.Name="Disconnect Spotify" />
                                        </StackPanel>
                                    </Grid>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>

                            <!-- ===== Weather ===== -->
                            <ui:SettingCard DataContext="{x:Static svc:WeatherService.Instance}" Glyph="&#xE753;"
                                            Tint="{StaticResource WeatherBlue}" TintSoft="{StaticResource WeatherBlueSoft}"
                                            Title="Weather" Keywords="forecast city location temperature celsius fahrenheit radar spc outlook"
                                            IsExpanded="{Binding Enabled, Mode=OneWay}"
                                            Description="Conditions, NWS radar, and SPC Day 1–3 outlooks. Turn on to show U.S. or Canadian conditions next to the settings gear, and to open radar and SPC outlook maps.">
                                <ui:SettingCard.Status>
                                    <Grid Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}"
                                                Visibility="{Binding HasLocation, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                            <TextBlock Text="No location" Style="{StaticResource PillText}"
                                                       Foreground="{StaticResource Amber}" />
                                        </Border>
                                    </Grid>
                                </ui:SettingCard.Status>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Checked="OnWeatherEnabledChanged" Unchecked="OnWeatherEnabledChanged"
                                              AutomationProperties.Name="Enable weather" />
                                <ui:SettingCard.Footer>
                                    <StackPanel>
                                        <!-- what the titlebar chip is showing right now. No reading yet simply says
                                             nothing at all: the titlebar chip is one line wide and has to print a
                                             placeholder, this card has the room not to. -->
                                        <DockPanel Margin="0,0,0,14"
                                                   Visibility="{Binding HasLocation, Converter={StaticResource BoolVis}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SettingButton}" Content="Open maps"
                                                    Margin="12,0,0,0" Click="OnOpenRadar"
                                                    AutomationProperties.Name="Open weather maps" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ConditionGlyph}"
                                                       FontFamily="{StaticResource Icons}" FontSize="19"
                                                       Foreground="{StaticResource WeatherBlue}" VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Place}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0"
                                                           Visibility="{Binding HasReading, Converter={StaticResource BoolVis}}">
                                                    <Run Text="{Binding TempText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Conditions, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Style="{StaticResource Caption}" Text="CHANGE LOCATION" Margin="0,0,0,7"
                                                   Visibility="{Binding HasLocation, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="PICK A LOCATION" Margin="0,0,0,7"
                                                   Visibility="{Binding HasLocation, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}" />

                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SettingButton}" Content="Search"
                                                    Margin="6,0,0,0" Click="OnWeatherSearch"
                                                    AutomationProperties.Name="Search places" />
                                            <TextBox x:Name="WeatherSearchBox" Style="{StaticResource SearchField}"
                                                     Tag="Search a U.S. or Canadian city"
                                                     KeyDown="OnWeatherSearchKey" TextChanged="OnWeatherSearchTextChanged"
                                                     AutomationProperties.Name="Place search"
                                                     AutomationProperties.HelpText="Suggestions appear as you type at least 3 characters" />
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,0">
                                            <Button x:Name="WeatherLocationButton" DockPanel.Dock="Left"
                                                    Style="{StaticResource SettingButton}" Click="OnWeatherGetLocation"
                                                    ToolTip="Uses your approximate network location"
                                                    AutomationProperties.Name="Get my location">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE707;" FontFamily="{StaticResource Icons}" FontSize="11.5"
                                                               Foreground="{StaticResource WeatherBlue}" Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Use my location" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="WeatherStatus" FontSize="11" Foreground="{StaticResource Faint}"
                                                       Margin="11,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Visibility="Collapsed" />
                                        </DockPanel>

                                        <ScrollViewer Margin="0,8,0,0" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding Content.HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolVis}}">
                                            <ItemsControl x:Name="WeatherResults">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                                HorizontalAlignment="Stretch" Padding="11,7" Margin="0,0,0,2"
                                                                Click="OnWeatherPickPlace" AutomationProperties.Name="{Binding Display}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Display}" FontSize="12.5"
                                                                           Foreground="{StaticResource Text}" />
                                                                <TextBlock Text="{Binding Country}" FontSize="10.5"
                                                                           Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>

                            <!-- ===== Speech to text (Groq) =====
                                 Ships OFF: dictation already works offline with the local model, and this one uploads
                                 the clip to a third party, so it stays opt-in and says so. -->
                            <ui:SettingCard DataContext="{x:Static svc:GroqSpeechService.Instance}" Glyph="&#xE720;"
                                            Title="Speech to text" Keywords="dictation speech voice microphone groq whisper api key offline"
                                            IsExpanded="{Binding Enabled, Mode=OneWay}"
                                            Description="Groq's Whisper large-v3 instead of the offline medium.en. The mic button works exactly as before — this only changes what does the transcribing. Your recording is uploaded to Groq and billed to your key.&#x0a;&#x0a;Off, the mic button transcribes on this machine with Whisper medium.en and no audio ever leaves it, so switch this off for private dictation. Leaving it off downloads that model once, about 1.5 GB, the first time you dictate.">
                                <ui:SettingCard.Status>
                                    <Grid Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource GreenSoft}"
                                                Visibility="{Binding HasKey, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource Green}" />
                                                <TextBlock Text="Key saved" Style="{StaticResource PillText}"
                                                           Foreground="{StaticResource Green}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}"
                                                Visibility="{Binding HasKey, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                            <TextBlock Text="Needs a key" Style="{StaticResource PillText}"
                                                       Foreground="{StaticResource Amber}" />
                                        </Border>
                                    </Grid>
                                </ui:SettingCard.Status>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Checked="OnGroqSpeechEnabledChanged" Unchecked="OnGroqSpeechEnabledChanged"
                                              AutomationProperties.Name="Use Groq for speech to text" />
                                <ui:SettingCard.Footer>
                                    <Grid>
                                        <!-- no key yet -->
                                        <StackPanel Visibility="{Binding HasKey, Converter={StaticResource ShowIfLocal}, ConverterParameter=invert}">
                                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}">
                                                <Run Text="Create a free key at " /><Hyperlink Foreground="{StaticResource Accent}" Cursor="Hand"
                                                           Click="OnCopyGroqKeyLink" ToolTip="Copy link to clipboard">console.groq.com/keys</Hyperlink><Run Text=" and paste it here. It starts with &quot;gsk_&quot;." />
                                            </TextBlock>
                                            <TextBlock x:Name="GroqLinkCopied" Text="&#x2713; Copied link to clipboard" FontSize="11"
                                                       Foreground="{StaticResource Green}" Margin="0,5,0,0" Visibility="Collapsed" />
                                            <DockPanel Margin="0,9,0,0">
                                                <Button x:Name="GroqSaveBtn" DockPanel.Dock="Right" Style="{StaticResource SettingButtonPrimary}"
                                                        Content="Verify and save" Margin="6,0,0,0"
                                                        Click="OnSaveGroqKey" AutomationProperties.Name="Verify and save Groq API key" />
                                                <PasswordBox x:Name="GroqKeyBox" FontFamily="{StaticResource Mono}"
                                                             AutomationProperties.Name="Groq API key" />
                                            </DockPanel>
                                            <TextBlock x:Name="GroqKeyStatus" Text="Dictation still runs offline until a key is saved."
                                                       FontSize="11.5" Foreground="{StaticResource Amber}" TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>

                                        <!-- key saved -->
                                        <DockPanel Visibility="{Binding HasKey, Converter={StaticResource BoolVis}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SettingButton}" Content="Remove key"
                                                    Margin="12,0,0,0" Click="OnRemoveGroqKey"
                                                    AutomationProperties.Name="Remove Groq API key" />
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="12.5"
                                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                    </Grid>
                                </ui:SettingCard.Footer>
                            </ui:SettingCard>

                            <!-- ===== Phone =====
                                 Ships OFF: the phone button opens a window that can start a listening socket, so it stays
                                 out of the titlebar until it is asked for. Turning this off again also stops the bridge -
                                 see PhoneBridgeService.Enabled. -->
                            <ui:SettingCard DataContext="{x:Static svc:PhoneBridgeService.Instance}" Glyph="&#xE8EA;"
                                            Title="Phone" Keywords="mobile remote pairing chats bridge android"
                                            Description="Read and reply to your chats from your phone. Turning this on puts a phone button in the title bar; pairing, the generated app, and the bridge itself all live in that window. Turning it off closes the bridge too.">
                                <ui:SettingCard.Status>
                                    <!-- Labelled, because StatusText is the socket's state ("Off"), not the
                                         extension's - unprefixed it reads as contradicting the switch beside it. -->
                                    <TextBlock Style="{StaticResource RowStatus}"
                                               Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                                        <Run Text="Bridge · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                    </TextBlock>
                                </ui:SettingCard.Status>
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Checked="OnPhoneEnabledChanged" Unchecked="OnPhoneEnabledChanged"
                                              AutomationProperties.Name="Enable phone" />
                            </ui:SettingCard>
                        </ui:SettingGroup>
                    </ui:SettingPage>
                </ScrollViewer>

                <!-- ============================== Usage ==============================
                     A dashboard, not a list of settings, so everything down to the telemetry rows is its own. -->
                <ScrollViewer x:Name="PaneUsage" VerticalScrollBarVisibility="Visible" Visibility="Collapsed">
                    <ui:SettingPage MaxContentWidth="700">
                        <ui:SettingHeading Title="Usage"
                                           Keywords="tokens cost history statistics electricity energy water telemetry charts spend"
                                           Description="Every model call VibeCode makes is recorded on this machine — which model, how many tokens in and out, and what those tokens are worth at the provider's public list price. Nothing is uploaded anywhere." />

                        <!-- One filter row above everything it scopes: every chart and the table below redraw
                             against the same slice, so no card carries a range control of its own. -->
                        <Border Style="{StaticResource Segmented}" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RangeToday" Style="{StaticResource Chip}" Content="Today"
                                             GroupName="UsageRange" Checked="OnUsageRangeChanged" />
                                <RadioButton x:Name="RangeWeek" Style="{StaticResource Chip}" Content="7 days"
                                             GroupName="UsageRange" Checked="OnUsageRangeChanged" IsChecked="True" />
                                <RadioButton x:Name="RangeMonth" Style="{StaticResource Chip}" Content="30 days"
                                             GroupName="UsageRange" Checked="OnUsageRangeChanged" />
                                <RadioButton x:Name="RangeAll" Style="{StaticResource Chip}" Content="All time"
                                             GroupName="UsageRange" Checked="OnUsageRangeChanged" />
                            </StackPanel>
                        </Border>

                        <!-- Hero: the one number this page leads with, then the supporting tiles. -->
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <TextBlock x:Name="UsageHeroLabel" Text="ESTIMATED SPEND · LAST 7 DAYS" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="UsageHero" Text="$0" FontFamily="{StaticResource Ui}" FontSize="40"
                                           FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,4,0,0" />
                                <TextBlock x:Name="UsageHeroSub" Text="No model calls recorded yet."
                                           FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Tokens in" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageTileIn" Text="0" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Tokens out" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageTileOut" Text="0" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Served from cache" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageTileCache" Text="0%" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Turns" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageTileTurns" Text="0" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,20,0,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ShareByCost" Style="{StaticResource Chip}" Content="Cost"
                                                 Padding="10,3" GroupName="UsageShare" IsChecked="True" Checked="OnUsageShareMetricChanged" />
                                    <RadioButton x:Name="ShareByTokens" Style="{StaticResource Chip}" Content="Tokens"
                                                 Padding="10,3" GroupName="UsageShare" Checked="OnUsageShareMetricChanged" />
                                    <RadioButton x:Name="ShareByEnergy" Style="{StaticResource Chip}" Content="Electricity"
                                                 Padding="10,3" GroupName="UsageShare" Checked="OnUsageShareMetricChanged" />
                                    <RadioButton x:Name="ShareByWater" Style="{StaticResource Chip}" Content="Water"
                                                 Padding="10,3" GroupName="UsageShare" Checked="OnUsageShareMetricChanged" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="SHARE BY MODEL" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <ui:ModelShareDonut x:Name="UsageDonut" SurfaceKey="Bg2" />
                        </Border>

                        <TextBlock Text="TOKENS IN AND OUT, BY MODEL" Style="{StaticResource Caption}" Margin="2,20,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <ui:ModelTokenBarChart x:Name="UsageBars" SurfaceKey="Bg2" />
                        </Border>

                        <DockPanel Margin="0,20,0,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TrendByCost" Style="{StaticResource Chip}" Content="Cost"
                                                 Padding="10,3" GroupName="UsageTrend" IsChecked="True" Checked="OnUsageTrendMetricChanged" />
                                    <RadioButton x:Name="TrendByTokens" Style="{StaticResource Chip}" Content="Tokens"
                                                 Padding="10,3" GroupName="UsageTrend" Checked="OnUsageTrendMetricChanged" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="UsageTrendCaption" Text="DAILY SPEND" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <ui:DailyTrend x:Name="UsageTrend" SurfaceKey="Bg2" />
                        </Border>

                        <TextBlock Text="BREAKDOWN" Style="{StaticResource Caption}" Margin="2,20,0,8" />
                        <Border Style="{StaticResource Card}" Padding="4,2">
                            <StackPanel>
                                <!-- The table view: the WCAG-clean twin of every chart above, so no value on this
                                     page is reachable only by hovering a mark. -->
                                <Grid Margin="12,10,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Model" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="TURNS" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="IN" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="OUT" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="COST" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="ENERGY" Style="{StaticResource Caption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="WATER" Style="{StaticResource Caption}" TextAlignment="Right" />
                                </Grid>
                                <Rectangle Height="1" Fill="{StaticResource BorderHairline}" />
                                <ItemsControl x:Name="UsageTable">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="{StaticResource Rad2}"
                                                            Background="{Binding Swatch}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Display}" FontSize="12" Margin="9,0,8,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                    <TextBlock Text="est." FontSize="9.5" Foreground="{StaticResource Faint}"
                                                               VerticalAlignment="Center" ToolTip="No published price for this model — priced at the Opus tier."
                                                               Visibility="{Binding EstimateFlagVisibility}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Turns}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding TokensIn}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding TokensOut}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Cost}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding Energy}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding Water}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="UsageTableEmpty" Text="Nothing recorded in this range yet."
                                           FontSize="11.5" Foreground="{StaticResource Faint}" Margin="12,14,12,16" />
                            </StackPanel>
                        </Border>

                        <!-- The physical bill behind the money one. It sits AFTER the metered numbers on purpose:
                             everything above is counted, this is modelled, and reading it last means the page
                             leads with what it knows. Its own card, its own trend, and the note under the tiles
                             is part of the number rather than a footnote to it. -->
                        <DockPanel Margin="0,26,0,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FootprintByEnergy" Style="{StaticResource Chip}" Content="Electricity"
                                                 Padding="10,3" GroupName="UsageFootprint" IsChecked="True" Checked="OnUsageFootprintMetricChanged" />
                                    <RadioButton x:Name="FootprintByWater" Style="{StaticResource Chip}" Content="Water"
                                                 Padding="10,3" GroupName="UsageFootprint" Checked="OnUsageFootprintMetricChanged" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ELECTRICITY AND WATER" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Electricity" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageEnergy" Text="0 Wh" FontFamily="{StaticResource Ui}"
                                                   FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                   Margin="0,3,0,0" />
                                        <TextBlock x:Name="UsageEnergySub" FontSize="11" Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Water" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        <TextBlock x:Name="UsageWater" Text="0 mL" FontFamily="{StaticResource Ui}"
                                                   FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                   Margin="0,3,0,0" />
                                        <TextBlock x:Name="UsageWaterSub" FontSize="11" Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                                <!-- Its own daily trend, one measure at a time. Water is a fixed multiple of
                                     electricity, so overlaying them would draw the same curve twice. -->
                                <TextBlock x:Name="UsageFootprintTrendCaption" Text="ELECTRICITY PER DAY"
                                           Style="{StaticResource Caption}" Margin="0,18,0,2" />
                                <!-- Metric is set here as well as on the chip: the chip's Checked fires during
                                     InitializeComponent, before _ready, so the handler cannot be what establishes
                                     the initial state. Markup and chip must agree. -->
                                <ui:DailyTrend x:Name="UsageFootprintTrend" Metric="Energy" SurfaceKey="Bg2" />
                                <TextBlock x:Name="UsageFootprintNote" FontSize="11" Foreground="{StaticResource Faint}"
                                           TextWrapping="Wrap" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                CornerRadius="{StaticResource Rad10}" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock x:Name="UsageFootnote" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"
                                           Text="Costs are an estimate of what these tokens would bill at each provider's public list price, including the cheaper cache-write and cache-read rates. On a subscription you are not charged per token, so treat this as the value of the work rather than an invoice." />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource SettingButton}" Click="OnExportUsage"
                                            AutomationProperties.Name="Export usage history as CSV">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            <TextBlock Text="Export CSV" FontSize="12" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SettingButton}" Margin="6,0,0,0" Click="OnClearUsage"
                                            AutomationProperties.Name="Clear usage history">
                                        <TextBlock Text="Clear history" FontSize="12" Foreground="{StaticResource Red}" />
                                    </Button>
                                    <TextBlock x:Name="UsageStorageNote" FontSize="10.5" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- The live windows sit BELOW everything the range filter scopes, and outside its reach:
                             nothing in this group is filtered by it - these are actions, and both windows carry
                             their own range control. Reading order is the page's own numbers first, then the two
                             ways to leave them running on another screen. -->
                        <ui:SettingGroup Header="Live telemetry" Margin="0,26,0,0" Keywords="hud wall dashboard monitor">
                            <ui:SettingCard Glyph="&#xE9D9;" Title="Telemetry HUD" Keywords="always on top full screen wall"
                                            Description="A compact always-on-top window covering the last 24 hours — spend, tokens, electricity and water, throughput hour by hour, and the split by model. Built to be parked on a spare screen and left running. The full-screen wall shows the same telemetry over anything from the last hour to the last 30 days, and remembers the range you leave it on.">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SettingButton}" Content="Full-screen wall"
                                            Click="OnOpenTelemetryWall"
                                            AutomationProperties.Name="Open the full-screen telemetry wall" />
                                    <Button Style="{StaticResource SettingButtonPrimary}" Content="Open HUD" Margin="6,0,0,0"
                                            Click="OnOpenTelemetryHud" AutomationProperties.Name="Open the telemetry HUD" />
                                </StackPanel>
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE7F4;" Title="Open on the second display"
                                            Description="Sends it to whichever display VibeCode is not on, so watching it never means covering the thing it is reporting on. Drag it elsewhere and it stays there — this only decides where it goes when it would otherwise land on top of the app.">
                                <ToggleButton x:Name="TelemetryCompanionDisplayToggle" Style="{StaticResource Switch}"
                                              Checked="OnTelemetryCompanionDisplayChanged" Unchecked="OnTelemetryCompanionDisplayChanged"
                                              AutomationProperties.Name="Open telemetry on the second display" />
                            </ui:SettingCard>
                            <ui:SettingCard Glyph="&#xE9D2;" Title="Live animation"
                                            Description="Bars and trend lines travel to each new reading instead of jumping to it, the headline figures count across, and the sparklines keep a slow ripple so a glance tells you the window is still live. Every figure still settles on the real one.">
                                <ToggleButton x:Name="TelemetryAnimationToggle" Style="{StaticResource Switch}"
                                              Checked="OnTelemetryAnimationChanged" Unchecked="OnTelemetryAnimationChanged"
                                              AutomationProperties.Name="Animate the telemetry windows" />
                            </ui:SettingCard>
                        </ui:SettingGroup>
                    </ui:SettingPage>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
